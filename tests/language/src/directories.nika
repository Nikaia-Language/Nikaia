// **Names made, removed, renamed and copied** (Part III 17.1, #546): each
// under a root of the test's own, and none of them able to leave it.

use std::fs

test "a directory is made, recursively where asked" {
    let root = fs::scratch()
    fs::create_dir("a/b", root; recursive: true)
    fs::create_dir("c", root)
    let nested = fs::metadata("a/b", root)
    let flat = fs::metadata("c", root)
    assert(nested.is_dir())
    assert(flat.is_dir())
    let mut refused = false
    fs::create_dir("d/e", root) catch { refused = true }
    assert(refused)
}

test "a file is copied, renamed and measured" {
    let root = fs::scratch()
    fs::write("one.txt", root, "hello")
    let copied = fs::copy("one.txt", "two.txt", root)
    fs::rename("two.txt", "three.txt", root)
    let meta = fs::metadata("three.txt", root)
    assert(copied == 5)
    assert(meta.len() == 5)
    assert(meta.is_file())
    assert(!meta.is_dir())
    let moved = !fs::exists("two.txt", root)
    assert(moved)
}

test "a directory's names are read in byte order" {
    let root = fs::scratch()
    fs::create_dir("d", root)
    fs::write("d/b.txt", root, "")
    fs::write("d/a.txt", root, "")
    fs::create_dir("d/c", root)
    let mut seen = ""
    for name in fs::read_dir("d", root) {
        seen = f"{seen}{name.to_text()} "
    }
    assert(seen == "a.txt b.txt c ")
}

test "a file and a tree are removed" {
    let root = fs::scratch()
    fs::create_dir("t/u", root; recursive: true)
    fs::write("t/u/f.txt", root, "x")
    fs::write("g.txt", root, "x")
    fs::remove("g.txt", root)
    let mut kept = false
    fs::remove("t", root) catch { kept = true }
    assert(kept)
    fs::remove("t", root; recursive: true)
    let file_gone = !fs::exists("g.txt", root)
    let tree_gone = !fs::exists("t", root)
    assert(file_gone)
    assert(tree_gone)
}

test "a name that leaves the root is refused before anything is touched" {
    let root = fs::scratch()
    let mut said = ""
    fs::create_dir("../out", root) catch { said = f"{error}" }
    let leaves = said.contains("leaves the root")
    assert(leaves)
}

// **A file held open** (Part III 17.1): written, moved about in and read, and
// closed when the function that owns it ends.
fn written(root: ref fs::Root) throws {
    let mut f = fs::open("data.bin", root; write: true, create: true, truncate: true)
    f.write("hello world")
    f.seek(fs::Seek::Start(6))
    f.write("WORLD")
}

test "a file is written, moved about in and read" {
    let root = fs::scratch()
    written(root)
    let mut f = fs::open("data.bin", root)
    let mut first: Vec[u8] = [0, 0, 0, 0, 0]
    let n = f.read(first)
    let size = f.len()
    let at = f.seek(fs::Seek::End(-5))
    let mut last: Vec[u8] = [0, 0, 0, 0, 0]
    f.read(last)
    f.close()
    let text = fs::read_to_string("data.bin", root)
    assert(n == 5)
    assert(size == 11)
    assert(at == 6)
    assert(first[0] == 'h')
    assert(last[0] == 'W')
    assert(text == "hello WORLD")
}

fn opens(name: ref String, root: ref fs::Root) -> bool throws {
    let f = fs::open(name, root) catch { return false }
    let size = f.len() catch { return false }
    return size == 0
}

fn seeks_to(to: i64, root: ref fs::Root) -> bool throws {
    let mut f = fs::open("made.txt", root; write: true, create: true) catch { return false }
    f.seek(fs::Seek::Start(to)) catch { return false }
    return true
}

test "a file is not made unless asked, and no position is before the start" {
    let root = fs::scratch()
    let missing = !opens("none.txt", root)
    let reached = seeks_to(3, root)
    let before = !seeks_to(-1, root)
    assert(missing)
    assert(reached)
    assert(before)
}
