// A name the language below reserves (ADR-298): the escape is the compiler's
// business and invisible to the program. Where a name compiles, where it is
// refused and how it is lowered is `crates/nikaia/tests/reserved_below.rs`.

struct ReservedBelowEvent {
    type: String,
    at: i64,
}

// The escape is invisible to the program's own output: a field called `type`
// still holds what was put in it.
test "an escaped name still names the same value" {
    let e = ReservedBelowEvent { type: "click".to_string(), at: 7 }
    let shown = f"{e.type} {e.at}"
    assert(shown == "click 7")
}
