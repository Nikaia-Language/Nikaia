// A struct's field may have a default (ADR-331 D5, D8): a build-time value a
// literal that leaves the field out takes. What is refused, what the ledger
// records and how a default crosses packages stays in
// `crates/nikaia/tests/field_defaults.rs`.

pub struct FieldDefaultsPage {
    pub size: i64 = 50,
    pub cursor: String?,
    pub label: String = "all = \"x\"",
    pub limit: i64? = 7,
    pub step: i64 = 3 * 4,
}

// `Page { cursor: null }` has a `size` of 50; a literal, text, a value into
// a `T?` and a computed default each reach the literal that leaves them out.
test "a field left out takes its default" {
    let p = FieldDefaultsPage { cursor: null }
    let q = FieldDefaultsPage { cursor: "c", size: 10 }
    let line = f"{p.size} {p.label} {p.limit ?? 0} {p.step} {q.size}"
    assert(line == "50 all = \"x\" 7 12 10")
}
