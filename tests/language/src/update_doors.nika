// `update` takes `mut v` and changes the value in place (ADR-281 D12): what a
// lock holds after its doors ran. What the lowering writes and what is refused
// are `crates/nikaia/tests/update_doors.rs`.

// **Part II 12.2's own counter**, which stopped lowering the day the page was
// rewritten to D1's form, because a lambda's parameter did not take `mut`.
test "the specifications counter compiles and runs" {
    let counter = SharedMut(0)
    counter.update fn(mut n) { n += 1 }
    counter.update fn(mut n) { n += 1 }
    let n = counter.get()
    assert(n == 2)
}

// **A value that is not a word takes the address and is not copied**, which is
// what the `Option` was in the way of: a ten-thousand-entry list is changed
// where it lies.
test "a list is changed where it lies" {
    let log = SharedMut(Vec())
    log.update fn(mut entries) { entries.push(1) }
    log.update fn(mut entries) { entries.push(2) }
    let n = log.access fn(e) { e.len() }
    assert(n == 2)
}

// **`update_all` is D1 widened** (ADR-281 D6): one `mut` per lock, nothing
// returned, both held for the whole of the block.
test "update all takes one mut per lock" {
    let payer = SharedMut(100)
    let payee = SharedMut(0)
    update_all(payer, payee) fn(mut a, mut b) {
        a -= 30
        b += 30
    }
    let paid = payer.get()
    let received = payee.get()
    assert(paid == 70)
    assert(received == 30)
}

// **A lambda kept in a function field takes a handle of the lock it uses**
// (ADR-230 D4, ADR-312 D5): the name it was written beside stays usable on the
// next line. And the lock is the thread-safe one where the field may be called
// on any thread (#532): a kept function may be.
struct UpdateDoorsButton {
    on_click: fn() sync,
}

test "a kept lambda takes its own handle of a lock" {
    let a = SharedMut(0)
    let button = UpdateDoorsButton { on_click: fn() { a.update fn(mut n) { n += 1 } } }
    button.on_click()
    button.on_click()
    let n = a.get()
    assert(n == 2)
}

// **And so does one handed to a parameter the callee keeps** (#536): the
// callee stores it as a field is stored, and the capture used to move the
// name it was written beside.
fn update_doors_button_of(on_click: fn() sync) -> UpdateDoorsButton {
    return UpdateDoorsButton { on_click: on_click }
}

test "a lambda handed to a kept parameter takes its own handle of a lock" {
    let a = SharedMut(0)
    let button = update_doors_button_of(fn() { a.update fn(mut n) { n += 1 } })
    button.on_click()
    let n = a.get()
    assert(n == 1)
}
