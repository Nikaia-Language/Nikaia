// A panic in a task ends that task, at both settings, and the program goes on
// (ADR-326 D4). What a panic leaves in a lock is never read again (ADR-327 D1,
// D2): `crates/nikaia-std/src/lock.rs`'s tests.

test "a task that panics ends alone and another finishes" {
    let other = SharedMut(1)
    let _broken = spawn fn { panic("boom") }
    let fine = spawn fn { other.update fn(mut v) { v += 1 } }
    fine.join()
    let total = other.get()
    assert(total == 2)
}

// `join` on a task that panicked throws `task::Crashed`, with what the panic
// said and where (ADR-328 D8); the joiner goes on.
test "a crashed task is an error to its joiner" {
    let t = spawn fn { panic("boom") }
    let said = t.join() catch { f"{error.message}" }
    let u = spawn fn { 41 + 1 }
    let n = u.join() catch { 0 }
    assert(said == "boom")
    assert(n == 42)
}
