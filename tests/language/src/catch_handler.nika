// A `catch` that ignores the error binds `_error` (ADR-308), and one that
// reads it still has it. How each handler is lowered and what `rustc` says
// about it stay in `crates/nikaia/tests/catch_handler.rs`.

fn catch_handler_parsed(text: ref String, mut said: Vec[String]) -> i32 {
    return text.parse() catch {
        said.push(f"caught {error}")
        0
    }
}

// The other half of the polarity: a handler that does read the error still
// gets a binding it can read, under the name Part I 7.1 promises. A `_error`
// written here would not compile at all.
test "a handler that reads the error still can" {
    let mut said: Vec[String] = []
    let it = catch_handler_parsed("not a number", said)
    assert(it == 0)
    assert(said.len() == 1)
    assert(said[0].starts_with("caught "))
}
