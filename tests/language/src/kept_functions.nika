// A function value that is kept - in a field, a result, a `let`, or a
// parameter the callee stores (Part I 5.3, Part II 12.3).

use std::time

// A function value kept in a field, a result and a `let`: one shared closure
// below, called through the field and by name.
struct KeptFunctionsButton { label: String, on_click: fn(i64) -> i64 sync }

fn kept_functions_adder(n: i64) -> fn(i64) -> i64 sync {
    return fn(x) { x + n }
}

test "a function value is kept in a field a result and a let" {
    let b = KeptFunctionsButton { label: "ok", on_click: fn(x) { x * 2 } }
    let add: fn(i64) -> i64 sync = kept_functions_adder(3)
    let twice: fn(i64) -> i64 sync = fn(x) { x + x }
    let line = f"{b.label} {b.on_click(4)} {add(1)} {twice(5)}"
    assert(line == "ok 8 4 10")
}

// A kept function that may pause hands back a boxed future, and a call through
// the field waits for it.
struct KeptFunctionsJob { name: String, step: fn(i64) -> i64 }

test "a kept function that may pause is awaited" {
    let job = KeptFunctionsJob { name: "tick", step: fn(n) {
        time::sleep(1.millis())
        n + 1
    } }
    let line = f"{job.name} {job.step(41)}"
    assert(line == "tick 42")
}

// A parameter the callee keeps is the same kept value: a handler handed in and
// stored in a field, then called from there.
struct KeptFunctionsRouter { handler: fn(i64) -> i64 sync }

fn kept_functions_route(handler: fn(i64) -> i64 sync) -> KeptFunctionsRouter {
    return KeptFunctionsRouter { handler: handler }
}

test "a kept parameter is stored in a field" {
    let r = kept_functions_route(fn(x) { x * 10 })
    let line = f"{r.handler(7)}"
    assert(line == "70")
}

// A pausing function held in a `let` is awaited where it is called.
test "a pausing function in a let is awaited" {
    let step: fn(i64) -> i64 = fn(n) {
        time::sleep(1.millis())
        n * 3
    }
    let line = f"{step(5)}"
    assert(line == "15")
}

// A kept value handed to a parameter that only runs it is lent to it.
fn kept_functions_apply(f: fn(i64) -> i64 sync, x: i64) -> i64 {
    return f(x)
}

test "a kept value is handed to a run parameter" {
    let add: fn(i64) -> i64 sync = fn(x) { x + 1 }
    let line = f"{kept_functions_apply(add, 1)} {kept_functions_apply(add, 2)}"
    assert(line == "2 3")
}

// A field whose function may fail fails the function that calls it. (The
// lambda names its result: one written as a bare expression is lowered as
// `Ok({ … })`, which `rustc` warns about.)
struct KeptFunctionsParser { parse: fn(ref String) -> i64 sync throws }

fn kept_functions_run(p: ref KeptFunctionsParser) -> i64 throws {
    return p.parse("12") + 1
}

test "a kept function that may fail is propagated" {
    let p = KeptFunctionsParser { parse: fn(t) {
        let n = t.len() as i64
        n
    } }
    let n = kept_functions_run(p) catch { 0 }
    assert(n == 3)
}

// A kept function handed to a task travels with it, at both settings.
fn kept_functions_holds(f: fn() -> String) -> String throws {
    let t = spawn fn { f() }
    return t.join()
}

test "a kept function travels into a task" {
    let said = kept_functions_holds(fn() { "from the task" })
    assert(said == "from the task")
}

// A named function where a function value is kept is the closure that calls
// it, lent its arguments as a written call is.
struct KeptFunctionsTools { double: fn(i64) -> i64 sync, measure: fn(String) -> i64 sync }

fn kept_functions_double(x: i64) -> i64 { return x * 2 }
fn kept_functions_measure(text: String) -> i64 { return text.len() as i64 }

test "a named function is kept as the closure that calls it" {
    let t = KeptFunctionsTools { double: kept_functions_double, measure: kept_functions_measure }
    let line = f"{t.double(21)} {t.measure("four")}"
    assert(line == "42 4")
}
