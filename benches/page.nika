// benches/page.nika
//
// The other shape a template has: mostly **static markup**, a few holes, and
// rendered many times - a page per request, which is what `fortunes.nika` and
// every server after it will do.
//
// `benches/template.nika` is the first shape: one table whose size is the
// input's. There the literal text is a few dozen bytes and the result is
// megabytes, so what the compiler knows about the length is worth nothing.
// Here the compiler knows almost the whole answer, which is the case the
// reservation of `docs/staging-candidates.md` §3 was proposed for.
//
// Measured by `crates/nikaia/tests/measure.rs`.

use std::cli
use std::text
use std::html

fn page(title: ref String, body: ref String) -> String {
    return dsl html {
        <!DOCTYPE html>
        <html lang="en">
        <head>
          <meta charset="utf-8">
          <title>{title}</title>
          <link rel="stylesheet" href="/static/site.css">
        </head>
        <body>
          <header class="masthead">
            <h1 class="title">{title}</h1>
            <nav><a href="/">Home</a> <a href="/about">About</a> <a href="/contact">Contact</a></nav>
          </header>
          <main class="content">
            <p>{body}</p>
          </main>
          <footer class="colophon">
            <p>Rendered by Nikaia. No template engine was consulted at run time.</p>
          </footer>
        </body>
        </html>
    } eod
}

fn main() {
    let count = cli::args().nth(1) ?? "2000"
    let n = text::parse_i32(count) ?? 2000

    let mut total = 0
    for i in 0..<n {
        let markup = page("A page with <angles> & an ampersand", "Some body text.")
        total += markup.len()
    }
    println(f"{total}")
}
