// A small web server that answers a greeting, a header and a POST.
//
//     cd examples/hello-http
//     nikaia run
//     http: listening on 127.0.0.1:8080
//
// Then, from another terminal:
//
//     curl 'localhost:8080/?name=Ada'    Hello, Ada
//     curl localhost:8080/who             you asked localhost:8080
//     curl -d hello localhost:8080/       you sent 5 bytes
//     curl localhost:8080/elsewhere       not found
//
// Shows: a package reached by a path (`../http`, named in `nikaia.toml`), a
// function passed as the last argument after the call, and `??` for a value
// that may be missing.

use http
use std::cli

fn main() throws {
    // An address may be given as an argument. Port `0` picks any free port,
    // and `listen` prints the one it got.
    let at = cli::args().nth(1) ?? "127.0.0.1:8080"

    // One function answers every request and decides by method and path.
    // Nothing is served that this function does not name.
    http::listen(at) fn(request) {
        if request.method() == http::Method::Post {
            let size = request.body().len()
            return http::Response::text(f"you sent {size} bytes")
        }
        // A missing value is not an empty string: `?name=` gives "" and no
        // `name` at all gives nothing. `??` supplies a value for the second
        // case only.
        if request.path() == "/" {
            let who = request.query("name") ?? "world"
            return http::Response::text(f"Hello, {who}")
        }
        if request.path() == "/who" {
            let host = request.header("host") ?? "nobody"
            return http::Response::text(f"you asked {host}")
        }
        return http::Response::not_found()
    }
}
