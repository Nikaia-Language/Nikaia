#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 3

[fn."Calc::expr"]
sync = true
throws = ["ParseError"]
touches = []
signature = "(input: ?) -> i64"

[fn."main"]
sync = "inferred"
throws = ["?"]
locks = true
touches = ["args read", "stderr write", "stdout write"]
signature = "()"

[type."Op"]
variants = ["Times", "Divide"]
