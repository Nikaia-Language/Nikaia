# --- What is produced step by step, and what walks it ------------------------
#
# [ADR-105](../../docs/specification/adr/adr-105.md) D1. `Seq[T]` is the
# ledger's word for elements produced one at a time when asked for, with no
# length until the end and nothing laid out in memory. It is **not** a type a
# program can write (D4): a program writes `keys()`, `for` and `collect()`, and
# these entries do the naming.
#
# The words after it say what one **step** may do, as they do after a function
# type, and there are **three** states rather than two
# ([ADR-172](../../docs/specification/adr/adr-172.md) D1). `Seq[$K] sync` on
# `keys` is a step that reads memory; `Seq[String] pauses` on `io::lines` is a
# step that suspends; a `map`'s step runs the lambda, so it says neither and is
# read as *nobody said*, which keeps the blocking form. The two ways of being
# wrong are not symmetric: awaiting a step that has none does not compile, and
# holding a thread that could have been given up costs a thread.
#
# **Every entry here is found by its receiver being a `Seq`**, which is what
# gives the 35 unanswered method calls of ADR-105 §1 somewhere to resolve.
#
# **And three words about the sequence as a whole**
# ([ADR-212](../../docs/specification/adr/adr-212.md) D1): `ends` - it can be
# walked from the back; `sized` - its length is known before it is walked;
# `replays` - walking it does not use it up, which only a range does. In a
# receiver's position they are a **demand** (`rev` writes `Seq[$T] ends`); on a
# result they **pass through** (D2): the result has a word the entry writes
# where every sequence handed in has it too. `ends_by_length` says the result is
# walked from the back only where the length of what went in is known, which is
# what the language below asks of a `take`, a `zip`, a `skip` and a `step_by`.

[fn."Seq::collect"]
pub = true
sync = true
touches = []
# The walk is what consumes it (D2): the sequence goes in by value.
signature = "(Seq[$T]) -> Vec[$T]"
doc = "Everything the sequence produces, as a list.\n\nThe walk is what consumes it, so the sequence is not there afterwards."

[fn."Seq::count"]
pub = true
sync = true
touches = []
# `i64`, which is what `Vec::len` says for the same reason: this language's
# integer is not Rust's `usize`, and the emitter writes the cast.
signature = "(Seq[$T]) -> i64"
doc = "How many elements the sequence produces.\n\nIt has to walk the whole of it to answer, which is what separates this from a\nlist's `len()`."

[fn."Seq::nth"]
pub = true
sync = true
touches = []
# **There may not be one**, which is `Args::nth`'s shape one type over.
signature = "(Seq[$T], at: i64) -> $T?"
doc = "The element at a position, or nothing where the sequence is shorter than that.\n\nIt walks up to that position to answer."

[fn."Seq::join"]
pub = true
sync = true
touches = []
signature = "(Seq[$T], sep: ref String) -> String"
doc = "Everything the sequence produces, written one after another with this text\nbetween them."

# `sync = "from(f)"` for the reason `list::ListExt::map` has it: the step is the
# lambda, so the caller's own claim is what decides ([ADR-029](../../docs/specification/adr/adr-029.md)
# D3). The **result's** step words are left off for the same reason, one level
# down: a step of this may pause exactly when the lambda may, and the type
# language has no way to say *whatever the lambda says*. What its elements
# **are** it does say since ADR-212 D5: `$U` is what the lambda comes to.
[fn."Seq::map"]
pub = true
sync = "from(f)"
touches = []
signature = "(Seq[$T], f: fn($T) -> $U) -> Seq[$U] ends sized"
doc = "Each element through a function.\n\nThe elements are produced as they are asked for, so nothing is walked until\nsomething walks the result. Whether a step pauses is the lambda's answer."

[fn."Seq::filter"]
pub = true
sync = "from(f)"
touches = []
# The element type survives a filter, which is the one place a `Seq` entry says
# more than `?`.
signature = "(Seq[$T], f: fn($T)) -> Seq[$T] ends"
doc = "Only the elements the function says yes to.\n\nThe element type survives, so what comes out holds what went in. Whether a\nstep pauses is the lambda's answer."

# --- The rest of a pipeline ([ADR-212](../../docs/specification/adr/adr-212.md) D5)
#
# None of these allocates: each is the language below's own adapter, walked one
# element at a time, and a chain of them is one loop. `step_by`, `take`, `skip`
# and `nth` take a count, which is an `i64` here and a `usize` below; the
# checker names those arguments by entry and the emitter converts them.

# **Each element handed to a lambda, and nothing handed back**
# ([ADR-235](../../docs/specification/adr/adr-235.md) D1): the walk that exists
# for what the lambda does. `from(f)` for `map`'s reason.
[fn."Seq::for_each"]
pub = true
sync = "from(f)"
touches = []
signature = "(Seq[$T], f: fn($T))"
doc = "Each element through a function, for what the function does.\n\nIt walks the whole sequence, one element at a time."

[fn."Seq::rev"]
pub = true
sync = true
touches = []
# `ends` on the receiver is the demand: `io::lines().rev()` is `NK2703`.
signature = "(Seq[$T] ends) -> Seq[$T] ends sized"
doc = "The same elements, from the last to the first.\n\nNothing is collected on the way: the sequence is walked from its back end,\nwhich is why it has to have one - a range, a list's `iter()`, `chars()`."

[fn."Seq::zip"]
pub = true
sync = true
touches = []
ends_by_length = true
signature = "(Seq[$T], other: Seq[$U]) -> Seq[($T, $U)] ends sized"
doc = "Pairs, one element of each, until the shorter of the two ends."

[fn."Seq::take"]
pub = true
sync = true
touches = []
ends_by_length = true
signature = "(Seq[$T], n: i64) -> Seq[$T] ends sized"
doc = "The first `n` elements, or all of them where there are fewer."

[fn."Seq::skip"]
pub = true
sync = true
touches = []
ends_by_length = true
signature = "(Seq[$T], n: i64) -> Seq[$T] ends sized"
doc = "Everything after the first `n` elements."

[fn."Seq::step_by"]
pub = true
sync = true
touches = []
ends_by_length = true
signature = "(Seq[$T], step: i64) -> Seq[$T] ends sized"
doc = "The first element, and then every `step`-th after it.\n\nA step of `0` aborts, since it would never move."

# **The list's elements on every core at once** (Part II 12.6,
# [ADR-235](../../docs/specification/adr/adr-235.md) D1). A `Par` has `Seq`'s
# surface; a lambda handed to it may not pause (`NK2209`) and may not change a
# name outside it (`NK2107`). At `user_parallelism = no` it is the list's `iter`.
[fn."Vec::par_iter"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Vec[$T]) -> Par[ref $T] sync ends sized"
doc = "The list's elements, walked on every core at once.\n\nWhat `map`, `filter` and `for_each` are handed runs in parallel, so it may not\npause and may not change a name outside it. The order of a `collect` is the\nlist's."

[fn."Vec::iter"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Vec[$T]) -> Seq[ref $T] sync ends sized"
doc = "The elements, one at a time, **lent**: the list stays where it is.\n\nThis is where a pipeline over a list starts - `xs.iter().map(…)` - and it\ncan be walked from either end."

[fn."Vec::chunks"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Vec[$T], n: i64) -> Seq[ref Array[$T]] sync ends sized"
doc = "The list in runs of `n` elements, the last one shorter where it does not\ndivide evenly.\n\nEach run is a view of the list, not a copy."

[fn."Vec::windows"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Vec[$T], n: i64) -> Seq[ref Array[$T]] sync ends sized"
doc = "Every run of `n` elements in a row, each one starting one further on.\n\nEach run is a view of the list, not a copy."

[fn."Vec::push"]
pub = true
sync = true
mutates = true
touches = []
keeps = ["value"]
signature = "(ref Vec[$T], value: $T)"
doc = "Add a value to the end of the list.\n\nThe list **keeps** the value, so what is handed over is given away rather\nthan lent."

[fn."Vec::sort"]
pub = true
sync = true
mutates = true
touches = []
signature = "(ref Vec[?])"
doc = "Put the elements in their natural order, in place.\n\nIt is **stable**: elements the order does not separate keep the order they\nhad, which is what lets two passes express a compound order."

# Part II 12.2's four doors ([ADR-059](../../docs/specification/adr/adr-059.md)).
# Written down so the checker can resolve them: without an entry a call is "a
# method nothing describes", which costs the value its plain shape - and 12.2's
# own idiom cannot be `sync`, which `docs/mutex-floor.md` §3.1 found before these
# existed.
#
# `sync = "from(f)"` (ADR-029 D3) on the two that take a lambda: the lambda
# decides, which is the whole of ADR-005 D6's rule - the door itself never
# pauses, and what runs inside it is the caller's own code. Waiting to acquire is
# not pausing: the rule is about a suspension point while a lock is *held*, and
# the panic hook must be `sync` and may block (Part I 7.2).
#
# `get` and `set` carry no `sync` line and need none, for a stronger reason than
# the other two have: while the lock is open in either, no code of the user's
# runs at all (ADR-039 D10).
[fn."Locked::get"]
pub = true
touches = ["lock read"]
sync = true
locks = true
signature = "(ref Locked[$T]) -> Seen[$T]"
doc = "A copy of what the lock holds.\n\nWhat comes back is **stamped**: it carries where it came from, so a `set`\nthat means *only if nothing changed since* can say which reading it means."

[fn."Locked::set"]
pub = true
touches = ["lock write"]
sync = true
keeps = ["value"]
locks = true
signature = "(ref Locked[$T], value: $T)"
doc = "Put a value in, whatever is there now.\n\nThe lock **keeps** the value. Where the new value is worked out from the old\none, `update` is the door that does not lose a change made in between."


# **The one door for a stamped value** (ADR-111 D5). `kasse.set(neu; after:
# stand)` is a different operation from `set` - it compares and may fail - so it
# is a different entry, and its key is spelled the way it is *written* rather
# than the way it lowers: `set(after)` is not a method name a program can write,
# which is what keeps D5's "one door" one. The witness is an ordinary parameter
# here, because this ledger's options must carry a default (Part I 5.1) and
# there is no value a missing witness could stand for.
#
# `throws = ["Overtaken"]` and not `["?"]`: this one failure *has* a name a
# program reads, and a caller that has to declare `throws` is owed it.
#
# **The witness is a view and the value is not.** The value is stored and the
# witness is only read, so `seen: ref $T` - a witness taken by value would be moved
# out of the caller, and reading what was seen after asking whether it still
# holds is an ordinary thing to write. `keeps = ["value"]` says the same thing
# from the other side.
[fn."Locked::set(after)"]
pub = true
touches = ["lock write"]
sync = true
throws = ["Overtaken"]
keeps = ["value"]
locks = true
signature = "(ref Locked[$T], value: $T, seen: ref $T)"
doc = "Put a value in **only if** what the lock holds is still what was seen.\n\nIt is written `lock.set(value; after: seen)`, and it fails with `Overtaken`\nwhere something changed in between - which is the answer a read-modify-write\nthrough two doors needs."

# **Reads in place and may not change what it is handed** (ADR-059 D1): the one
# door that answers a question about a large value without copying it.
[fn."Locked::access"]
pub = true
touches = ["lock read"]
sync = "from(f)"
locks = true
signature = "(ref Locked[$T], f: fn(ref $T)) -> ?"
doc = "Read what the lock holds, in place, without copying it.\n\nThe block may not change it. Whether the call pauses is the block's answer\nand not the door's; waiting to open the lock is not pausing."

# **Where locked data changes** (D2). The old value goes in by value and the new
# one comes back, so no handle into the inside ever exists - and `old` is an
# ordinary immutable parameter, which is why no lambda in this language is handed
# something it may change.
[fn."Locked::update"]
pub = true
touches = ["lock write"]
sync = "from(f)"
# `fn($T)` and not `fn($T) -> $T`: this ledger's type language has no result on a
# lambda, which is a limit of the ledger rather than of the door. What it is read
# for here is the arity and the `sync` column.
locks = true
signature = "(ref Locked[$T], f: fn($T))"
doc = "Change what the lock holds: the old value goes in and the new one comes back.\n\nNo handle into the inside ever exists, which is what makes this the door for\na change that depends on what is there. Whether the call pauses is the\nblock's answer."

# `SharedMut[T]` is the shared mutable type (Part I 6.2, ADR-039 D9): a value
# several parts own at once and any of them may change. **It is one name here and
# two hulls below** (ADR-064 D1) - the count and the lock - and the name is what
# the checker, this ledger and every message carry; only the emitter expands it.
#
# **The four doors are the same four** — and the witness door with them
# (ADR-111 D5) — so these entries are `Locked`'s with one name changed. They are here rather than reached through a `deref` because there
# is no `&` straight through a lock (Part I 6.2): you get in by opening it, and
# then what the lambda sees is an ordinary view.
#
# There is no constructor entry for the same reason there is none for `Locked` or
# `Shared`: this ledger's type language binds `$T` from the **receiver** (ADR-031),
# and a constructor has none - the type argument would have to come from what is
# handed in. So `SharedMut(0)` is the compiler's to type, the way `T?`'s `Some(…)`
# is (ADR-064 D2).
[fn."SharedMut::get"]
pub = true
touches = ["lock read"]
sync = true
locks = true
signature = "(ref SharedMut[$T]) -> Seen[$T]"
doc = "A copy of what this value holds.\n\nWhat comes back is **stamped**: it carries where it came from, so a `set`\nthat means *only if nothing changed since* can say which reading it means."

[fn."SharedMut::set"]
pub = true
touches = ["lock write"]
sync = true
keeps = ["value"]
locks = true
signature = "(ref SharedMut[$T], value: $T)"
doc = "Put a value in, whatever is there now.\n\nIt **keeps** the value. Where the new value is worked out from the old one,\n`update` is the door that does not lose a change made in between."

[fn."SharedMut::set(after)"]
pub = true
touches = ["lock write"]
sync = true
throws = ["Overtaken"]
keeps = ["value"]
locks = true
signature = "(ref SharedMut[$T], value: $T, seen: ref $T)"
doc = "Put a value in **only if** what is held is still what was seen.\n\nIt is written `value.set(next; after: seen)`, and it fails with `Overtaken`\nwhere something changed in between."

[fn."SharedMut::access"]
pub = true
touches = ["lock read"]
sync = "from(f)"
locks = true
signature = "(ref SharedMut[$T], f: fn(ref $T)) -> ?"
doc = "Read what this value holds, in place, without copying it.\n\nThe block may not change it. Whether the call pauses is the block's answer\nand not the door's."

[fn."SharedMut::update"]
pub = true
touches = ["lock write"]
sync = "from(f)"
signature = "(ref SharedMut[$T], f: fn($T))"
doc = "Change what this value holds: the old one goes in and the new one comes back.\n\nWhether the call pauses is the block's answer."

# **The two doors over several locks** (Part II 12.3, ADR-065). They take the
# locks and then the block, and the acquisition order is by address so that two
# tasks naming the same two locks the other way round still take them alike.
#
# **No `signature`, and that is the decision rather than a gap** (ADR-065 D1).
# This ledger's type language binds `$T` from a receiver (ADR-031); a door over
# several locks has none, the locks hold different types, and how many there are
# is open. So the compiler types these itself, the way it types `SharedMut(0)`.
# What the ledger *can* say is the `sync` column, and that is the half a caller
# needs: an acquisition adds no pausing of its own, so the block decides - the
# same shape `access` has, for the same reason (ADR-029 D3).
[fn."access_all"]
pub = true
touches = ["lock read"]
sync = "from(f)"
doc = "Read several locked values at once, in place.\n\nThe locks are taken in one order however they are written, so two tasks\nnaming the same two the other way round still take them alike and neither\nwaits forever. The block may not change what it is shown."

[fn."update_all"]
pub = true
touches = ["lock write"]
sync = "from(f)"
doc = "Change several locked values at once.\n\nThe locks are taken in one order however they are written, so two tasks\nnaming the same two the other way round still take them alike and neither\nwaits forever."

[fn."Vec::sort_by_key"]
pub = true
sync = "from(f)"
mutates = true
signature = "(ref Vec[$T], f: fn(ref $T)) -> ?"
doc = "Put the elements in the order of what the function returns, in place.\n\nIt is **stable**, so a sort by one key after a sort by another leaves the\nfirst as the tie-breaker."

[fn."str::chars"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> Seq[char] sync ends"
doc = "The characters, one at a time.\n\nThey are **characters** and not bytes: a character outside ASCII is more than\none byte, and this walks one of it rather than several."

[fn."str::len"]
pub = true
sync = true
touches = []
signature = "(ref String) -> i64"
doc = "How many **bytes** the text is.\n\nNot how many characters: text is UTF-8, so a character outside ASCII is more\nthan one byte. `chars().count()` is the other question."

# `n` is the `i64` a program can hold, not the `usize` Rust counts in
# (ADR-054 D2). The conversion is emitted at the call and a negative count
# aborts saying so - the parameter direction of ADR-048 D1, which that record
# left open and named this entry as the one site it had.
[fn."str::repeat"]
pub = true
sync = true
touches = []
signature = "(ref String, n: i64) -> String"
doc = "The text written `n` times, one after another.\n\n`n` is an ordinary `i64`, and a negative one aborts with *a count cannot be\nnegative* rather than with anything about the language below."

[fn."str::starts_with"]
pub = true
sync = true
touches = []
signature = "(ref String, prefix: ?) -> bool"
doc = "Whether the text begins with this."

[fn."str::to_string"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "The same text, owned rather than borrowed."

# Written down because the corpus asks for it - `line.to_uppercase()` in
# `examples/k-nucleotide.nika` - and because it is sayable: a case fold hands
# back an owned `String`, whatever it was given. It was the example a test used
# for *"a signature nobody has written"*, which is a bad thing to hold a test
# still with: every real `std` name is a candidate for being written, so a test
# resting on one being absent breaks the day somebody writes it. That test rests
# on ADR-024 D4's erasure now, which is an absence the language **decides**.
[fn."str::to_uppercase"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "The same text with every character in upper case, as owned text.\n\nIt follows Unicode rather than ASCII, so a character whose upper case is more\nthan one character becomes all of them."

[fn."str::to_lowercase"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "The same text with every character in lower case, as owned text.\n\nIt follows Unicode rather than ASCII."

[fn."String::to_uppercase"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "The same text with every character in upper case, as new text.\n\nIt follows Unicode rather than ASCII."

[fn."String::to_lowercase"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "The same text with every character in lower case, as new text.\n\nIt follows Unicode rather than ASCII."

# **The way out `NK1131` names, so it has to be described here**
# ([ADR-083](../../docs/specification/adr/adr-083.md)). A field of a borrowed
# subject cannot be handed out by value and the message says to write
# `.clone()` - and with no entry, `sync::infer` could not vouch for the call, so
# the method around it came out as one that *pauses* and `NK1129` refused it.
# A recommended way out that makes another diagnostic fire is not a way out.
#
# Measured the hard way: the trait tests' own fixture was the first program to
# take the advice.
[fn."String::clone"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "A copy of the text, owned by whoever asked for it.\n\nIt is the way out of handing a field of a borrowed subject away by value: the\ncopy is the caller's and the field stays where it is."

# The same for a view, which is what a `ref String` field or a literal is cloned from.
[fn."str::clone"]
pub = true
sync = true
touches = []
signature = "(ref String) -> String"
doc = "A copy of the text, owned by whoever asked for it.\n\nThe same way out one type over: a view is copied into text of its own."

[fn."str::trim"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> ref String"
doc = "The same text with the white space at both ends left off.\n\nWhat comes back is a **view** into the text it was given, so it costs no\nallocation and lives as long as that text does."

# **What cuts text into views says so** ([ADR-225](../../docs/specification/adr/adr-225.md)
# D1). Each hands back views into the text it is called on, which is what lets
# the checker ask whether one is kept where text of its own is wanted. A
# `String` receiver finds these as well: text of its own lends itself as a view.
[fn."str::trim_start"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> ref String"
doc = "The same text with the white space at the start left off, as a view into it."

[fn."str::trim_end"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> ref String"
doc = "The same text with the white space at the end left off, as a view into it."

[fn."str::lines"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> Seq[ref String] sync ends"
doc = "The lines of the text, each a view into it, without its line ending.\n\nNothing is copied: a line lives as long as the text does."

[fn."str::split"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String, sep: ?) -> Seq[ref String] sync ends"
doc = "The pieces of the text between each `sep`, each a view into it."

[fn."str::split_whitespace"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref String) -> Seq[ref String] sync ends"
doc = "The words of the text - the pieces between runs of white space - each a view\ninto it."

# --- Inferred from `src/*.nika` ----------------------------------------------

# `touches = []` is a **claim** and not a blank: it reaches nothing, so it orders
# against nothing (ADR-033 D4). It is written here because this entry is checked
# against the `.nika` source that produces it, and `touch::infer` reads that body
# and answers the same ([ADR-067](adr-067) D2) - the two must agree.
[fn."text::digit_value"]
pub = true
sync = true
touches = []
signature = "(c: char) -> i32"
doc = "The value of a decimal digit: `'7'` is `7`.\n\nA character that is not a digit is not a question this answers: it hands\nback whatever the subtraction comes to."

# What the program was started with, and the one type here that says it **may
# cross a thread** (`crosses`, ADR-005 §1 Group B). Its parts are Rust, so
# `contracts::send` cannot walk them and would answer "nobody said" - which is
# not permission, and would have cost `cli::args` the overlapping that the
# `touches` line above bought it (ADR-033 §8.1). The claim is a promise about a
# Rust type, written here and reviewed like code, exactly as `sync = true` is.
# **Text a C library owns**
# ([ADR-147](../../docs/specification/adr/adr-147.md) D4). An opaque handle with
# **no cleanup**, which is what tells it from that record's D3: a `FILE` is ours
# to close and a C string is not ours at all, so nothing here frees anything.
#
# No `crosses` line, and its absence is the honest answer rather than nobody
# saying: what the address points at is the library's, and whether that library
# is happy to have it read from another thread is not a question this file can
# answer for it.
[type."foreign::CStr"]
pub = true
doc = "Text a C library owns: an address, and a zero byte somewhere after it.\n\nIt is what a declaration writes where C hands back a `char *`. Nothing here\nfrees it - the memory is the library's, not the program's - and `to_string`\nis how a program gets text of its own out of it. Where the library may find\nnothing, the declaration says `-> CStr?` and the program writes `??`."

# The one function D4 asks for, and the reason it exists: the walk to the zero
# byte is the thing a program must not have to write, so it is written once,
# inside `unsafe`, here.
#
# `throws` in the one way this can fail - bytes that are not UTF-8 - which is
# what `fs::read_to_string` fails on for the same reason. *There is no text* was
# the second until [ADR-155](../../docs/specification/adr/adr-155.md) D4 made it
# a **value**: a declaration says `-> CStr?` where the library may find nothing,
# and `getenv` finding nothing is an ordinary Tuesday rather than an error.
[fn."foreign::CStr::to_string"]
pub = true
sync = true
touches = []
# The doc below already said it: *the same failure `fs::read_to_string` has*.
# Since ADR-158 D1 that failure has a name, so this says it in the column too.
throws = ["io::IoError"]
signature = "(foreign::CStr) -> String"
doc = "A copy of the text, owned by whoever asked for it.\n\nIt fails in **one** way: the bytes may not be UTF-8, which text in this\nlanguage is - the same failure `fs::read_to_string` has. *There is no text*\nis a value rather than a failure, because a declaration says `-> CStr?` where\nthe library may find nothing. The `unsafe` walk to the zero byte is here so\nthat no program has to write one."

[type."cli::Args"]
pub = true
crosses = true
doc = "The arguments the program was started with.\n\nIt may cross to another thread, so a task may be handed one."

# **Where a path may go** ([ADR-108](../../docs/specification/adr/adr-108.md) D2),
# and the one type in this file whose whole job is to be a **required argument**.
# `Dir(store)` resolves the name under that directory and refuses one that would
# leave it; `Anywhere` performs no check and says so in the word a review looks
# for, which `nikaia --trust` lists per site (D4).
#
# **Two variants and no shorthand.** Not a bare `String` where a `Root` is wanted,
# which would be a conversion rule this language does not have, and not a second
# spelling beside the variant.
[type."fs::Root"]
pub = true
crosses = true
compares = true
doc = "Where a path may go.\n\n`fs::Root::Dir(store)` resolves the name under that directory and throws\n`io::IoError::Outside` where it would leave it — resolved and compared\ncomponent by component, so `/data` is not a prefix of `/data2` and a symlink out\nis the same answer as a `..` out. `fs::Root::Anywhere` performs no check: it does\nnot say *checked*, it says *I answer for this*, and `nikaia --explain --trust`\nlists every site that writes it.\n\nEvery path-taking entry takes one, right after the path, with no default and no\nexception for a literal — a relative name is resolved against the working\ndirectory, and whoever controls that directory has changed what the name means\nwithout changing a line of the program."

[type."fs::Mapped"]
pub = true
# **Reading it is a page fault** (ADR-169 D1): the pages arrive as they are
# touched, so `mapped[i]` is a disk read with no call in the source to hang a
# `touches` on. It neither suspends nor takes a lock, which is why neither
# `NK2202` nor `NK2203` has anything to say about it and `NK2201` does.
touches = ["file read"]
doc = "A file held as memory: the pages arrive as they are touched rather than being\nread up front, which is what makes a file larger than memory workable.\n\nIt reads as text through the ordinary `ref String` surface."

# A step of this one can **fail**, and that is a fact a caller cannot get from
# anywhere else: a `for` over it is a place the enclosing function can fail
# from, and the compiler makes that function say `throws` (ADR-025 D1, `NK2701`).
[type."io::IoError"]
pub = true
crosses = true
# **`compares = true`** ([ADR-204](../../docs/specification/adr/adr-204.md) D1),
# and like `crosses` it is a claim reviewed like code: this type's parts are Rust,
# so nothing in the compiler can walk them. An easy claim here — every variant
# holds a `String`.
#
# **Absence is not permission**: a `std` type without this line does not compare,
# and `NK1188` says so on the author's line rather than letting `rustc` say it
# about a generated file.
compares = true
# **The cases, so a handler's `match` can be total** (Part I 3.4). Without them
# `NK1151` asked for an `else` on a `match` that had covered every variant — a
# correct program refused, with a way out that makes *this type gaining a
# variant* silent forever after, which is the one thing
# [ADR-146](../../docs/specification/adr/adr-146.md) D1 exists to prevent.
#
# Each carries what it was about, which is
# [ADR-158](../../docs/specification/adr/adr-158.md) D1's *the variant is the
# kind and it carries the thing*.
variants = ["NotFound(String)", "PermissionDenied(String)", "NotText(String)", "Outside(String)", "Other(String)"]
doc = "What a `std` call fails with.\n\nPart I 7.1's error type, for the library: `NotFound(what)` where the thing is\nnot there, `PermissionDenied(what)` where this program may not have it,\n`NotText(what)` where the bytes are not UTF-8, `Outside(what)` where a name\nwould leave the `fs::Root` it was given, and `Other(what)` for\neverything else the operating system said. A `catch` that only passes the\nfailure on names nothing; one that takes it apart writes `use std::io` and\n`io::IoError::NotFound(p)`."

# **What a parse fails with** ([ADR-173](../../docs/specification/adr/adr-173.md)
# D1), and the end of the last `"?"` in this tree. A `dsl` entry rule's ledger
# entry wrote `throws = ["?"]` because a parse fails with a rendered string and
# a string is not a type; seven of the corpus' eight `main`s carried that into
# their own set, and each of them has a **sum of two named members** now.
#
# No module in front, which is `Overtaken`'s shape: a program never writes a
# path to it, because it arrives in a `catch`.
#
# It carries the message and nothing else (D2). What the backend renders is a
# whole diagnostic - the headline, the line with a caret, what else was possible
# - and it is what a program already printed. Fields a program could *read* are
# a second question and nobody has asked it.
[type."ParseError"]
pub = true
crosses = true
doc = "What a parse fails with.\n\nA `dsl` entry rule hands this back where its input is not the shape the\ngrammar says. It prints the whole diagnostic the backend produced: the\nheadline, the line with a caret under what was found, and what else was\npossible there. A `catch` that only passes it on names nothing; one that tells\nit apart from an `io::IoError` writes `match error { … }`."

[type."io::Lines"]
pub = true
iterates = "throws"
doc = "Standard input, one line at a time.\n\nA **step** of it can fail, because a step reads the pipe - so a `for` over it\nis a place the function around it can fail from, and that function says\n`throws`."

# The type several parts of a program own at once (Part I 6.2), and the one type
# here whose `deref` entry above a caller is not meant to notice: a function that
# takes `ref Connection` accepts a `ref Shared[Connection]`, which is ADR-042 D2's
# rescue rather than a rule of this file's own.
#
# No `crosses` line, deliberately, and its absence is not "nobody said" here.
# `contracts::send` keeps `Shared` in its **container** list since ADR-037 D6, so
# a `Shared[T]` is answered by what `T` is: `Shared[String]` crosses and
# `Shared[Locked[i32]]` is undecided, for the lock's sake and not the count's. A
# `crosses = true` written here would answer for both, which is the one thing
# that is not true of the type.
# **What a `spawn` hands back** (Part I 8.2,
# [ADR-055](../../docs/specification/adr/adr-055.md) D5).
#
# No `crosses`, and here its absence really is "nobody said": whether a handle
# may cross a thread is a question about the value the task produces and about
# the executor that owns it, and the multi-threaded executor is not built
# (ADR-055 §6 step 1's `yes` half). An undecided crossing is handed on rather
# than read as permission (ADR-010 D1), which is what this file's own note
# above says.
[type."TaskHandle"]
pub = true
doc = "What a `spawn` hands back: the one end of a task that is still running.\n\n`join` is where the two meet again."

# `.join()` is where two tasks meet again, and it is a **suspension point**: the
# task fills a slot and wakes whoever is waiting on it, so joining gives the
# thread up rather than holding it. Hence no `sync` line, which is this file's
# way of saying it can pause - and the emitter turns that into the `.await`
# (ADR-055 D2).
#
# `$T` is bound by the receiver (ADR-031), so one line answers for every
# `TaskHandle` a program writes. It takes `self` by value because a value can
# only be joined once.
#
# No `throws`: a task's failure is the task's, and what `join` hands back is
# whatever the body's last statement was. A task whose body can fail hands back
# a value that says so, which is the same shape any other function has.
[fn."TaskHandle::join"]
pub = true
signature = "(TaskHandle[$T]) -> $T"
doc = "Wait for the task and take what it produced.\n\nIt gives the thread up rather than holding it, so other work runs while this\nwaits. A handle can be joined once, because joining takes it."

# **One mechanism, said three ways rather than three things**
# ([ADR-148](../../docs/specification/adr/adr-148.md) D3): a program's own
# cancel, a `select`'s loser and ADR-129's C `cancel` do the same thing to a
# task - it stops at its current pause point, its values are torn down, and a
# `cleanup` that pauses is adopted by the runtime.
#
# `sync = true`, and that is not a slip: this is a *request*. It sets a flag and
# wakes the task, and the caller does not wait for the teardown because it
# should not pay for it (D2).
#
# No `touches`, which is the fail-closed answer: what a cancel orders against is
# whatever the task was doing, and that is not a set this file can name.
#
# It takes the handle, as `join` does, which is what makes §4's open question -
# *can a cancelled task be observed to have been cancelled?* - one no program
# can ask.
[fn."TaskHandle::cancel"]
pub = true
sync = true
signature = "(TaskHandle[$T])"
doc = "Stop the task.\n\nIt stops at its current pause point and its values are torn down; a `cleanup`\nthat pauses is finished in the background. This does not wait for any of\nthat. Cancelling takes the handle, so a cancelled task is never joined."

[type."Shared"]
pub = true
doc = "A value several parts of a program own at once.\n\nA caller is not meant to notice it: a function taking `ref Connection` accepts a\n`ref Shared[Connection]`. Handing a handle on by value makes a second one rather\nthan taking the first away."

# --- A span of time (ADR-150) ------------------------------------------------
#
# **The language learns nothing here** (D4): no keyword, no suffix literal, no
# type in the grammar. What it costs is this block - one type, ten methods and
# one call - and the reason it is ten rather than five is ADR-048's two integer
# types: `5` is an `i32` where nothing asks otherwise and `count.minutes()` on a
# length is an `i64`, so a file holding both needs both halves or one of the two
# is refused in the language below's words (Part III C.1).
#
# `crosses = true` is a claim reviewed like code, and it is an easy one: a
# duration is a number of ticks and nothing else, so it may go anywhere.
[type."time::Duration"]
pub = true
crosses = true
compares = true
doc = "A span of time: how long something takes, how long to wait, how long is too\nlong.\n\nIt is written `5.seconds()` rather than `5s` - a literal has no suffix in\nthis language, and a rule with an exception in it is one a reader has to\nremember. `seconds`, `millis`, `micros`, `minutes` and `hours` are the five\nnames, on either integer type."

# `touches = []` and `sync = true` for the arithmetic entries' reason: a pure
# computation that reaches no resource. A count below zero is no time at all
# rather than an abort, which is the whole of what the implementation decides.
[fn."i32::hours"]
pub = true
sync = true
touches = []
signature = "(i32) -> time::Duration"
doc = "This many hours, as a span of time."

[fn."i32::minutes"]
pub = true
sync = true
touches = []
signature = "(i32) -> time::Duration"
doc = "This many minutes, as a span of time."

[fn."i32::seconds"]
pub = true
sync = true
touches = []
signature = "(i32) -> time::Duration"
doc = "This many seconds, as a span of time."

[fn."i32::millis"]
pub = true
sync = true
touches = []
signature = "(i32) -> time::Duration"
doc = "This many thousandths of a second, as a span of time."

[fn."i32::micros"]
pub = true
sync = true
touches = []
signature = "(i32) -> time::Duration"
doc = "This many millionths of a second, as a span of time."

[fn."i64::hours"]
pub = true
sync = true
touches = []
signature = "(i64) -> time::Duration"
doc = "This many hours, as a span of time."

[fn."i64::minutes"]
pub = true
sync = true
touches = []
signature = "(i64) -> time::Duration"
doc = "This many minutes, as a span of time."

[fn."i64::seconds"]
pub = true
sync = true
touches = []
signature = "(i64) -> time::Duration"
doc = "This many seconds, as a span of time."

[fn."i64::millis"]
pub = true
sync = true
touches = []
signature = "(i64) -> time::Duration"
doc = "This many thousandths of a second, as a span of time."

[fn."i64::micros"]
pub = true
sync = true
touches = []
signature = "(i64) -> time::Duration"
doc = "This many millionths of a second, as a span of time."

# **In `std::time` and not in the prelude**
# ([ADR-154](../../docs/specification/adr/adr-154.md) D2): the rule the list is
# built from is that nothing in it pauses, and this is the one entry here that
# does. So it is `use std::time` and `time::sleep(…)`, and Part II 12.4's line
# is written that way.
#
# **A suspension point**, which is what the missing `sync` line says: the thread
# is given up rather than held, so a program that sleeps runs its other tasks
# while it does. That is the whole difference between this and the language
# below's `thread::sleep`, and it is why the entry is here rather than nowhere.
#
# No `touches`, and its absence is the fail-closed answer rather than an
# omission: what a wait orders against is everything, because the point of it is
# that time passes in between.
[fn."time::sleep"]
pub = true
signature = "(span: time::Duration)"
doc = "Wait out a span of time.\n\nThe thread is given up rather than held, so other tasks run while this waits."

# --- Message passing (ADR-149) -----------------------------------------------
#
# **No language construct** (D1): two values, two methods, and the tuple `let`
# that binds them was already built (ADR-098). What this block costs is four
# entries.
#
# `-> (Sender[$T], Receiver[$T])` names the shape a `let` destructures. The
# variable stays unbound - nothing at the call says what the channel carries -
# so it becomes `?`, which is ADR-031's rule and is enough: what the two methods
# need from it is the *type name*, so that `tx.send(…)` resolves to the entry
# below and takes the `.await` its missing `sync` line asks for.
[fn."channel::bounded"]
pub = true
sync = true
touches = []
signature = "(capacity: i64) -> (channel::Sender[$T], channel::Receiver[$T])"
doc = "A channel of `capacity` values, and its two ends.\n\nThere is no unbounded channel: a capacity is a promise about memory, and an\nunbounded one is a `send` that never pauses. A program that wants *unbounded*\nwrites a large number - and has said it."

[type."channel::Sender"]
pub = true
doc = "The sending end of a channel.\n\nHanding it into a `spawn` is where the crossing check asks whether what the\nchannel carries may go to another thread."

[type."channel::Receiver"]
pub = true
doc = "The receiving end of a channel.\n\n`recv` hands back a `T?`, and `null` means every sender is gone."

# **A suspension point**, which is the missing `sync` line (D2): a `send` waits
# for room where the channel is full, so a `sync` body cannot send on one and
# the compiler names the promise in the way - without a rule about channels,
# because the column *is* the rule. That is what a bounded channel is for:
# back-pressure is a pause, and a pause is something this ledger already talks
# about.
#
# No `touches`, which is the fail-closed answer: what a send orders against is
# whatever the other end does with the value.
[fn."channel::Sender::send"]
pub = true
signature = "(ref channel::Sender[$T], value: ?)"
doc = "Put a value in, waiting for room where there is none.\n\nIt gives the thread up rather than holding it, so other work runs while this\nwaits."

# **`-> $T?`**, and the `?` is D3: a closed channel is the ordinary **end** of a
# stream rather than a failure, so `??` is what reads it (Part I 3.5) and
# nothing here `throws`.
[fn."channel::Receiver::recv"]
pub = true
signature = "(ref channel::Receiver[$T]) -> $T?"
doc = "The next value, or `null` where every sender is gone.\n\nA closed channel is the ordinary end of a stream and not a failure, so `??`\nis what reads it. It gives the thread up rather than holding it."

# --- The collections outside the prelude (ADR-154 D3) ------------------------
#
# **`HashMap` is the first thing outside the list**, and it is the name that
# makes that a rule rather than a tidy-up: a map is common enough to argue for,
# and `use std::collections` is one line, and a list that grows by *common
# enough* has no floor.
#
# They are here rather than in the compiler's built-in names because that is what
# puts them in a **module**: an entry keyed `collections::HashMap` is one a
# program reaches through its prefix, which is the whole of the rule.
[type."collections::HashMap"]
pub = true
doc = "A table from keys to values.\n\nIt is reached through its module: `use std::collections` and\n`collections::HashMap` where it is needed (Part I, 1.3)."

[type."collections::HashSet"]
pub = true
doc = "A set of values, in no order.\n\nIt is reached through its module, as every name outside the prelude is."

[type."collections::BTreeMap"]
pub = true
doc = "A table from keys to values, kept in the keys' order.\n\nIt is reached through its module, as every name outside the prelude is."

[type."collections::BTreeSet"]
pub = true
doc = "A set of values, kept in their order.\n\nIt is reached through its module, as every name outside the prelude is."

# --- `net`: the socket `std` lends (ADR-194 D1) ------------------------------
#
# [ADR-069](../../docs/specification/adr/adr-069.md) D2's subtraction carried one
# item further: what was pushed out of `std` is the *protocol and the framework*,
# and a socket is neither - it is an operating-system resource of exactly the kind
# `fs` and `io` already own. The `http` package is Nikaia and cannot syscall, so
# the line falls here.
#
# **`touches` says `socket` and never which socket**, for the reason `lock` says
# `lock`: a listener could be named by its address and a *connection* is what a
# program actually touches, and telling two of those apart is the alias analysis
# ADR-039 D4 refuses to make a program's compilation depend on. Two reads do not
# conflict - reads never do - and a write orders against every socket touch.
#
# **Nothing here is `sync`**, and that is the point: `accept`, `read` and `write`
# give the thread up rather than holding it, on ADR-121 D4's awaitable readiness.
# The same park `fs` uses, so one thread serves many connections at
# `user_parallelism = no` exactly as at `yes`.

[type."net::Listener"]
pub = true
# A listener may be handed to a task: it is a file descriptor and an address,
# and nothing in it is tied to the thread it was made on.
crosses = true
doc = "A bound socket, waiting for connections.\n\n`net::listen(\"127.0.0.1:8080\")` makes one. Which address a *server* binds when\nnobody says is the server's own question and not this one's."

[type."net::Connection"]
pub = true
crosses = true
doc = "One connection, open until it is dropped.\n\nReading hands back what the peer sent, and **empty means the peer closed** -\nwhich is the one thing a caller has to know to write a loop. `close` is for a\nprogram that wants the close at a named moment."

[fn."net::listen"]
pub = true
touches = ["socket write"]
throws = ["io::IoError"]
signature = "(address: ref String) -> net::Listener"
doc = "Bind an address and start listening.\n\nIt fails where the address cannot be bound - which is usually somebody else\nalready listening there."

[fn."net::connect"]
pub = true
touches = ["socket write"]
throws = ["io::IoError"]
signature = "(address: ref String) -> net::Connection"
doc = "Connect to an address.\n\nIt fails where nothing is listening there."

[fn."net::Listener::accept"]
pub = true
touches = ["socket read"]
throws = ["io::IoError"]
signature = "(ref Listener) -> net::Connection"
doc = "The next connection, waiting for one where there is none yet.\n\nIt gives the thread up while it waits, so one thread serves many connections."

# The address it is **bound** to, which is what a caller that asked for port `0`
# needs to know. Memory, so it touches nothing and cannot pause.
[fn."net::Listener::address"]
pub = true
sync = true
touches = []
signature = "(ref Listener) -> String"
doc = "The address this listener is bound to.\n\nA program that asked for port `0` finds out here which port it got."

# **The first untrusted source `std` has** (ADR-010 D2), which this file's own
# header predicted by name: *the untrusted ones - `http`, `net`, `db` - arrive
# with the modules that have them*. Somebody else chose these bytes.
[fn."net::Connection::read"]
pub = true
mutates = true
touches = ["socket read"]
throws = ["io::IoError"]
provenance = "untrusted"
signature = "(ref Connection) -> Bytes"
doc = "The next bytes the peer sent, waiting for them where there are none yet.\n\n**Empty means the peer closed.** What comes back is **untrusted**: somebody\nelse chose these bytes."

# `?` for the bytes, for `fs::write`'s reason: it takes a `Bytes`, a `ref String`\
# and a buffer, and writing one of them here would refuse a correct program.
[fn."net::Connection::write"]
pub = true
mutates = true
touches = ["socket write"]
throws = ["io::IoError"]
signature = "(ref Connection, bytes: ?)"
doc = "All of the bytes, waiting for room where there is none yet.\n\nAll of them, because a partial write is not something a caller can do anything\nuseful with: the loop that would follow one is inside this."

[fn."net::Connection::peer"]
pub = true
sync = true
touches = []
signature = "(ref Connection) -> String"
doc = "Who is on the other end."

[fn."net::Connection::close"]
pub = true
sync = true
touches = ["socket write"]
signature = "(Connection)"
doc = "Close it now rather than when it is dropped.\n\nDropping one closes it, which is the language below's answer; a program that\nwants the close at a named moment writes this."

# --- `http1`: HTTP/1.1's text half (ADR-194 D5) -------------------------------
#
# **Not named `http`**, and that is not a taste: a program reaches a *package* by
# that word (ADR-069 D1), and a `std` module of the same name would make
# `http::Response` mean two things. This file's own note about a crate's word
# colliding with a module's says what that day costs; this is the day not to
# create one.
#
# **The parser is Rust and moving it into a Nikaia grammar is a later step**
# (D5): self-hosting the protocol is not the MVP, and the route it will take is
# ADR-196 D2's.
#
# `sync = true` on all of it: this is text handling over bytes that are already
# there. It cannot pause and it reaches no resource, which is what lets a server
# call it between two things that do.
#
# **Where the line between this and a package runs.** This module holds
# **framing** - where a head ends, what its lines say, how many bytes of body the
# head promised - and a package holds **meaning**: what a path is for, what a
# handler is, what goes back. `Buffer` is on this side of the line because
# deciding that a head has *not arrived yet* is reading HTTP/1.1, not reading a
# request.
#
# **What it hands back is not marked `untrusted`**, and the reason is that it
# does not need to be: what came off the socket already is (`net::Connection::read`,
# ADR-010 D2), and provenance travels with the bytes rather than being re-stated
# by everything that reads them.

[type."http1::Buffer"]
pub = true
crosses = true
doc = "The bytes of one request as they arrive, and the questions HTTP/1.1 can ask of\nthem.\n\nIt is written `http1::Buffer()`. A caller reads a chunk from a socket, `take`s\nit, and asks `head_end` again."

[type."http1::Head"]
pub = true
crosses = true
doc = "What the head of one HTTP/1.1 request says.\n\nThe two methods this speaks are `GET` and `POST`; anything else is a refusal\nand not a guess. A path is **not** decoded — what a `%20` means is the\nprogram's question."

[fn."http1::Buffer::new"]
pub = true
sync = true
touches = []
signature = "() -> http1::Buffer"
doc = "Nothing read yet. It is written `http1::Buffer()`."

# `?` for the bytes, `net::Connection::write`'s reason: what a caller has is a
# `Bytes`, and a `Bytes` here would refuse the `ref String` a test hands it.
[fn."http1::Buffer::take"]
pub = true
sync = true
mutates = true
touches = []
signature = "(ref Buffer, more: ?)"
doc = "Add what the socket just handed over."

[fn."http1::Buffer::len"]
pub = true
sync = true
touches = []
signature = "(ref Buffer) -> i64"
doc = "How many bytes have arrived."

# **`0` is *not yet*** rather than a missing value, and the shape was chosen for
# what it lets a caller write: `while ended == 0` is one condition where a loop
# over an absence is a condition plus the unwrapping after it. A head cannot end
# at byte zero - the shortest one there is is `GET / HTTP/1.0\r\n\r\n` - so the
# two readings cannot collide.
[fn."http1::Buffer::head_end"]
pub = true
sync = true
touches = []
throws = ["io::IoError"]
signature = "(ref Buffer, cap: i64) -> i64"
doc = "Where the head ends, or **`0` for *not yet***: the blank line that ends a head\nhas not arrived, so read more and ask again.\n\nA head over `cap` fails rather than growing - the bytes are somebody else's -\nand it fails as soon as the buffer is over it, because a head that has not\nended and is already too long never will."

[fn."http1::Buffer::head"]
pub = true
sync = true
touches = []
throws = ["io::IoError"]
signature = "(ref Buffer) -> http1::Head"
doc = "What the head says, where `head_end` said there is one.\n\nEvery failure here is what a server sends back: a request line that is not\nthree words, a version this does not speak, a method it does not answer, a\n`content-length` that is not a count, a `transfer-encoding` at all."

[fn."http1::Buffer::text_from"]
pub = true
sync = true
touches = []
throws = ["io::IoError"]
signature = "(ref Buffer, at: i64) -> String"
doc = "The bytes from `at` on, as text.\n\n**Owned**, and the copy is not an oversight: this is the body, and a body goes\ninto a request a handler is given, which owns it."

[fn."http1::Head::method"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Head) -> ref String"
doc = "`GET` or `POST`, as it was written."

[fn."http1::Head::path"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Head) -> ref String"
doc = "The path, **without** the query string, and **not decoded** (ADR-018 D4, which\nwrites `path()` and `query()` as two things)."

[fn."http1::Head::target"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Head) -> ref String"
doc = "The whole request target as it was written, query string and all.\n\nWhat a log wants, and the one place the bytes the client chose are handed over\nuntouched."

# **`String?` and not an empty string** (ADR-018 D4: *Kap 3.5's nullable*): a name
# the client did not write and one it wrote empty are two different facts, and a
# server that read them as one would answer a question nobody asked.
[fn."http1::Head::query"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Head, name: ?) -> ref String?"
doc = "What the query string says under this name, or nothing where it says nothing.\n\n**Nothing is decoded**: a `%20` stays `%20` and a `+` stays a `+`, because which\nof the two a `+` means depends on who wrote the form. **A name with no `=` has\nan empty value**, which is not the same as being absent: `?debug` says the name\nwas written."

[fn."http1::Head::header"]
pub = true
sync = true
touches = []
returns = "borrows(self)"
signature = "(ref Head, name: ?) -> ref String?"
doc = "What the client sent under this name, or nothing where it sent none.\n\n**Case-insensitive, as the protocol is** (ADR-018 D4). Where a client sent the\nsame name twice this is the **first**: joining them with a comma is what the\nprotocol says a *list-valued* header means, and which headers those are is not\nsomething this module knows."

[fn."http1::Head::headers"]
pub = true
sync = true
touches = []
signature = "(ref Head) -> i64"
doc = "How many headers there are, which is what a program counts before it decides a\nclient is being unreasonable."

[fn."http1::Head::length"]
pub = true
sync = true
touches = []
signature = "(ref Head) -> i64"
doc = "What `Content-Length` said, or `0` where it said nothing."

[fn."http1::Head::size"]
pub = true
sync = true
touches = []
signature = "(ref Head) -> i64"
doc = "How many bytes of the buffer the head took, so a caller knows where the body\nstarts."

[fn."http1::Head::keep_alive"]
pub = true
sync = true
touches = []
signature = "(ref Head) -> bool"
doc = "Whether the client asked for the connection to stay open.\n\n**Read and not honoured**: `Connection: close` is the MVP's scope, and a server\nthat read the header and ignored it silently would be lying to a client that\nasked."

# --- `Bytes`: how many there are ----------------------------------------------
#
# The one thing a program has to be able to ask a `Bytes`, because
# `net::Connection::read` says **empty means the peer closed** and a loop over a
# socket cannot be written without the question.
[fn."Bytes::len"]
pub = true
sync = true
touches = []
signature = "(ref Bytes) -> i64"
doc = "How many bytes there are.\n\nAfter `net::Connection::read`, **zero means the peer closed**."

[fn."Bytes::is_empty"]
pub = true
sync = true
touches = []
signature = "(ref Bytes) -> bool"
doc = "Whether there are none."
