# one, `update` is the door that does not lose a change made in between.
[fn."Locked::set"]
pub = true
touches = ["lock write"]
sync = true
keeps = ["value"]
locks = true
signature = "[T](self: ref Locked[T], value: T)"


# **The one door for a stamped value** (ADR-281 D26). `kasse.set(neu; after:
# stand)` is a different operation from `set` - it compares and may fail - so it
# is a different entry, and its key is spelled the way it is *written* rather
# than the way it lowers: `set(after)` is not a method name a program can write,
# which is what keeps D5's "one door" one. The witness is an ordinary parameter
# here, because this ledger's options must carry a default (Part I 5.1) and
# there is no value a missing witness could stand for.
#
# `throws = ["Overtaken"]` and not `["?"]`: this one failure *has* a name a
# program reads, and a caller that has to declare `throws` is owed it.
#
# **The witness is a view and the value is not.** The value is stored and the
# witness is only read, so `seen: ref T` - a witness taken by value would be moved
# out of the caller, and reading what was seen after asking whether it still
# holds is an ordinary thing to write. `keeps = ["value"]` says the same thing
# from the other side.
# Put a value in **only if** what the lock holds is still what was seen.
#
# It is written `lock.set(value; after: seen)`, and it fails with `Overtaken`
# where something changed in between - which is the answer a read-modify-write
# through two doors needs.
[fn."Locked::set(after)"]
pub = true
touches = ["lock write"]
sync = true
throws = ["Overtaken"]
keeps = ["value"]
locks = true
signature = "[T](self: ref Locked[T], value: T, seen: ref T)"

