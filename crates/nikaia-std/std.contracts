# **Truncation has a name**, and the name carries the destination
# ([ADR-285](../../docs/specification/adr/adr-285.md) D13). Since D4 a conversion
# that may not fit aborts, so this is the only way left to say "keep the low
# digits" - said rather than assumed, exactly as `wrapping_` is said.
#
# One entry per destination, because that is what a signature can be written for:
# `truncating_i32` hands back an `i32` whatever it was given, and a single name
# with a type that follows the call site is not something the ledger can say.
#
# The sources are the two a Nikaia program can have a narrowing conversion out
# of: the larger integer and a floating-point number. There is no
# `truncating_f64` - nothing narrows *to* one in a program written in the types
# Part I 2.2 offers - and there is no `truncating_usize` either, since ADR-285 D1:
# a length is an `i64`, the machine-width type left the surface a program can
# write, and nothing narrows out of a type nobody can hold.
#
# `touches = []` and `sync = true` for the reason the arithmetic entries give: a
# pure computation that reaches no resource.

# The low 32 bits of an `i64`, as an `i32`.
#
# A conversion that may not fit aborts, so this is how a program says it means
# to keep the low digits - said rather than assumed.
[fn."i64::truncating_i32"]
pub = true
sync = true
touches = []
signature = "(self) -> i32"

# The whole part of an `f64`, as an `i32`, with the digits that do not fit
