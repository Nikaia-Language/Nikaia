# Not how many characters: text is UTF-8, so a character outside ASCII is more
# than one byte. `chars().count()` is the other question.
[fn."str::len"]
pub = true
sync = true
touches = []
signature = "(self: ref String) -> i64"

# Whether the text has no bytes at all. The same question as `String::is_empty`,
