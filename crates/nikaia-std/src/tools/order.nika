// crates/nikaia-std/src/tools/order.nika
//
// **Whether two statements have to keep the order they were written in**
// (ADR-033, Part I 8.1.1): the verdict half of the compiler's
// `contracts::order`, moved from Rust (ADR-250, #125). What stays Rust is the
// walk that reduces a statement to an `Operation`, or says why it could not.
//
// The rule is one sentence - *two operations whose touch sets are disjoint
// have no order between them* - and it says "no" for every reason it can think
// of, and for every reason it cannot (ADR-033 D4). Every refusal is either a
// real dependency or an admission of ignorance, and the two are deliberately
// worth the same; the reason is the whole point (D9).

use std::collections

/// One statement, reduced to what deciding an order needs.
pub struct Operation {
    /// The name it binds, where it binds one.
    pub binds: String?,
    /// Every name its value mentions: a statement that mentions what the one
    /// before it bound is a data dependency, and nothing else is consulted.
    pub mentions: collections::BTreeSet[String],
    /// What the call it performs reaches, as the ledger describes it with the
    /// call's own arguments filled in.
    pub reaches: Vec[Reached],
    /// The ledger key of the call, for a diagnostic that wants to name it.
    pub callee: String,
}

/// A statement, reduced - or the reason it could not be.
pub enum Accounted {
    Operation(Operation),
    /// It performs nothing at all: a loop, an `if`, an assignment, a
    /// `return`, a `let` of a value that calls nothing.
    NotAnOperation,
    /// It performs something this analysis will not take apart, named so the
    /// report says *which* thing.
    Opaque(String),
    /// Its `catch` handler can leave the function (ADR-034).
    DivertingHandler,
    /// It can fail and nothing catches the failure (ADR-034 D2).
    UncaughtFailure(String),
    /// Nothing describes what the call reaches, so it reaches everything (D4).
    NoTouches(String),
    /// Something describes what the call reaches, in a word this compiler does
    /// not know - refused, because an unknown kind would be disjoint from
    /// every kind there is.
    UnknownResource { callee: String, kind: String },
    /// What it hands back may not cross a thread, or nothing written down says
    /// it may (ADR-005 §1 Group B).
    MayNotCross { callee: String, crossing: Crossing },
    /// A value that is not a literal, which this increment will not send to
    /// another thread - D9's "implementation limit, not a language question".
    NonLiteralArgument(String),
}

impl Accounted {
    /// One line, for a report a person reads - and, where there is one, the
    /// way out.
    pub fn why(ref self) -> String {
        return match self {
            Accounted::Operation(_) => "it is an operation",
            Accounted::NotAnOperation => "one of them performs no operation at all",
            Accounted::Opaque(what) => f"one of them holds {what}",
            Accounted::DivertingHandler => "its `catch` can leave the function, so the next statement might never run. Make the handler return a value instead, and check it afterwards",
            Accounted::UncaughtFailure(name) => f"`{name}` can fail and nothing catches it, so the next statement might never run. `catch` it into a value, and check it afterwards",
            Accounted::NoTouches(name) => f"nothing says what `{name}` touches, so it might touch anything",
            Accounted::UnknownResource { callee, kind } => unknown_resource(callee, kind),
            Accounted::MayNotCross { callee, crossing } => may_not_cross(callee, crossing),
            Accounted::NonLiteralArgument(name) => f"`{name}` isn't a literal, and only literals can be sent to another thread",
        }
    }
}

fn unknown_resource(callee: ref String, kind: ref String) -> String {
    let article = an_or_a(kind)
    return f"`{callee}` says it touches {article} `{kind}`, which this version of Nikaia doesn't know, so it might touch anything"
}

fn may_not_cross(callee: ref String, crossing: ref Crossing) -> String {
    let note = crossing.note() ?? "It can't."
    return f"what `{callee}` returns would have to move to another thread. {note}"
}

/// Why two statements keep their order, or that they need not.
pub enum Verdict {
    /// They meet on nothing and neither waits for the other.
    Overlap,
    /// The later uses what the earlier bound.
    DataDependency(String),
    /// Both bind the same name, so the order decides which value survives.
    Shadowed(String),
    /// Their touch sets meet on something one of them writes. `unnameable`
    /// says the resource has no name because this compiler could not read
    /// one, rather than because the kind has only one of it.
    SameResource { kind: String, named: String?, unnameable: bool },
    /// Their touch sets meet on two resources named differently that may be
    /// the same thing - `stdout` and `stderr` under `2>&1`.
    SameDestination { one: String, other: String },
    /// One of them is not a statement this analysis can account for at all.
    NotAccountedFor,
}

impl Verdict {
    pub fn is_overlap(ref self) -> bool {
        return match self {
            Verdict::Overlap => true,
            else => false,
        }
    }

    /// One line, for a report a person reads.
    pub fn why(ref self) -> String {
        return match self {
            Verdict::Overlap => "they meet on nothing",
            Verdict::DataDependency(name) => f"the second uses `{name}`",
            Verdict::Shadowed(name) => f"both bind `{name}`",
            Verdict::SameResource { kind, named, unnameable } => same_resource(kind, named, unnameable),
            Verdict::SameDestination { one, other } => f"one touches {one} and the other {other}, which might be the same place. Use `seq` to run them in order",
            Verdict::NotAccountedFor => "the compiler can't tell what one of them does",
        }
    }
}

fn same_resource(kind: ref String, named: ref String?, unnameable: bool) -> String {
    if named != null {
        let name = named ?? ""
        return f"both reach {kind} `{name}`, and one writes it"
    }
    if unnameable {
        return f"both touch a {kind} the compiler can't name, and one writes to it"
    }
    return f"both touch {kind}, and one writes to it"
}

/// Whether `later` may run at the same time as `earlier`, and why not: a
/// **data** dependency first, then two bindings of one name, then an
/// **effect** dependency, where their touch sets meet on something one of
/// them writes.
pub fn verdict(earlier: ref Operation, later: ref Operation) -> Verdict {
    let bound = written_or_nothing(earlier.binds)
    if earlier.binds != null && later.mentions.contains(bound) {
        return Verdict::DataDependency(bound.clone())
    }
    // Two `let`s of the same name would make the order decide which value
    // survives. The parser allows shadowing, so this is reachable.
    if earlier.binds != null && earlier.binds == later.binds {
        return Verdict::Shadowed(bound.clone())
    }
    for a in earlier.reaches {
        for b in later.reaches {
            if a.conflicts_with(b) {
                return conflict(a, b)
            }
        }
    }
    return Verdict::Overlap
}

// Two kinds that conflict at all are two names for what may be one thing; one
// kind is one resource, and the named half is the more useful one to print.
fn conflict(a: ref Reached, b: ref Reached) -> Verdict {
    if a.kind != b.kind {
        return Verdict::SameDestination { one: a.kind.clone(), other: b.kind.clone() }
    }
    let named = readable_name(a) ?? readable_name(b) ?? return Verdict::SameResource { kind: a.kind.clone(), named: null, unnameable: a.unknown || b.unknown }
    return Verdict::SameResource { kind: a.kind.clone(), named: named, unnameable: false }
}

// The name a reached resource was given, where it was readable.
fn readable_name(reached: ref Reached) -> String? {
    if reached.unknown {
        return null
    }
    return reached.named?.clone()
}

/// Whether a whole **run** of operations may run as one group, and why not
/// (ADR-033 §6). **Every pair, not every adjacent pair**: disjointness is not
/// transitive, and believing it would overlap a read of a file with the write
/// of it. The pair named is the earliest.
pub fn group_verdict(run: ref Vec[Operation]) -> Verdict {
    for i in 0..<run.len() {
        for j in (i + 1)..<run.len() {
            let found = verdict(run[i], run[j])
            if !found.is_overlap() {
                return found
            }
        }
    }
    return Verdict::Overlap
}

/// How many operations from the front of `run` may go together: the longest
/// **prefix** every member of which meets every other on nothing, and `0`
/// where that is fewer than two - a group is a run the emitter replaces in
/// place, so leaving one out of the middle would reorder the rest.
pub fn group_of(run: ref Vec[Operation]) -> i64 {
    let mut taken = if run.len() > 0 { 1 } else { 0 }
    while taken < run.len() {
        if !fits_with_the_front(run, taken) {
            break
        }
        taken += 1
    }
    if taken < 2 {
        return 0
    }
    return taken
}

// Whether the operation at `at` meets every one before it on nothing.
fn fits_with_the_front(run: ref Vec[Operation], at: i64) -> bool {
    for i in 0..<at {
        if !verdict(run[i], run[at]).is_overlap() {
            return false
        }
    }
    return true
}

// The kinds of resource this compiler knows (ADR-033 D2). A ledger that names
// another is not malformed - it is a file this compiler is too old to read,
// and D4 says what to do with an effect that cannot be read.
comptime KNOWN_KINDS: Array[ref String, 6] = ["file", "stdout", "stderr", "args", "lock", "socket"]

/// A statement, reduced to an `Operation` - or the reason it could not be.
/// `walking` carries the two ledgers and the destination the result of each
/// call is asked about (`Going::Ours`, ADR-045 D1: the closure overlapping
/// builds is this compiler's own).
///
/// Two shapes are read: a `let` of one name and a bare expression statement.
/// An **assignment** is not among them and must not be: `x = 1` changes a
/// name without binding one, so the data-dependency test would miss it.
pub fn accounted(stmt: ref Stmt, words: ref winnow_grammar::InternerContext, walking: ref Walking) -> Accounted {
    return match stmt {
        Stmt::Let { names, value, ty, .. } => {
            // A written type would have to be carried onto one half of a
            // pattern; a tuple of names would need all of them carried.
            if ty != null {
                return Accounted::Opaque("a written type, which would have to be carried onto one half of a pattern")
            }
            if names.len() != 1 {
                return Accounted::Opaque("several names bound at once")
            }
            let binds: String? = words.resolve(names[0]).clone()
            accounted_value(binds, value, words, walking)
        }
        Stmt::Expr(value) => accounted_value(null, value, words, walking),
        else => Accounted::NotAnOperation,
    }
}

// The value of a statement, looked through a `catch` whose handler cannot
// divert: a handler that leaves makes the *next* statement conditional on
// this one (ADR-034).
fn accounted_value(binds: String?, value: ref Expr, names: ref winnow_grammar::InternerContext, walking: ref Walking) -> Accounted {
    return match value {
        Expr::TryCatch { expr, handler } => {
            if diverts_within(handler.stmts, false) {
                return Accounted::DivertingHandler
            }
            let mut reduced = Reduced { calls: [], performs: false, methods: [], refused: null }
            reduce(expr, names, reduced)
            // **And the handler's own effects**: it is part of the statement,
            // so what it reaches is part of what the statement touches.
            reduce_handler(handler, names, reduced)
            let mut mentions: collections::BTreeSet[String] = collections::BTreeSet()
            names_in(expr, names, mentions)
            // **The handler counts too** for a data dependency.
            names_in_block(handler, names, mentions)
            accounted_reduced(binds, mentions, reduced, true, walking)
        }
        else => {
            let mut reduced = Reduced { calls: [], performs: false, methods: [], refused: null }
            reduce(value, names, reduced)
            let mut mentions: collections::BTreeSet[String] = collections::BTreeSet()
            names_in(value, names, mentions)
            accounted_reduced(binds, mentions, reduced, false, walking)
        }
    }
}

// What the walk found, made an answer. The ledger is consulted **before** the
// walk's own refusal is reported: "nothing says what `x` reaches" is a gap a
// reader can close, where "it holds a method call" is this compiler's own
// limit (D9).
fn accounted_reduced(binds: String?, mentions: collections::BTreeSet[String], reduced: ref Reduced, caught: bool, walking: ref Walking) -> Accounted {
    if reduced.calls.len() == 0 && !reduced.performs {
        // Nothing here reaches the world at all.
        return Accounted::NotAnOperation
    }
    let mut reaches: Vec[Reached] = []
    let mut named_by: Vec[String] = []
    for call in reduced.calls {
        let refused = a_call_reaches(call, caught, walking, reaches, named_by)
        if refused != null {
            return refused ?? Accounted::NotAnOperation
        }
    }
    // A method call is accounted for only where **every** entry of that name
    // reaches nothing (D4).
    for method in reduced.methods {
        if !reaches_nothing(method, walking) {
            return Accounted::NoTouches(method.clone())
        }
    }
    if reduced.refused != null {
        return reduced.refused?.clone() ?? Accounted::NotAnOperation
    }
    return Accounted::Operation(Operation { binds: binds, mentions: mentions, reaches: reaches, callee: named_by.join(" + ") })
}

// What one call reaches, added to `reaches`; the refusal where it cannot be
// accounted for.
fn a_call_reaches(call: ref OneCall, caught: bool, walking: ref Walking, mut reaches: Vec[Reached], mut named_by: Vec[String]) -> Accounted? {
    let key = call.key.clone()
    // The contract has to be found *and* has to describe its effects: an
    // entry without `touches` is the absence of an answer (D4).
    let contract = touches_described(key, walking) ?? return Accounted::NoTouches(key)
    // A failure nobody catches leaves the function, which makes the next
    // statement conditional on this one (ADR-034 D2).
    if !caught && contract.fails_with.len() > 0 {
        return Accounted::UncaughtFailure(key)
    }
    // An unknown kind differs from every kind there is, so it would be
    // disjoint from all of them: D4's answer instead.
    for touch in contract.touches {
        if !known_kind(touch.kind) {
            return Accounted::UnknownResource { callee: key.clone(), kind: touch.kind.clone() }
        }
    }
    let signature = contract.signature?.clone() ?? return Accounted::NoTouches(key)
    // **And what it hands back has to be able to cross a thread** (ADR-005
    // §1 Group B): the overlapped operation runs in a closure elsewhere and
    // hands its value back.
    let crossed = crossing(signature.result_or_unit(), walking)
    if !crossed.may() {
        return Accounted::MayNotCross { callee: key.clone(), crossing: crossed }
    }
    let parameters = call_parameters(signature)
    for touch in contract.touches {
        let named = argument_named(touch.parameter, parameters, call.arguments)
        reaches.push(Reached { kind: touch.kind.clone(), unknown: touch.parameter != null && named == null, named: named, write: touch.write })
    }
    named_by.push(key)
    return null
}

// The contract a call's key names, in the program's ledger and then `std`'s,
// where it describes what it touches.
fn touches_described(key: ref String, walking: ref Walking) -> FnContract? {
    let mine: FnContract? = walking.own.functions[key]?.clone()
    let found = mine ?? walking.library.functions[key]?.clone() ?? return null
    if !found.touches_known {
        return null
    }
    return found
}

fn known_kind(kind: ref String) -> bool {
    for known in KNOWN_KINDS {
        if known == kind {
            return true
        }
    }
    return false
}

// The parameters a *call* passes, which is the parameters after a receiver.
fn call_parameters(signature: ref Signature) -> Vec[String] {
    let mut out: Vec[String] = []
    for i in 0..<signature.params.len() {
        if i > 0 || signature.params[i].0 != "self" {
            out.push(signature.params[i].0.clone())
        }
    }
    return out
}

// The literal text of the argument a touch's parameter names, where it is a
// literal: `fs::read(pfad, root)` names a file this compiler cannot identify,
// and D4 says what happens then.
fn argument_named(parameter: ref String?, parameters: ref Vec[String], arguments: ref Vec[Expr]) -> String? {
    let wanted = parameter ?? return null
    for at in 0..<parameters.len() {
        if parameters[at] == wanted {
            if at >= arguments.len() {
                return null
            }
            return literal_text(arguments[at])
        }
    }
    return null
}

fn literal_text(expr: ref Expr) -> String? {
    return match expr {
        Expr::LitStr { text, .. } => text.clone(),
        else => null,
    }
}

// Whether every entry a bare method name could resolve to reaches nothing,
// in the program's ledger if it has any, else in `std`'s. Only a method is a
// candidate: an entry whose signature takes no `self` is a function a call
// names by its path.
fn reaches_nothing(method: ref String, walking: ref Walking) -> bool {
    let mut candidates = method_entries(method, walking.own)
    if candidates.len() == 0 {
        candidates = method_entries(method, walking.library)
    }
    if candidates.len() == 0 {
        return false
    }
    for contract in candidates {
        if !contract.touches_known || contract.touches.len() > 0 {
            return false
        }
    }
    return true
}

fn method_entries(method: ref String, ledger: ref Ledger) -> Vec[FnContract] {
    let suffix = f"::{method}"
    let mut out: Vec[FnContract] = []
    for (key, contract) in ledger.functions {
        if key.ends_with(ref suffix) && takes_a_subject(contract.signature) {
            out.push(contract.clone())
        }
    }
    return out
}

fn takes_a_subject(signature: ref Signature?) -> bool {
    let written = signature ?? return true
    return written.takes_a_receiver()
}

/// One call a statement performs: its ledger key and its arguments.
pub struct OneCall {
    pub key: String,
    pub arguments: Vec[Expr],
}

// What walking a statement's value found (ADR-033 §8.3): the calls it
// performs at any depth; whether it performs *something* even where this
// could not say what; every method called, by name; and the first reason it
// could not be taken apart.
struct Reduced {
    calls: Vec[OneCall],
    performs: bool,
    methods: Vec[String],
    refused: Accounted?,
}

// Record a reason, and say nothing about whether anything was performed.
fn noted(mut reduced: Reduced, why: Accounted) {
    if reduced.refused == null {
        reduced.refused = why
    }
}

// Record a reason for a node the walk stops at: what is inside was not read,
// so "performs something" has to be assumed.
fn stopped(mut reduced: Reduced, why: Accounted) {
    reduced.performs = true
    noted(reduced, why)
}

// The statements of a `catch` handler: only the two shapes whose value the
// walk can take apart are read.
fn reduce_handler(block: ref Block, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { value, .. } => reduce(value, names, reduced),
            Stmt::Expr(value) => reduce(value, names, reduced),
            else => stopped(reduced, Accounted::Opaque("a `catch` handler doing more than handing back a value")),
        }
    }
}

// Take a statement's value apart into the calls it performs: literals, calls
// and operators over them. Everything else records a reason and stops, which
// makes adding a shape a deliberate act.
fn reduce(node: ref Expr, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    match node {
        Expr::LitInt { .. } => {}
        Expr::LitFloat(_) => {}
        Expr::LitBool(_) => {}
        Expr::LitNull => {}
        Expr::LitChar(_) => {}
        Expr::LitStr { .. } => {}
        Expr::Call { func, args, config } => {
            // Kap 5.1's options would have to be matched against the callee's
            // declaration order first.
            if config.len() > 0 {
                stopped(reduced, Accounted::Opaque("a call with options, which nothing matches against the callee's order yet"))
                return
            }
            let key = called_key(func, names) ?? return stopped(reduced, Accounted::Opaque("a call through something that is not a name"))
            for arg in args {
                reduce(arg, names, reduced)
            }
            reduced.calls.push(OneCall { key: key, arguments: args.clone() })
        }
        Expr::Unary { expr, .. } => reduce(expr, names, reduced),
        Expr::Cast { expr, .. } => reduce(expr, names, reduced),
        Expr::Binary { op, lhs, rhs, .. } => {
            // `&&` and `||` evaluate their right side only sometimes (D5).
            if a_short_circuit(op) {
                stopped(reduced, Accounted::Opaque("a `&&` or `||`, whose right side runs only sometimes"))
                return
            }
            reduce(lhs, names, reduced)
            reduce(rhs, names, reduced)
        }
        Expr::Tuple(parts) => {
            for part in parts {
                reduce(part, names, reduced)
            }
        }
        Expr::ListLit { items, .. } => {
            for item in items {
                reduce(item, names, reduced)
            }
        }
        // A jump ends the sequence (ADR-138 D1).
        Expr::Return(_) => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        Expr::Break => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        Expr::Continue => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        // A name is a value from somewhere else, which the closure would have
        // to capture.
        Expr::Variable(name) => noted(reduced, Accounted::NonLiteralArgument(names.resolve(name).clone())),
        Expr::Field { base, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
        }
        Expr::SafeField { base, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
        }
        Expr::Index { base, index } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
            reduce(index, names, reduced)
        }
        // **A path names an item, and an item is not a place**: nothing to
        // read, capture or carry.
        Expr::Path(_) => {}
        Expr::StructLit { fields, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            for field in fields {
                reduce_maybe(field.value, names, reduced)
            }
        }
        Expr::Range { start, end, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(start, names, reduced)
            reduce(end, names, reduced)
        }
        // `a ?? b` runs `b` only when `a` had nothing (D5).
        Expr::Coalesce { value, fallback } => {
            noted(reduced, Accounted::Opaque("a `??`, whose fallback runs only sometimes"))
            reduce(value, names, reduced)
            reduce(fallback, names, reduced)
        }
        Expr::LitInterpolated { .. } => stopped(reduced, Accounted::Opaque("text with code in it, whose holes this has not parsed")),
        // *Which* entry `xs.len()` is needs the type checker (ADR-028); the
        // name is recorded and `accounted` asks whether every entry of it
        // reaches nothing. A `?.m()` is accounted for exactly as a `.m()`.
        Expr::MethodCall { receiver, method, args, config } => reduce_method(receiver, method, args, config, names, reduced),
        Expr::SafeMethod { receiver, method, args, config } => reduce_method(receiver, method, args, config, names, reduced),
        // A lambda's body is in the function and not in this value, and the
        // touch set has to be complete for the statement (D4).
        Expr::Closure { .. } => stopped(reduced, Accounted::Opaque("a lambda, whose body this analysis does not read")),
        // Everything with its own control flow: D5 allows only operations
        // that certainly run.
        else => stopped(reduced, Accounted::Opaque("something with its own control flow")),
    }
}

fn reduce_method(receiver: ref Expr, method: winnow_grammar::Symbol, args: ref Vec[Expr], config: ref Vec[ConfigArg], names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    reduce(receiver, names, reduced)
    for arg in args {
        reduce(arg, names, reduced)
    }
    for option in config {
        reduce(option.value, names, reduced)
    }
    reduced.methods.push(names.resolve(method).clone())
}

fn reduce_maybe(expr: ref Expr?, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    reduce(expr ?? return, names, reduced)
}

fn a_short_circuit(op: ref BinaryOp) -> bool {
    return match op {
        BinaryOp::And => true,
        BinaryOp::Or => true,
        else => false,
    }
}

// The ledger key of the call an expression performs: a bare name, or a path
// joined by `::`.
fn called_key(func: ref Expr, names: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name) => names.resolve(name).clone(),
        Expr::Path(segments) => joined_segments(segments, names),
        else => null,
    }
}

fn joined_segments(segments: ref Vec[winnow_grammar::Symbol], names: ref winnow_grammar::InternerContext) -> String {
    let mut parts: Vec[String] = []
    for segment in segments {
        parts.push(names.resolve(segment).clone())
    }
    return parts.join("::")
}

/// Whether a block can leave **by a door other than its own last statement**
/// - a `return` or a `throw` anywhere in it, and a `break` or `continue` not
/// bound to a loop written inside it. `bound` says such a loop stands between
/// here and the block's end.
pub fn diverts_within(stmts: ref Vec[Spanned[Stmt]], bound: bool) -> bool {
    for stmt in stmts {
        let leaves = match stmt.node {
            Stmt::Return(_) => true,
            Stmt::Break => !bound,
            Stmt::Continue => !bound,
            Stmt::Expr(expr) => holds_throw(expr, bound),
            Stmt::Let { value, .. } => holds_throw(value, bound),
            Stmt::Comptime { value, .. } => holds_throw(value, bound),
            Stmt::Assign { value, .. } => holds_throw(value, bound),
            Stmt::For { body, .. } => diverts_within(body.stmts, true),
            Stmt::While { body, .. } => diverts_within(body.stmts, true),
        }
        if leaves {
            return true
        }
    }
    return false
}

// Whether an expression can leave the block it is in.
fn holds_throw(expr: ref Expr, bound: bool) -> bool {
    return match expr {
        Expr::Throw(_) => true,
        Expr::Block(block) => diverts_within(block.stmts, bound),
        Expr::Overlap(block) => diverts_within(block.stmts, bound),
        Expr::If { then_branch, else_branch, .. } => diverts_within(then_branch.stmts, bound) || else_diverts(else_branch, bound),
        Expr::Match { arms, .. } => an_arm_throws(arms, bound),
        else => false,
    }
}

fn else_diverts(block: ref Block?, bound: bool) -> bool {
    let written = block ?? return false
    return diverts_within(written.stmts, bound)
}

fn an_arm_throws(arms: ref Vec[MatchArm], bound: bool) -> bool {
    for arm in arms {
        if holds_throw(arm.body, bound) {
            return true
        }
    }
    return false
}
