// crates/nikaia-std/src/tools/rust.nika
//
// A Rust file's public surface, read by a Nikaia grammar.
//
// **This is the reading half of `nikaia describe`**
// ([ADR-290](../../../../docs/specification/adr/adr-290.md) D13), written in the
// language the command belongs to. It reaches the compiler - which is Rust -
// the way [ADR-290](../../../../docs/specification/adr/adr-290.md) D16 says such a
// thing reaches Rust: lowered ahead of time by `nikaia lower-std`, committed as
// the `rust.rs` beside this file, and `include!`d into
// `nikaia_std::tools::rust`. The
// call across is an ordinary Rust call with ordinary Rust types. There is no
// process, no C ABI and no interface to design.
//
// **It is not part of `std`, and the directory is what says so.** A `.nika`
// beside `lib.rs` is a module of `std` and `crates/nikaia/tests/contracts.rs`
// requires `std.contracts` to carry every `pub` thing it declares; this one is
// under `tools/` and must not be in that file. It lives in this crate at all
// because this crate is where the release step already looks for `.nika`
// sources ([ADR-002](../../../../docs/specification/adr/adr-002.md) D4,
// [ADR-290](../../../../docs/specification/adr/adr-290.md) D12), and for no
// other reason.
//
// **And writing it is refused, in this language's words**: `use std::tools` is
// `NK1186`, saying that `tools` is the toolchain's own and holds the grammar
// below, which `nikaia describe` calls and a program cannot reach. It used to
// lower, with `rustc` complaining about a file nobody wrote - [Part III
// C.1](../../../../docs/specification/30-nikaia-tooling.md)'s own class, and a
// defect this file found rather than made, since `use std::<anything>` had
// always been accepted.
//
// ## What it reads, and how it differs from what it replaces
//
// `pub fn` (with `async`, `const`, `unsafe`, `extern "C"`), `pub struct`,
// `pub enum`, `pub trait`, `pub mod`, `pub use` and `impl` headers, the type
// text under them, and the module and `impl` path each item was found at.
//
// What it replaces is a hand-written character scanner that matched `pub fn` at
// the start of a line and counted braces without knowing what a brace is.
// Measured on one file, that scanner reports **four functions that do not
// exist** - one inside a block comment, one on the second line of a string
// literal, two inside a private `mod` - and puts a fifth at the crate root
// rather than under its module. Three things here are why none of that
// happens:
//
//   * **A skipper that knows what it is skipping.** `JUNK` crosses a string, a
//     character literal, a comment and a balanced brace group as single units,
//     so a private `mod`'s whole body is one skip.
//   * **Visibility is a rule of the language and not of the line.** An
//     inherent `impl` reports its `pub fn`s; an `impl Trait for Type` reports
//     all of them, because a trait method is as public as its trait. And a
//     `pub use` is an item here, because a `pub fn` inside a private `mod` is
//     reachable after all when one says so - a reader that did not look for
//     one would refuse a call that is correct
//     ([Part III C.4](../../../../docs/specification/30-nikaia-tooling.md)).
//   * **The extent of a type, without a type grammar.** A parameter's type
//     runs to the next top-level `,` or `)`, a field's to the next `,` or `}`,
//     a result's to the next `{`, `;` or `where` - with every bracket, string
//     and character literal inside it crossed as a unit. The text is what the
//     ledger's translation step already reads, so this replaces the scanner
//     without touching the translator.
//
// ## What it does not read
//
// Stated rather than guessed at, which is
// [ADR-290](../../../../docs/specification/adr/adr-290.md) D4's own rule - an
// absence of a claim is never a claim:
//
//   * **an item a macro generates**, which is not in the text and which no
//     parser reaches. That limit is
//     [ADR-001](../../../../docs/specification/adr/adr-001.md) D1's and not this
//     grammar's: it survives `syn` too, for the same reason rustdoc's JSON is
//     out of reach.
//   * **a raw string** (`r"…"`, `r#"…"#`) and a **nested block comment**, both
//     of which are one token in Rust and two here;
//   * **what a `pub use` resolves to.** The item is reported with the text it
//     was written with; splitting a path is string work rather than parsing
//     work, and whoever needs the pieces takes them.
//   * **a tuple struct's fields**, which are reported as none - and *none* and
//     *nobody looked* are the same word here, which is the one place this is no
//     better than the scanner.

// A named part: a parameter, a field, an enum variant. `ty` is the text of the
// type as it was written, which is what the translation step reads.
pub struct Part {
    pub name: ref String,
    pub ty: ref String,
}

pub struct Fun {
    pub name: ref String,
    // The crate's own type parameters, as the text between the angle brackets
    // and empty where there are none. Not split here, for the reason
    // `Item::Export` gives: splitting a list is string work.
    pub generics: ref String,
    // Every path this body calls, in the order it calls them, with duplicates.
    //
    // **The other row's evidence** ([ADR-290](../../../../docs/specification/adr/adr-290.md)
    // D4). A bound is what a function asks of its caller; a **call** is what it
    // does, and the two answer different questions - `across_a_thread_unchecked`
    // has no bound, because an `unsafe impl Send` took it away, and only
    // following the calls reaches the `spawn`.
    //
    // A path and not a resolved callee: `spawn` and `tokio::spawn` are two
    // strings for one function and which one a file writes is a question about
    // its `use` items. That is whoever walks this to answer, from `Item::Used`
    // beside this.
    pub calls: Vec[ref String],
    // The `where` clause's text, without the word, and empty where there is
    // none.
    //
    // **Kept because a bound is evidence.** Every safe way of reaching another
    // thread carries `Send`, so a foreign function that takes a value across a
    // thread boundary in safe Rust demands it of its caller - and says so here
    // or in `generics` above
    // ([ADR-290](../../../../docs/specification/adr/adr-290.md) D9). A reader
    // that dropped this would see half the bounds a crate writes.
    pub wheres: ref String,
    // `async fn` - a plain `fn` is `sync` (ADR-290 D3).
    pub pauses: bool,
    pub parts: Vec[Part],
    // The text after `->`, or empty where there is none. Empty is *no result
    // was written*, which in Rust is the unit type.
    pub result: ref String,
}

// A named type with parts: a `struct` or an `enum`. `what` says which, because
// the two differ in what a part means and nothing else here cares.
pub struct Rec {
    pub what: ref String,
    pub name: ref String,
    pub parts: Vec[Part],
    // The text inside each `#[derive(…)]` in front of it, one entry per
    // attribute, as written: `Clone, Copy, PartialEq`. Whether the type copies
    // and compares is read from these ([ADR-294](../../../../docs/specification/adr/adr-294.md)
    // D4.3), and splitting them is string work for whoever reads them.
    pub derives: Vec[ref String],
}

// A named scope holding items: `mod`, `trait`, `impl`, `unsafe impl`.
//
// `via` is the trait of an `impl Trait for Type`, and empty for every other
// scope. It is kept apart from `name` because they answer different questions:
// the methods inside belong to the *type*, and `unsafe impl Send for X` is a
// claim about the *trait* - which is the one ADR-290 D9's flag is after.
pub struct Group {
    pub what: ref String,
    pub name: ref String,
    pub via: ref String,
    // Whether the scope itself is reachable from outside the crate. False for
    // a `mod` that is not `pub`.
    //
    // **A private `mod` is reported rather than skipped**, and what is in it is
    // reported under it. That is not a contradiction of *this crate does not
    // offer it*: a `pub use` may reach through a private `mod` and make one of
    // its items reachable at another path, so a reader that threw the body
    // away could not answer a call that is correct
    // ([Part III C.4](../../../../docs/specification/30-nikaia-tooling.md)).
    // What is a question about reachability is answered by whoever walks this,
    // from `visible` and from the re-exports - not by the grammar deciding not
    // to look.
    pub visible: bool,
    pub items: Vec[RustItem],
}

pub enum RustItem {
    Fun(Fun),
    Rec(Rec),
    Group(Group),
    // A `fn` that is **not** `pub`, with everything a `pub` one carries.
    //
    // **Reported rather than skipped**, for the reason a private `mod` is: a
    // private function is not an entry and is on the way to one. `on_one_worker`
    // in `examples/foreign-runtime/shim` is the case
    // ([ADR-290](../../../../docs/specification/adr/adr-290.md) D9) - nothing
    // outside the crate can call it, and it is the only thing between
    // `across_a_thread_unchecked` and a `tokio::spawn`. A reader that threw it
    // away could not follow the calls at all.
    Hidden(Fun),
    // A plain `use`, kept as the text between the keyword and the semicolon.
    //
    // **What a name in this file means** ([ADR-290](../../../../docs/specification/adr/adr-290.md)
    // D4): `use tokio::spawn; spawn(x)` and `tokio::spawn(x)` are one function
    // and two strings, and a reader of `Fun::calls` that did not have this
    // table would miss every crate that imports what it calls. It offers
    // nothing to anybody outside, which is what makes it a different variant
    // from `Export` beside it.
    Used(ref String),
    // A `pub use`, kept as the text between the keyword and the semicolon.
    //
    // **Not split here on purpose.** Which name a re-export makes reachable at
    // which path is a question about `::`, and splitting a path is string work
    // rather than parsing work - so the grammar says *this item is a
    // re-export and here is what it said*, and whoever needs the pieces takes
    // them. What matters is that the item is **seen**: a `pub fn` inside a
    // private `mod` is reachable after all when a `pub use` says so, and a
    // reader that did not look for one would refuse a call that is correct.
    Export(ref String),
}

// What one position in a file turned out to be. A file is a run of these, and
// the ones that are nothing are the text between the items.
pub enum Found {
    One(RustItem),
    Skip,
}

// What one piece of a function body turned out to be.
pub enum Called {
    One(ref String),
    Many(Vec[ref String]),
    Nothing,
}

grammar Rust {

    // Comments are whitespace, which is the same move `config.nika` makes for
    // `#`: say it once here and no rule below mentions a comment.
    //
    // A nested `/* /* */ */` is one comment in Rust and two here. That is a
    // stated limit and not a silent one - see the header.
    rule WSE = multispace1 { }
    rule WS = (WSE | LINE | BLOCK)* { }
    rule LINE = "//" until(line_ending) { }
    rule BLOCK = "/*" until("*/") "*/" { }

    pub rule file -> Vec[RustItem] = items:public eof { items }

    // ---- the two bodies ------------------------------------------------
    //
    // `public` reports what is public where it stands; `exposed` reports every
    // function, and is what an `impl Trait for Type` body gets, because a
    // trait method is as public as the trait is. The difference is one
    // alternative and it is the whole of the visibility rule.

    rule public -> Vec[RustItem] =
        found:found* { kept(found) }

    rule exposed -> Vec[RustItem] =
        found:found_exposed* { kept(found) }

    rule found -> Found =
          i:item { Found::One(i) }
        | f:method { Found::One(RustItem::Hidden(f)) }
        | JUNK { Found::Skip }

    rule found_exposed -> Found =
          f:method { Found::One(RustItem::Fun(f)) }
        | i:item { Found::One(i) }
        | JUNK { Found::Skip }

    rule item -> RustItem =
          f:function { RustItem::Fun(f) }
        | r:record { RustItem::Rec(r) }
        | g:group { RustItem::Group(g) }
        | e:export { RustItem::Export(e) }
        | u:import { RustItem::Used(u) }

    // `pub use …;` and nothing else: a plain `use` brings a name into this
    // file's scope and makes nothing reachable from outside it, and
    // `pub(crate) use` is refused by `PUB` itself.
    rule export -> ref String = PUB USE t:USE_TEXT ";" { t }

    rule import -> ref String = USE t:USE_TEXT ";" { t }

    rule USE_TEXT -> ref String = s:text(USE_RUN) { s.trim() }
    rule USE_RUN = USE_PIECE+ { }
    rule USE_PIECE = not(";") (BRACES | LINE | BLOCK | ANY) { }

    // ---- functions -----------------------------------------------------

    rule function -> Fun = PUB f:method { f }

    rule method -> Fun =
        pauses:qualifiers FN name:IDENT g:generics parts:parameters result:result w:where_clause c:tail {
            Fun { name, generics: g, wheres: w, calls: c, pauses, parts, result }
        }

    // `const`, `unsafe` and `extern "C"` may stand between `pub` and `fn`, and
    // only one of them is a question the ledger asks: whether the function
    // pauses.
    rule qualifiers -> bool =
        qs:qualifier* {
            let mut pauses = false
            for q in qs.drain() { if q { pauses = true } }
            pauses
        }

    rule qualifier -> bool =
          ASYNC { true }
        | CONST { false }
        | UNSAFE { false }
        | EXTERN abi { false }

    rule abi = string { } | empty { }

    // A body, or the semicolon a trait's own declaration ends with.
    // A body, or the semicolon a trait's own declaration ends with - and what
    // the body **calls**, at every depth.
    rule tail -> Vec[ref String] = cs:inside { cs } | ";" { Vec() }

    rule inside -> Vec[ref String] = "{" cs:inside_run "}" { cs }

    rule inside_run -> Vec[ref String] =
        pieces:inside_piece* { every_call(pieces) }

    // What one piece turned out to be. **Three variants and not a list**: a
    // piece that is one call would otherwise build a list of one, which the
    // language below reads as `Vec::new()` followed by a `push` and complains
    // about - a complaint about the generated file, which is
    // [Part III C.1](../../../../docs/specification/30-nikaia-tooling.md)'s
    // class whoever makes it.

    // One unit of a body. **Not named `block`**: the backend folds a rule's
    // name, so `block` and the `BLOCK` above would be one rule and the
    // generated Rust would not compile - a thing worth writing down once
    // rather than meeting twice.
    //
    // Order matters: a string, a character literal and a
    // comment are crossed before anything inside them is read, a nested brace
    // group is descended into so a call inside a closure is not lost, and a
    // call is taken before the character it starts with would be.
    rule inside_piece -> Called =
          not("}") STRING { Called::Nothing }
        | not("}") CHAR { Called::Nothing }
        | not("}") LINE { Called::Nothing }
        | not("}") BLOCK { Called::Nothing }
        | not("}") inner:inside { Called::Many(inner) }
        | not("}") p:CALL { Called::One(p) }
        | not("}") ANY { Called::Nothing }

    // A path immediately followed by `(`. Lexical, so the `(` has to be the
    // next character: `match (a, b) {` is not a call to `match`, and `f (x)` is
    // not read as one either - which is the price of not writing a Rust
    // expression grammar, and a price worth naming.
    //
    // A turbofish is read past: `spawn::<T>(…)` is a call to `spawn`.
    rule CALL -> ref String = p:text(PATH) TURBOFISH "(" { p }

    rule PATH = raw_ident (PATH_TAIL)* { }
    rule PATH_TAIL = "::" raw_ident { }
    rule TURBOFISH = "::" ANGLES { } | empty { }

    rule parameters -> Vec[Part] = "(" ps:parameter_list ")" { ps }

    rule parameter_list -> Vec[Part] =
          head:parameter tail:parameter_tail* COMMA {
              let mut all = Vec()
              all.push(head)
              for p in tail.drain() { all.push(p) }
              all
          }
        | empty { Vec() }

    rule parameter_tail -> Part = "," p:parameter { p }

    // The receiver keeps the text it was written as, so `&mut self` and `self`
    // stay different without a type for either.
    rule parameter -> Part =
          t:text(receiver) { Part { name: "self", ty: t.trim() } }
        | MUT n:IDENT ":" t:PARAM_TYPE { Part { name: n, ty: t } }
        | n:IDENT ":" t:PARAM_TYPE { Part { name: n, ty: t } }
        | n:HOLE ":" t:PARAM_TYPE { Part { name: n, ty: t } }

    // Longest first: a PEG takes the first alternative that matches, so
    // `&mut self` has to be tried before `&self`.
    rule receiver =
          "&" LIFETIME MUT SELF { }
        | "&" LIFETIME SELF { }
        | "&" MUT SELF { }
        | "&" SELF { }
        | MUT SELF { }
        | SELF { }

    // ---- structs, enums ------------------------------------------------

    rule record -> Rec =
          ds:attributes PUB STRUCT name:IDENT generics where_clause "{" fs:field_list "}" {
              Rec { what: "struct", name, parts: fs, derives: ds }
          }
        | ds:attributes PUB STRUCT name:IDENT generics tuple_body where_clause ";" {
              Rec { what: "struct", name, parts: Vec(), derives: ds }
          }
        | ds:attributes PUB ENUM name:IDENT generics where_clause "{" vs:variant_list "}" {
              Rec { what: "enum", name, parts: vs, derives: ds }
          }

    // The attributes in front of a type: what each `derive` lists, and
    // nothing for any other attribute.
    rule attributes -> Vec[ref String] =
        all:attribute* {
            let mut derives = Vec()
            for d in all.drain() {
                if !d.is_empty() { derives.push(d) }
            }
            derives
        }

    rule attribute -> ref String =
          "#" "[" DERIVE "(" d:text(TUPLE_INNER) ")" "]" { d.trim() }
        | "#" "[" BRACKET_INNER "]" { "" }

    rule tuple_body = "(" TUPLE_INNER ")" { } | empty { }

    rule field_list -> Vec[Part] =
          head:field tail:field_tail* COMMA {
              let mut all = Vec()
              all.push(head)
              for f in tail.drain() { all.push(f) }
              all
          }
        | empty { Vec() }

    rule field_tail -> Part = "," f:field { f }

    rule field -> Part =
          PUB n:IDENT ":" t:FIELD_TYPE { Part { name: n, ty: t } }
        | n:IDENT ":" t:FIELD_TYPE { Part { name: n, ty: t } }

    rule variant_list -> Vec[Part] =
          head:variant tail:variant_tail* COMMA {
              let mut all = Vec()
              all.push(head)
              for v in tail.drain() { all.push(v) }
              all
          }
        | empty { Vec() }

    rule variant_tail -> Part = "," v:variant { v }

    // A variant's payload is kept as the text it was written as, which is the
    // same answer a field's type gets and for the same reason.
    rule variant -> Part =
          n:IDENT t:text(payload) { Part { name: n, ty: t.trim() } }

    rule payload =
          "(" TUPLE_INNER ")" { }
        | "{" BRACE_INNER "}" { }
        | empty { }

    // ---- scopes --------------------------------------------------------

    rule group -> Group =
          UNSAFE IMPL generics v:IMPL_TYPE FOR t:IMPL_TYPE where_clause "{" items:exposed "}" {
              Group { what: "unsafe impl", name: t, via: v, visible: true, items }
          }
        | UNSAFE IMPL generics t:IMPL_TYPE where_clause "{" items:public "}" {
              Group { what: "unsafe impl", name: t, via: "", visible: true, items }
          }
        | IMPL generics v:IMPL_TYPE FOR t:IMPL_TYPE where_clause "{" items:exposed "}" {
              Group { what: "impl", name: t, via: v, visible: true, items }
          }
        | IMPL generics t:IMPL_TYPE where_clause "{" items:public "}" {
              Group { what: "impl", name: t, via: "", visible: true, items }
          }
        | PUB TRAIT name:IDENT generics where_clause "{" items:exposed "}" {
              Group { what: "trait", name, via: "", visible: true, items }
          }
        | PUB MOD name:IDENT "{" items:public "}" {
              Group { what: "mod", name, via: "", visible: true, items }
          }
        | PUB MOD name:IDENT ";" {
              Group { what: "mod", name, via: "", visible: true, items: Vec() }
          }
        // A `mod` that is not `pub`. Read for what a `pub use` may reach
        // through it, and marked so that nobody mistakes it for an offer.
        | MOD name:IDENT "{" items:public "}" {
              Group { what: "mod", name, via: "", visible: false, items }
          }
        | MOD name:IDENT ";" {
              Group { what: "mod", name, via: "", visible: false, items: Vec() }
          }

    rule generics -> ref String =
          "<" g:text(ANGLE_INNER) ">" { g.trim() }
        | empty { "" }

    rule where_clause -> ref String =
          WHERE w:text(WHERE_RUN) { w.trim() }
        | empty { "" }

    // ---- what a type looks like, where it stops ------------------------
    //
    // Not a type grammar: the text, with every bracket, string and character
    // literal inside it crossed as a unit, up to the delimiter that ends it.
    // Which delimiter that is, is the only thing that differs between the
    // three.

    rule PARAM_TYPE -> ref String = s:text(PARAM_RUN) { s.trim() }
    rule PARAM_RUN = PARAM_PIECE+ { }
    rule PARAM_PIECE = not(",") not(")") SPAN { }

    rule FIELD_TYPE -> ref String = s:text(FIELD_RUN) { s.trim() }
    rule FIELD_RUN = FIELD_PIECE+ { }
    rule FIELD_PIECE = not(",") not("}") SPAN { }

    // `where` ends a result as surely as a brace does - and `not(WHERE)` says
    // so about the *word*, so a result of type `Wherever` is still a result.
    rule result -> ref String = "->" t:RESULT_TYPE { t } | empty { "" }

    rule RESULT_TYPE -> ref String = s:text(RESULT_RUN) { s.trim() }
    rule RESULT_RUN = RESULT_PIECE+ { }
    rule RESULT_PIECE = not("{") not(";") not(WHERE) SPAN { }

    rule WHERE_RUN = WHERE_PIECE+ { }
    rule WHERE_PIECE = not("{") not(";") SPAN { }

    rule IMPL_TYPE -> ref String = s:text(IMPL_RUN) { s.trim() }
    rule IMPL_RUN = IMPL_PIECE+ { }
    rule IMPL_PIECE = not("{") not(WHERE) not(FOR) SPAN { }

    // One unit of text that is not a delimiter: a bracket group, a literal, a
    // comment, or one character. Everything above is this with a different
    // thing in front of it.
    rule SPAN = (ANGLES | PARENS | BRACKETS | STRING | CHAR | LINE | BLOCK | ANY) { }

    // ---- the skipper ---------------------------------------------------
    //
    // `not("}")` is what keeps a scope's own closing brace for the rule that
    // opened it, and is the reason `public` and `exposed` terminate.

    rule JUNK = not("}") (STRING | CHAR | LINE | BLOCK | BRACES | ANY) { }

    rule BRACES = "{" BRACE_INNER "}" { }
    rule BRACE_INNER = BRACE_PIECE* { }
    rule BRACE_PIECE = not("}") (STRING | CHAR | LINE | BLOCK | BRACES | ANY) { }

    rule PARENS = "(" TUPLE_INNER ")" { }
    rule TUPLE_INNER = PAREN_PIECE* { }
    rule PAREN_PIECE = not(")") (STRING | CHAR | LINE | BLOCK | PARENS | BRACES | BRACKETS | ANGLES | ANY) { }

    rule BRACKETS = "[" BRACKET_INNER "]" { }
    rule BRACKET_INNER = BRACKET_PIECE* { }
    rule BRACKET_PIECE = not("]") (STRING | CHAR | LINE | BLOCK | PARENS | BRACES | BRACKETS | ANGLES | ANY) { }

    // Angle brackets are the one pair that is not a delimiter in Rust's
    // grammar, only in its types - so this is used inside a type and nowhere
    // else, and a `>` that closes nothing is one character like any other.
    rule ANGLES = "<" ANGLE_INNER ">" { }
    rule ANGLE_INNER = ANGLE_PIECE* { }
    rule ANGLE_PIECE = not(">") (STRING | CHAR | LINE | BLOCK | PARENS | BRACKETS | ANGLES | ANY) { }

    // A string literal, crossed rather than read. A raw string (`r"…"`) is not
    // here: it is a stated limit, like the nested comment.
    rule STRING = "\"" (SESC | SPLAIN)* "\"" { }
    rule SESC = "\\" any { }
    rule SPLAIN = not("\"") not("\\") any { }

    // A character literal, and the reason it is written this exactly: `'a` in
    // Rust is a *lifetime*, and a rule that read `'` and then anything would
    // swallow the `'static` in `Box<dyn Any + 'static>` and everything after
    // it up to the next quote. Requiring the closing quote is what makes a
    // lifetime fall through to `ANY`.
    rule CHAR = "'" (CESC | CPLAIN) "'" { }
    rule CESC = "\\" any { }
    rule CPLAIN = not("'") not("\\") any { }

    rule ANY = any { }

    // ---- words ---------------------------------------------------------
    //
    // Every keyword below says `not(WORD)` after itself, so `pub` is a word
    // and not the first three letters of `publish`. A scanner that matched the
    // text alone found `publish` and `republish` both.

    rule PUB = "pub" not(WORD) not("(") { }
    rule FN = "fn" not(WORD) { }
    rule ASYNC = "async" not(WORD) { }
    rule CONST = "const" not(WORD) { }
    rule UNSAFE = "unsafe" not(WORD) { }
    rule EXTERN = "extern" not(WORD) { }
    rule STRUCT = "struct" not(WORD) { }
    rule DERIVE = "derive" not(WORD) { }
    rule ENUM = "enum" not(WORD) { }
    rule TRAIT = "trait" not(WORD) { }
    rule IMPL = "impl" not(WORD) { }
    rule MOD = "mod" not(WORD) { }
    rule FOR = "for" not(WORD) { }
    rule WHERE = "where" not(WORD) { }
    rule MUT = "mut" not(WORD) { }
    rule USE = "use" not(WORD) { }
    rule SELF = "self" not(WORD) { }

    rule WORD = alpha1 { } | digit { } | "_" { }

    rule IDENT -> ref String = s:raw_ident { s }
    rule HOLE -> ref String = s:text("_") { s }
    rule LIFETIME = "'" raw_ident { }

    // A trailing comma, allowed everywhere Rust allows one.
    rule COMMA = "," { } | empty { }
}

// Every call one body's pieces found, in order.
fn every_call(pieces: Vec[Called]) -> Vec[ref String] {
    let mut all = Vec()
    for piece in pieces.drain() {
        match piece {
            Called::One(one) => { all.push(one) }
            Called::Many(many) => { for one in many { all.push(one) } }
            Called::Nothing => { }
        }
    }
    return all
}

// What `p*` collected, with the text between the items dropped.
fn kept(found: Vec[Found]) -> Vec[RustItem] {
    let mut all = Vec()
    for f in found.drain() {
        // Both variants by name rather than a catch-all: `Found` has exactly
        // two, so naming them is what an exhaustive `match` is for - and this
        // file is lowered into a crate that runs `clippy`, which reads a
        // single pattern beside an `else` as an `if let` written the long way.
        // A complaint about the generated file is
        // [Part III C.1](../../../../docs/specification/30-nikaia-tooling.md)'s
        // class whoever makes it.
        match f {
            Found::One(item) => { all.push(item) }
            Found::Skip => { }
        }
    }
    return all
}
