// crates/nikaia-std/src/tools/prover_state.nika
//
// **What the prover's walk keeps from one function to the next** (ADR-269
// D15-D18), moved from the compiler's `prove` (ADR-294, #436 step 4): the
// preconditions and postconditions it has found, the calls between
// functions, and which pass it is in.

use std::collections

/// What the walk keeps across functions and passes.
pub struct ProverState {
    /// Another package's contracts as terms, read once per function.
    pub foreign: collections::BTreeMap[String, Foreign?],
    pub preconditions: collections::BTreeMap[String, Precondition],
    /// **The preconditions of the walk before**, which the first pass reads
    /// at a call to carry a callee's precondition back (ADR-269 D15): the
    /// pass repeats until they stop changing.
    pub known: collections::BTreeMap[String, Precondition],
    /// Which function calls which, by name: a call inside a cycle is not
    /// carried back, so that recursion cannot grow a precondition forever.
    pub edges: collections::BTreeSet[(String, String)],
    /// Pass 1's postconditions, before any exit is asked (ADR-269 D17).
    pub candidates: collections::BTreeMap[String, Vec[PostClaim]],
    /// The postconditions standing in this walk: callers read them.
    pub postconditions: collections::BTreeMap[String, Vec[PostClaim]],
    /// The postconditions an exit of this walk did not show, by function and
    /// place in its list.
    pub broken: collections::BTreeSet[(String, i64)],
    /// The `assert`s that stand directly before a `return name`, by the
    /// statement's start: the claims a postcondition is made from.
    pub before_return: collections::BTreeMap[i64, String],
    /// Pass 1 records preconditions and says nothing.
    pub collecting: bool,
    pub in_test: bool,
}

impl ProverState {
    /// Before the first pass.
    pub fn fresh() -> ProverState {
        return ProverState {
            foreign: collections::BTreeMap(),
            preconditions: collections::BTreeMap(),
            known: collections::BTreeMap(),
            edges: collections::BTreeSet(),
            candidates: collections::BTreeMap(),
            postconditions: collections::BTreeMap(),
            broken: collections::BTreeSet(),
            before_return: collections::BTreeMap(),
            collecting: true,
            in_test: false,
        }
    }

    /// Whether `from` calls `to`, directly or through others, in what the
    /// walks so far have seen.
    pub fn reaches(ref self, from: ref String, to: ref String) -> bool {
        let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
        let mut next: Vec[String] = [from.clone()]
        while !next.is_empty() {
            let f = next.pop() ?? return false
            if f == to {
                return true
            }
            if seen.contains(f) {
                continue
            }
            seen.insert(f.clone())
            for (caller, callee) in self.edges {
                if caller == f {
                    next.push(callee.clone())
                }
            }
        }
        return false
    }


    /// **An exit of a free function**: each postcondition standing has to be
    /// shown here, with the value handed back as `result`, or it falls
    /// (ADR-269 D17). A parameter bound again before the exit reads something
    /// else than at the entry, and that is a fall too. `counts` says the exit
    /// is the function's own - not a lambda's, and of a free function.
    pub fn exit(ref mut self, mut arena: TermArena, value: ref Expr, words: ref winnow_grammar::InternerContext, scope: ref ProverScope, function: ref String?, counts: bool, params: ref collections::BTreeSet[String], ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync) {
        if self.collecting || !counts {
            return
        }
        let owner = carrying_function(function) ?? return
        let posts = standing_posts(self.postconditions, owner) ?? return
        let returned = lin_term(value, words, fn(name) { scope.ints.contains(name) }, arena.nodes)
        let mut unshadowed = true
        for p in params {
            let key = if scope.entry.contains_key(p) { p.clone() } else { length_of(p) }
            let at_entry = scope.entry[key] ?? -1
            if at_entry < 0 || !arena.is_the_variable(at_entry, key) {
                unshadowed = false
                break
            }
        }
        for index in 0..<posts.len() {
            let mut shown = false
            if unshadowed && returned != null {
                let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
                given.insert(result_name(), returned ?? 0)
                let goal = arena.substitute(posts[index].term, given)
                shown = match ask(arena, scope.facts, goal) {
                    SolverAnswer::Proved => true,
                    else => false,
                }
            }
            if !shown {
                self.broken.insert((owner.clone(), index))
            }
        }
    }


    /// Whether a claim was carried back from the call `site` to the entry
    /// of `function` in the first pass.
    fn carried_here(ref self, function: ref String?, site: ref CarriedFrom) -> bool {
        let owner = carrying_function(function) ?? return false
        let found = self.preconditions[owner] ?? return false
        for claim in found.claims {
            if claim.carried_from(site) {
                return true
            }
        }
        return false
    }

    /// **One `assert`** (ADR-269 D4-D8, D11, D15, D17): proved from what is
    /// known before it, a precondition of the function it stands in, refused
    /// as a claim about data from outside, or checked where it is reached -
    /// with the values that break it, where what is known shows them. A
    /// candidate postcondition where it stands before a `return`. `written`
    /// is the condition as the program wrote it, `names` the names it reads,
    /// `at_byte` where the statement starts.
    pub fn an_assert(ref mut self, mut arena: TermArena, words: ref winnow_grammar::InternerContext, cond: ref Expr, written: String, names: ref collections::BTreeSet[String], message: String?, span: Span, mut scope: ProverScope, at: ref ProverWhere, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> AssertOutcome {
        let mut outcome = AssertOutcome { held: ClaimHeld::ByTheTest, findings: [] }
        if self.in_test {
            return outcome
        }
        let claim = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, arena.nodes)
        let at_byte = span.start as i64
        // A claim about the value the next statement returns is a candidate
        // postcondition (D17).
        if self.collecting && at.free && !at.lambda && claim != null {
            let function = carrying_function(at.function)
            let returned = returned_before(self.before_return, at_byte)
            if function != null && returned != null {
                let term = scope.postcondition_at(arena, claim ?? 0, returned ?? "", at.params)
                if term != null {
                    let owner = function ?? ""
                    let mut posts = self.candidates.remove(owner) ?? []
                    posts.push(PostClaim { term: term ?? 0, written: written.clone() })
                    self.candidates.insert(owner, posts)
                }
            }
        }
        let mut rejected: String? = null
        if claim != null {
            match ask(arena, scope.facts, claim ?? 0) {
                SolverAnswer::Proved => {
                    scope.facts.push(claim ?? 0)
                    outcome.held = ClaimHeld::Proved
                    return outcome
                },
                SolverAnswer::Rejected(why) => {
                    rejected = why
                },
                SolverAnswer::NotProved => {},
            }
        }

        // **A claim the body cannot prove is its callers'** where it can be
        // carried back to the entry (D15): what it says about the parameters,
        // under the branches and guards on the way. At the top of the body,
        // over parameters only, that is the claim as written (D5).
        let mut only_params = !names.is_empty()
        for n in names {
            if !at.params.contains(n) {
                only_params = false
            }
        }
        // **A claim what is known rules out is not a precondition**: every
        // caller that reaches it breaks it, so it would only say *never come
        // here*. It is warned about where it stands (D8). Decided in both
        // passes alike, so the first pass's preconditions are the second's.
        let mut tainted_name: String? = null
        for n in names {
            if tainted_name == null && scope.tainted.contains(n) {
                tainted_name = n.clone()
            }
        }
        let tainted_claim = tainted_name != null
        let mut refuted: collections::BTreeMap[String, i64]? = null
        if claim != null && !tainted_claim {
            refuted = refuting_values(arena, scope.facts, claim ?? 0, ask, model)
        }
        let is_refuted = refuted != null
        let owner = carrying_function(at.function)
        if claim != null && at.no_precondition == null && owner != null && !is_refuted {
            let term = scope.precondition_at(arena, claim ?? 0, at.params)
            if term != null {
                let function = owner ?? ""
                if self.collecting {
                    let as_written = only_params && at.top
                    let mut computed: String? = null
                    if !as_written {
                        computed = arena.text(term ?? 0)
                    }
                    let pre = PreClaim { term: term ?? 0, written: written.clone(), computed: computed, message: message, origin: null, site: null }
                    let mut found = self.preconditions.remove(function) ?? Precondition::none()
                    found.claims.push(pre)
                    self.preconditions.insert(function.clone(), found)
                }
                scope.facts.push(claim ?? 0)
                outcome.held = ClaimHeld::Precondition(function, 0)
                return outcome
            }
        }

        // **A claim about data from outside is a guard's job** (D6): the one
        // claim that is refused rather than checked.
        if tainted_claim {
            outcome.held = ClaimHeld::Refused
            if self.collecting {
                return outcome
            }
            let first = tainted_name ?? ""
            outcome.findings.push(Finding {
                code: "NK1202",
                span: span,
                message: f"`{written}` is a claim about data from outside the program.",
                notes: [
                    f"`{first}` comes from outside the program, so nothing the compiler can see says what it holds.",
                    "That it is wrong is a case the program has to handle, not a defect an `assert` catches.",
                ],
                help: f"Check it where it arrives, with a guard the program handles: `throw BadInput({first}) if !({written})`, or `return … if !({written})`. After that line, this `assert` is proved.",
                warning: false,
            })
            return outcome
        }

        // **Neither proved nor refused: checked where it is reached** (D4) -
        // and where what is known before it rules the claim out, the author
        // is told, with values (D8).
        let refuted_values = refuted ?? collections::BTreeMap()
        if is_refuted && !self.collecting {
            outcome.findings.push(Finding {
                code: "NK1207",
                span: span,
                message: f"`{written}` is false every time it is reached.",
                notes: [f"What is known before it rules the claim out: {shown(refuted_values)}."],
                help: "If the claim is right, the code before it is wrong; if the code is right, the claim is.",
                warning: false,
            })
        }
        // **False for some of the values that reach it** (D8): the same
        // warning, with one such state.
        let mut sometimes: collections::BTreeMap[String, i64]? = null
        if claim != null && !is_refuted && !tainted_claim {
            sometimes = breaking_values(arena, scope, claim ?? 0, model)
        }
        let is_sometimes = sometimes != null
        let sometimes_values = sometimes ?? collections::BTreeMap()
        if is_sometimes && !self.collecting {
            outcome.findings.push(Finding {
                code: "NK1207",
                span: span,
                message: f"`{written}` is false when {shown(sometimes_values)}.",
                notes: ["That state reaches it: what is known here pins every name the claim depends on."],
                help: "If the claim is right, the code before it is wrong; if the code is right, the claim is.",
                warning: false,
            })
        }
        let mut why = "nothing before it shows it"
        if rejected != null {
            why = rejected ?? ""
        } else if is_refuted {
            why = f"it is false every time it is reached ({shown(refuted_values)})"
        } else if is_sometimes {
            why = f"it is false when {shown(sometimes_values)}"
        } else if claim == null {
            why = "it is not a comparison of whole numbers the prover reads"
        } else if only_params && at.no_precondition != null {
            let no = claim_text_of(at.no_precondition) ?? ""
            why = f"nothing before it shows it; {lowered_first(without_full_stops(no))}"
        } else if only_params && !at.top {
            why = "nothing before it shows it, and a claim about parameters is a precondition only at the top of the function's body"
        }
        outcome.held = ClaimHeld::AtRunTime(why)
        // Past a check the claim holds: the program stops where it does not.
        // Not a claim ruled out, which would make what follows vacuous.
        if claim != null && !is_refuted {
            scope.facts.push(claim ?? 0)
        }
        return outcome
    }

    /// **A call to a function with a precondition** (ADR-269 D5): each of
    /// the callee's `claims`, with this call's arguments in place of its
    /// `params`, is proved here, carried back to the caller's entry in the
    /// first pass (D15), shown broken - every time, or for a state that
    /// reaches the call (D8) - or checked by the call itself; where an
    /// argument is one the prover does not read, the call reaches the checked
    /// entry (D20). `escape` writes a name as the language below does.
    pub fn precondition_call(ref mut self, mut arena: TermArena, words: ref winnow_grammar::InternerContext, callee: ref String, params: ref Vec[String], claims: ref Vec[PreClaim], args: ref Vec[Expr], span: Span, scope: ref ProverScope, at: ref ProverWhere, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync) -> CallOutcome {
        let mut outcome = CallOutcome { reach: CallReach::Proved, findings: [] }
        for index in 0..<claims.len() {
            let pre = claims[index]
            // Each parameter's term as this call gives it, and a list's
            // length as the argument's: `p.len()` in the precondition is the
            // argument's.
            let mut given_by: collections::BTreeMap[String, i64] = collections::BTreeMap()
            let mut k = 0
            for arg in args {
                if k >= params.len() {
                    break
                }
                let param = params[k]
                let term = lin_term(arg, words, fn(name) { scope.ints.contains(name) }, arena.nodes)
                if term != null {
                    given_by.insert(param.clone(), term ?? 0)
                }
                match arg {
                    Expr::Variable(name) => {
                        let length = length_of(words.resolve(name))
                        if scope.ints.contains(length) {
                            let known = arena.var(length)
                            given_by.insert(length_of(param), known)
                        }
                    },
                    else => {},
                }
                k += 1
            }
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            arena.variables(pre.term, read)
            let mut goal: i64? = null
            if every_given(read, given_by) {
                goal = arena.substitute(pre.term, given_by)
            }
            if goal != null && is_proved(ask(arena, scope.facts, goal ?? 0)) {
                continue
            }
            let site = CarriedFrom { at: span.start as i64, callee: callee.clone(), place: index }
            if self.collecting {
                let mut carrying: String? = null
                if at.no_precondition == null {
                    carrying = carrying_function(at.function)
                }
                self.carry_back(arena, goal, pre, callee, site, scope, carrying, at.params, ask, model)
                continue
            }
            // **Carried back to this function's entry** in the first pass:
            // its callers prove it, so the call needs no check of its own.
            if self.carried_here(at.function, site) {
                continue
            }
            // **A call that breaks the precondition every time** (D8): what is
            // known at the call rules it out. The values shown are the
            // parameters', as this call gives them.
            let mut always: collections::BTreeMap[String, i64]? = null
            if goal != null {
                always = refuting_values(arena, scope.facts, goal ?? 0, ask, model)
            }
            let broken_always = always != null
            if broken_always {
                let values = always ?? collections::BTreeMap()
                let given = values_given(arena, given_by, read, values)
                let computed = claim_text_of(pre.computed)
                let mut written = pre.written.clone()
                let mut notes: Vec[String] = [f"Here {shown(given)}."]
                if computed != null {
                    written = computed ?? ""
                    let origin = claim_text_of(pre.origin)
                    if origin != null {
                        notes.push(f"The precondition is `assert({pre.written})` in `{origin ?? ""}`, carried back to `{callee}`'s entry.")
                    } else {
                        notes.push(f"The precondition is `assert({pre.written})` in `{callee}`, carried back to its entry.")
                    }
                }
                outcome.findings.push(Finding { code: "NK1207", span: span, message: f"This call breaks `{callee}`'s precondition `{written}` every time it is reached.", notes: notes, help: f"Pass `{callee}` arguments for which `{written}` holds, or check them with a guard before the call.", warning: false })
            }
            // **A call that breaks it for some of the values that reach it**
            // (D8): one such state, and what the parameters are in it.
            if !broken_always && goal != null {
                let breaking = breaking_values(arena, scope, goal ?? 0, model)
                if breaking != null {
                    let values = breaking ?? collections::BTreeMap()
                    let given = values_given(arena, given_by, read, values)
                    let computed = claim_text_of(pre.computed)
                    let has_computed = computed != null
                    let written = computed ?? pre.written.clone()
                    let mut notes: Vec[String] = [f"Then {shown(given)}."]
                    if has_computed {
                        let origin = claim_text_of(pre.origin) ?? callee.clone()
                        notes.push(f"The precondition is `assert({pre.written})` in `{origin}`.")
                    }
                    outcome.findings.push(Finding { code: "NK1207", span: span, message: f"This call breaks `{callee}`'s precondition `{written}` when {shown(values)}.", notes: notes, help: f"Pass `{callee}` arguments for which `{written}` holds, or check them with a guard before the call.", warning: false })
                }
            }
            // **Not proved: the call carries the check** (D5), with the
            // arguments in place of the parameters - where every argument is
            // one the prover reads, which also makes it pure, so evaluating it
            // once more for the check changes nothing. Where one is not, the
            // call reaches the checked entry (D20).
            let mut this_reach = CallReach::Through
            if goal != null {
                let mut operands: Vec[(String, String)] = []
                for name in read {
                    let value = given_by[name] ?? continue
                    operands.push((name.clone(), rust_text(arena, value, escape)))
                }
                let check = PreconditionCheck { rust: rust_text(arena, goal ?? 0, escape), written: pre.failure(callee), message: claim_text_of(pre.message), operands: operands }
                this_reach = CallReach::Checked([check])
            }
            outcome.reach = joined_reach(outcome.reach, this_reach)
        }
        return outcome
    }

    /// **A callee's precondition this function cannot show is its callers'**
    /// (ADR-269 D15), as an `assert` of it standing at the call would be:
    /// carried back to the entry, where that reads only the parameters.
    /// Not where what is known rules it out - that call is warned about
    /// (D8) - nor through a call that can come back to this function, nor in
    /// a test. `function` is the free function the call stands in, where a
    /// precondition may belong to it.
    pub fn carry_back(ref mut self, mut arena: TermArena, goal: i64?, pre: ref PreClaim, callee: ref String, site: CarriedFrom, scope: ref ProverScope, function: ref String?, params: ref collections::BTreeSet[String], ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) {
        let claim = goal ?? return
        let owner = carrying_function(function) ?? return
        if self.in_test || self.reaches(callee, owner) {
            return
        }
        if refuting_values(arena, scope.facts, claim, ask, model) != null {
            return
        }
        let term = scope.precondition_at(arena, claim, params) ?? return
        let carried = PreClaim {
            term: term,
            written: pre.written.clone(),
            computed: arena.text(term),
            message: claim_text_of(pre.message),
            origin: claim_text_of(pre.origin) ?? callee.clone(),
            site: site,
        }
        let mut found = self.preconditions.remove(owner) ?? Precondition::none()
        found.claims.push(carried)
        self.preconditions.insert(owner, found)
    }
}

/// **What a call's postconditions say of the name its result is bound to**
/// (ADR-269 D17): each of `posts` with the call's arguments in place of
/// `params` and `bound` in place of `result`. Computed before the name is
/// bound, so an argument that reads the name it shadows makes none; a
/// postcondition that reads a parameter no argument gives makes none either.
pub fn postconditions_for(mut arena: TermArena, posts: ref Vec[PostClaim], params: ref Vec[String], args: ref Vec[Expr], bound: ref String, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> Vec[i64] {
    let mut args_given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut k = 0
    for arg in args {
        if k >= params.len() {
            break
        }
        let param = params[k]
        let term = lin_term(arg, words, fn(name) { scope.ints.contains(name) }, arena.nodes)
        if term != null {
            args_given.insert(param.clone(), term ?? 0)
        }
        match arg {
            Expr::Variable(name) => {
                let length = length_of(words.resolve(name))
                if scope.ints.contains(length) {
                    let known = arena.var(length)
                    args_given.insert(length_of(param), known)
                }
            },
            else => {},
        }
        k += 1
    }
    let bound_length = length_of(bound)
    for (_, term) in args_given {
        if arena.mentions(term, bound) || arena.mentions(term, bound_length) {
            return []
        }
    }
    let result = arena.var(bound)
    args_given.insert(result_name(), result)
    let mut out: Vec[i64] = []
    for post in posts {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        arena.variables(post.term, read)
        if every_given(read, args_given) {
            out.push(arena.substitute(post.term, args_given))
        }
    }
    return out
}

/// Whether `args_given` gives each of `names`.
fn every_given(names: ref collections::BTreeSet[String], args_given: ref collections::BTreeMap[String, i64]) -> bool {
    for name in names {
        if !args_given.contains_key(name) {
            return false
        }
    }
    return true
}

/// A function's postconditions, as they stand now.
fn standing_posts(postconditions: ref collections::BTreeMap[String, Vec[PostClaim]], function: ref String) -> Vec[PostClaim]? {
    let posts = postconditions[function] ?? return null
    return posts.clone()
}

fn carrying_function(function: ref String?) -> String? {
    let f = function ?? return null
    return f.clone()
}

/// **Where a function body is**, for what an `assert` there may become.
pub struct ProverWhere {
    /// The free function this body is, where a precondition may belong to it.
    pub function: String?,
    /// Its whole-number parameters.
    pub params: collections::BTreeSet[String],
    /// Why a parameter claim here cannot be a precondition, if it cannot.
    pub no_precondition: String?,
    /// The function body's own statements, not a nested block.
    pub top: bool,
    /// A free function's body, called by name: what has a postcondition.
    pub free: bool,
    /// Inside a lambda, whose `return` is not the function's.
    pub lambda: bool,
    /// The function `throws`, so a call in it may leave it.
    pub throws_out: bool,
}

impl ProverWhere {
    /// The same body, one block in - in a lambda where `lambda` says so.
    pub fn inside(ref self, lambda: bool) -> ProverWhere {
        let mut at = self.clone()
        at.top = false
        at.lambda = self.lambda || lambda
        return at
    }
}

/// What one call to a function with a precondition makes: how it reaches
/// the callee, and what it was found to break.
pub struct CallOutcome {
    pub reach: CallReach,
    pub findings: Vec[Finding],
}

fn is_proved(answer: SolverAnswer) -> bool {
    return match answer {
        SolverAnswer::Proved => true,
        else => false,
    }
}

/// The values the precondition's own names - the parameters it reads, and
/// their lengths - have under `values`, as this call gives them.
fn values_given(arena: ref TermArena, given_by: ref collections::BTreeMap[String, i64], read: ref collections::BTreeSet[String], values: ref collections::BTreeMap[String, i64]) -> collections::BTreeMap[String, i64] {
    let mut out: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for (name, term) in given_by {
        if !read.contains(name) {
            continue
        }
        let value = arena.int_value(term, values) ?? continue
        out.insert(name.clone(), value)
    }
    return out
}

/// A term as the language below writes it (`prove_text.nika`'s `rust_of`),
/// each name as `escape` writes it.
fn rust_text(arena: ref TermArena, id: i64, escape: fn(ref String) -> String sync) -> String {
    return rust_of(id, fn(at) { arena.at(at) }, escape)
}

/// How one `assert` is held, and what it was found to say.
pub struct AssertOutcome {
    pub held: ClaimHeld,
    pub findings: Vec[Finding],
}

/// The name the statement after `at` returns, where an `assert` stands
/// directly before a `return name`.
fn returned_before(before_return: ref collections::BTreeMap[i64, String], at: i64) -> String? {
    let name = before_return[at] ?? return null
    return name.clone()
}

/// `text` without the full stops it ends in.
fn without_full_stops(text: ref String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut end = c.len()
    while end > 0 && c[end - 1] == '.' {
        end -= 1
    }
    let mut out: String = ""
    for k in 0..<end {
        out.push(c[k])
    }
    return out
}
