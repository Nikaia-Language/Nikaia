// crates/nikaia-std/src/tools/integers.nika
//
// **An integer while the program is built** - a magnitude and a sign, the
// shape the tree gives a literal and the fold counts in (ADR-294 D11) - and
// what the build-time evaluator does with two of them (ADR-287, ADR-285).
//
// A literal is as large as a `u64` holds and as small as an `i64` (ADR-285
// D19), so 65 bits carry every one. A step whose answer leaves them is not
// wrapped: it has no answer here, and the evaluator says it cannot evaluate
// the expression rather than inventing a number.

/// An integer: `magnitude` with a sign. Zero is never negative.
pub struct Integer {
    pub magnitude: u64,
    pub negative: bool,
}

/// An integer from its magnitude and sign, with zero made positive.
pub fn integer(magnitude: u64, negative: bool) -> Integer {
    return Integer { magnitude: magnitude, negative: negative && magnitude != 0 }
}

/// An integer that is a count: a length, an index.
pub fn integer_of_count(n: i64) -> Integer {
    if n < 0 {
        return integer((0 - (n + 1)) as u64 + 1, true)
    }
    return integer(n as u64, false)
}

/// The number as a count, where it is one an `i64` holds (ADR-315). A
/// negative one is counted down from `-1`, so the most negative `i64`, whose
/// magnitude no `i64` holds, is one too.
pub fn integer_as_count(n: ref Integer) -> i64? {
    if !n.negative {
        return n.magnitude.checked_i64()
    }
    let below = (n.magnitude - 1).checked_i64() ?? return null
    return -1 - below
}

/// The number written out, `-` in front where it is negative.
pub fn integer_text(n: ref Integer) -> String {
    if n.negative {
        return f"-{n.magnitude}"
    }
    return f"{n.magnitude}"
}

/// `-n`.
pub fn integer_negated(n: ref Integer) -> Integer {
    return integer(n.magnitude, !n.negative)
}

/// `a + b`, counted in magnitudes: the same sign adds, different signs take
/// the smaller from the larger and keep the larger's sign.
pub fn integer_sum(a: ref Integer, b: ref Integer) -> Integer? {
    if a.negative == b.negative {
        let sum = a.magnitude.checked_add(b.magnitude) ?? return null
        return integer(sum, a.negative)
    }
    if a.magnitude >= b.magnitude {
        return integer(a.magnitude - b.magnitude, a.negative)
    }
    return integer(b.magnitude - a.magnitude, b.negative)
}

/// `a - b`.
pub fn integer_difference(a: ref Integer, b: ref Integer) -> Integer? {
    return integer_sum(a, integer_negated(b))
}

/// `a * b`: the magnitudes multiply, and the signs differ or agree.
pub fn integer_product(a: ref Integer, b: ref Integer) -> Integer? {
    let product = a.magnitude.checked_mul(b.magnitude) ?? return null
    return integer(product, a.negative != b.negative)
}

/// `a / b`, toward zero, and `a % b`, which takes the sign of `a`. Nothing
/// for a division by zero, which the magnitudes' own `checked_` names say.
pub fn integer_quotient(a: ref Integer, b: ref Integer, remainder: bool) -> Integer? {
    if remainder {
        let left = a.magnitude.checked_rem(b.magnitude) ?? return null
        return integer(left, a.negative)
    }
    let quotient = a.magnitude.checked_div(b.magnitude) ?? return null
    return integer(quotient, a.negative != b.negative)
}

/// `a` against `b`: -1 below, 0 equal, 1 above.
pub fn integer_order(a: ref Integer, b: ref Integer) -> i64 {
    if a.negative != b.negative {
        return if a.negative { -1 } else { 1 }
    }
    if a.magnitude == b.magnitude {
        return 0
    }
    let larger = a.magnitude > b.magnitude
    if larger != a.negative {
        return 1
    }
    return -1
}

/// **The bit operators, on the bits the value has** (ADR-285 D9): two
/// numbers that are not negative are their `u64` bits, and two an `i64` holds
/// are its two's complement. A mix of the two shapes has no answer here.
pub fn integer_bits(a: ref Integer, b: ref Integer, op: ref String) -> Integer? {
    if !a.negative && !b.negative {
        let x = a.magnitude
        let y = b.magnitude
        if op == "&" {
            return integer(x & y, false)
        }
        if op == "|" {
            return integer(x | y, false)
        }
        return integer(x ^ y, false)
    }
    let x = integer_as_count(a) ?? return null
    let y = integer_as_count(b) ?? return null
    if op == "&" {
        return integer_of_count(x & y)
    }
    if op == "|" {
        return integer_of_count(x | y)
    }
    return integer_of_count(x ^ y)
}

/// `a << b` and `a >> b`: a count outside the width is not evaluated (D5), a
/// left shift whose answer leaves 64 bits has none, and a right shift of a
/// negative number rounds down as its two's complement does.
pub fn integer_shifted(a: ref Integer, b: ref Integer, left: bool) -> Integer? {
    if b.negative || b.magnitude >= 64 {
        return null
    }
    let count = b.magnitude as i64
    if left {
        let mut magnitude = a.magnitude
        for _ in 0..<count {
            magnitude = magnitude.checked_mul(2) ?? return null
        }
        return integer(magnitude, a.negative)
    }
    if !a.negative {
        let mut magnitude = a.magnitude
        for _ in 0..<count {
            magnitude /= 2
        }
        return integer(magnitude, false)
    }
    let mut value = integer_as_count(a) ?? return null
    for _ in 0..<count {
        // Toward negative infinity, as an arithmetic shift is.
        if value % 2 != 0 {
            value = (value - 1) / 2
        } else {
            value /= 2
        }
    }
    return integer_of_count(value)
}
