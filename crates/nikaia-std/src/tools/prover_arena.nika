// crates/nikaia-std/src/tools/prover_arena.nika
//
// **The prover's terms, held in Nikaia** (ADR-270 D2, ADR-294, #436 step 4):
// an arena of `SolverTerm` nodes, each child named by its place, with the
// operations the prover's walk uses - the same ones, with the same results,
// as `nikaia-logic`'s `Arena`. A term never changes once built; what
// `substitute` makes is new nodes, as there.
//
// The solver still reads `nikaia-logic`'s arena: a question is handed over
// with the nodes it reads (`prover.nika`'s `ask`), so the two hold the same
// terms in the same order.

use std::collections

/// The terms of one walk. Appended to, never changed.
pub struct TermArena {
    pub nodes: Vec[SolverTerm],
}

impl TermArena {
    pub fn empty() -> TermArena {
        return TermArena { nodes: [] }
    }

    fn push(ref mut self, node: SolverTerm) -> i64 {
        self.nodes.push(node)
        return self.nodes.len() - 1
    }

    pub fn at(ref self, id: i64) -> SolverTerm {
        return self.nodes[id].clone()
    }

    pub fn boolean(ref mut self, value: bool) -> i64 {
        return self.push(SolverTerm::Bool(value))
    }

    pub fn int(ref mut self, value: i64) -> i64 {
        return self.push(SolverTerm::Int(value))
    }

    pub fn var(ref mut self, name: ref String) -> i64 {
        return self.push(SolverTerm::Var(name.clone()))
    }

    pub fn add(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Add(a, b))
    }

    pub fn sub(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Sub(a, b))
    }

    pub fn neg(ref mut self, a: i64) -> i64 {
        return self.push(SolverTerm::Neg(a))
    }

    pub fn mul(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Mul(a, b))
    }

    pub fn le(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Le(a, b))
    }

    pub fn lt(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Lt(a, b))
    }

    pub fn ge(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Ge(a, b))
    }

    pub fn gt(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Gt(a, b))
    }

    pub fn equal(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Eq(a, b))
    }

    pub fn unequal(ref mut self, a: i64, b: i64) -> i64 {
        return self.push(SolverTerm::Ne(a, b))
    }

    pub fn and(ref mut self, parts: Vec[i64]) -> i64 {
        return self.push(SolverTerm::And(parts))
    }

    pub fn or(ref mut self, parts: Vec[i64]) -> i64 {
        return self.push(SolverTerm::Or(parts))
    }

    pub fn not(ref mut self, a: i64) -> i64 {
        return self.push(SolverTerm::Not(a))
    }

    /// Whether `id` reads the variable `name`.
    pub fn mentions(ref self, id: i64, name: ref String) -> bool {
        return match self.nodes[id] {
            SolverTerm::Var(n) => n == name,
            SolverTerm::Neg(a) => self.mentions(a, name),
            SolverTerm::Not(a) => self.mentions(a, name),
            SolverTerm::Add(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Sub(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Mul(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Le(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Lt(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Ge(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Gt(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Eq(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Ne(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::And(parts) => self.any_mentions(parts, name),
            SolverTerm::Or(parts) => self.any_mentions(parts, name),
            else => false,
        }
    }

    fn any_mentions(ref self, parts: ref Vec[i64], name: ref String) -> bool {
        for part in parts {
            if self.mentions(part, name) {
                return true
            }
        }
        return false
    }

    /// Every variable `id` reads, added to `names`.
    pub fn variables(ref self, id: i64, mut names: collections::BTreeSet[String]) {
        match self.nodes[id] {
            SolverTerm::Var(name) => {
                names.insert(name.clone())
            },
            SolverTerm::Neg(a) => self.variables(a, names),
            SolverTerm::Not(a) => self.variables(a, names),
            SolverTerm::Add(a, b) => self.both_variables(a, b, names),
            SolverTerm::Sub(a, b) => self.both_variables(a, b, names),
            SolverTerm::Mul(a, b) => self.both_variables(a, b, names),
            SolverTerm::Le(a, b) => self.both_variables(a, b, names),
            SolverTerm::Lt(a, b) => self.both_variables(a, b, names),
            SolverTerm::Ge(a, b) => self.both_variables(a, b, names),
            SolverTerm::Gt(a, b) => self.both_variables(a, b, names),
            SolverTerm::Eq(a, b) => self.both_variables(a, b, names),
            SolverTerm::Ne(a, b) => self.both_variables(a, b, names),
            SolverTerm::And(parts) => {
                for part in parts {
                    self.variables(part, names)
                }
            },
            SolverTerm::Or(parts) => {
                for part in parts {
                    self.variables(part, names)
                }
            },
            else => {},
        }
    }

    fn both_variables(ref self, a: i64, b: i64, mut names: collections::BTreeSet[String]) {
        self.variables(a, names)
        self.variables(b, names)
    }

    /// The value of an integer term that reads no variable, where it fits.
    pub fn constant(ref self, id: i64) -> i64? {
        return match self.nodes[id] {
            SolverTerm::Int(n) => n,
            SolverTerm::Neg(a) => {
                let v = self.constant(a) ?? return null
                v.checked_neg()
            },
            SolverTerm::Add(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_add(y)
            },
            SolverTerm::Sub(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_sub(y)
            },
            SolverTerm::Mul(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_mul(y)
            },
            else => null,
        }
    }

    /// An integer term's value under `values`, where it has one: every
    /// variable it reads is given, and nothing leaves `i64`.
    pub fn int_value(ref self, id: i64, values: ref collections::BTreeMap[String, i64]) -> i64? {
        return match self.nodes[id] {
            SolverTerm::Int(n) => n,
            // `contains_key` and the brackets rather than `?? return`, until
            // #456's first lowering copies.
            SolverTerm::Var(name) => {
                if !values.contains_key(name) {
                    return null
                }
                let found: i64 = values[name] ?? 0
                found
            },
            SolverTerm::Neg(a) => {
                let v = self.int_value(a, values) ?? return null
                v.checked_neg()
            },
            SolverTerm::Add(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_add(y)
            },
            SolverTerm::Sub(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_sub(y)
            },
            SolverTerm::Mul(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_mul(y)
            },
            else => null,
        }
    }

    /// **`id` with each variable `given` names replaced by its term**; a
    /// variable it does not name stays. Built anew at every node that is not
    /// a leaf, changed or not, as `nikaia-logic`'s arena builds it.
    pub fn substitute(ref mut self, id: i64, given: ref collections::BTreeMap[String, i64]) -> i64 {
        let node = self.nodes[id].clone()
        return match node {
            // A block arm, until #456's second lowering lends once.
            SolverTerm::Var(name) => {
                let found = given.get(name) ?? id
                found
            },
            SolverTerm::Bool(_) => id,
            SolverTerm::Int(_) => id,
            SolverTerm::Neg(a) => {
                let x = self.substitute(a, given)
                self.push(SolverTerm::Neg(x))
            },
            SolverTerm::Not(a) => {
                let x = self.substitute(a, given)
                self.push(SolverTerm::Not(x))
            },
            SolverTerm::Add(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Add(x, y))
            },
            SolverTerm::Sub(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Sub(x, y))
            },
            SolverTerm::Mul(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Mul(x, y))
            },
            SolverTerm::Le(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Le(x, y))
            },
            SolverTerm::Lt(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Lt(x, y))
            },
            SolverTerm::Ge(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Ge(x, y))
            },
            SolverTerm::Gt(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Gt(x, y))
            },
            SolverTerm::Eq(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Eq(x, y))
            },
            SolverTerm::Ne(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Ne(x, y))
            },
            SolverTerm::And(parts) => {
                let mut changed: Vec[i64] = []
                for part in parts {
                    changed.push(self.substitute(part, given))
                }
                self.push(SolverTerm::And(changed))
            },
            SolverTerm::Or(parts) => {
                let mut changed: Vec[i64] = []
                for part in parts {
                    changed.push(self.substitute(part, given))
                }
                self.push(SolverTerm::Or(changed))
            },
            else => id,
        }
    }

    /// How many terms `id` is made of, counting a shared one each time.
    pub fn size(ref self, id: i64) -> i64 {
        return 1 + match self.nodes[id] {
            SolverTerm::Neg(a) => self.size(a),
            SolverTerm::Not(a) => self.size(a),
            SolverTerm::Add(a, b) => self.size(a) + self.size(b),
            SolverTerm::Sub(a, b) => self.size(a) + self.size(b),
            SolverTerm::Mul(a, b) => self.size(a) + self.size(b),
            SolverTerm::Le(a, b) => self.size(a) + self.size(b),
            SolverTerm::Lt(a, b) => self.size(a) + self.size(b),
            SolverTerm::Ge(a, b) => self.size(a) + self.size(b),
            SolverTerm::Gt(a, b) => self.size(a) + self.size(b),
            SolverTerm::Eq(a, b) => self.size(a) + self.size(b),
            SolverTerm::Ne(a, b) => self.size(a) + self.size(b),
            SolverTerm::And(parts) => self.parts_size(parts),
            SolverTerm::Or(parts) => self.parts_size(parts),
            else => 0,
        }
    }

    fn parts_size(ref self, parts: ref Vec[i64]) -> i64 {
        let mut total = 0
        for part in parts {
            total += self.size(part)
        }
        return total
    }

    /// Whether `id` is the variable `name` itself.
    pub fn is_the_variable(ref self, id: i64, name: ref String) -> bool {
        return match self.nodes[id] {
            SolverTerm::Var(n) => n == name,
            else => false,
        }
    }
}
