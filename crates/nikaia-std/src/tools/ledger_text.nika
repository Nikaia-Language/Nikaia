// crates/nikaia-std/src/tools/ledger_text.nika
//
// **A ledger as it is written out** (Part III 13.5) - `nikaia.contracts`,
// the record beside it of what it was derived from (ADR-251 D1), and a
// description of a foreign crate's boundary (ADR-290 D5) - moved from the
// compiler's `contracts` module (ADR-294, #125). `ledger.nika` reads the same
// format back, so the two halves of one file format stand side by side.
//
// Only what is *true* is recorded: a `sync = false` on every entry would
// treble the file and say nothing, and a diff should show a promise being made
// or withdrawn rather than a column of falses.

use std::collections

/// The file, as it is written out: the header that says not to edit it, and
/// the contract.
pub fn ledger_text(ledger: ref Ledger) -> String {
    let mut out: String = ""
    out.push_str("# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.\n")
    out.push_str("# Do not edit by hand - it is regenerated on every build.\n")
    out.push_str("#\n")
    out.push_str("# What a caller has to know about a function it cannot see the body of:\n")
    out.push_str("# whether it may pause (`sync`), whether it may fail and with what\n")
    out.push_str("# (`throws`), and what its result may point into (`returns`). Part III, 13.5.\n")
    out.push_str("#\n")
    out.push_str("# A `\"?\"` among the errors is the absence of a claim: it fails, with\n")
    out.push_str("# something this compiler cannot name.\n")
    out.push_str(contract_text(ledger, no_notes()))
    return out
}

/// **What the contract beside it was derived from** (ADR-251 D1): the
/// compiler, the inference, and the SHA-256 of every source it read. It
/// decides whether a consumer may believe the contract (ADR-100 D3) and never
/// what the contract says, which is why it is a file of its own.
pub fn derived_text(ledger: ref Ledger) -> String {
    let mut out: String = ""
    out.push_str("# AUTO-GENERATED by `nikaia`, beside the contract it describes.\n")
    out.push_str("# What that contract was derived from: the compiler, the inference and\n")
    out.push_str("# the sources. A consumer believes the contract while the sources hash\n")
    out.push_str("# as recorded here. Part III, 13.5.\n")
    out.push_str(f"version = {ledger.version}\n")
    out.push_str(f"toolchain = \"{ledger.toolchain}\"\n")
    out.push_str(f"inference = \"{ledger.inference}\"\n")
    if ledger.sources.len() > 0 {
        out.push_str("\n[sources]\n")
        for (unit, hash) in ledger.sources {
            out.push_str(f"\"{unit}\" = \"{hash}\"\n")
        }
    }
    return out
}

/// The same file under a **description's** header (ADR-290 D5): written once,
/// **reviewed like code**, and hand-edited where a signature could not say
/// what a field does - so the header says that, where `ledger_text`'s says not
/// to edit it.
pub fn description_text(ledger: ref Ledger, crate_name: ref String, version: ref String, notes: ref Notes) -> String {
    let mut out: String = ""
    out.push_str(f"# The boundary of `{crate_name}`, described before it is called\n")
    out.push_str("# ([ADR-290](../../docs/specification/adr/adr-290.md) D2).\n")
    out.push_str("#\n")
    out.push_str(f"# Written by `nikaia describe {crate_name}` from the crate's `pub` signatures,\n")
    out.push_str("# translated by Part III 15.2's table. **Committed and reviewed like code**,\n")
    out.push_str("# and a hand edit is expected: what a signature cannot say is written\n")
    out.push_str("# fail-closed, and what it says wrongly is caught by the reviewer or by\n")
    out.push_str("# nobody (D5).\n")
    out.push_str("#\n")
    out.push_str("# What the signatures do not say: no `touches` on any entry, which reads as\n")
    out.push_str("# *touches everything*; no `locks`, which is that column's third answer.\n")
    out.push_str("# Neither is something a Rust signature can tell anybody, and reading\n")
    out.push_str("# silence as nothing at all is the polarity ADR-010 D1 forbids.\n")
    out.push_str("#\n")
    out.push_str(f"# crate: {crate_name} {version}\n")
    // **What the describer saw and did not claim** (ADR-290 D8, D10), before
    // the entries because it is about the crate rather than one of them.
    if notes.about_the_crate.len() > 0 {
        out.push_str("#\n")
        for line in notes.about_the_crate {
            out.push_str(f"# {line}\n")
        }
    }
    out.push_str(contract_text(ledger, notes))
    return out
}

fn no_notes() -> Notes {
    return Notes { about_the_crate: [], about_a_function: collections::BTreeMap() }
}

/// The `throws` list exactly as the ledger writes it: a diagnostic quoting
/// the contract quotes the bytes a reader finds in `nikaia.contracts`, which
/// is Part III C.4's rule that **the note is the contract**.
pub fn throws_text(errors: ref Vec[String]) -> String {
    return f"[{quoted_all(errors)}]"
}

/// Each, in quotes, joined by commas.
fn quoted_all(items: ref Vec[String]) -> String {
    let mut out: String = ""
    for item in items {
        if out.len() > 0 {
            out.push_str(", ")
        }
        out.push_str(f"\"{item}\"")
    }
    return out
}

/// ADR-307 D5's one demand on this format: a doc comment holds its line
/// breaks and the file is read a line at a time.
fn ledger_escaped(value: ref String) -> String {
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
}

/// The header line and everything after it, with the describer's notes
/// spliced above the entries they are about.
///
/// **A note is a comment and not a column** (ADR-290 D3): what the describer
/// saw does not *entail* an answer, so writing it as a claim could refuse a
/// correct program. It is never parsed back.
pub fn contract_text(ledger: ref Ledger, notes: ref Notes) -> String {
    // **The contract and nothing it was derived from** (ADR-251 D1): which
    // compiler wrote it, by which inference, from which sources, is
    // `derived_text`'s file beside this one.
    let mut out = f"version = {ledger.version}\n"
    for (name, contract) in ledger.functions {
        out.push('\n')
        let about: Vec[String] = notes.about_a_function[name]?.clone() ?? []
        for line in about {
            out.push_str(f"# {line}\n")
        }
        out.push_str(f"[fn.\"{name}\"]\n")
        out.push_str(function_text(name, contract))
    }
    // **A trait a package publishes** (ADR-295 D3): the one word a checker
    // needs - *this name is a trait*. Its methods are the `fn` entries above.
    for (name, _) in ledger.traits {
        out.push_str(f"\n[trait.\"{name}\"]\n")
    }
    // **And each `impl`, in the ledger of the package that wrote it**
    // (ADR-295 D13): each ledger says only what it wrote.
    for (trait_name, types) in ledger.implementations {
        for ty in types {
            out.push_str(f"\n[impl.\"{trait_name} for {ty}\"]\n")
        }
    }
    for (name, contract) in ledger.types {
        out.push_str(f"\n[type.\"{name}\"]\n")
        out.push_str(type_text(contract))
    }
    return out
}

fn function_text(name: ref String, contract: ref FnContract) -> String {
    let mut out: String = ""
    if contract.public {
        out.push_str("pub = true\n")
    }
    // `true` is the promise the source made, `"inferred"` the one the body
    // implies, and `sync(f)` the source's own word (ADR-288 D4). Absent is
    // "not `sync`".
    match contract.sync_claim {
        Sync::Asserted => out.push_str("sync = true\n"),
        Sync::Inferred => out.push_str("sync = \"inferred\"\n"),
        // The checker's reading of an `"inferred"` from another package
        // (ADR-288 D28), not meant to be written; where it is, it is still
        // that fact.
        Sync::Unpromised => out.push_str("sync = \"inferred\"\n"),
        Sync::From(lambda) => out.push_str(f"sync = \"sync({lambda})\"\n"),
        Sync::No => {}
    }
    if contract.fails_with.len() > 0 {
        out.push_str(f"throws = {throws_text(contract.fails_with)}\n")
    }
    // **In Nikaia's spelling** (ADR-251 D4): what the result points into is
    // written `ref(a | b)` in the signature's result, and the receiver as the
    // source writes it. `returns` and `mutates` are written only where the
    // signature has no place for them.
    let spelled = spelled_of(name, contract)
    let mut borrows_said = false
    let mut mutates_said = false
    let mut signature_line: String = ""
    if spelled != null {
        let said = spelled ?? return out
        borrows_said = said.borrows_said
        mutates_said = said.mutates_said
        signature_line = f"signature = \"{ledger_escaped(said.text)}\"\n"
    }
    if contract.borrows.len() > 0 && !borrows_said {
        out.push_str(f"returns = \"ref({contract.borrows.join(" | ")})\"\n")
    }
    // Beside `returns`, the other thing a caller reads off a signature about
    // where a value goes (ADR-094 D2).
    if contract.keeps.len() > 0 {
        out.push_str(f"keeps = [{quoted_all(contract.keeps)}]\n")
    }
    // Beside `keeps`: the two together are what a caller has to know before
    // it may hand a name over rather than lend it (ADR-094 D3).
    if contract.mutates && !mutates_said {
        out.push_str("mutates = true\n")
    }
    // Beside `touches`, the other column about what a body reaches
    // (ADR-281 D29). `"?"` is the absence of a claim.
    match contract.touches_a_lock {
        Lock::No => {}
        Lock::Holds => out.push_str("locks = true\n"),
        Lock::Undecided => out.push_str("locks = \"?\"\n"),
    }
    // Claims about what a body does that no signature shows (ADR-290 D6).
    match contract.threads {
        Threads::Undecided => {}
        Threads::May => out.push_str("threads = true\n"),
        Threads::MayNot => out.push_str("threads = false\n"),
    }
    if contract.touches_known {
        let mut touched: Vec[String] = []
        for touch in contract.touches {
            touched.push(touch.text())
        }
        out.push_str(f"touches = [{quoted_all(touched)}]\n")
    }
    if contract.provenance != null {
        let provenance = contract.provenance?.clone() ?? return out
        out.push_str(f"provenance = \"{provenance.as_str()}\"\n")
    }
    if contract.views.len() > 0 {
        let mut views: Vec[String] = []
        for held in contract.views {
            views.push(held.text())
        }
        out.push_str(f"views = [{quoted_all(views)}]\n")
    }
    if contract.sharing.len() > 0 {
        let mut classes: Vec[String] = []
        for class in contract.sharing {
            classes.push(class.text())
        }
        out.push_str(f"sharing = [{quoted_all(classes)}]\n")
    }
    if contract.ends_by_length {
        out.push_str("ends_by_length = true\n")
    }
    if contract.pieces {
        out.push_str("pieces = true\n")
    }
    // **The function's contract from its `assert`s** (ADR-269 D18): what a
    // caller establishes, what it may rely on, and the `assert` each came
    // from.
    out.push_str(claims_text("requires", contract.requires))
    out.push_str(claims_text("ensures", contract.ensures))
    out.push_str(claims_text("from", contract.from))
    out.push_str(signature_line)
    return out
}

fn spelled_of(name: ref String, contract: ref FnContract) -> Spelled? {
    let signature = contract.signature ?? return null
    return spell(signature.text(), name, contract.borrows, contract.mutates)
}

fn claims_text(key: ref String, claims: ref Vec[String]) -> String {
    if claims.len() == 0 {
        return ""
    }
    let mut escaped: Vec[String] = []
    for claim in claims {
        escaped.push(ledger_escaped(claim))
    }
    return f"{key} = [{quoted_all(escaped)}]\n"
}

fn type_text(contract: ref TypeContract) -> String {
    let mut out: String = ""
    if contract.public {
        out.push_str("pub = true\n")
    }
    if contract.fields.len() > 0 {
        // `pub ` in front, where it is - the same word the source writes, so
        // the line reads as the declaration it came from.
        let mut fields: Vec[String] = []
        for field in contract.fields {
            let word = if field.public { "pub " } else { "" }
            // `= value` after the type, where the field has a default
            // (ADR-331 D8): escaped, as text in a signature is.
            let default = if field.default.len() > 0 { f" = {field.default}" } else { "" }
            fields.push(ledger_escaped(f"{word}{field.name}: {field.ty.text()}{default}"))
        }
        out.push_str(f"fields = [{quoted_all(fields)}]\n")
        // **Each field's attributes**, as the values they came to
        // (ADR-331 D8), under the field's name.
        let mut attributes: Vec[String] = []
        for field in contract.fields {
            for attribute in field.attributes {
                attributes.push(ledger_escaped(f"{field.name}: {attribute}"))
            }
        }
        if attributes.len() > 0 {
            out.push_str(f"field_attributes = [{quoted_all(attributes)}]\n")
        }
    }
    // **The other shape of type**: an `enum`'s cases, which is what lets a
    // consumer's `match` be total (Part I 3.4).
    if contract.variants.len() > 0 {
        let mut variants: Vec[String] = []
        for variant in contract.variants {
            variants.push(variant.text())
        }
        out.push_str(f"variants = [{quoted_all(variants)}]\n")
    }
    // Both claims are written and the third is silence, which is what makes
    // every ledger already on disk mean what it meant (ADR-123 D1).
    match contract.crosses {
        Crosses::May => out.push_str("crosses = true\n"),
        Crosses::MayNot => out.push_str("crosses = false\n"),
        Crosses::Undecided => {}
    }
    if contract.compares {
        out.push_str("compares = true\n")
    }
    if contract.copies {
        out.push_str("copies = true\n")
    }
    if contract.iterates_fallibly {
        out.push_str("iterates = \"throws\"\n")
    }
    if contract.touches.len() > 0 {
        out.push_str(f"touches = [{quoted_all(contract.touches)}]\n")
    }
    if contract.tethered.len() > 0 {
        out.push_str(f"tethered = [{quoted_all(contract.tethered)}]\n")
    }
    if contract.mark.len() > 0 {
        out.push_str(f"attribute = \"{contract.mark}\"\n")
    }
    if contract.constant.len() > 0 {
        out.push_str(f"constant = \"{contract.constant}\"\n")
    }
    return out
}
