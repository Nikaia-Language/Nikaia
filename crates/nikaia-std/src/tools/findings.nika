// crates/nikaia-std/src/tools/findings.nika
//
// **What a check written in Nikaia hands back** (ADR-250, ADR-261): one
// finding, in the shape Part III C.2 gives every diagnostic - a code, the
// statement it is about, a headline, the notes that say why, and one way out.
// The compiler's `check::Finding` is built from it at one place
// (`check::from_nikaia`), so a check that moves to Nikaia says exactly what it
// said in Rust.

/// One diagnostic. `warning` is the one severity that does not stop the build
/// (`NK1111`, `NK2211`); everything else is a refusal.
pub struct Finding {
    pub code: String,
    pub span: Span,
    pub message: String,
    pub notes: Vec[String],
    pub help: String?,
    pub warning: bool,
}

/// A refusal at `span`.
pub fn refusal(code: ref String, span: Span, message: String, notes: Vec[String], help: String) -> Finding {
    return Finding { code: code.clone(), span: span, message: message, notes: notes, help: help, warning: false }
}
