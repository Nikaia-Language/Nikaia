// crates/nikaia-std/src/tools/proofs_book.nika
//
// **`nikaia.proofs`, the file** (ADR-270 D4, D19-D21, #448): the text a book of
// the prover's answers is written as and read back from - one line per key a
// question asked, sorted by key, so that two branches that add entries merge
// without a conflict. Moved from the compiler's `proofs` (ADR-294, #125); the
// files, the thread's book and the check of an entry stay Rust.

use std::collections

/// One line of the file: the key, what kind of answer, and its body.
pub struct PbLine {
    pub key: String,
    pub kind: String,
    pub body: String,
}

/// The lines of a file that read. A line that does not is left out: it is
/// missing, and missing is searched (D20). `long` gives the certificate kept
/// under a key of its own, where a line says `@` for it.
pub fn pb_read(text: ref String, long: fn(ref String) -> String? sync) -> Vec[PbLine] {
    let mut out: Vec[PbLine] = []
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len() == 0 {
            continue
        }
        let words: Vec[ref String] = line.split(" ").collect()
        if words.len() != 3 {
            continue
        }
        let key = words[0].clone()
        let kind = words[1].clone()
        let body = words[2].clone()
        if kind == "proved" && body == "@" {
            let held = long(key) ?? continue
            out.push(PbLine { key: key, kind: kind, body: held.trim().clone() })
        } else if kind == "proved" || kind == "refuted" || kind == "unknown" {
            out.push(PbLine { key: key, kind: kind, body: body })
        }
    }
    return out
}

/// The file as a build leaves it, and the certificates too long to stand in it.
pub struct PbRendered {
    pub text: String,
    pub long: collections::BTreeMap[String, String],
}

/// **The file as this build leaves it**: one line per entry given, which are the
/// keys a question asked, sorted by key (D19, D21). A certificate longer than
/// `limit` bytes is kept under its key, and the line says `@` for it.
pub fn pb_render(entries: ref Vec[PbLine], limit: i64) -> PbRendered {
    let mut out: String = "# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.\n# The prover's answers, one per question it asks: the SHA-256 of the\n# question in normal form, and `proved` with its certificate,\n# `refuted` with its model, or `unknown` with the solver that gave up.\n# Every entry is checked when it is read; a wrong one is searched again.\n"
    let mut long: collections::BTreeMap[String, String] = collections::BTreeMap()
    for entry in entries {
        if entry.kind == "proved" && entry.body.len() > limit {
            long.insert(entry.key.clone(), entry.body.clone())
            out.push_str(f"{entry.key} proved @\n")
        } else {
            out.push_str(f"{entry.key} {entry.kind} {entry.body}\n")
        }
    }
    return PbRendered { text: out, long: long }
}
