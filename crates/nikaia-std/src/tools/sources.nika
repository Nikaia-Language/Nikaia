// crates/nikaia-std/src/tools/sources.nika
//
// **The files `nikaia describe` reads a crate from** (ADR-290 D14, ADR-290 D19):
// every `.rs` under the crate's `src`, with its text.
//
// The walk the Rust half did with `std::fs::read_dir` and a recursion, moved to
// Nikaia once `fs` had a walk of its own (0.0.307). Lowered by
// `nikaia lower-std` to `sources.rs` beside it, `include!`d as
// `nikaia_std::tools::sources`, and called from the compiler's `describe`.
//
// **`fs::Root::Anywhere`, and on purpose**: the directory is the one the
// operator named as the crate's `path` in `nikaia.toml`, and the describer
// reads what that crate is made of. A `src` that links a module in from
// elsewhere is still that crate's source, which is what `Anywhere` says - the
// program answers for the name, and here the name is the manifest's.

use std::fs
use std::collections

/// The `.rs` files under a crate's `src`, each with its text, keyed by its
/// name in the crate: `src/<path under src>`, `/` between the parts.
///
/// A directory under `src` that cannot be read is left out, as the walk leaves
/// it out; a file that cannot be read, or is not UTF-8, is the failure, named.
pub fn rust_sources(src: ref String) -> collections::BTreeMap[String, String] throws {
    let mut out = collections::BTreeMap()
    for name in fs::walk(src, fs::Root::Anywhere) {
        if !name.ends_with(".rs") { continue }
        let text = fs::read_to_string(f"{src}/{name}", fs::Root::Anywhere)
        out.insert(f"src/{name}", text)
    }
    return out
}

/// **The `.nika` files of a project**, each with its text, keyed by its name
/// under `root`, `/` between the parts: what `nikaia describe` reads for the
/// names a program writes of a crate (ADR-290 D2).
///
/// A file under a directory called `target` or `contracts` is left out, at
/// any depth: `target` is the build's own and holds nothing a program wrote,
/// and `contracts` holds the describer's own output. A file that cannot be
/// read, or is not UTF-8, is left out too - a program the build cannot read is
/// the build's to report, and the same message twice helps nobody.
///
/// `fs::Root::Anywhere` for `rust_sources`' reason: the root is the project
/// the operator ran the command in.
pub fn program_sources(root: ref String) -> collections::BTreeMap[String, String] throws {
    let mut out = collections::BTreeMap()
    for name in fs::walk(root, fs::Root::Anywhere) {
        if !name.ends_with(".nika") || under_output(name) { continue }
        let text = fs::read_to_string(f"{root}/{name}", fs::Root::Anywhere) catch { continue }
        out.insert(name, text)
    }
    return out
}

// Whether a name passes through a directory a build or the describer writes.
fn under_output(name: ref String) -> bool {
    for part in name.split("/") {
        if part == "target" || part == "contracts" {
            return true
        }
    }
    return false
}
