// crates/nikaia-std/src/tools/sharing.nika
//
// **Which reference count a particular `Shared` value gets** (ADR-037 D7):
// the records, the `--sharing` report and the leaf questions of the
// compiler's `contracts::sharing`, moved from Rust (ADR-294, #125). What
// stays Rust for now is the union-find walk that joins handles into
// allocation classes and decides each one.
//
// One rule, and everything is downstream of it: **it may only ever take an
// atomic away.** The atomic count is the floor (ADR-037 D6, lowered to the
// plain one at `user_parallelism = no` by ADR-061 D2); a value may be lowered
// to a plain count only where the analysis *proves* nothing crosses a thread
// with it, and every case it cannot decide stays atomic with a reason from a
// **closed list** - `Fallback`, the enumeration ADR-037 D8 answers "would an
// override help?" for.

use std::collections

/// Every reason the analysis answers `atomic` **because nothing decided
/// it**. A row added here is a row ADR-037 D8 has to answer.
pub enum Fallback {
    /// A parameter or the result of a **public** function: its callers are in
    /// a unit this build never reads.
    PublicSignature,
    /// Held by a **public field of a public type**, which code this build
    /// never reads may take out of it.
    PublicField,
    /// Handed to a **call** nothing written down describes.
    UnseenCall,
    /// Handed to a **method** nothing written down describes.
    UnseenMethod,
    /// Handed over in an **argument position** no contract covers.
    UncoveredArgument,
    /// A handle whose allocation this analysis did not watch being made.
    UnseenOrigin,
    /// A slot **another file of this package** owns: each file's run sees
    /// only half of it, so neither may lower it.
    ForeignFile,
}

impl Fallback {
    pub fn as_str(ref self) -> String {
        return match self {
            Fallback::PublicSignature => "a public signature",
            Fallback::PublicField => "a public field",
            Fallback::UnseenCall => "a call nothing describes",
            Fallback::UnseenMethod => "a method nothing describes",
            Fallback::UncoveredArgument => "an argument position no contract covers",
            Fallback::UnseenOrigin => "an origin this analysis cannot see",
            Fallback::ForeignFile => "a slot another file owns",
        }
    }

    /// What a person would do about it, which is ADR-037 D8's whole answer:
    /// for five of the seven, write the contract; for the other two, nothing.
    pub fn remedy(ref self) -> String {
        return match self {
            Fallback::PublicSignature => "nothing here - whether it crosses is decided by callers this build does not read, so an answer would be a promise about somebody else's code",
            Fallback::PublicField => "keep the field out of the published surface, or accept the atomic - code this build does not read can take the value out of it",
            Fallback::UnseenCall => "describe the callee in a ledger, so the compiler can see what it does",
            Fallback::UnseenMethod => "describe the callee in a ledger, so the compiler can see what it does",
            Fallback::UncoveredArgument => "describe the callee in a ledger, so the compiler can see what it does",
            Fallback::UnseenOrigin => "write down the call the value came out of, so this analysis can follow it to the allocation",
            Fallback::ForeignFile => "nothing here - the file that declares the field or the function decides its count, and this run reads only one of the two",
        }
    }
}

/// Every row, for a report that enumerates rather than summarises.
pub fn every_fallback() -> Vec[Fallback] {
    return [Fallback::PublicSignature, Fallback::PublicField, Fallback::UnseenCall, Fallback::UnseenMethod, Fallback::UncoveredArgument, Fallback::UnseenOrigin, Fallback::ForeignFile]
}

/// What the analysis chose for one `Shared` value, and why.
pub struct Decision {
    /// The function the value is written in, as a ledger key.
    pub function: String,
    /// The name the source gives it, or `<result>`.
    pub value: String,
    /// Its type, as written.
    pub ty: String,
    pub count: Count,
    /// What kept the count atomic, in a user's words; nothing for a plain one.
    pub why: String?,
    /// Which row of `Fallback` this is, where it is one; nothing where the
    /// analysis *found* the crossing.
    pub fallback: Fallback?,
    /// Every place a second handle on this allocation is made (ADR-040 D5).
    pub duplications: Vec[String],
    /// Where a `get` copies the whole value out of the lock (ADR-281 D16).
    pub copied_out: Vec[String],
    /// Why a word-sized value that crosses kept its lock (ADR-281 D18).
    pub kept_its_lock: String?,
}

impl Decision {
    /// Whether the atomic count is the floor holding rather than a crossing
    /// the analysis found - the list ADR-010 D1 asks to be named.
    pub fn undecided(ref self) -> bool {
        return self.fallback != null
    }
}

/// Everything one program's `Shared` values got, and what the ledger keeps.
pub struct Sharing {
    /// One per `Shared` value a person wrote, by function and then by name.
    pub decisions: Vec[Decision],
    /// Per function key, the allocation classes of its caller-visible
    /// positions.
    pub summaries: collections::BTreeMap[String, Vec[Class]],
    /// The count every slot's class got, by the slot key `function::value` -
    /// the internal slots too, which the emitter lowers.
    pub counts: collections::BTreeMap[String, Count],
}

impl Sharing {
    /// The count one slot's class got, with the floor where nothing is known.
    pub fn count_of(ref self, function: ref String, value: ref String) -> Count {
        return self.counts[slot(function, value)] ?? Count::Atomic
    }
}

/// Every count plain, because nothing can cross (ADR-061 D2). Applied to the
/// finished answer, so the duplication sites are kept as they were found.
pub fn every_count_plain(mut sharing: Sharing) {
    for i in 0..<sharing.decisions.len() {
        sharing.decisions[i].count = Count::Plain
        sharing.decisions[i].why = null
        sharing.decisions[i].fallback = null
    }
    let mut keys: Vec[String] = []
    for key in sharing.counts.keys() {
        keys.push(key.clone())
    }
    for key in keys {
        sharing.counts.insert(key.clone(), Count::Plain)
    }
    let mut functions: Vec[String] = []
    for key in sharing.summaries.keys() {
        functions.push(key.clone())
    }
    for function in functions {
        let classes = sharing.summaries[function]?.clone() ?? []
        let mut plain: Vec[Class] = []
        for class in classes {
            plain.push(Class { members: class.members.clone(), count: Count::Plain })
        }
        sharing.summaries.insert(function.clone(), plain)
    }
}

/// What `--sharing` prints: one line per `Shared` value, the reason beside
/// every atomic one, and the enumeration of what the floor caught. It
/// **explains a decision rather than changing one** (ADR-292 D2).
pub fn sharing_report(sharing: ref Sharing) -> String {
    if sharing.decisions.len() == 0 {
        return "no `Shared` value here, so there is nothing to choose.\n"
    }
    let mut out: String = ""
    let mut at: String = ""
    let mut atomic = 0
    let mut undecided = 0
    let mut caught: Vec[String] = []
    for decision in sharing.decisions {
        if at != decision.function {
            out.push_str(ref f"{decision.function}:\n")
            at = decision.function.clone()
        }
        let count = decision.count.as_str()
        out.push_str(ref f"    {padded_right(count, 7)} `{decision.value}` ({decision.ty})\n")
        out.push_str(ref why_line(decision))
        out.push_str(ref kept_line(decision.kept_its_lock))
        for site in decision.copied_out {
            out.push_str(ref f"             copied out: {site} each time - `access` reads it in place\n")
        }
        // ADR-040 D5: where a handle is duplicated, which the source does not
        // say, is named beside the count.
        if decision.duplications.len() == 0 {
            out.push_str("             one handle, so the count is never stepped\n")
        }
        for site in decision.duplications {
            out.push_str(ref f"             duplicated: {site}\n")
        }
        if decision.count != Count::Plain {
            atomic += 1
        }
        if decision.undecided() {
            undecided += 1
            caught.push(fallback_text(decision.fallback))
        }
    }
    let all = sharing.decisions.len()
    let plain = all - atomic
    out.push_str(ref f"\n{all} `Shared` value(s): {plain} plain, {atomic} atomic, of which {undecided} because this analysis could not decide.\n")
    out.push_str("An atomic count is the safe default. A plain count is an optimisation, and where it isn't taken the reason is one of these:\n")
    for fallback in every_fallback() {
        let said = fallback.as_str()
        let mark = if caught.contains(said) { "*" } else { " " }
        let remedy = fallback.remedy()
        out.push_str(ref f"  {mark} {said} - {remedy}\n")
    }
    out.push_str("The ones that need a contract get sharper as `std`'s contracts grow.\n")
    return out
}

fn fallback_text(fallback: ref Fallback?) -> String {
    let row = fallback ?? return ""
    return row.as_str()
}

// Why a word that crosses kept its lock, where it did.
fn kept_line(kept: ref String?) -> String {
    let said = kept ?? return ""
    return f"             {said}\n"
}

// The line under a value that says why its count is what it is.
fn why_line(decision: ref Decision) -> String {
    return why_said(decision, decision.why)
}

fn why_said(decision: ref Decision, said: ref String?) -> String {
    let why = said ?? return "             nothing crosses a thread with it, so the count is lowered\n"
    if decision.undecided() {
        return f"             could not decide: {why}\n"
    }
    if decision.count == Count::Word {
        return f"             crosses: {why}\n             a word, and no door over several locks takes it, so its `update` is a compare-and-swap and there is no lock\n"
    }
    return f"             crosses: {why}\n"
}

/// One handle, named by the function it is written in.
pub fn slot(function: ref String, name: ref String) -> String {
    return f"{function}::{name}"
}

/// `Counter::record` back into its two halves.
pub fn split_slot(key: ref String) -> (String, String) {
    let parts: Vec[ref String] = key.split("::").collect()
    if parts.len() < 2 {
        return ("", key.clone())
    }
    let name = parts[parts.len() - 1].clone()
    let mut function: Vec[String] = []
    for i in 0..<(parts.len() - 1) {
        function.push(parts[i].clone())
    }
    return (function.join("::"), name)
}

/// **A `SharedMut` of a value that fits a machine word** (ADR-281 D8).
pub fn holds_a_word(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, view } => !view && name == "SharedMut" && args.len() == 1 && a_word(args[0]),
        else => false,
    }
}

comptime WORD_TYPES: Array[ref String, 12] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "char"]

fn a_word(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, view } => !view && args.len() == 0 && one_of(WORD_TYPES, name),
        else => false,
    }
}

/// What a `SharedMut` holds, where it does not copy cheaply (ADR-281 D16); a
/// hull whose content nobody named says nothing.
pub fn held_that_does_not_copy(ty: ref Ty) -> String? {
    return match ty {
        Ty::Named { name, args, .. } => a_held_value(ty, name, args),
        else => null,
    }
}

fn a_held_value(ty: ref Ty, name: ref String, args: ref Vec[Ty]) -> String? {
    if name != "SharedMut" || args.len() != 1 || holds_a_word(ty) || args[0].is_unknown() {
        return null
    }
    return args[0].text()
}

/// The type a literal is: a word-sized one, or text.
pub fn literal_type(expr: ref Expr) -> String? {
    return match expr {
        Expr::LitStr { .. } => "String",
        Expr::LitInterpolated { .. } => "String",
        Expr::LitInt { .. } => "i64",
        Expr::LitFloat(_) => "f64",
        Expr::LitBool(_) => "bool",
        Expr::LitChar(_) => "char",
        Expr::Unary { expr, .. } => literal_type(expr),
        else => null,
    }
}

/// The sentence a published position gets.
pub fn published_reason(key: ref String, at: ref String) -> String {
    if at == RESULT_POSITION {
        return f"`{key}` is public and hands a `Shared` back, so what the caller does with it is in a unit this build cannot see"
    }
    return f"`{key}` is public, so its callers are in a unit this build cannot see, and one of them may cross a thread with it"
}

/// The sentence a duplication at a call gets: the callee and the position it
/// takes the handle in, which are enough to find the line.
pub fn handed_on_to(key: ref String, param: ref String) -> String {
    return f"handed to `{key}` as `{param}`, which takes a handle of its own"
}

/// The sentence a call nothing describes gets.
pub fn unseen(callee: ref String?) -> String {
    let named = callee ?? "the callee"
    return f"the compiler knows nothing about `{named}`, so it has to assume it might start a thread"
}

/// Whether a position takes a handle on a shared value **by value**
/// (ADR-040 D1): a view of one hands no handle on, and a type that merely
/// holds one is carried by whatever holds it.
pub fn by_value_shared(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, view, .. } => !view && (name == "Shared" || name == "SharedMut"),
        else => false,
    }
}

/// The three types a program makes a hull of by calling their name
/// (ADR-281 D2).
pub fn is_hull(name: ref String) -> bool {
    return name == "Shared" || name == "SharedMut" || name == "Locked"
}

/// Whether a type is, or holds, a `Shared`.
pub fn holds_shared(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, .. } => name == "Shared" || name == "SharedMut" || any_holds_shared(args),
        Ty::Tuple(parts) => any_holds_shared(parts),
        else => false,
    }
}

fn any_holds_shared(types: ref Vec[Ty]) -> bool {
    for ty in types {
        if holds_shared(ty) {
            return true
        }
    }
    return false
}

/// The `<struct>.<field>` slots a type reaches that hold a `Shared`, through
/// the ledger's `fields` (ADR-024).
pub fn shared_fields(ty: ref String, asked: ref Asked) -> Vec[String] {
    let name = without_a_view(ty)
    let contract = ledger_type(name, asked.own, asked.library) ?? return []
    let mut out: Vec[String] = []
    for field in contract.fields {
        if holds_shared(field.ty) {
            out.push(f"{name}.{field.name}")
        }
    }
    return out
}

/// One field's declared type, through the same lookup.
pub fn declared_field_type(ty: ref String, field: ref String, asked: ref Asked) -> Ty? {
    let contract = ledger_type(without_a_view(ty), asked.own, asked.library) ?? return null
    for declared in contract.fields {
        if declared.name == field {
            return declared.ty.clone()
        }
    }
    return null
}

// The name with the `&` a view writes in front of it taken off.
fn without_a_view(ty: ref String) -> String {
    let mut out: String = ""
    let mut leading = true
    for c in ty.chars() {
        if leading && c == '&' {
            continue
        }
        leading = false
        out.push(c)
    }
    return out
}

/// What `Shared[T]` lowers to: the atomic count is the floor (ADR-037 D6),
/// a value proven never to cross may take the plain one (D7).
pub fn rust_name(count: Count) -> String {
    return match count {
        Count::Plain => "std::rc::Rc",
        Count::Word => "std::sync::Arc",
        Count::Atomic => "std::sync::Arc",
    }
}

/// What `Locked[T]` lowers to - the same answer to the same question
/// (ADR-281 D7): the count given the handle decides the lock inside it.
pub fn lock_name(count: Count) -> String {
    return match count {
        Count::Plain => "nikaia_std::lock::Local",
        Count::Word => "nikaia_std::lock::Word",
        Count::Atomic => "nikaia_std::lock::Crossing",
    }
}

// ---------------------------------------------------------------------------
// **The classes, and what each one gets** (ADR-037 D7): every `Shared`
// handle the walk found, joined into allocation classes by a union-find, with
// what forced a class atomic. The walk over the bodies stays Rust and fills
// this record; reading the answer off it is here.

/// The pseudo-function every `<struct>.<field>` slot is filed under.
pub comptime FIELDS: ref String = "<field>"

/// One `Shared` handle, and what was written about it.
pub struct Handle {
    pub function: String,
    pub value: String,
    pub ty: Ty,
    /// A slot that stands for a struct's field or a function's result rather
    /// than for something a person wrote: not reported, but classes join
    /// through it.
    pub internal: bool,
    /// A position a **caller** meets - a parameter, or the result: what the
    /// ledger's summary is about.
    pub position: bool,
}

/// What forced a slot's class to be atomic.
pub struct Forced {
    pub key: String,
    pub why: String,
    pub fallback: Fallback?,
}

/// The handles of one file, joined into classes.
pub struct Slots {
    /// Everything this file declares that a slot can belong to: a slot whose
    /// owner is not in here belongs to another file (`Fallback::ForeignFile`).
    pub declared_here: collections::BTreeSet[String],
    pub handles: collections::BTreeMap[String, Handle],
    /// Union-find over slot keys, by index into `parent`.
    pub index: collections::BTreeMap[String, i64],
    pub parent: Vec[i64],
    pub forced: Vec[Forced],
    /// Where a second handle on a slot's allocation is made (ADR-040 D5):
    /// the slot key, and what a reader is told about the place.
    pub duplicated: Vec[(String, String)],
    /// The slots a door over several locks names (ADR-281 D18): a
    /// compare-and-swap cannot be held, so their classes keep the lock.
    pub held_together: Vec[String],
    /// Where a `get` copies a value that does not copy cheaply out of its
    /// lock, by slot (ADR-281 D16).
    pub copies: Vec[(String, String)],
}

impl Slots {
    pub fn new(declared_here: collections::BTreeSet[String]) -> Slots {
        return Slots { declared_here: declared_here, handles: collections::BTreeMap(), index: collections::BTreeMap(), parent: [], forced: [], duplicated: [], held_together: [], copies: [] }
    }

    /// The slot's number in the union-find, made where it has none.
    pub fn id(ref mut self, key: ref String) -> i64 {
        let found = self.index[key]
        if found != null {
            return found ?? 0
        }
        let fresh = self.parent.len()
        self.parent.push(fresh)
        self.index.insert(key.clone(), fresh)
        return fresh
    }

    /// The class a slot's number is in.
    pub fn root(ref mut self, start: i64) -> i64 {
        let mut at = start
        while self.parent[at] != at {
            let up = self.parent[at]
            self.parent[at] = self.parent[up]
            at = self.parent[at]
        }
        return at
    }

    /// The class a slot is in, by its key.
    pub fn class_of(ref mut self, key: ref String) -> i64 {
        let id = self.id(key)
        return self.root(id)
    }

    /// Two handles on one allocation, which therefore share one count.
    pub fn join(ref mut self, left: ref String, right: ref String) {
        let one = self.class_of(left)
        let other = self.class_of(right)
        if one != other {
            self.parent[one] = other
        }
    }

    /// A handle the walk met.
    pub fn note(ref mut self, function: ref String, value: ref String, ty: Ty, internal: bool, position: bool) {
        let key = slot(function, value)
        self.id(key)
        if !self.handles.contains_key(key) {
            self.handles.insert(key.clone(), Handle { function: function.clone(), value: value.clone(), ty: ty, internal: internal, position: position })
        }
    }

    /// This slot's class must be atomic, and this is what forced it. **The
    /// slot is made where it does not exist yet, and no guard may be added**:
    /// the answer may not depend on the order the walk reaches the functions
    /// in (`docs/history/rc-or-arc.md` §8).
    pub fn force(ref mut self, function: ref String, value: ref String, why: String, fallback: Fallback?) {
        let key = slot(function, value)
        self.id(key)
        self.forced.push(Forced { key: key, why: why, fallback: fallback })
    }

    /// A second handle on this slot's allocation is made here (ADR-040 D1),
    /// where the handle is handed on by value.
    pub fn duplicates(ref mut self, function: ref String, value: ref String, site: String) {
        let key = slot(function, value)
        self.id(key)
        self.duplicated.push((key, site))
    }

    /// **A slot another file owns keeps the atomic floor**
    /// (`Fallback::ForeignFile`): this analysis runs once per file, and
    /// neither run sees the whole of such a slot. Asked of every slot the
    /// union-find knows, because a slot another file owns has no handle here
    /// and joining to it is the only trace of it there is.
    fn foreign_slots_hold_the_floor(ref mut self) {
        let field_prefix = f"{FIELDS}::"
        let mut foreign: Vec[(String, String)] = []
        for key in self.index.keys() {
            if !key.contains("::") {
                continue
            }
            let mut owner = before_last(key, "::")
            let mut named = key.clone()
            if key.starts_with(ref field_prefix) {
                let parts: Vec[ref String] = key.splitn(2, "::").collect()
                named = parts[1].clone()
                owner = before_last(named, ".")
            }
            if !self.declared_here.contains(owner) {
                foreign.push((key.clone(), named))
            }
        }
        for (key, named) in foreign {
            let why = f"`{named}` belongs to another file of this package, and that file's own pass decides its count - this one reads only one of the two"
            self.forced.push(Forced { key: key.clone(), why: why, fallback: Fallback::ForeignFile })
        }
    }
}

// Everything before the last `separator`, or the whole text where there is none.
fn before_last(text: ref String, separator: ref String) -> String {
    let parts: Vec[ref String] = text.split(separator).collect()
    if parts.len() < 2 {
        return text.clone()
    }
    let mut kept: Vec[String] = []
    for i in 0..<(parts.len() - 1) {
        kept.push(parts[i].clone())
    }
    return kept.join(separator)
}

/// What every handle of one file got: the classes read off the union-find,
/// the reason beside every atomic one, and the per-function summary.
pub fn decided(mut slots: Slots) -> Sharing {
    slots.foreign_slots_hold_the_floor()
    // Of two reasons, the one that is a crossing rather than an admission of
    // ignorance: ADR-292 D2, of two true answers the one somebody can act on.
    let mut why_of: collections::BTreeMap[i64, String] = collections::BTreeMap()
    // The rows of `Fallback` the classes' reasons are, where they are one.
    let mut fallback_of: collections::BTreeMap[i64, Fallback] = collections::BTreeMap()
    // The classes the floor answered for (ADR-281 D18).
    let mut floor: collections::BTreeSet[i64] = collections::BTreeSet()
    let forced = slots.forced.clone()
    for one in forced {
        let root = slots.class_of(one.key)
        if one.fallback != null {
            floor.insert(root)
        }
        if !why_of.contains_key(root) || (fallback_of.contains_key(root) && one.fallback == null) {
            why_of.insert(root, one.why.clone())
            set_fallback(fallback_of, root, one.fallback)
        }
    }
    let mut held: collections::BTreeSet[i64] = collections::BTreeSet()
    let together = slots.held_together.clone()
    for key in together {
        held.insert(slots.class_of(key))
    }
    let keys: Vec[String] = handle_keys(slots)
    // A class is a word where every handle in it is a `SharedMut` of one.
    let mut not_a_word: collections::BTreeSet[i64] = collections::BTreeSet()
    for key in keys {
        let root = slots.class_of(key)
        if !holds_a_word(handle_type(slots, key)) {
            not_a_word.insert(root)
        }
    }
    let duplicated = sites_by_slot(slots.duplicated)
    let copied_out = sites_by_slot(slots.copies)

    let mut decisions: Vec[Decision] = []
    let mut counts: collections::BTreeMap[String, Count] = collections::BTreeMap()
    let mut classes: collections::BTreeMap[String, collections::BTreeMap[i64, Class]] = collections::BTreeMap()
    for key in keys {
        let root = slots.class_of(key)
        let handle = slots.handles[key]?.clone() ?? continue
        let a_word = !not_a_word.contains(root)
        let mut count = Count::Plain
        let mut why: String? = null
        let mut fallback: Fallback? = null
        if why_of.contains_key(root) {
            why = why_of[root]?.clone()
            fallback = fallback_of[root] ?? null
            count = Count::Atomic
            if fallback == null && a_word && !floor.contains(root) && !held.contains(root) {
                count = Count::Word
            }
        }
        if handle.position {
            put_in_class(classes, handle.function, root, handle.value, count)
        }
        counts.insert(key.clone(), count)
        if !handle.internal {
            decisions.push(Decision { function: handle.function.clone(), value: handle.value.clone(), ty: handle.ty.text(), count: count, why: why, fallback: fallback, duplications: duplicated[key]?.clone() ?? [], copied_out: copied_out[key]?.clone() ?? [], kept_its_lock: lock_kept(count, a_word, held.contains(root)) })
        }
    }

    let mut summaries: collections::BTreeMap[String, Vec[Class]] = collections::BTreeMap()
    for (function, roots) in classes {
        let mut found: Vec[Class] = []
        for (_, class) in roots {
            found.push(Class { members: sorted_once(class.members), count: class.count })
        }
        summaries.insert(function.clone(), in_class_order(found))
    }
    return Sharing { decisions: decisions, summaries: summaries, counts: counts }
}

// The row a class's reason is, or none where the reason is a crossing.
fn set_fallback(mut fallback_of: collections::BTreeMap[i64, Fallback], root: i64, fallback: Fallback?) {
    fallback_of.remove(root)
    let row = fallback ?? return
    fallback_of.insert(root, row)
}

fn handle_keys(slots: ref Slots) -> Vec[String] {
    let mut keys: Vec[String] = []
    for key in slots.handles.keys() {
        keys.push(key.clone())
    }
    return keys
}

fn handle_type(slots: ref Slots, key: ref String) -> Ty {
    let handle = slots.handles[key] ?? return Ty::Unknown
    return handle.ty.clone()
}

// The places recorded against each slot, each once, in the order met.
fn sites_by_slot(pairs: ref Vec[(String, String)]) -> collections::BTreeMap[String, Vec[String]] {
    let mut out: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (key, site) in pairs {
        let mut sites = out[key]?.clone() ?? []
        if !sites.contains(site) {
            sites.push(site.clone())
        }
        out.insert(key.clone(), sites)
    }
    return out
}

fn put_in_class(mut classes: collections::BTreeMap[String, collections::BTreeMap[i64, Class]], function: ref String, root: i64, member: ref String, count: Count) {
    let mut roots = classes[function]?.clone() ?? collections::BTreeMap()
    let mut class = roots[root]?.clone() ?? Class { members: [], count: count }
    class.members.push(member.clone())
    class.count = class.count.join(count)
    roots.insert(root, class)
    classes.insert(function.clone(), roots)
}

// Why a word-sized value that crosses kept its lock (ADR-281 D18).
fn lock_kept(count: Count, a_word: bool, held_together: bool) -> String? {
    if count != Count::Atomic || !a_word {
        return null
    }
    if held_together {
        return "a word, but a door over several locks takes it, and a compare-and-swap cannot be held, so it keeps its lock"
    }
    return "a word, but the floor answered for it rather than a crossing, so it keeps its lock"
}

// The members in their order, each once.
fn sorted_once(members: ref Vec[String]) -> Vec[String] {
    let mut sorted = members.clone()
    sorted.sort()
    let mut out: Vec[String] = []
    for one in sorted {
        if out.len() == 0 || out[out.len() - 1] != one {
            out.push(one.clone())
        }
    }
    return out
}

// The classes by their members, then by the count's rank: the order the
// derive gave while `Class` was Rust (ADR-204 §4 leaves a declared type no
// order of its own, so the key is written here).
fn in_class_order(classes: Vec[Class]) -> Vec[Class] {
    let mut out: Vec[Class] = []
    for class in classes {
        let mut at = out.len()
        while at > 0 && class_before(class, out[at - 1]) {
            at -= 1
        }
        out.insert(at, class.clone())
    }
    return out
}

fn class_before(a: ref Class, b: ref Class) -> bool {
    let shorter = if a.members.len() < b.members.len() { a.members.len() } else { b.members.len() }
    for i in 0..<shorter {
        if a.members[i] != b.members[i] {
            return a.members[i] < b.members[i]
        }
    }
    if a.members.len() != b.members.len() {
        return a.members.len() < b.members.len()
    }
    return a.count.rank() < b.count.rank()
}

// ---------------------------------------------------------------------------
// **What the walk over the bodies asks of one expression**, answered without
// the walk's state: where a handle is made, why one is unseen, and what a name
// in scope is.

// Methods that run their lambda on a thread the program asked for: a closed
// list, so a name this file does not know contributes nothing.
comptime PARALLEL: Array[ref String, 3] = ["par_iter", "par_fold", "par_map"]

/// Everything a file declares that a slot can belong to: its structs and
/// enums, its functions, its `impl` targets and their methods as
/// `Type::method`. A slot whose owner is not here belongs to another file
/// (`Fallback::ForeignFile`).
pub fn declared_here(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]]) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for item in items {
        match item.node {
            Item::Struct { name, .. } => {
                out.insert(names.resolve(name).clone())
            }
            Item::Enum { name, .. } => {
                out.insert(names.resolve(name).clone())
            }
            Item::Fn { name, .. } => {
                let own = a_symbols_text(names, name)
                if own.len() > 0 {
                    out.insert(own)
                }
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    let own = method_name(names, method.node)
                    if own.len() > 0 {
                        out.insert(f"{owner}::{own}")
                    }
                }
                out.insert(owner)
            }
            else => {}
        }
    }
    return out
}

// A method's own name, `new` for the one written without, or nothing for an
// item that is not a function.
fn method_name(names: ref winnow_grammar::InternerContext, item: ref Item) -> String {
    return match item {
        Item::Fn { name, .. } => if name == null { "new" } else { a_symbols_text(names, name) },
        else => "",
    }
}

/// **Whether this `let` is itself the place the first handle is made**
/// (ADR-281 D2): a literal or a struct literal is a plain value by
/// construction; a hull's own constructor is the allocation; and a call is
/// one only where a ledger gives it a known result that holds no `Shared`.
/// Everything else is no, the polarity this analysis runs on.
pub fn allocates_here(expr: ref Expr, asked: ref Asked) -> bool {
    return match expr {
        Expr::LitInt { .. } => true,
        Expr::LitFloat(_) => true,
        Expr::LitStr { .. } => true,
        Expr::LitInterpolated { .. } => true,
        Expr::LitChar(_) => true,
        Expr::LitBool(_) => true,
        Expr::LitNull => true,
        Expr::StructLit { .. } => true,
        Expr::Call { func, .. } => a_call_that_allocates(call_path(func, asked.names), asked),
        Expr::MethodCall { method, .. } => hands_back_a_plain_value(asked.names.resolve(method), asked),
        Expr::SafeMethod { method, .. } => hands_back_a_plain_value(asked.names.resolve(method), asked),
        else => false,
    }
}

fn a_call_that_allocates(path: ref String?, asked: ref Asked) -> bool {
    let callee = path ?? return false
    return is_hull(callee) || hands_back_a_plain_value(callee, asked)
}

/// Whether a ledger says this callee's result is a value and not a handle:
/// the program's entry first, then `std`'s, by the name or by its last
/// segment.
pub fn hands_back_a_plain_value(callee: ref String, asked: ref Asked) -> bool {
    let suffix = f"::{callee}"
    if has_an_entry(asked.own, callee, suffix) {
        return plain_in(asked.own, callee, suffix)
    }
    return plain_in(asked.library, callee, suffix)
}

fn has_an_entry(ledger: ref Ledger, callee: ref String, suffix: ref String) -> bool {
    if ledger.functions.contains_key(callee) {
        return true
    }
    for key in ledger.functions.keys() {
        if key.ends_with(ref suffix) {
            return true
        }
    }
    return false
}

fn plain_in(ledger: ref Ledger, callee: ref String, suffix: ref String) -> bool {
    let exact = ledger.functions[callee]
    if exact != null {
        return a_plain_result(exact)
    }
    for (key, contract) in ledger.functions {
        if key.ends_with(ref suffix) {
            return a_plain_result(contract)
        }
    }
    return false
}

fn a_plain_result(contract: ref FnContract?) -> bool {
    let found = contract ?? return false
    let signature = found.signature ?? return false
    let result = signature.result ?? return false
    return !result.is_unknown() && !holds_shared(result)
}

/// What is said of a handle whose allocation this analysis did not watch
/// being made (`Fallback::UnseenOrigin`): where it came from.
pub fn origin_reason(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> String {
    let from = where_it_came_from(expr, names)
    return f"{from}, so this analysis did not watch the allocation being made - and the count belongs to the allocation. A call handed to another thread hands its result back across one (ADR-292)"
}

fn where_it_came_from(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> String {
    return match expr {
        Expr::Call { func, .. } => a_call_that_hands_it_back(call_path(func, names)),
        Expr::MethodCall { method, .. } => f"`{names.resolve(method)}` hands it back",
        Expr::SafeMethod { method, .. } => f"`{names.resolve(method)}` hands it back",
        Expr::Field { name, .. } => f"it is read out of `{names.resolve(name)}`",
        Expr::Index { .. } => "it is read out of a collection",
        else => "it comes from an expression this analysis does not follow",
    }
}

fn a_call_that_hands_it_back(path: ref String?) -> String {
    let callee = path ?? return "a call hands it back"
    return f"`{callee}` hands it back"
}

/// The handle an expression names in this function's own scope: a name whose
/// type holds a `Shared`, or the tail of a block that is one.
pub fn named_handle(expr: ref Expr, names: ref winnow_grammar::InternerContext, scope: ref collections::BTreeMap[String, Ty]) -> String? {
    return match expr {
        Expr::Variable(name) => a_handle_in_scope(names.resolve(name), scope),
        Expr::Block(block) => a_handle_at_the_tail(block, names, scope),
        else => null,
    }
}

fn a_handle_in_scope(name: ref String, scope: ref collections::BTreeMap[String, Ty]) -> String? {
    let ty = scope[name] ?? return null
    if holds_shared(ty) {
        return name.clone()
    }
    return null
}

fn a_handle_at_the_tail(block: ref Block, names: ref winnow_grammar::InternerContext, scope: ref collections::BTreeMap[String, Ty]) -> String? {
    if block.stmts.len() == 0 {
        return null
    }
    return match block.stmts[block.stmts.len() - 1].node {
        Stmt::Expr(tail) => named_handle(tail, names, scope),
        else => null,
    }
}

/// The name of the type a name in scope has, without its view.
pub fn named_type(expr: ref Expr, names: ref winnow_grammar::InternerContext, scope: ref collections::BTreeMap[String, Ty]) -> String? {
    return match expr {
        Expr::Variable(name) => scope_type_name(names.resolve(name), scope),
        else => null,
    }
}

fn scope_type_name(name: ref String, scope: ref collections::BTreeMap[String, Ty]) -> String? {
    let ty = scope[name] ?? return null
    return without_a_view(ty.text())
}

/// Whether a receiver is a walk that runs in parallel (ADR-235 D1): a
/// `par_iter()`, a name bound to one, or a walk chained onto either.
pub fn walks_in_parallel(receiver: ref Expr, names: ref winnow_grammar::InternerContext, parallel: ref collections::BTreeSet[String]) -> bool {
    return match receiver {
        Expr::Variable(name) => parallel.contains(names.resolve(name)),
        Expr::MethodCall { receiver, method, .. } => a_parallel_method(names.resolve(method)) || walks_in_parallel(receiver, names, parallel),
        else => false,
    }
}

pub fn a_parallel_method(method: ref String) -> bool {
    for one in PARALLEL {
        if one == method {
            return true
        }
    }
    return false
}

/// The name a call is written with: a bare name, or a path joined by `::`.
pub fn call_path(func: ref Expr, names: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name) => names.resolve(name).clone(),
        Expr::Path(segments) => joined_segments(segments, names),
        else => null,
    }
}
