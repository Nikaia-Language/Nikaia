# **The Rust the toolchain's own Nikaia reads** (ADR-294 D9.3), described as
# `nikaia describe` describes a crate for a program: a claim reviewed like
# code. `nikaia lower-std` checks a module of `src/tools/` against `std`'s
# ledger and this one; a program never reads it.
version = 2
toolchain = "described"
inference = "described"

# An interned name: the compiler's tree holds one wherever the source wrote a
# name. A `Copy` handle of one `u32`, compared as that number.
[type."winnow_grammar::Symbol"]
pub = true
crosses = true
compares = true
copies = true

# A copy of the handle, which is the handle (0.0.325).
[fn."winnow_grammar::Symbol::clone"]
pub = true
sync = true
touches = []
signature = "(self: ref winnow_grammar::Symbol) -> winnow_grammar::Symbol"

# What a `Symbol` was interned from.
[type."winnow_grammar::InternerContext"]
pub = true

# The text a name was interned from.
[fn."winnow_grammar::InternerContext::resolve"]
pub = true
sync = true
touches = []
signature = "(self: ref winnow_grammar::InternerContext, symbol: winnow_grammar::Symbol) -> ref(self) String"

# The id every expression node of the tree carries (ADR-340, #558): a `u32`
# the parser gives, compared as equal whatever the number (D3), so a key is
# `get`, never the id itself.
[type."node_id::NodeId"]
pub = true
crosses = true
compares = true
copies = true

# The id of a node the compiler builds after parsing: one no other node has.
[fn."node_id::NodeId::fresh"]
pub = true
sync = true
touches = []
signature = "() -> node_id::NodeId"

# The number a table is keyed on.
[fn."node_id::NodeId::get"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> u32"

# The id with this number: what the parser gives the nodes it makes, in order.
[fn."node_id::NodeId::numbered"]
pub = true
sync = true
touches = []
signature = "(number: u32) -> node_id::NodeId"
