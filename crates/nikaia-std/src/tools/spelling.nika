// crates/nikaia-std/src/tools/spelling.nika
//
// **How close one word is to another**, for the compiler's *did you mean*.
//
// The first piece of the compiler that moved from Rust to Nikaia (0.0.238), by
// ADR-290's route: written here, lowered ahead of time by `nikaia lower-std`
// to `spelling.rs` beside it, `include!`d as `nikaia_std::tools::spelling`,
// and called from the checker as an ordinary Rust function. The two functions
// it replaced - `check::distance` and `dsl::one_edit_apart` - are gone from
// the compiler; `tests/self_hosting.rs` and every refusal that names a near
// miss are what hold the two versions to one behaviour.
//
// Under `tools/` and not beside `text.nika`, because this is the toolchain's
// and not `std`'s: a program cannot reach it (`NK1186`'s note for `tools`).

/// How many edits turn one word into another, where an edit is a character
/// put in, taken out or changed - and two neighbours that swapped places count
/// as **one**.
///
/// Plain Levenshtein charges two for `nmae` against `name`, which puts the
/// most common typo there is outside any threshold worth having. This is the
/// optimal-string-alignment variant, which charges one.
pub fn distance(a: ref String, b: ref String) -> i64 sync {
    let x: Vec[char] = a.chars().collect()
    let y: Vec[char] = b.chars().collect()
    let rows = x.len() + 1
    let cols = y.len() + 1
    // `d[i][j]` is the distance between the first `i` characters of `a` and
    // the first `j` of `b`; the first row and column are the empty word's.
    let mut d: Vec[Vec[i64]] = Vec()
    for i in 0..<rows {
        let mut row: Vec[i64] = Vec()
        for j in 0..<cols {
            if i == 0 {
                row.push(j)
            } else if j == 0 {
                row.push(i)
            } else {
                row.push(0)
            }
        }
        d.push(row)
    }
    for i in 1..<rows {
        for j in 1..<cols {
            let cost = if x[i - 1] == y[j - 1] { 0 } else { 1 }
            let mut best = d[i - 1][j] + 1
            if d[i][j - 1] + 1 < best {
                best = d[i][j - 1] + 1
            }
            if d[i - 1][j - 1] + cost < best {
                best = d[i - 1][j - 1] + cost
            }
            let swapped = i > 1 && j > 1 && x[i - 1] == y[j - 2] && x[i - 2] == y[j - 1]
            if swapped && d[i - 2][j - 2] + 1 < best {
                best = d[i - 2][j - 2] + 1
            }
            d[i][j] = best
        }
    }
    return d[rows - 1][cols - 1]
}

/// Whether two different words are exactly one character apart: one changed,
/// one put in or one taken out. Two neighbours that swapped are **two** edits
/// here, which is the narrower question a DSL's parameter names are asked.
pub fn one_edit_apart(a: ref String, b: ref String) -> bool sync {
    if a == b {
        return false
    }
    let x: Vec[char] = a.chars().collect()
    let y: Vec[char] = b.chars().collect()
    if x.len() == y.len() {
        let mut differ = 0
        for i in 0..<x.len() {
            if x[i] != y[i] {
                differ += 1
            }
        }
        return differ == 1
    }
    if x.len() == y.len() + 1 {
        return one_put_in(a, b)
    }
    if y.len() == x.len() + 1 {
        return one_put_in(b, a)
    }
    return false
}

// Whether `long` is `short` with one character put in: walk `long`, keeping
// pace with `short`, and allow one step where they do not agree. It takes the
// words and not their characters, because a `ref Vec[char]` is a `&Vec<char>`
// below, which `clippy` refuses in `std` and a `&str` it does not.
fn one_put_in(long: ref String, short: ref String) -> bool sync {
    let kept: Vec[char] = short.chars().collect()
    let mut at = 0
    let mut skipped = false
    for c in long.chars() {
        if at < kept.len() && kept[at] == c {
            at += 1
        } else if skipped {
            return false
        } else {
            skipped = true
        }
    }
    return true
}
