// crates/nikaia-std/src/tools/fold.nika
//
// **What a constant integer expression comes to** (ADR-285, ADR-294 D11), for
// the checker's `NK1116` and the emitter's widening.
//
// The first module of the ring after the tree (ADR-294) moved from Rust to
// Nikaia, by ADR-290's route: lowered ahead of time by `nikaia lower-std` to
// `fold.rs` beside it, `include!`d as `nikaia_std::tools::fold`, and called
// from the compiler's `fold`, which turns its answer into the `i128` the Rust
// that remains keeps a constant in.
//
// **A magnitude and a sign** (ADR-294 D11): a literal is as large as a `u64`
// holds and as small as an `i64` (ADR-285 D19), so a number here is
// `integers.nika`'s `Integer`, which is exactly the shape the tree already
// gives a literal, and its arithmetic is that file's. A step that leaves the
// `u64` is not wrapped: it is `Folded::TooLarge`, which the checker refuses in
// this language's words.
//
// **A declared operand pins the arithmetic to its type** (D6's refinement):
// `let a = 2000000000` then `a + a - a` ends inside an `i32`, and its first
// step does not - the language below refuses the program there, so this does
// too, with the step's number.
//
// **`Folded::Nothing` means nothing is claimed**: a name the lookup cannot
// evaluate, an operator this does not fold, a division by zero. An expression
// that does not fold is never refused (Part III C.4).

/// A folded integer, and the integer type an operand's declaration pinned -
/// empty where none did, since a literal pins nothing (ADR-285).
pub struct Constant {
    pub value: Integer,
    pub pinned: String,
}

/// What a fold came to.
pub enum Folded {
    /// A number, and the type a declaration pinned it to.
    Value(Constant),
    /// A step left the type an operand's declaration pinned: the fold stops
    /// there, and the step is what is refused.
    Overflows(Constant),
    /// A step left the 65 bits every literal fits in, with the sign it was
    /// heading for.
    TooLarge(bool),
    /// Nothing is claimed.
    Nothing,
}

// The magnitudes at the ends of the types no `checked_` conversion names
// (ADR-315 D4 offers them for the four Part I 2.2 has). Named with their type,
// because a bare literal past an `i32` would be written as an `i64`.
comptime I8_LOW: u64 = 128
comptime I8_HIGH: u64 = 127
comptime I16_LOW: u64 = 32768
comptime I16_HIGH: u64 = 32767
comptime U8_HIGH: u64 = 255
comptime U16_HIGH: u64 = 65535

/// Whether `c` is a number of the integer type `ty`. A name this does not
/// know is not claimed to hold anything.
pub fn fits(c: ref Constant, ty: ref String) -> bool sync {
    return integer_fits(c.value, ty)
}

/// Whether `n` is a number of the integer type `ty`, as `fits` asks it.
pub fn integer_fits(n: ref Integer, ty: ref String) -> bool sync {
    return match ty {
        "i64" => integer_as_count(n) != null,
        "i32" => fits_an_i32(n),
        "u64" => !n.negative,
        "u32" => !n.negative && n.magnitude.checked_u32() != null,
        "i8" => within(n, I8_LOW, I8_HIGH),
        "i16" => within(n, I16_LOW, I16_HIGH),
        "u8" => within(n, 0, U8_HIGH),
        "u16" => within(n, 0, U16_HIGH),
        else => true,
    }
}

fn fits_an_i32(n: ref Integer) -> bool {
    let count = integer_as_count(n) ?? return false
    return count.checked_i32() != null
}

/// Whether `n` is between `-low` and `high`.
fn within(n: ref Integer, low: u64, high: u64) -> bool {
    return n.magnitude <= low if n.negative
    return n.magnitude <= high
}

/// A step of `integers.nika`'s arithmetic as the fold says it: the number, or
/// past the 65 bits with the sign it was heading for.
fn stepped(n: Integer?, heading: bool, pinned: String) -> Folded {
    let found = n ?? return Folded::TooLarge(heading)
    return Folded::Value(Constant { value: found, pinned: pinned })
}

/// The value a constant integer expression comes to, reading a name through
/// `name_is`: `Folded::Value` for a name whose value the caller knows, and
/// `Folded::Nothing` for one it does not.
pub fn constant_of(expr: ref Expr, name_is: fn(winnow_grammar::Symbol) -> Folded sync) -> Folded {
    return match expr {
        Expr::LitInt { value, negative, .. } => Folded::Value(Constant { value: integer(value, negative), pinned: "" }),
        Expr::Variable(name, _) => name_is(name),
        Expr::Unary { op, expr, .. } => negated(op, expr, name_is),
        Expr::Binary { op, lhs, rhs, .. } => combined(op, lhs, rhs, name_is),
        else => Folded::Nothing,
    }
}

/// `-x`, and nothing else a unary operator does.
fn negated(op: ref UnaryOp, inner: ref Expr, name_is: fn(winnow_grammar::Symbol) -> Folded sync) -> Folded {
    return Folded::Nothing if op != UnaryOp::Neg
    return match constant_of(inner, name_is) {
        Folded::Value(c) => pinned_step(Constant { value: integer_negated(c.value), pinned: c.pinned }),
        Folded::TooLarge(negative) => Folded::TooLarge(!negative),
        other => other,
    }
}

/// One step, held to the type an operand pinned.
fn pinned_step(c: Constant) -> Folded {
    // No type, and a type this does not know, answer `true` in `fits`.
    return if fits(c, c.pinned) { Folded::Value(c) } else { Folded::Overflows(c) }
}

/// `lhs op rhs`, for the five operators the fold knows.
fn combined(op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr, name_is: fn(winnow_grammar::Symbol) -> Folded sync) -> Folded {
    let a = match constant_of(lhs, name_is) {
        Folded::Value(c) => c,
        other => return other,
    }
    let b = match constant_of(rhs, name_is) {
        Folded::Value(c) => c,
        other => return other,
    }
    // Two operands that pin different types are a mismatch the type check
    // reports on its own; folding them would be arithmetic in a type neither
    // of them has.
    if !a.pinned.is_empty() && !b.pinned.is_empty() && a.pinned != b.pinned {
        return Folded::Nothing
    }
    let pinned = if a.pinned.is_empty() { b.pinned.clone() } else { a.pinned.clone() }
    // A sum and a difference leave the 65 bits only heading the way `a`
    // does, and a product the way the signs together do.
    let x = a.value
    let y = b.value
    let folded = match op {
        BinaryOp::Add => stepped(integer_sum(x, y), x.negative, pinned),
        BinaryOp::Sub => stepped(integer_difference(x, y), x.negative, pinned),
        BinaryOp::Mul => stepped(integer_product(x, y), x.negative != y.negative, pinned),
        BinaryOp::Div => divided(integer_quotient(x, y, false), pinned),
        BinaryOp::Rem => divided(integer_quotient(x, y, true), pinned),
        else => Folded::Nothing,
    }
    return match folded {
        Folded::Value(c) => pinned_step(c),
        other => other,
    }
}

/// `a / b` and `a % b`, truncating toward zero as the language below does
/// (`integers.nika`). A division by zero is not claimed.
fn divided(n: Integer?, pinned: String) -> Folded {
    let found = n ?? return Folded::Nothing
    return Folded::Value(Constant { value: found, pinned: pinned })
}

/// **Does this constant need the wider type, and may it have it?** (ADR-285
/// D1): nothing pinned it, an `i32` does not hold it, and an `i64` does.
pub fn wants_widening(folded: ref Folded) -> bool {
    return match folded {
        Folded::Value(c) => c.pinned.is_empty() && !fits(c, "i32") && fits(c, "i64"),
        else => false,
    }
}
