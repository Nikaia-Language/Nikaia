// crates/nikaia-std/src/tools/check_state.nika
//
// **What the checker keeps while it walks a body**, declared in Nikaia
// (ADR-294, #125; the owner's direction on #558: the `Checker`'s state is a
// Nikaia struct, as directly as possible). These are the small records its
// fields hold - a name in scope, what was taken or read of a path, a way out,
// a loop that may run again - and the questions that need nothing else to be
// answered. The Rust `Checker` holds them; a method that moves holds the whole
// state as one field.
//
// **Positions are `i64`**: an expression's key is a number here, never an
// address, and Nikaia has no `usize` (ADR-294 D7). A statement's words
// (`"loop"`, `"return"`) are `String`, not a `&'static str`.

use std::collections

/// Which of the two ways a binding comes to be one that did not say `mut`.
///
/// They are one rule reached from two sides - *what is changed says `mut`* -
/// and two codes, because the way out is written in a different place:
/// `NK1138` is a **parameter**'s (ADR-094 D3), `NK1139` is a **`let`**'s
/// (Part I 2.1).
pub enum CheckKind {
    Parameter,
    Let,
}

/// A binding that did not say `mut`: where it was written, and which kind it is.
pub struct CheckImmutable {
    pub at: Span,
    pub kind: CheckKind,
}

/// A name in scope: what it is called, the type it holds, and - where this
/// checker could work it out - the constant integer it stands for.
///
/// **Only a `let` ever fills `constant`**, and only an immutable one whose value
/// folded. A parameter, a `for` binding, a `match` arm's name and a lambda's
/// argument all name something no compile-time evaluation reaches, so they
/// carry `null` and the fold stops at them - the fail-closed direction the
/// refusal needs (ADR-010 D1).
pub struct CheckLocal {
    pub name: String,
    /// **A `let mut`** (Part I 2.1): what a supervisor's child may not capture
    /// (`NK1229`), because the next attempt would not start fresh.
    pub written_mut: bool,
    pub ty: Ty,
    pub constant: Integer?,
    /// **The binding is a view the emitter lent**, which a `for` over a place
    /// is (ADR-094 D4). One reader: a cast over it.
    pub lent: bool,
    /// Where the binding was written and what kind it is, when it did **not**
    /// say `mut`. On the binding rather than in a map so that the scope is the
    /// one `scope` already keeps.
    pub immutable: CheckImmutable?,
    /// **A parameter whose declaration wrote `mut`**, which is already a
    /// `&mut T` in the lowering (ADR-094 D3): a second reference would be
    /// `&mut &mut T`.
    pub changing: bool,
    /// **What the build worked out this name is**, whole - a `comptime`'s
    /// value, where there is one.
    pub built: BuildValue?,
    /// **The text literal a `let` bound this name to**, for the one sentence
    /// that has to say so (ADR-282 D25).
    pub literal: String?,
    /// Where the `let` stands, for a binding whose value was an **empty list**
    /// and whose element type nothing has said yet (ADR-135 D2).
    pub empty_list: i64?,
    /// **A number no annotation typed, whose uses will** (ADR-285 D23): the
    /// `let` it was bound at.
    pub open_number: i64?,
    /// **Which binding this is**, of all the ones a name has had: a number no
    /// other binding gets. A read of another `k` is not a read of the one that
    /// was handed over (`NK2105`).
    pub id: i64,
}

impl CheckLocal {
    /// A binding nothing here refuses a change to: `self`, an option, a `for`
    /// binding, a pattern's name. `id` is a number no other binding has.
    pub fn free(name: String, ty: Ty, id: i64) -> CheckLocal {
        return CheckLocal {
            name: name,
            written_mut: false,
            ty: ty,
            constant: null,
            lent: false,
            immutable: null,
            changing: false,
            built: null,
            literal: null,
            empty_list: null,
            open_number: null,
            id: id,
        }
    }
}

/// What a function type **allows** the code it names to do (ADR-277 D2): without
/// `sync` it may pause, without `throws` it cannot fail.
pub struct CheckPromises {
    pub may_pause: bool,
    pub may_fail: bool,
}

/// What a lambda's body was seen to do (ADR-277 D7), kept beside what the type
/// it was handed to allows, so that the one message about a mismatch is the one
/// that is said.
pub struct CheckHanded {
    pub pauses: bool,
    pub fails: bool,
    /// Whether the walk is inside the guarded half of a `catch` written **in
    /// this lambda's body**.
    pub caught: bool,
    pub promised: CheckPromises,
}

/// What the guarded expression of a `catch` turned out to hold: two answers
/// and not one, because *nothing can fail here* and *nothing here could be
/// looked up* are different facts and only the first may be acted on.
pub struct CheckGuarded {
    /// A call the ledger describes, whose contract carries a `throws`.
    pub fallible: bool,
    /// Something this compiler could not look up, or a nested `catch`.
    pub unanswered: bool,
    /// The error types the described calls say they throw (#501).
    pub thrown: collections::BTreeSet[String],
}

impl CheckGuarded {
    pub fn nothing() -> CheckGuarded {
        return CheckGuarded { fallible: false, unanswered: false, thrown: collections::BTreeSet() }
    }
}

/// **Something taken**: a sequence walked (`NK2702`) or data handed to what
/// keeps it (`NK2105`).
pub struct CheckTaken {
    /// A name, or a part of one: `p.name` (ADR-293 D32).
    pub path: String,
    pub ty: Ty,
    /// The bytes the statement that took it starts and ends at.
    pub from: i64,
    pub at: i64,
    /// **Where in that statement**: the order the walk read it in (ADR-293 D31).
    pub seq: i64,
    /// The branch it was taken in.
    pub choices: Vec[(i64, i64)],
    /// Where a branch that left the function ends, for a taking inside it
    /// (ADR-293 D30).
    pub until: i64?,
    /// What took it, in words (`NK2105`).
    pub to: String,
    /// Which binding of the path's first name was taken: a read of another
    /// binding of the same name is not a read of it.
    pub binding: i64?,
}

/// **One read**: of what, in which statement, on which path, in which order.
pub struct CheckRead {
    pub path: String,
    pub at: i64,
    pub choices: Vec[(i64, i64)],
    pub seq: i64,
    pub binding: i64?,
}

/// **A part taken out of a `mut` parameter** (ADR-094 D7, `NK2108`): the arm of
/// a `match` over the parameter bound it and handed it to something that keeps
/// it, so the parameter is missing it until an assignment gives it back.
pub struct CheckPartOut {
    /// The parameter, or the place in it, that was matched: `e`, `e.kind`.
    pub subject: String,
    /// The name the arm bound the part to.
    pub part: String,
    /// Which binding that is.
    pub binding: i64,
    /// The hand-over that took it.
    pub handed: i64,
}

/// **An assignment**, where it stands: what gives a part back.
pub struct CheckGive {
    pub path: String,
    pub at: i64,
    pub choices: Vec[(i64, i64)],
}

/// **A way out of the function, or a call that can fail**, where it stands:
/// what a part taken out of a `mut` parameter may not be missing at.
pub struct CheckWayOut {
    /// `"return"`, `"throw"`, or `"fails"` for a call that can.
    pub how: String,
    /// The call, for `"fails"`.
    pub word: String,
    pub at: i64,
    pub seq: i64,
    pub choices: Vec[(i64, i64)],
    pub span: Span,
}

/// A `??` whose left side may be lent rather than taken.
pub struct CheckPendingCoalesce {
    /// The `??`, by statement and shape: what the emitter looks it up by.
    pub key: (i64, String),
    /// The read its left side is, for the hand-over.
    pub left: i64,
    /// The left side's type, `T?`.
    pub ty: Ty,
    pub span: Span,
    /// How the option is opened where it is lent.
    pub opened: String,
}

/// Whether reading `read` touches what taking `taken` took: the same path, a
/// part of it (`p.name` after `p`), or the whole it was part of (`p` after
/// `p.name`).
pub fn a_path_overlaps(read: ref String, taken: ref String) -> bool {
    if read == taken {
        return true
    }
    if read.starts_with(taken) && (read.strip_prefix(taken) ?? "").starts_with(".") {
        return true
    }
    return taken.starts_with(read) && (taken.strip_prefix(read) ?? "").starts_with(".")
}

/// Whether assigning `written` gives `taken` a value again: the same path, or
/// the whole it is a part of.
pub fn a_path_revives(written: ref String, taken: ref String) -> bool {
    if written == taken {
        return true
    }
    return taken.starts_with(written) && (taken.strip_prefix(written) ?? "").starts_with(".")
}

/// Whether two places are in different arms of one choice, so that no run
/// reaches both.
pub fn choices_apart(a: ref Vec[(i64, i64)], b: ref Vec[(i64, i64)]) -> bool {
    for mine in a {
        for theirs in b {
            if theirs.0 == mine.0 && theirs.1 != mine.1 {
                return true
            }
        }
    }
    return false
}

/// A body that may run more than once, around a sequence being taken
/// (ADR-293 D19).
pub struct CheckRepeats {
    /// Where the body's own names begin in the scope: a name bound in a frame
    /// before this is from outside it.
    pub frame: i64,
    /// `"loop"` or `"lambda"`, for the sentence.
    pub what: String,
    /// The names the body assigns, any of which it may give a new sequence
    /// before the next turn takes it - a loop only.
    pub revived: collections::BTreeSet[String],
    /// Whether a `break` or a `return` is anywhere in the body, which may end
    /// the loop on the turn that took it - a loop only. Over-approximated, in
    /// the direction that refuses less.
    pub leaves: bool,
}

impl CheckRepeats {
    pub fn a_loop(words: ref winnow_grammar::InternerContext, frame: i64, body: ref Block) -> CheckRepeats {
        let mut found = CheckRepeats { frame: frame, what: "loop".clone(), revived: collections::BTreeSet(), leaves: false }
        what_a_loop_does(words, body, found)
        return found
    }

    pub fn a_lambda(frame: i64) -> CheckRepeats {
        return CheckRepeats { frame: frame, what: "lambda".clone(), revived: collections::BTreeSet(), leaves: false }
    }

    /// Whether the body takes `name` again on its next turn.
    pub fn takes_again(ref self, name: ref String) -> bool {
        return !(self.leaves || self.revived.contains(name))
    }
}

fn what_a_loop_does(words: ref winnow_grammar::InternerContext, block: ref Block, mut found: CheckRepeats) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Break => {
                found.leaves = true
            }
            Stmt::Return(_) => {
                found.leaves = true
            }
            Stmt::Assign { target, .. } => {
                match target {
                    Expr::Variable(name, _) => {
                        found.revived.insert(words.resolve(name).clone())
                    }
                    else => {}
                }
            }
            else => {}
        }
        for inner in blocks_of_stmt(stmt.node) {
            what_a_loop_does(words, inner, found)
        }
    }
}

/// Whether a body's last statement is a loop no jump leaves (ADR-276).
///
/// **The literal `true` only**, never a name that happens to be true: the
/// equivalence is about the written form. **And no `break` bound to this
/// loop.** The walk over-approximates - it descends into a lambda, where a
/// `break` is not bound to this loop at all - and that is the safe direction.
pub fn a_body_never_ends(body: ref Block) -> bool {
    if body.stmts.len() == 0 {
        return false
    }
    let last = body.stmts[body.stmts.len() - 1]
    match last.node {
        Stmt::While { cond, body } => {
            return a_true_literal(cond) && !a_jump_leaves(body, 0)
        }
        else => {
            return false
        }
    }
}

fn a_true_literal(expr: ref Expr) -> bool {
    return match expr {
        Expr::LitBool(value, _) => value,
        else => false,
    }
}

/// Whether a `break` in this block is bound to the loop **around** it rather
/// than to one written inside. A `continue` is not one.
pub fn a_jump_leaves(block: ref Block, loops: i64) -> bool {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Break => {
                if loops == 0 {
                    return true
                }
            }
            Stmt::For { body, .. } => {
                if a_jump_leaves(body, loops + 1) {
                    return true
                }
            }
            Stmt::While { body, .. } => {
                if a_jump_leaves(body, loops + 1) {
                    return true
                }
            }
            else => {
                for inner in blocks_of_stmt(stmt.node) {
                    if a_jump_leaves(inner, loops) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

/// Whether it stops the build.
///
/// Almost everything the checker says is an **error**. A warning is for a
/// finding that may be about a program that is right, such as `NK1111`: it
/// cannot be an error, because `"{ margin: 0 }"` is correct CSS, and it cannot
/// be silence, because a silent change of meaning is what Part III C.1 calls a
/// compiler bug.
pub enum CheckSeverity {
    /// The build stops.
    Error,
    /// The build goes on and the programmer is told.
    Warning,
}

/// One place a [`CheckFinding`] points at, and what it says there.
///
/// The checker knows a statement and not the bytes of the source, so a label
/// names the **word** it is about and the renderer, which holds the text,
/// underlines that word where it first stands at or after the statement's
/// start.
pub struct CheckLabel {
    /// The statement it is in.
    pub span: Span,
    /// What to underline, as written.
    pub word: String,
    /// What happens there, in a few words.
    pub text: String,
    /// The place the error is: `^` under it, where another place gets `-`.
    pub main: bool,
}

/// One thing the checker is sure about.
pub struct CheckFinding {
    /// Whether it stops the build.
    pub severity: CheckSeverity,
    /// The statement it is in.
    pub span: Span,
    /// Its `NK` code, from the catalogue in Part III, C.3.
    pub code: String,
    /// The headline, which says what is wrong and never how to think about it.
    pub message: String,
    /// Why the compiler believes it - the two types, and where each came from.
    pub notes: Vec[String],
    /// One concrete way out. Part III C.2 requires it of every diagnostic.
    pub help: String?,
    /// **The places in the source it points at**, each with what happens
    /// there (Part III C.2, rule 5).
    pub labels: Vec[CheckLabel],
}

/// A refusal at `span`: an error with no labels.
pub fn check_refusal(code: ref String, span: ref Span, message: String, notes: Vec[String], help: String?) -> CheckFinding {
    return CheckFinding { severity: CheckSeverity::Error, span: span.clone(), code: code.clone(), message: message, notes: notes, help: help, labels: [] }
}

/// **What the checker looks at and does not own**: the file's names, this
/// unit's contracts and `std`'s. Apart from `CheckState` so that the state
/// holds no view: a call on a struct that holds one might keep what it is given
/// (`NK2302`), and nothing in the state does.
pub struct CheckWorld {
    /// The names of the file, to read an identifier back.
    pub words: ref winnow_grammar::InternerContext,
    /// This unit's own contracts, inferred from the source being checked.
    pub own: ref Ledger,
    /// `std`'s, as `std` ships them.
    pub library: ref Ledger,
}

/// **What the checker keeps while it walks a program**: the findings, the
/// scope, and what the program declares. The Rust `Checker` holds it as one
/// field and the questions that need only this move here, a method at a time.
pub struct CheckState {
    /// Every mistake it is sure about.
    pub findings: Vec[CheckFinding],
    /// Every struct declared here, with its fields. A type whose fields are
    /// not known is simply absent, and an absent type is never an error.
    pub structs: collections::BTreeMap[String, Vec[FieldContract]],
    /// **Every type of the package that copies**, this file's and the ones
    /// beside it (`collect_copies`): what a view of a value is read as, where
    /// `Checked::copies` is what this file derives `Copy` for.
    pub copies_in_the_package: collections::BTreeSet[String],
    /// Every enum declared here, with its variant names.
    pub enums: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// What each declared `enum`'s variants **hold**, flattened across them.
    ///
    /// A `Named` variant's fields are in `structs` under the qualified key,
    /// because a struct literal wears that shape; a **positional** one's are in
    /// no map at all, which is what made `Json::Number(f64)` look like a variant
    /// holding nothing. This is the one question that needs all of them at once —
    /// does every part of this type compare — so it is a map of its own rather
    /// than a second meaning for `structs`.
    pub enum_payloads: collections::BTreeMap[String, Vec[Ty]],
    /// **What each positional variant of a declared `enum` holds**, by
    /// `Enum::Variant` and in order: what a `match` arm binds by position
    /// (`Shape::Named(n)` binds a `String`). A variant with named fields is in
    /// `structs`, as a library's variants are.
    pub variant_parts: collections::BTreeMap[String, Vec[Ty]],
    /// `Shape::Spot` → `Shape`, for every variant that carries **named**
    /// fields — the ones a struct literal builds.
    ///
    /// Two facts at one key: that this name is a variant and not a type, and
    /// which `enum` a literal for it has. [`Self::structs`] holds its fields
    /// under the same key, so one field check serves both shapes.
    pub variant_owner: collections::BTreeMap[String, String],
    /// **The functions whose body walks a type's fields**, and which type
    /// parameter each one walks ([ADR-304](../../docs/specification/adr/adr-304.md)
    /// D1): `describe` → `T`.
    ///
    /// Collected before any body is walked, because a call may stand **above**
    /// the function it names - items are order-independent here - and what a
    /// call has to do about one of these is decided at the call.
    pub walks_fields: collections::BTreeMap[String, String],
    /// Every **grammar** declared here, with the names of its `entry` rules
    /// ([ADR-296](../../docs/specification/adr/adr-296.md) D24, D25).
    ///
    /// A grammar is entered by an ordinary call — `Json.value(input)` — so its
    /// name has to be something `NK1117` counts as declared, and which rules
    /// may stand after the dot is what says `Json.internal(x)` is not an entry.
    pub grammars: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// Names in scope, innermost frame last.
    pub scope: Vec[Vec[CheckLocal]],
    /// The `std` modules this file wrote a `use std::…` for
    /// ([ADR-313](../../docs/specification/adr/adr-313.md), Part I 9.1's
    /// *a prefix is introduced before it is used*).
    pub std_in_scope: collections::BTreeSet[String],
    /// Every module `std`'s ledger has entries in — the prefix of a key that is
    /// not a type's name.
    ///
    /// Read off the ledger and not written here, so a `std` that grows a module
    /// needs no edit in this file. `fs::Mapped` is a **type in** a module, so
    /// `fs` is one of these and `HashMap` is not.
    pub std_modules: collections::BTreeSet[String],
    /// What the function being walked declared it hands back.
    pub expected: Ty?,
    /// The type parameters in scope where the body being walked stands - the
    /// function's own `[T]` and the `[T]` of the `impl` around it.
    ///
    /// A name in here is a **type** while the body is walked and a **variable**
    /// at every call site ([ADR-295](../../docs/specification/adr/adr-295.md)
    /// D1). Empty everywhere else, which is every function written today.
    pub type_parameters: collections::BTreeMap[String, Vec[String]],
    /// Every generic struct declared here, with its parameters in **declaration
    /// order** - which is what makes a type argument's position mean something.
    ///
    /// Absent for a struct with no parameters, which is every struct written
    /// today, so the two questions below cost a failed lookup and nothing else.
    pub struct_parameters: collections::BTreeMap[String, Vec[String]],
    /// Whether the method being walked took its subject by **reference**.
    ///
    /// `&self` and `&mut self` borrow it; a bare `self` owns it. What hangs on
    /// the difference is whether a field may be handed out by value at all
    /// ([ADR-083](../../docs/specification/adr/adr-083.md)). `false` for a free
    /// function, which has no subject to borrow.
    pub borrowing_self: bool,
    /// The `[T]` of the `impl` whose methods are being walked, on its own.
    ///
    /// Separate from the field above because `function` rebuilds that one per
    /// method and has to start from what the `impl` put in scope rather than
    /// from nothing.
    pub enclosing: collections::BTreeMap[String, Vec[String]],
    /// **What the `impl` header writes in its own brackets**, in declaration
    /// order - `[T]` for `impl Holder[T]`, `[i64]` for `impl Holder[i64]`.
    ///
    /// The receiver's type is built from this rather than from the bare name,
    /// and that is what lets a field reach the body as something
    /// ([ADR-295](../../docs/specification/adr/adr-295.md) D1). `self` typed as
    /// a bare `Holder` binds none of the struct's parameters, so `self.value`
    /// substituted a `T` nothing had bound and came out `?` - and a `?` is the
    /// one thing this checker says nothing about. Every refusal a `T` earns as
    /// a *parameter* - `NK1126` for a member on it, `NK1104` for a slot it does
    /// not fit, `NK1131` for handing one out of a borrowed subject - was silent
    /// through a field, and the program went to `rustc` about the generated
    /// file, which is [Part III C.1](../../docs/specification/30-nikaia-tooling.md)'s
    /// class.
    ///
    /// Empty outside an `impl`, and empty for one whose target takes no
    /// arguments - which is the same as what it was before.
    pub subject_arguments: Vec[Ty],
    /// The bounds each function's parameters were declared with, by the key a
    /// call resolves to - `tell` for a free function, `Dog::tell` for a method.
    ///
    /// Not read off the ledger, which has no column for a bound: its signature
    /// writes `(x: $T) -> String` and the `: Speaks` is nowhere in it. So what
    /// this table reaches is a call to a function of **this build** — every unit
    /// of it is walked, so every such `fn` is in one of these ASTs — and a call
    /// into a package whose generic function carries a bound is not checked
    /// against it. That is the column a ledger would need, and nothing asks for
    /// it yet: a bound may name a path since
    /// [ADR-295](../../docs/specification/adr/adr-295.md) D10, and what a caller
    /// gets wrong is caught where the callee's body reads the parameter.
    pub declared_bounds: collections::BTreeMap[String, collections::BTreeMap[String, Vec[String]]],
    /// The modules this program is made of (Part I, 9.1). Empty for a single
    /// file, where no call crosses a file boundary.
    pub modules: collections::BTreeSet[String],
    /// **The names an `extern "C"` block declares**
    /// ([ADR-302](../../docs/specification/adr/adr-302.md) D3).
    ///
    /// Collected from the item tree rather than read off the ledger, because
    /// the ledger records what a name *is* and this asks where it **came
    /// from**: a Nikaia function and a C declaration are both entries, and only
    /// one of them has to be called inside an `unsafe` block.
    pub foreign_names: collections::BTreeSet[String],
    /// **The opaque handles this file declares**
    /// ([ADR-302](../../docs/specification/adr/adr-302.md) D7), by name.
    ///
    /// A handle is an address the language never dereferences, so it has no
    /// fields and no indexing — and both are refused here rather than left to
    /// the language below, where the words would be about a file nobody wrote
    /// (Part III, C.1).
    pub opaque_handles: collections::BTreeSet[String],
    /// The parameters of the function being walked that are code it only
    /// runs, which stay closure arguments below.
    pub run_code: collections::BTreeSet[String],
    /// The functions that take a DSL's parameters as `...args: Self::dsl`
    /// (ADR-296 D5), by name: what one hands back is the statement's
    /// parameters, a type of each call site's own.
    pub dsl_drivers: collections::BTreeSet[String],
    /// The rings of constants this walk has already reported, by their members.
    ///
    /// Every constant in a ring is circular, and each would report the same
    /// loop from a different corner — which is one mistake said as many times
    /// as it has members.
    pub said_rings: collections::BTreeSet[Vec[String]],
    /// **The option whose default is being computed** (ADR-318 D7): a
    /// refusal's way out for it is a `T?`, not a `let` in place of a
    /// `comptime` it never was.
    pub computing_default: bool,
    /// **What the lambda being walked has been seen to do**
    /// ([ADR-277](../../docs/specification/adr/adr-277.md) D7).
    ///
    /// A function type carries two promises and the defaults are the
    /// language's: without `sync` the code may pause, without `throws` it
    /// cannot fail. A lambda handed to one has to keep them, and *keeping* is
    /// a question about its body — so the body is walked with this in hand and
    /// the calls it makes put their answers in it.
    ///
    /// **It does not cross a boundary.** A lambda written inside another one
    /// is a function of its own: what its body does happens when *its* callee
    /// runs it, not when this one does. So [`Checker::past_a_boundary`] clears
    /// it and puts the outer one back, the way it does with the loop count.
    ///
    /// `None` where nothing is being asked — outside a lambda, and inside one
    /// whose parameter's type nothing describes.
    pub handed_over: CheckHanded?,
    /// **Inside a lambda handed to a walk of a `Par[T]`**, the length of the
    /// scope where it began: a name bound below it is one every core shares
    /// ([ADR-235](../../docs/specification/adr/adr-235.md) D2). `None`
    /// elsewhere.
    pub in_parallel: i64?,
    /// **The parallel context is a task of `task::scope`** (Part II 12.7)
    /// rather than a `par_iter()` walk: the same rules, said of a task.
    pub scoped_task: bool,
    /// Whether what is being walked stands inside one.
    ///
    /// It reaches inward the way `caught` and `in_lambda` do, and it stops at
    /// nothing: a lambda written inside an `unsafe` block runs later, and D3
    /// asks about where the **call** is written rather than about when it runs.
    pub inside_unsafe: bool,
    /// **The loops and lambdas around the expression being walked**, innermost
    /// last ([ADR-293](../../docs/specification/adr/adr-293.md) D19): where each
    /// begins in `scope`, and what would let a sequence taken inside it be
    /// taken again.
    ///
    /// A sequence declared outside a loop and taken inside it is taken on the
    /// first turn and gone on the second, and a lambda may be run more than
    /// once by whatever it is handed to. Both are one statement in the source,
    /// which is why the per-statement order `walked` reads cannot see them.
    pub repeats: Vec[CheckRepeats],
    /// The name the `set` being typed was called on, for `NK2205`'s message
    /// ([ADR-281](../../docs/specification/adr/adr-281.md) D25).
    ///
    /// The rule wants the receiver's **name** and the argument's **type**, and
    /// those are known in two different places: the name where the method call
    /// is walked, the types after `arguments_given` has run. Carried rather
    /// than passed, the way the door flags beside it are.
    pub set_receiver: String?,
    /// Where the condition this stands under was read from a lock, if it was
    /// ([ADR-281](../../docs/specification/adr/adr-281.md) D25's second shape).
    ///
    /// `if stand > 100 { kasse.set(0) }` stores a plain value; the **decision**
    /// is the stale thing. A `while`, a `match` and a nested `if` are
    /// conditions alike, which is why this is a flag over a block rather than a
    /// question asked of one statement.
    pub stamped_condition: i64?,
    /// Whether what is being walked is **inside a door's block** — `access`,
    /// `update`, `access_all` or `update_all`
    /// ([ADR-281](../../docs/specification/adr/adr-281.md) D10).
    ///
    /// `at_a_write_door` above is the narrower question `NK1138` and `NK1141`
    /// ask; this is the one `NK2203` asks, because *a lock taken while a lock
    /// is held* is about **any** door being open and not about which
    /// ([ADR-281](../../docs/specification/adr/adr-281.md) D28).
    ///
    /// `get` and `set` are doors and are **not** here, and D10 says why: while
    /// the lock is open in either of them no code of the program's runs, so
    /// there is nothing that could take a second one.
    pub inside_a_door: bool,
    /// The rule whose action is being walked, for
    /// [ADR-296](../../docs/specification/adr/adr-296.md) D35's refusal - which
    /// needs the rule's name, because a grammar is a page of rules and a caret
    /// on a call inside one is not enough to find it.
    pub inside_an_action: String?,
    /// The name of the enclosing function, where its declaration **writes**
    /// `sync` ([ADR-288](../../docs/specification/adr/adr-288.md) D4: an
    /// assertion is checked, never overwritten).
    ///
    /// It is here because `NK2202` cannot see a **method** call: `contracts::sync`
    /// deliberately does not resolve one, on the ground that the type checker is
    /// the only thing that knows what `tx.send(1)` goes to
    /// ([ADR-288](../../docs/specification/adr/adr-288.md)) — and the type
    /// checker is here. Without it a `sync` function that sends on a channel
    /// lowered to an ordinary `fn` with an `.await` inside it, which is not Rust
    /// (Part III, C.1). Found by
    /// [ADR-149](../../docs/specification/adr/adr-149.md) D2, and reachable
    /// before it through `TaskHandle::join`.
    pub inside_a_sync_function: String?,
}
