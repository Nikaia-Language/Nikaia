// crates/nikaia-std/src/tools/ledger.nika
//
// **How a ledger is written down, read back** (Part III 13.5, ADR-251).
//
// The sixth piece of the compiler moved from Rust to Nikaia (0.0.258), by
// ADR-290's route and on ADR-294's road: lowered ahead of time by
// `nikaia lower-std` to `ledger.rs` beside it, `include!`d as
// `nikaia_std::tools::ledger`, and called from the compiler's
// `Ledger::parse`, which is left holding what each key *means*.
//
// This is the half of the reader that knows the file's shape and nothing of
// its words: which lines are comments, which open a table and what the table
// is called, where a key ends and its value begins, what a quoted string holds
// and where one entry of a list ends. `nikaia.contracts` is generated, so the
// shapes are the ones `Ledger::render` writes - a small reader for a small
// format, deliberately not a TOML parser (ADR-294 keeps the `toml` crate
// behind the manifest's adapter; this file was never read by it).
//
// **A list's entries are split where a comma stands outside quotes.** The Rust
// this replaces split at every comma, and an entry that holds one - a variant
// with two payloads, `"Pair(i64, i64)"`, or a field typed
// `collections::HashMap[String, i64]` - could not be read back: a package with
// either wrote a ledger its consumer refused.
//
// **What each key means is read here too** (0.0.292, ADR-294 step (c)):
// `read` fills the ledger's records, which `ty.nika` declares and this module
// reads beside itself, and the compiler's `Ledger::parse` is a call to it.

use std::collections
use std::text

/// One line of a ledger, as a view of the text it stands in: nothing is
/// copied until a value goes into the ledger.
pub enum LedgerLine {
    /// `[fn."…"]`, `[type."…"]`, `[trait."…"]` or `[impl."…"]`: which kind
    /// of table, and the name between its quotes, as written.
    Table { kind: ref String, name: ref String },
    /// `[sources]`, the one table whose name is not quoted.
    Sources,
    /// `key = value`, each trimmed, the value exactly as it stands.
    Pair { key: ref String, value: ref String },
    /// A blank line or a `#` comment, which says nothing.
    Nothing,
    /// A table header that opens and does not close.
    Unterminated,
    /// A line that is none of these.
    Bad(ref String),
}

/// Why a ledger is refused, in the words the compiler reports.
pub enum Refused {
    Because(String),
}

impl Error for Refused {
    fn message(ref self) -> String {
        return match self {
            Refused::Because(why) => why.clone()
        }
    }
}

// **The file's shape, read by a grammar** (0.0.297): every line, so that its
// place in the list is its number, and each one a view of the text. A
// `nikaia.contracts` is generated, so the shapes are the ones `render`
// writes; what is not one of them is a line the reader refuses by number.
grammar LedgerText {

    // Nothing is skipped: a line is read character by character.
    rule WS = "" { }

    entry rule file -> Vec[LedgerLine] =
        ls:line* last:BODY eof {
            let mut all = Vec()
            for l in ls.drain() { all.push(l) }
            all.push(last)
            all
        }

    rule line -> LedgerLine = l:BODY line_ending { l }

    // The spaces in front once, and then what the first character says the
    // line is: one choice per line rather than one per kind of line.
    rule BODY -> LedgerLine = SP l:AFTER { l }

    rule AFTER -> LedgerLine =
          "#" REST { LedgerLine::Nothing }
        | "[" t:TABLE { t }
        | peek(END) { LedgerLine::Nothing }
        | k:text(KEY) "=" v:text(REST) { LedgerLine::Pair { key: k.trim(), value: v.trim() } }
        | r:text(REST) { LedgerLine::Bad(r.trim()) }

    rule TABLE -> LedgerLine =
          "sources]" SP peek(END) { LedgerLine::Sources }
        | k:KIND ".\"" n:text(NAME) CLOSE { LedgerLine::Table { kind: k, name: n } }
        | KIND ".\"" REST { LedgerLine::Unterminated }

    rule KIND -> ref String =
          "fn" { "fn" }
        | "type" { "type" }
        | "trait" { "trait" }
        | "impl" { "impl" }

    rule SP = SPACE* { }
    rule SPACE = " " { } | "\t" { }
    rule END = line_ending { } | eof { }
    // The rest of a line, found in one scan to its end rather than a
    // character at a time: most of a ledger is comments (10.7).
    rule REST = until(line_ending | eof) { }
    rule CLOSE = "\"]" SP peek(END) { }
    // A table's name and a key, each in one scan to what ends it.
    rule NAME = until("\"]" | line_ending | eof) { }
    rule KEY = until("=" | line_ending | eof) { }
}

// **A value's two shapes**, a quoted string and a list of them, each entry a
// view of the text between its quotes. A comma inside quotes is the entry's,
// and a `\` before a character keeps it from ending one.
grammar LedgerValue {

    entry rule list -> Vec[ref String] = "[" items:list(QUOTED, ",") TRAILING "]" eof { items }

    rule TRAILING = "," { } | empty { }
    rule QUOTED -> ref String = "\"" s:text(INSIDE) "\"" { s }
    rule INSIDE = PIECE* { }
    rule PIECE = ESCAPED { } | not("\"") not("\\") any { }
    rule ESCAPED = "\\" any { }
}

/// What a quoted string holds: `\n` is a line break, and a `\` before any
/// other character is that character.
pub fn unquote(value: ref String) -> String throws {
    return unquote_at(value, "")
}

// `unquote`, with what a refusal starts with: the line, where it is known.
fn unquote_at(value: ref String, at: ref String) -> String throws {
    // The quotes are one byte each, so what is between them is a view of the
    // value itself: no grammar is entered for a value this short.
    if value.len() < 2 || !value.starts_with("\"") || !value.ends_with("\"") {
        throw Refused::Because(f"{at}expected a quoted string, found `{value}`")
    }
    return unescaped(value[1..<value.len() - 1])
}

/// The entries of `["a", "b"]`, each unquoted, split where a comma stands
/// outside quotes.
pub fn list(value: ref String) -> Vec[String] throws {
    return list_at(value, "")
}

// `list`, with what a refusal starts with.
fn list_at(value: ref String, at: ref String) -> Vec[String] throws {
    // `[]` is most lists a ledger writes, and says nothing to read.
    if value == "[]" {
        return []
    }
    let entries = LedgerValue::list(value) catch {
        throw Refused::Because(f"{at}expected a list, found `{value}`")
    }
    let mut out: Vec[String] = []
    for entry in entries {
        out.push(unescaped(entry))
    }
    return out
}

// A quoted string's text as it means it: most have no `\` and are copied as
// they stand.
fn unescaped(inside: ref String) -> String {
    if !inside.contains("\\") {
        return inside.clone()
    }
    let mut out: String = ""
    let mut escaped = false
    for c in inside.chars() {
        if escaped {
            if c == 'n' {
                out.push('\n')
            } else {
                out.push(c)
            }
            escaped = false
        } else if c == '\\' {
            escaped = true
        } else {
            out.push(c)
        }
    }
    return out
}

/// Which table the lines being read belong to. `[sources]` (ADR-100 D3) is
/// why this is not a pair of flags: its keys are neither a function's nor a
/// type's.
enum Section {
    Header,
    Function,
    Kind,
    Sources,
    /// `[trait."X"]` and `[impl."A for T"]`: a table whose whole content is
    /// its name, so a key inside one is a mistake and says so rather than
    /// being filed under the table before it.
    Nothing,
}

/// **A ledger read back from its text**: the file's shape by `lines`, and
/// what each table and key means here.
pub fn read(written: ref String) -> Ledger throws {
    let mut ledger = Ledger::blank()
    let mut section = Section::Header
    let mut current: String = ""
    let mut function = FnContract::empty()
    let mut a_type = TypeContract::empty()
    let mut traits: Vec[String] = []
    let mut functions: Vec[String] = []
    let mut answers: Vec[(String, String)] = []
    // A file this grammar cannot read at all says where, in the parse's own
    // words; every line it can read is refused below by number.
    let lines = LedgerText::file(written) catch {
        throw Refused::Because(f"{error}")
    }
    let mut n = 0
    for one in lines {
        n += 1
        match one {
            LedgerLine::Table { kind, name } => {
                if section == Section::Function {
                    ledger.functions.insert(current.clone(), function)
                    function = FnContract::empty()
                }
                if section == Section::Kind {
                    ledger.types.insert(current.clone(), a_type)
                    a_type = TypeContract::empty()
                }
                current = name.clone()
                if kind == "fn" {
                    if ledger.functions.contains_key(current) {
                        function = ledger.functions[current]?.clone() ?? FnContract::empty()
                    }
                    functions.push(current.clone())
                    section = Section::Function
                } else if kind == "type" {
                    if ledger.types.contains_key(current) {
                        a_type = ledger.types[current]?.clone() ?? TypeContract::empty()
                    }
                    section = Section::Kind
                } else if kind == "trait" {
                    // **A trait's methods are not read here**: they are the
                    // `fn` entries of this same file (ADR-295 D12), filled in
                    // once the whole file is read.
                    if !ledger.traits.contains_key(current) {
                        ledger.traits.insert(current.clone(), collections::BTreeSet())
                    }
                    traits.push(current.clone())
                    section = Section::Nothing
                } else {
                    answers.push(implemented(current, n))
                    section = Section::Nothing
                }
            }
            LedgerLine::Sources => {
                if section == Section::Function {
                    ledger.functions.insert(current.clone(), function)
                    function = FnContract::empty()
                }
                if section == Section::Kind {
                    ledger.types.insert(current.clone(), a_type)
                    a_type = TypeContract::empty()
                }
                section = Section::Sources
            }
            LedgerLine::Pair { key, value } => {
                if section == Section::Header {
                    header(ledger, key, value, n)
                } else if section == Section::Sources {
                    // A unit and its hash, and the **key** is quoted here
                    // where every other table quotes its name: a file name
                    // holds a `.`.
                    ledger.sources.insert(unquoted(key, n), unquoted(value, n))
                } else if section == Section::Function {
                    function_key(function, current, key, value, n)
                } else if section == Section::Kind {
                    type_key(a_type, key, value, n)
                } else {
                    throw Refused::Because(f"line {n}: a `trait` or an `impl` table has no keys, and this has `{key}`")
                }
            }
            LedgerLine::Unterminated => {
                throw Refused::Because(f"line {n}: unterminated section header")
            }
            LedgerLine::Bad(text) => {
                throw Refused::Because(f"line {n}: not a key and a value: {text}")
            }
            LedgerLine::Nothing => {}
        }
    }
    if section == Section::Function {
        ledger.functions.insert(current.clone(), function)
    }
    if section == Section::Kind {
        ledger.types.insert(current.clone(), a_type)
    }
    // **A trait's methods are the `fn` entries the file carries** under
    // `Trait::method`, after the whole file, because a `[trait.…]` table may
    // stand before the entries it owns.
    for name in traits {
        let prefix = f"{name}::"
        let mut methods: collections::BTreeSet[String] = collections::BTreeSet()
        for entry in functions {
            let method = after_prefix(entry, prefix)
            if method != null {
                let rest = method ?? ""
                if !rest.contains("::") {
                    methods.insert(rest.clone())
                }
            }
        }
        ledger.traits.insert(name.clone(), methods)
    }
    // **Who answers for what** (ADR-295 D15), a set per trait, gathered after
    // the whole file because one trait's `impl` tables may stand apart.
    let mut done: Vec[String] = []
    for (trait_name, _) in answers {
        if !done.contains(trait_name) {
            let mut types: collections::BTreeSet[String] = collections::BTreeSet()
            for (other, answering) in answers {
                if other == trait_name {
                    types.insert(answering.clone())
                }
            }
            ledger.implementations.insert(trait_name.clone(), types)
            done.push(trait_name.clone())
        }
    }
    return ledger
}

// The header's three keys.
fn header(mut ledger: Ledger, key: ref String, value: ref String, n: i64) throws {
    if key == "version" {
        let number = text::parse_i64(value) ?? -1
        if number < 0 {
            throw Refused::Because(f"line {n}: `version` is a whole number, not `{value}`")
        }
        if number > 4294967295 {
            throw Refused::Because(f"line {n}: `version` is a whole number, not `{value}`")
        }
        ledger.version = number as u32
    } else if key == "toolchain" {
        ledger.toolchain = unquoted(value, n)
    } else if key == "inference" {
        ledger.inference = unquoted(value, n)
    } else {
        throw Refused::Because(f"line {n}: unknown header key `{key}`")
    }
}

// `[impl."A for T"]`: the trait `A`, and `T`, which answers for it (ADR-295
// D1).
fn implemented(name: ref String, n: i64) -> (String, String) throws {
    let c: Vec[char] = name.chars().collect()
    let at = find_text(c, 0, " for ")
    if at < 0 {
        throw Refused::Because(f"line {n}: an `impl` entry is `A for T`: {name}")
    }
    return (trimmed(slice(c, 0, at)), trimmed(slice(c, at + 5, c.len())))
}

// One key of a `[fn."…"]` table.
fn function_key(mut entry: FnContract, name: ref String, key: ref String, value: ref String, n: i64) throws {
    if key == "pub" {
        entry.public = value == "true"
    } else if key == "sync" {
        entry.sync_claim = sync_of(value, n)
    } else if key == "throws" {
        entry.fails_with = throws_of(value, n)
    } else if key == "returns" {
        entry.borrows = borrows_of(unquoted(value, n), n)
    } else if key == "signature" {
        // **Read back from Nikaia's spelling** (ADR-251 D4): the receiver says
        // whether the call changes it, and a `ref(a | b)` in the result where
        // it points.
        let spelled = spelled_signature(unquoted(value, n), name)
        if spelled.mutates {
            entry.mutates = true
        }
        if spelled.borrows.len() > 0 {
            entry.borrows = spelled.borrows.clone()
        }
        entry.signature = spelled.signature
    } else if key == "keeps" {
        entry.keeps = entries(value, n)
    } else if key == "mutates" {
        entry.mutates = value == "true"
    } else if key == "locks" {
        let said = value.trim()
        if said == "true" {
            entry.touches_a_lock = Lock::Holds
        } else if said == "\"?\"" {
            entry.touches_a_lock = Lock::Undecided
        } else {
            entry.touches_a_lock = Lock::No
        }
    } else if key == "threads" {
        let said = value.trim()
        if said == "true" {
            entry.threads = Threads::May
        } else if said == "false" {
            entry.threads = Threads::MayNot
        } else {
            throw Refused::Because(f"line {n}: `threads` is `true` or `false`, not `{said}`. (Leave it out if nobody knows.)")
        }
    } else if key == "touches" {
        let mut touches: Vec[Touch] = []
        for one in entries(value, n) {
            touches.push(touch_of(one))
        }
        entry.touches = touches
        entry.touches_known = true
    } else if key == "provenance" {
        entry.provenance = provenance_of(unquoted(value, n), n)
    } else if key == "views" {
        let mut views: Vec[Held] = []
        for held in entries(value, n) {
            let read = held_of(held)
            if read == null {
                throw Refused::Because(f"line {n}: a tether state is `name: borrowed` or `name: tethered`, not `{held}`")
            }
            views.push(read ?? Held { position: "", state: State::Borrowed })
        }
        entry.views = views
    } else if key == "sharing" {
        let mut classes: Vec[Class] = []
        for class in entries(value, n) {
            let read = class_of(class)
            if read == null {
                throw Refused::Because(f"line {n}: a sharing class is `a | b: plain` or `a | b: atomic`, not `{class}`")
            }
            classes.push(read ?? Class { members: [], count: Count::Atomic })
        }
        entry.sharing = classes
    } else if key == "ends_by_length" {
        entry.ends_by_length = value == "true"
    } else if key == "requires" {
        entry.requires = entries(value, n)
    } else if key == "ensures" {
        entry.ensures = entries(value, n)
    } else if key == "from" {
        entry.from = entries(value, n)
    } else {
        throw Refused::Because(f"line {n}: unknown key `{key}` on a fn")
    }
}

// One key of a `[type."…"]` table.
fn type_key(mut entry: TypeContract, key: ref String, value: ref String, n: i64) throws {
    if key == "pub" {
        entry.public = value == "true"
    } else if key == "crosses" {
        // Refused rather than guessed at: a third spelling is a claim somebody
        // meant to make, and reading it as either would put a promise or a
        // restriction in the file that nobody wrote.
        if value == "true" {
            entry.crosses = Crosses::May
        } else if value == "false" {
            entry.crosses = Crosses::MayNot
        } else {
            throw Refused::Because(f"line {n}: `crosses` is `true` or `false`, not `{value}` - and leaving the line out is the third answer")
        }
    } else if key == "compares" {
        entry.compares = value.trim() == "true"
    } else if key == "copies" {
        entry.copies = value.trim() == "true"
    } else if key == "tethered" {
        entry.tethered = entries(value, n)
    } else if key == "touches" {
        entry.touches = entries(value, n)
    } else if key == "iterates" {
        let said = unquoted(value, n)
        if said != "throws" {
            throw Refused::Because(f"line {n}: `iterates` is `throws` and nothing else, not `{said}` - a step that cannot fail says nothing")
        }
        entry.iterates_fallibly = true
    } else if key == "variants" {
        let mut variants: Vec[VariantContract] = []
        for one in entries(value, n) {
            variants.push(variant_of(one))
        }
        entry.variants = variants
    } else if key == "fields" {
        let mut fields: Vec[FieldContract] = []
        for one in entries(value, n) {
            fields.push(field_of(one))
        }
        entry.fields = fields
    } else {
        throw Refused::Because(f"line {n}: unknown key `{key}` on a type")
    }
}

// A quoted value, with the line a refusal names.
fn unquoted(value: ref String, n: i64) -> String throws {
    return unquote_at(value, f"line {n}: ")
}

// A list's entries, with the line a refusal names.
fn entries(value: ref String, n: i64) -> Vec[String] throws {
    return list_at(value, f"line {n}: ")
}

/// `sync = true` is a promise the source made, `"inferred"` one the body
/// implies, `"sync(f)"` one its lambda decides. `false` is what leaving the
/// key out says, and a file that writes it is not refused for saying so.
fn sync_of(value: ref String, n: i64) -> Sync throws {
    if value == "true" {
        return Sync::Asserted
    }
    if value == "false" {
        return Sync::No
    }
    if value == "\"inferred\"" {
        return Sync::Inferred
    }
    let c: Vec[char] = value.chars().collect()
    if value.ends_with(")\"") && (value.starts_with("\"sync(") || value.starts_with("\"from(")) && c.len() >= 8 {
        let inside = slice(c, 6, c.len() - 2)
        let name = inside.trim()
        if name.len() > 0 {
            return Sync::From(name.clone())
        }
    }
    throw Refused::Because(f"line {n}: `sync` is `true` (the source says so), `\"inferred\"` (the body implies it) or `\"sync(f)\"` (its lambda decides), not `{value}`")
}

/// Kap 7.1: the errors that can leave a function. A ledger from before
/// ADR-023 D1 writes `true`, which is read as `["?"]`: it fails, with
/// something the file does not name.
fn throws_of(value: ref String, n: i64) -> Vec[String] throws {
    if value == "true" {
        let unnamed: String = "?"
        return [unnamed]
    }
    return entries(value, n)
}

// `ref(a | b)`, and `borrows(a | b)`, the spelling before ADR-251 D4.
fn borrows_of(value: ref String, n: i64) -> Vec[String] throws {
    let c: Vec[char] = value.chars().collect()
    let mut from = -1
    if value.ends_with(")") {
        if value.starts_with("ref(") {
            from = 4
        } else if value.starts_with("borrows(") {
            from = 8
        }
    }
    if from < 0 {
        throw Refused::Because(f"line {n}: expected `ref(…)`, found `{value}`")
    }
    let inside = slice(c, from, c.len() - 1)
    let mut names: Vec[String] = []
    for part in inside.split("|") {
        let name = part.trim()
        if name.len() > 0 {
            names.push(name.clone())
        }
    }
    return names
}

fn provenance_of(value: ref String, n: i64) -> Provenance throws {
    if value == "trusted" {
        return Provenance::Trusted
    }
    if value == "untrusted" {
        return Provenance::Untrusted
    }
    throw Refused::Because(f"line {n}: a provenance is `trusted` or `untrusted`, not `{value}`")
}

/// **A touch read back from its text**: `resource read`, `kind(parameter)
/// write`.
pub fn touch_of(written: ref String) -> Touch throws {
    let whole = written.trim()
    let c: Vec[char] = whole.chars().collect()
    let space = find_last(c, ' ')
    if space < 0 {
        throw Refused::Because(f"a touch is `resource read` or `resource write`, found `{whole}`")
    }
    let said = slice(c, space + 1, c.len())
    let access = said.trim()
    let mut write = false
    if access == "write" {
        write = true
    } else if access != "read" {
        throw Refused::Because(f"a touch is `read` or `write`, not `{access}` (in `{whole}`)")
    }
    let before = slice(c, 0, space)
    let resource = before.trim()
    let r: Vec[char] = resource.chars().collect()
    let open = find(r, 0, '(')
    let mut kind: String = resource.clone()
    let mut parameter: String? = null
    if open >= 0 {
        if !resource.ends_with(")") {
            throw Refused::Because(f"a resource is `kind(parameter)`, and `{resource}` has no `)`")
        }
        let named = slice(r, 0, open)
        kind = named.trim().clone()
        let inside = slice(r, open + 1, r.len() - 1)
        parameter = inside.trim().clone()
    }
    if kind.len() == 0 {
        throw Refused::Because(f"a touch needs a resource kind, found `{whole}`")
    }
    return Touch { kind: kind, parameter: parameter, write: write }
}

/// `position: borrowed` or `position: tethered`, or nothing.
pub fn held_of(written: ref String) -> Held? {
    let c: Vec[char] = written.chars().collect()
    let colon = find_last(c, ':')
    if colon < 0 {
        return null
    }
    let state = State::parse(slice(c, colon + 1, c.len()))
    if state == null {
        return null
    }
    let position = slice(c, 0, colon)
    return Held { position: position.trim().clone(), state: state ?? State::Borrowed }
}

/// `a | b: plain`, or nothing where no member or no count is written.
pub fn class_of(written: ref String) -> Class? {
    let c: Vec[char] = written.chars().collect()
    let colon = find_last(c, ':')
    if colon < 0 {
        return null
    }
    let named = slice(c, 0, colon)
    let mut members: Vec[String] = []
    for part in named.split("|") {
        let member = part.trim()
        if member.len() > 0 {
            members.push(member.clone())
        }
    }
    if members.len() == 0 {
        return null
    }
    let count = Count::parse(slice(c, colon + 1, c.len()))
    if count == null {
        return null
    }
    return Class { members: members, count: count ?? Count::Atomic }
}

/// A variant back from `Name`, `Name(A, B)` or `Name { a: A }`.
pub fn variant_of(written: ref String) -> VariantContract {
    let whole = written.trim()
    let c: Vec[char] = whole.chars().collect()
    let paren = find(c, 0, '(')
    if paren >= 0 {
        let named = slice(c, 0, paren)
        let rest = slice(c, paren + 1, c.len())
        let inside = without_last(rest.trim_end(), ')')
        let mut holds: Vec[FieldContract] = []
        let mut at = 0
        for part in split_args(inside) {
            holds.push(FieldContract { name: f"{at}", ty: parse(part), public: true })
            at += 1
        }
        return VariantContract { name: named.trim().clone(), holds: holds, positional: true }
    }
    let brace = find(c, 0, '{')
    if brace >= 0 {
        let named = slice(c, 0, brace)
        let rest = slice(c, brace + 1, c.len())
        let inside = without_last(rest.trim_end(), '}')
        let mut holds: Vec[FieldContract] = []
        for part in split_args(inside) {
            let p: Vec[char] = part.chars().collect()
            let colon = find(p, 0, ':')
            if colon >= 0 {
                let field = slice(p, 0, colon)
                holds.push(FieldContract { name: field.trim().clone(), ty: parse(slice(p, colon + 1, p.len())), public: true })
            }
        }
        return VariantContract { name: named.trim().clone(), holds: holds, positional: false }
    }
    let nothing: Vec[FieldContract] = []
    return VariantContract { name: whole.clone(), holds: nothing, positional: false }
}

// A field back from `pub name: T`. `pub ` is optional, so a ledger written
// before the word existed reads as a type with no public fields, which is the
// fail-closed reading (ADR-010 D1).
fn field_of(written: ref String) -> FieldContract {
    let mut field: String = written.trim().clone()
    let mut public = false
    if field.starts_with("pub ") {
        public = true
        let rest = from_char(field, 4)
        field = rest.trim().clone()
    }
    let c: Vec[char] = field.chars().collect()
    let colon = find(c, 0, ':')
    if colon < 0 {
        return FieldContract { name: field.clone(), ty: Ty::Unknown, public: public }
    }
    let name = slice(c, 0, colon)
    return FieldContract { name: name.trim().clone(), ty: parse(slice(c, colon + 1, c.len())), public: public }
}

/// **A signature read back from the compiler's text**: `[T: Trait](a: A, mut
/// b: B; option: C = 1) -> R`, which is the file's spelling with the receiver
/// a type and the variables written `$T`.
pub fn signature_of(written: ref String) -> Signature throws {
    let spelled = spelled_signature(written, "")
    return spelled.signature
}

/// A signature read back, and the two facts its spelling carries beside it.
pub struct Spelling {
    pub signature: Signature,
    /// Where the result points, from its `ref(a | b)`, in the order the
    /// parameters are declared.
    pub borrows: Vec[String],
    /// Whether the receiver is written `ref mut self` or `mut self: T`.
    pub mutates: bool,
}

/// One part of a parameter list, as it is written.
enum Piece {
    /// `self`, `ref self`, `ref mut self`: the type the entry is on.
    Owner { view: bool, mutates: bool },
    /// `self: T`, `mut self: T`, or a bare type, which is the receiver in the
    /// spelling before ADR-251.
    Typed { ty: ref String, mutates: bool },
    /// `name: T` or `mut name: T`.
    Named { name: ref String, ty: ref String, mutable: bool },
}

/// One entry of the bracket list: a type variable, and its bounds.
struct Declared {
    name: ref String,
    traits: Vec[ref String],
}

/// An option after the `;` (Kap 5.1): `name: T = value`.
struct Setting {
    name: ref String,
    ty: ref String,
    default: ref String,
}

/// A signature taken apart, every piece a view of its text.
struct Signed {
    declared: Vec[Declared],
    parts: Vec[Piece],
    settings: Vec[Setting],
    result: ref String?,
}

// **A signature, read by a grammar** (0.0.297): the file's spelling
// (ADR-251 D4) and the compiler's, in one pass, each piece a view. A type is
// the text up to what ends it, with its own brackets and strings inside, and
// `Ty`'s reader reads it.
grammar SignatureText {

    entry rule signature -> Signed =
        d:bracket "(" ps:list(part, ",") TRAILING ss:settings ")" r:result? eof {
            Signed { declared: d, parts: ps, settings: ss, result: r }
        }

    rule bracket -> Vec[Declared] = "[" ds:list(declared, ",") "]" { ds } | empty { Vec() }

    rule declared -> Declared =
          n:raw_ident COLON ts:list(BOUND, "+") { Declared { name: n, traits: ts } }
        | n:raw_ident { Declared { name: n, traits: Vec() } }

    rule part -> Piece =
          REF MUT SELF { Piece::Owner { view: true, mutates: true } }
        | REF SELF { Piece::Owner { view: true, mutates: false } }
        | MUT SELF COLON t:TYPE { Piece::Typed { ty: t, mutates: true } }
        | SELF COLON t:TYPE { Piece::Typed { ty: t, mutates: false } }
        | SELF { Piece::Owner { view: false, mutates: false } }
        | MUT n:raw_ident COLON t:TYPE { Piece::Named { name: n, ty: t, mutable: true } }
        | n:raw_ident COLON t:TYPE { Piece::Named { name: n, ty: t, mutable: false } }
        | t:TYPE { Piece::Typed { ty: t, mutates: false } }

    rule settings -> Vec[Setting] = ";" ss:list(setting, ",") TRAILING { ss } | empty { Vec() }

    rule setting -> Setting =
        n:raw_ident COLON t:SETTING_TYPE "=" d:DEFAULT { Setting { name: n, ty: t, default: d } }

    rule result -> ref String = "->" t:REST { t }

    // The names a result points into: every `ref(a | b)` in it, and a word
    // that only ends in `ref` is not one.
    entry rule pointed -> Vec[Vec[ref String]] = ps:POINTING* eof { ps }

    rule POINTING -> Vec[ref String] =
          "ref(" ns:list(POINTED_NAME, "|") ")" { ns }
        | WORD_CHARS { Vec() }
        | any { Vec() }

    rule POINTED_NAME -> ref String = WS0 n:raw_ident WS0 { n }
    rule WS0 = " "* { }
    rule WORD_CHARS = WORD_CHAR+ { }
    rule WORD_CHAR = alpha1 { } | digit { } | "_" { } | "$" { }

    rule REF = "ref" not(WORD_CHAR) { }
    rule MUT = "mut" not(WORD_CHAR) { }
    rule SELF = "self" not(WORD_CHAR) { }
    rule COLON = ":" not(":") { }
    rule TRAILING = "," { } | empty { }

    rule BOUND -> ref String = t:text(BOUND_RUN) { t.trim() }
    rule BOUND_RUN = BOUND_PIECE+ { }
    rule BOUND_PIECE = not("+") not(",") not("]") SPAN { }

    rule TYPE -> ref String = t:text(TYPE_RUN) { t.trim() }
    rule TYPE_RUN = TYPE_PIECE+ { }
    rule TYPE_PIECE = not(",") not(")") not(";") SPAN { }

    rule SETTING_TYPE -> ref String = t:text(SETTING_RUN) { t.trim() }
    rule SETTING_RUN = SETTING_PIECE+ { }
    rule SETTING_PIECE = not("=") not(",") not(")") SPAN { }

    rule DEFAULT -> ref String = t:text(DEFAULT_RUN) { t.trim() }
    rule DEFAULT_RUN = DEFAULT_PIECE+ { }
    rule DEFAULT_PIECE = not(",") not(")") SPAN { }

    rule REST -> ref String = t:text(REST_RUN) { t.trim() }
    rule REST_RUN = until(eof) { }

    // One unit of a type: a bracket group with what is inside it, a quoted
    // string, or one character.
    // A brace group too: a default may be a struct, `Point { x: 1, y: 2 }`
    // (ADR-318 D3), whose commas are its own.
    rule SPAN = PARENS { } | BRACKETS { } | BRACES { } | STRING { } | any { }
    rule PARENS = "(" IN_PARENS* ")" { }
    rule BRACES = "{" IN_BRACES* "}" { }
    rule IN_BRACES = not("}") SPAN { }
    rule IN_PARENS = not(")") SPAN { }
    rule BRACKETS = "[" IN_BRACKETS* "]" { }
    rule IN_BRACKETS = not("]") SPAN { }
    rule STRING = "\"" STRING_PIECE* "\"" { }
    rule STRING_PIECE = "\\" any { } | not("\"") any { }
}

/// **A signature read back from either spelling**, with what the file's
/// spelling says beside it: the receiver as the type `key` is on, a bracket
/// list's names as variables, and where the result points.
pub fn spelled_signature(written: ref String, key: ref String) -> Spelling throws {
    let parts = SignatureText::signature(written) catch {
        throw Refused::Because(f"a signature is `[T](a: A; o: O = v) -> R`, found `{written}`")
    }
    let mut variables: collections::BTreeSet[String] = collections::BTreeSet()
    let mut bounds: Vec[(String, Vec[String])] = []
    for declared in parts.declared {
        variables.insert(declared.name.clone())
        // A ledger's entry lists the parameters that have a bound, which is
        // what the contract records; a signature read on its own (no `key`)
        // lists every one, `[H: One, U]` as two entries.
        if declared.traits.len() > 0 || key.len() == 0 {
            let mut traits: Vec[String] = []
            for one in declared.traits {
                traits.push(one.clone())
            }
            bounds.push(a_bound(declared.name, traits))
        }
    }
    let mut params: Vec[(String, Ty)] = []
    let mut changed: Vec[String] = []
    let mut order: Vec[String] = []
    let mut receiver_changes = false
    let mut first = true
    for part in parts.parts {
        match part {
            Piece::Owner { view, mutates } => {
                let owner = owner_of(key) ?? "?"
                let written_type = if view { f"ref {owner}" } else { owner.clone() }
                params.push(a_param("self", typed(written_type, variables)))
                if mutates {
                    receiver_changes = true
                }
                if first {
                    order.push(a_receiver())
                }
            }
            Piece::Typed { ty, mutates } => {
                params.push(a_param("self", typed(ty, variables)))
                if mutates {
                    receiver_changes = true
                }
                if first {
                    order.push(a_receiver())
                }
            }
            Piece::Named { name, ty, mutable } => {
                params.push(a_param(name, typed(ty, variables)))
                if mutable {
                    changed.push(name.clone())
                }
                order.push(name.clone())
            }
        }
        first = false
    }
    let mut config: Vec[ConfigContract] = []
    for setting in parts.settings {
        config.push(ConfigContract { name: setting.name.clone(), ty: typed(setting.ty, variables), default: setting.default.clone() })
    }
    let mut result: Ty? = null
    let mut borrows: Vec[String] = []
    let result_text = parts.result ?? ""
    if parts.result != null {
        result = typed(result_text, variables)
        borrows = pointed_into(result_text, order)
    }
    return Spelling {
        signature: Signature { bounds: bounds, params: params, mutable: changed, config: config, result: result },
        borrows: borrows,
        mutates: receiver_changes,
    }
}

// A type read back, with the bracket list's names as variables.
fn typed(written: ref String, variables: ref collections::BTreeSet[String]) -> Ty {
    let ty = parse(written)
    if variables.len() == 0 {
        return ty
    }
    return ty.parameterise(variables)
}

// The names every `ref(…)` in a result holds, in the order the parameters are
// declared, then any the list does not name.
fn pointed_into(result: ref String, order: ref Vec[String]) -> Vec[String] {
    if !result.contains("ref(") {
        return []
    }
    let groups = SignatureText::pointed(result) catch {
        return []
    }
    let mut named: Vec[String] = []
    for group in groups {
        for name in group {
            if !named.contains(name) {
                named.push(name.clone())
            }
        }
    }
    let mut borrows: Vec[String] = []
    for name in order {
        if named.contains(name) {
            borrows.push(name.clone())
        }
    }
    for name in named {
        if !borrows.contains(name) {
            borrows.push(name.clone())
        }
    }
    return borrows
}

fn a_bound(name: ref String, traits: Vec[String]) -> (String, Vec[String]) {
    return (name.clone(), traits)
}

fn a_receiver() -> String {
    let receiver: String = "self"
    return receiver
}

// The type an entry's receiver is when it is written `self`: what stands
// before the last `::` of its key.
fn owner_of(key: ref String) -> String? {
    let c: Vec[char] = key.chars().collect()
    let mut last = -1
    for at in 0..<c.len() {
        if at + 1 < c.len() && c[at] == ':' && c[at + 1] == ':' {
            last = at
        }
    }
    if last < 0 {
        return null
    }
    return slice(c, 0, last)
}

// Where `target` first stands at or after `from`, or -1.
fn find(c: ref Array[char], from: i64, target: char) -> i64 {
    for at in from..<c.len() {
        if c[at] == target {
            return at
        }
    }
    return -1
}

// Where `target` last stands, or -1.
fn find_last(c: ref Array[char], target: char) -> i64 {
    let mut found = -1
    for at in 0..<c.len() {
        if c[at] == target {
            found = at
        }
    }
    return found
}

// Where `word` first stands at or after `from`, or -1.
fn find_text(c: ref Array[char], from: i64, word: ref String) -> i64 {
    let w: Vec[char] = word.chars().collect()
    if w.len() == 0 || c.len() < w.len() {
        return -1
    }
    for at in from..<c.len() - w.len() + 1 {
        let mut same = true
        for k in 0..<w.len() {
            if same && c[at + k] != w[k] {
                same = false
            }
        }
        if same {
            return at
        }
    }
    return -1
}

// The characters from `from` up to `to`, as text.
fn slice(c: ref Array[char], from: i64, to: i64) -> String {
    let mut out: String = ""
    for k in from..<to {
        out.push(c[k])
    }
    return out
}

// `written` from its `front`th character on.
fn from_char(written: ref String, front: i64) -> String {
    let c: Vec[char] = written.chars().collect()
    return slice(c, front, c.len())
}

// `written` after `prefix`, or nothing where it does not start with it.
fn after_prefix(written: ref String, prefix: ref String) -> String? {
    if !written.starts_with(prefix) {
        return null
    }
    let p: Vec[char] = prefix.chars().collect()
    return from_char(written, p.len())
}

// `written` with every `last` at its end taken off.
fn without_last(written: ref String, last: char) -> String {
    let c: Vec[char] = written.chars().collect()
    let mut end = c.len()
    while end > 0 && c[end - 1] == last {
        end -= 1
    }
    return slice(c, 0, end)
}

// A parameter and its type, read.
fn a_param(name: ref String, ty: Ty) -> (String, Ty) {
    return (name.clone(), ty)
}

// `written` trimmed, as text of its own.
fn trimmed(written: ref String) -> String {
    return written.trim().clone()
}


// ---------------------------------------------------------------------------
// **A signature written the way Nikaia writes one** (ADR-251 D4), moved from
// the compiler's `contracts::spelling` (#125). The compiler keeps a signature
// as it always has - the receiver as its type, a type variable as `$T`, what
// the result points into as a list beside it - and this writes the file's
// spelling; `spelled_signature` above reads it back.
//
//     (ref Scan, c: char)                       mutates = true
//     (ref mut self, c: char)
//
//     (ref HashMap[$K, $V], key: ?) -> Entry[$V]
//     [K, V](ref self: HashMap[K, V], key: ?) -> Entry[V]
//
//     (ref Position) -> ref String              returns = "borrows(self)"
//     (ref self) -> ref(self) String

/// A signature in the file's spelling, and which of the two facts beside it the
/// spelling could carry: a result with no `ref` in it has no place for where it
/// points, and a function with no receiver none for whether the call changes it.
pub struct Spelled {
    pub text: String,
    pub borrows_said: bool,
    pub mutates_said: bool,
}

/// The compiler's signature text, `key`'s entry, into the file's spelling.
/// Text that is not a signature stays as it is, and says neither fact.
pub fn spell(text: ref String, key: ref String, borrows: ref Vec[String], mutates: bool) -> Spelled {
    let c: Vec[char] = text.trim().chars().collect()
    // The bracket list's entries, where there is one.
    let mut declared: Vec[String] = []
    let mut open = 0
    if c.len() > 0 && c[0] == '[' {
        let close = matching(c, 1, '[', ']')
        if close < 0 {
            return as_written(text)
        }
        for entry in split_args(slice(c, 1, close)) {
            let entry = trimmed(entry)
            if entry.len() > 0 {
                declared.push(entry)
            }
        }
        open = close + 1
        while open < c.len() && c[open].is_whitespace() {
            open += 1
        }
    }
    if open >= c.len() || c[open] != '(' {
        return as_written(text)
    }
    let close = matching(c, open + 1, '(', ')')
    if close < 0 {
        return as_written(text)
    }
    let inside: Vec[char] = slice(c, open + 1, close).chars().collect()
    let mut result = slice(c, close + 1, c.len())

    // The positional parameters, and the options after a `;`.
    let semicolon = top_level_semicolon(inside)
    let positional = if semicolon < 0 { slice(inside, 0, inside.len()) } else { slice(inside, 0, semicolon) }
    let mut parameters: Vec[String] = []
    for part in split_args(positional) {
        let part = trimmed(part)
        if part.len() > 0 {
            parameters.push(part)
        }
    }

    // **The receiver as the source writes it.** `ref self` where the type is
    // the owner's own, and the type written out where it is not - a type with
    // arguments, a trait's `?`.
    let mut mutates_said = false
    let mut written_parameters: Vec[String] = []
    for k in 0..<parameters.len() {
        if k == 0 && !is_named(parameters[0]) {
            written_parameters.push(receiver(parameters[0], key, mutates))
            mutates_said = mutates
        } else {
            written_parameters.push(parameters[k].clone())
        }
    }

    // **Where the result points, in the result** - every `ref` in it, because
    // a view the result holds may point into any view it was given.
    let mut borrows_said = false
    if borrows.len() > 0 && word_starts(result, "ref").len() > 0 {
        let pointed = joined_by(borrows, " | ")
        result = replace_ref(result, f"ref({pointed})")
        borrows_said = true
    }

    // **Type variables declared in brackets**, the bounded ones first and in
    // their order, then every other in the order it first appears.
    let mut seen: Vec[String] = []
    for entry in declared {
        seen.push(before_colon(entry))
    }
    let mut body = joined_by(written_parameters, ", ")
    if semicolon >= 0 {
        let options = trimmed(slice(inside, semicolon + 1, inside.len()))
        body = f"{body}; {options}"
    }
    for variable in variables(f"{body}{result}") {
        if !seen.contains(variable) {
            seen.push(variable.clone())
            declared.push(variable.clone())
        }
    }
    let mut before: String = ""
    if declared.len() > 0 {
        let names = joined_by(declared, ", ")
        before = f"[{names}]"
    }
    return Spelled { text: without_dollars(f"{before}({body}){result}"), borrows_said: borrows_said, mutates_said: mutates_said }
}

// What is not a signature, kept as it is.
fn as_written(text: ref String) -> Spelled {
    return Spelled { text: text.clone(), borrows_said: false, mutates_said: false }
}

// The receiver, `written` as the compiler keeps it, as the source writes it.
fn receiver(written: ref String, key: ref String, mutates: bool) -> String {
    let has_owner = owner_of(key) != null
    let owner = owner_of(key) ?? ""
    let viewed = after_prefix(written, "ref ")
    if viewed != null && has_owner && (viewed ?? "") == owner {
        if mutates {
            return "ref mut self"
        }
        return "ref self"
    }
    if viewed == null && has_owner && written == owner && !mutates {
        return "self"
    }
    if mutates {
        return f"mut self: {written}"
    }
    return f"self: {written}"
}

// `name: T` or `mut name: T`, and not a bare type - which may hold a `::`.
fn is_named(part: ref String) -> bool {
    let mut rest = trimmed(part)
    while rest.starts_with("mut ") {
        rest = from_char(rest, 4)
    }
    let c: Vec[char] = rest.chars().collect()
    let mut end = 0
    while end < c.len() && is_word_char(c[end]) {
        end += 1
    }
    if end == 0 || !(is_lower(c[0]) || c[0] == '_') {
        return false
    }
    let after = trimmed_start(slice(c, end, c.len()))
    return after.starts_with(":") && !after.starts_with("::")
}

// Where the bracket opened just before `from` closes, or -1.
fn matching(c: ref Array[char], from: i64, open: char, close: char) -> i64 {
    let mut depth = 0
    for at in from..<c.len() {
        if c[at] == open {
            depth += 1
        } else if c[at] == close {
            if depth == 0 {
                return at
            }
            depth -= 1
        }
    }
    return -1
}

// Where the first `;` outside a bracket stands, or -1.
fn top_level_semicolon(c: ref Array[char]) -> i64 {
    let mut depth = 0
    for at in 0..<c.len() {
        if c[at] == '[' || c[at] == '(' {
            depth += 1
        } else if c[at] == ']' || c[at] == ')' {
            if depth > 0 {
                depth -= 1
            }
        } else if c[at] == ';' && depth == 0 {
            return at
        }
    }
    return -1
}

// Where `word` stands in `text` as a word of its own, followed by a blank.
fn word_starts(text: ref String, word: ref String) -> Vec[i64] {
    let c: Vec[char] = text.chars().collect()
    let w: Vec[char] = word.chars().collect()
    let mut starts: Vec[i64] = []
    let mut at = find_text(c, 0, word)
    while at >= 0 {
        let free_before = at == 0 || !(is_word_char(c[at - 1]) || c[at - 1] == '$')
        let blank_after = at + w.len() < c.len() && c[at + w.len()] == ' '
        if free_before && blank_after {
            starts.push(at)
        }
        at = find_text(c, at + 1, word)
    }
    return starts
}

// Every `ref ` in `text`, written `by ` instead.
fn replace_ref(text: ref String, by: ref String) -> String {
    let c: Vec[char] = text.chars().collect()
    let mut out: String = ""
    let mut from = 0
    for at in word_starts(text, "ref") {
        out.push_str(ref slice(c, from, at))
        out.push_str(by)
        from = at + 3
    }
    out.push_str(ref slice(c, from, c.len()))
    return out
}

// Every `$T` in `text`, by name, in the order each first appears.
fn variables(text: ref String) -> Vec[String] {
    let c: Vec[char] = text.chars().collect()
    let mut out: Vec[String] = []
    for at in 0..<c.len() {
        if c[at] == '$' {
            let mut end = at + 1
            while end < c.len() && is_word_char(c[end]) {
                end += 1
            }
            let name = slice(c, at + 1, end)
            if name.len() > 0 && !out.contains(name) {
                out.push(name)
            }
        }
    }
    return out
}

// `parts` with `between` between each two.
fn joined_by(parts: ref Vec[String], between: ref String) -> String {
    let mut out: String = ""
    for k in 0..<parts.len() {
        if k > 0 {
            out.push_str(between)
        }
        out.push_str(ref parts[k])
    }
    return out
}

// `text` without its `$`s.
fn without_dollars(text: ref String) -> String {
    let mut out: String = ""
    for c in text.chars() {
        if c != '$' {
            out.push(c)
        }
    }
    return out
}

// `written` with the blanks at its front taken off.
fn trimmed_start(written: ref String) -> String {
    return written.trim_start().clone()
}

fn is_word_char(c: char) -> bool {
    return is_lower(c) || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn is_lower(c: char) -> bool {
    return c >= 'a' && c <= 'z'
}
