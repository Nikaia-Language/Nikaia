// crates/nikaia-std/src/tools/check_literals.nika
//
// **Refusals about a table, an index computed at build time, a thrown value
// and a C handle** - moved from the compiler's checker (ADR-294, #125, #558).

impl CheckState {
    /// `NK1169`: a fixed table that holds a key twice. `first` and `again` are
    /// the places of the two pairs, counted from 0.
    pub fn a_table_with_one_key_twice(ref mut self, bound: ref String, key: ref String, first: i64, again: i64, span: ref Span) sync {
        self.findings.push(check_refusal("NK1169", span, f"`{bound}` has the key `{key}` twice.", [f"Pairs {first + 1} and {again + 1} both use it, and a table holds one value per key."], "Remove one of them, or give them different keys.".clone()))
    }

    /// `NK1170`: a fixed table whose keys are not text.
    pub fn a_table_key_that_is_not_text(ref mut self, bound: ref String, key: ref String, span: ref Span) sync {
        self.findings.push(check_refusal("NK1170", span, f"`{bound}` uses `{key}` as its keys, but a fixed table's keys are text.", ["A fixed table looks up text keys. Numbers or `bool`s as keys need a different kind of table, which isn't available yet.".clone()], "Write the keys as text, or use a `collections::HashMap` built while the program runs.".clone()))
    }

    /// **`NK1165`: a build-time index the array does not have.**
    ///
    /// The same mistake a running program makes, met at the one moment there is
    /// no run to abort: `xs[7]` of five elements while the program is being
    /// built. [ADR-285](../../docs/specification/adr/adr-285.md) D1 aborts with
    /// this sentence at run time, and saying *this compiler cannot evaluate it*
    /// instead would send the reader looking for a missing feature rather than
    /// at the line ([Part III C.2](../../docs/specification/30-nikaia-tooling.md)).
    pub fn a_build_time_index_is_not_there(ref mut self, at: ref Integer, len: i64, span: ref Span) sync {
        let help: String = match len {
            0 => "The array is empty, so there's nothing to read.",
            else => f"The indexes go from 0 to {len - 1}.",
        }
        self.findings.push(check_refusal("NK1165", span, f"This reads element {integer_text(at)}, but there are only {counted(len, "element")}.", ["This is computed while the program is built, so the read would fail right here.".clone()], help))
    }

    /// `NK1161`: a `throw` of something that is not an error (Part I 7.1).
    ///
    /// *"What is thrown implements `Error`, and the `impl` line says so."* A
    /// number, a `bool`, a `char` and **text** are Part I 2.2's own types and
    /// none of them does — nor ever will, because an `impl` for one would have
    /// to be written somewhere and there is nowhere.
    ///
    /// **Only those**, which is the whole rule and is what makes it safe. A
    /// type this file declares may have its `impl Error` in another file of the
    /// same package ([ADR-286](../../docs/specification/adr/adr-286.md)), a
    /// package's type is not this compiler's to answer for
    /// ([ADR-286](../../docs/specification/adr/adr-286.md) D11), and a caught
    /// error re-thrown is a `?` — so each of those is left alone, which is
    /// [Part III C.4](../../docs/specification/30-nikaia-tooling.md)'s rule.
    ///
    /// **Found by writing `sqlite3` end to end**
    /// ([ADR-302](../../docs/specification/adr/adr-302.md) step 5), which is
    /// what that step is for: `throw "no database"` read like a program and
    /// `rustc` answered *the trait bound `str: Error` is not satisfied* about a
    /// file nobody wrote. It had been writable since `throw` existed and no
    /// program in the tree had written one.
    pub fn a_thrown_value_that_is_not_an_error(ref mut self, value: ref Expr, thrown: ref Ty, span: ref Span) sync {
        let what = element_kind(value, thrown) ?? return
        self.findings.push(check_refusal("NK1161", span, f"You can only throw an error, and this throws {what}.", ["An error is a type with an `impl Error` for it, which says what its message is.".clone()], "Declare one, such as `enum Refused { NotFound }` with `impl Error for Refused { fn message(ref self) -> String { … } }`, and throw a value of it.".clone()))
    }

    /// `NK1160`: a field or an index reached on an **opaque handle**
    /// ([ADR-302](../../docs/specification/adr/adr-302.md) D7).
    ///
    /// A handle is an address this language never dereferences. It is moved and
    /// stored like any value, and that is all it is — there is nothing inside
    /// it to name and nothing to count, because what it points at belongs to
    /// the library that made it.
    ///
    /// **Refused here rather than below**, which is the choice this compiler
    /// makes everywhere ([Part III C.1](../../docs/specification/30-nikaia-tooling.md)):
    /// what `rustc` would say about a field of a `#[repr(transparent)]` newtype
    /// is about a file nobody wrote, and it would name the wrapper rather than
    /// the handle.
    pub fn a_handle_has_nothing_inside(ref mut self, handle: ref String, what: ref String, span: ref Span) sync {
        self.findings.push(check_refusal("NK1160", span, f"You can't look inside `{handle}`: it's a handle, and {what} reaches into it.", [f"`{handle}` is declared `opaque`: what it points at belongs to the C library that made it."], "Pass the handle to a function declared in the `extern \"C\"` block.".clone()))
    }

    /// `NK1160`, the third shape: a **handle** written as a call
    /// ([ADR-302](../../docs/specification/adr/adr-302.md) D7).
    ///
    /// An opaque handle is an address a C function hands back. There is no
    /// value of one this language can make, so a constructor would have to
    /// invent an address — and the one thing a handle may never be is a number
    /// somebody chose.
    ///
    /// **The out-parameter shape is why a reader reaches for this.**
    /// `sqlite3_open(path, db)` wants a handle to fill, and C writes it as an
    /// uninitialised pointer. What this language does there is a question the
    /// record does not answer, and it is in
    /// the former `open-decisions.md` rather than guessed
    /// at here.
    pub fn a_handle_is_not_made_here(ref mut self, handle: ref String, span: ref Span) sync {
        self.findings.push(check_refusal("NK1160", span, f"You can't make a `{handle}` yourself: it's a handle a C library gives you.", [f"`{handle}` is declared `opaque`: only a C function can hand one out."], f"Call the function in the `extern \"C\"` block that returns a `{handle}`."))
    }

    /// `NK1159`: a length handed to a C declaration beside a buffer it cannot be
    /// shown to fit ([ADR-302](../../docs/specification/adr/adr-302.md) D6).
    ///
    /// **The help names both ways out**, because D2 accepts exactly two: the
    /// buffer's own `len()`, and a constant a known length covers. Anything
    /// else is refused rather than guessed at, which is the polarity every
    /// check at this boundary keeps — the alternative is the operating system
    /// answering, about memory the program did not mean to touch.
    pub fn a_length_that_may_not_fit(ref mut self, world: ref CheckWorld, written: ref String, buffer: ref Expr, span: ref Span) sync {
        let named = match buffer {
            Expr::Variable(name) => world.words.resolve(name).clone(),
            else => "the buffer",
        }
        self.findings.push(check_refusal("NK1159", span, f"`{written}` takes this as the length of `{named}`, but it might be longer than the buffer.", ["C trusts the count completely, so a count longer than the buffer would read or write past its end.".clone()], f"Pass `{named}.len()`, or a constant no bigger than the buffer. An `Array[T, N]` knows its length; a `Vec[T]` doesn't until the program runs."))
    }
}

/// What kind of value an element of a list literal is, where that much is known
/// without a type ([ADR-135](../../docs/specification/adr/adr-135.md) D1).
///
/// **A literal first**, because that is the case the type cannot answer: a bare
/// `1` fits every numeric type, so it arrives as `?` and two of those say
/// nothing about each other. A number and a piece of text do.
///
/// `i64` and `f64` are one kind here, deliberately: this is a **coarse** answer
/// used only to refuse, and a finer one would refuse `[1, 1.5]` on a reading of
/// the literals rather than of the program.
pub fn element_kind(expr: ref Expr, ty: ref Ty) -> String? sync {
    match expr {
        Expr::LitInt { .. } => return "a number",
        Expr::LitFloat(_) => return "a number",
        Expr::LitStr { .. } => return "text",
        Expr::LitInterpolated { .. } => return "text",
        Expr::LitChar(_) => return "a character",
        Expr::LitBool(_) => return "a `bool`",
        else => {}
    }
    return match ty {
        Ty::Named { name, .. } => a_kind_by_name(name),
        else => null,
    }
}

fn a_kind_by_name(name: ref String) -> String? sync {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize" || name == "f32" || name == "f64" {
        return "a number"
    }
    if name == "str" || name == "String" {
        return "text"
    }
    if name == "char" || name == "scalar" {
        return "a character"
    }
    if name == "bool" {
        return "a `bool`"
    }
    return null
}
