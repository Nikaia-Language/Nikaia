// crates/nikaia-std/src/tools/bounds_basic.nika
//
// **The index checks a loop over a list's own length makes unneeded**
// (ADR-306 D3, `--optimization=remove-bounds-checks:basic`), moved from the
// compiler's `bounds` (ADR-294, #125). One shape and no solver: `xs[k]` where
// `k` is the binding of an enclosing `for k in lo..<xs.len()`, `lo` is not
// negative, and nothing in the loop's body can change `xs`'s length or bind
// `k` again.
//
// What it finds is a set of index nodes, each the indexed `base`'s id
// (`id_of`, ADR-340) as the emitter finds it again: an id is the node's own,
// so a copy of the tree names the same nodes.
//
// Also here, because the aggressive level (D4) asks them too: which methods
// leave a list's length as it was, and whether a body binds a name again.

use std::collections

/// A loop `for k in lo..<xs.len()` whose body leaves `xs`'s length alone.
struct CountedLoop {
    binding: String,
    list: String,
}

/// **The index nodes of `body` whose check the basic level drops**: every
/// `xs[k]` inside a loop over `xs`'s own length that `k` counts.
pub fn basic_indices(body: ref Block, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[i64] {
    let mut out: collections::BTreeSet[i64] = collections::BTreeSet()
    counted_block(body, [], words, out)
    return out
}

fn counted_block(block: ref Block, mut over: Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    for stmt in block.stmts {
        counted_statement(stmt.node, over, words, out)
    }
}

/// The loops still in force after `name` is bound again: from there on in
/// this block it is another binding.
fn without(over: ref Vec[CountedLoop], name: ref String) -> Vec[CountedLoop] {
    let mut kept: Vec[CountedLoop] = []
    for o in over {
        if o.binding != name && o.list != name {
            kept.push(CountedLoop { binding: o.binding.clone(), list: o.list.clone() })
        }
    }
    return kept
}

fn copied(over: ref Vec[CountedLoop]) -> Vec[CountedLoop] {
    let mut kept: Vec[CountedLoop] = []
    for o in over {
        kept.push(CountedLoop { binding: o.binding.clone(), list: o.list.clone() })
    }
    return kept
}

fn counted_statement(stmt: ref Stmt, mut over: Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    match stmt {
        Stmt::For { bindings, iter, body } => {
            counted_expr(iter, over, words, out)
            // A binding of this loop hides an outer loop's of the same name.
            let mut inner = copied(over)
            for b in bindings {
                inner = without(inner, words.resolve(b))
            }
            if bindings.len() == 1 {
                let found = loop_over_length(bindings[0], iter, body, over, words)
                if found != null {
                    inner.push(found ?? CountedLoop { binding: "", list: "" })
                }
            }
            counted_block(body, inner, words, out)
        },
        Stmt::Let { names, value, .. } => {
            counted_expr(value, over, words, out)
            for name in names {
                let kept = without(over, words.resolve(name))
                over.clear()
                over.extend(kept)
            }
        },
        Stmt::Comptime { name, value, .. } => {
            counted_expr(value, over, words, out)
            let kept = without(over, words.resolve(name))
            over.clear()
            over.extend(kept)
        },
        Stmt::Assign { target, value, .. } => {
            counted_expr(target, over, words, out)
            counted_expr(value, over, words, out)
        },
        Stmt::While { cond, body } => {
            counted_expr(cond, over, words, out)
            counted_block(body, copied(over), words, out)
        },
        Stmt::Return(value) => {
            counted_maybe(value, over, words, out)
        },
        Stmt::Expr(value) => counted_expr(value, over, words, out),
        Stmt::Break => {},
        Stmt::Continue => {},
    }
}

/// `for k in lo..<xs.len()` with a start that is not negative, a body that
/// leaves `xs`'s length alone and does not bind `k` again; nothing for any
/// other loop.
fn loop_over_length(binding: winnow_grammar::Symbol, iter: ref Expr, body: ref Block, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext) -> CountedLoop? {
    let (start, end) = match iter {
        Expr::Range { start, end, inclusive, .. } => {
            return null if inclusive
            (start, end)
        },
        else => return null,
    }
    let list = match end {
        Expr::MethodCall { receiver, method, args, .. } => {
            return null if !args.is_empty() || words.resolve(method) != "len"
            match receiver {
                Expr::Variable(list, _) => words.resolve(list).clone(),
                else => return null,
            }
        },
        else => return null,
    }
    let counter = words.resolve(binding).clone()
    if !starts_not_negative(start, over, words) || !length_stays(body, list, words) || rebinds(body, counter, words) {
        return null
    }
    return CountedLoop { binding: counter, list: list }
}

/// A literal that is not negative, or the binding of a loop D3 already holds.
fn starts_not_negative(start: ref Expr, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext) -> bool {
    return match start {
        Expr::LitInt { negative, .. } => !negative,
        Expr::Variable(name, _) => counts(over, words.resolve(name)),
        else => false,
    }
}

fn counts(over: ref Vec[CountedLoop], binding: ref String) -> bool {
    for o in over {
        if o.binding == binding {
            return true
        }
    }
    return false
}

fn indexes_its_loop(over: ref Vec[CountedLoop], list: ref String, at: ref String) -> bool {
    for o in over {
        if o.list == list && o.binding == at {
            return true
        }
    }
    return false
}

fn counted_expr(expr: ref Expr, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    match expr {
        Expr::Index { base, index, .. } => {
            match base {
                Expr::Variable(list, _) => match index {
                    Expr::Variable(at, _) => {
                        if indexes_its_loop(over, words.resolve(list), words.resolve(at)) {
                            out.insert(node_key(base))
                        }
                    },
                    else => {},
                },
                else => {},
            }
        },
        else => {},
    }
    match expr {
        // A lambda may run after the loop, when the list is another length.
        Expr::Closure { .. } => {},
        Expr::Spawn { .. } => {},
        else => {
            counted_children(expr, over, words, out)
            counted_blocks(expr, over, words, out)
        },
    }
}

fn counted_all(exprs: ref Vec[Expr], over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    for e in exprs {
        counted_expr(e, over, words, out)
    }
}

fn counted_maybe(expr: ref Expr?, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    counted_expr(expr ?? return, over, words, out)
}

fn counted_maybe_block(block: ref Block?, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    counted_block(block ?? return, copied(over), words, out)
}

/// Each expression directly inside `expr`.
fn counted_children(expr: ref Expr, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    match expr {
        Expr::Match { value, arms, .. } => {
            counted_expr(value, over, words, out)
            for arm in arms {
                counted_maybe(arm.guard, over, words, out)
                counted_expr(arm.body, over, words, out)
            }
        },
        Expr::Range { start, end, .. } => {
            counted_expr(start, over, words, out)
            counted_expr(end, over, words, out)
        },
        Expr::Tuple(items, _) => counted_all(items, over, words, out),
        Expr::ListLit { items, .. } => counted_all(items, over, words, out),
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => counted_expr(expr, over, words, out),
                    else => {},
                }
            }
        },
        Expr::If { cond, .. } => counted_expr(cond, over, words, out),
        Expr::Call { func, args, config, .. } => {
            counted_expr(func, over, words, out)
            counted_all(args, over, words, out)
            for c in config {
                counted_expr(c.value, over, words, out)
            }
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            counted_expr(receiver, over, words, out)
            counted_all(args, over, words, out)
            for c in config {
                counted_expr(c.value, over, words, out)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            counted_expr(receiver, over, words, out)
            counted_all(args, over, words, out)
            for c in config {
                counted_expr(c.value, over, words, out)
            }
        },
        Expr::Field { base, .. } => counted_expr(base, over, words, out),
        Expr::SafeField { base, .. } => counted_expr(base, over, words, out),
        Expr::StructLit { fields, .. } => {
            for field in fields {
                counted_maybe(field.value, over, words, out)
            }
        },
        Expr::With { base, fields, .. } => {
            counted_expr(base, over, words, out)
            for field in fields {
                counted_maybe(field.value, over, words, out)
            }
        },
        Expr::Unary { expr, .. } => counted_expr(expr, over, words, out),
        Expr::Try(inner, _) => counted_expr(inner, over, words, out),
        Expr::Throw(inner, _) => counted_expr(inner, over, words, out),
        Expr::Cast { expr, .. } => counted_expr(expr, over, words, out),
        Expr::TryCatch { expr, .. } => counted_expr(expr, over, words, out),
        Expr::Binary { lhs, rhs, .. } => {
            counted_expr(lhs, over, words, out)
            counted_expr(rhs, over, words, out)
        },
        Expr::Return(value, _) => {
            counted_maybe(value, over, words, out)
        },
        Expr::Index { base, index, .. } => {
            counted_expr(base, over, words, out)
            counted_expr(index, over, words, out)
        },
        Expr::Coalesce { value, fallback, .. } => {
            counted_expr(value, over, words, out)
            counted_expr(fallback, over, words, out)
        },
        Expr::Select(arms, _) => {
            for arm in arms {
                counted_expr(arm.value, over, words, out)
            }
        },
        else => {},
    }
}

/// Each block directly inside `expr`, each with the loops in force here.
fn counted_blocks(expr: ref Expr, over: ref Vec[CountedLoop], words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[i64]) {
    match expr {
        Expr::Block(b, _) => counted_block(b, copied(over), words, out),
        Expr::Overlap(b, _) => counted_block(b, copied(over), words, out),
        Expr::Unsafe(b, _) => counted_block(b, copied(over), words, out),
        Expr::If { then_branch, else_branch, .. } => {
            counted_block(then_branch, copied(over), words, out)
            counted_maybe_block(else_branch, over, words, out)
        },
        Expr::TryCatch { handler, .. } => counted_block(handler, copied(over), words, out),
        Expr::Select(arms, _) => {
            for arm in arms {
                counted_block(arm.body, copied(over), words, out)
            }
        },
        else => {},
    }
}

/// **Methods that leave a list's length as it was.** A method not on this
/// list is taken to change it, so a method the list does not know costs a
/// proof and never makes a wrong one.
pub fn keeps_length(method: ref String) -> bool {
    return match method {
        "len" => true, "is_empty" => true, "contains" => true, "iter" => true,
        "first" => true, "last" => true, "get" => true, "clone" => true,
        "to_vec" => true, "index_of" => true, "starts_with" => true,
        "ends_with" => true, "join" => true, "sum" => true, "min" => true,
        "max" => true, "sort" => true, "sort_by" => true, "sort_by_key" => true,
        "reverse" => true, "swap" => true, "fill" => true, "map" => true,
        "filter" => true, "any" => true, "all" => true, "count" => true,
        "find" => true, "position" => true, "enumerate" => true, "zip" => true,
        "windows" => true, "chunks" => true, "rev" => true, "fold" => true,
        "binary_search" => true, "to_string" => true, "chars" => true,
        "bytes" => true,
        else => false,
    }
}

// --- What a body does to a name, anywhere in it ------------------------------
//
// Each question is asked of every statement and every expression in a body
// and the blocks inside it, lambdas included, and is answered `true` by the
// first that says so.

enum Seek {
    /// Something that may change this list's length: assigning it, binding
    /// it again, handing it to a call, a lambda that names it, or a method
    /// `keeps_length` does not know.
    LengthChanged(String),
    /// A `let`, `comptime`, loop, assignment or lambda parameter of the name.
    Rebound(String),
    /// The name read anywhere, or assigned.
    Mentioned(String),
}

/// **Nothing in `body` can change `list`'s length.**
pub fn length_stays(body: ref Block, list: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    return !seek_block(body, Seek::LengthChanged(list.clone()), words)
}

/// Whether `body` binds `name` again anywhere.
pub fn rebinds(body: ref Block, name: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    return seek_block(body, Seek::Rebound(name.clone()), words)
}

fn is_variable(expr: ref Expr, name: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Variable(n, _) => words.resolve(n) == name,
        else => false,
    }
}

fn any_is_variable(exprs: ref Vec[Expr], name: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    for e in exprs {
        if is_variable(e, name, words) {
            return true
        }
    }
    return false
}

fn any_symbol(symbols: ref Vec[winnow_grammar::Symbol], name: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    for s in symbols {
        if words.resolve(s) == name {
            return true
        }
    }
    return false
}

/// What one statement, by itself, answers.
fn statement_says(stmt: ref Stmt, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    return match seek {
        Seek::LengthChanged(list) => match stmt {
            Stmt::Assign { target, .. } => is_variable(target, list, words),
            Stmt::Let { names, .. } => any_symbol(names, list, words),
            Stmt::For { bindings, .. } => any_symbol(bindings, list, words),
            else => false,
        },
        Seek::Rebound(wanted) => match stmt {
            Stmt::Let { names, .. } => any_symbol(names, wanted, words),
            Stmt::Comptime { name, .. } => words.resolve(name) == wanted,
            Stmt::For { bindings, .. } => any_symbol(bindings, wanted, words),
            Stmt::Assign { target, .. } => is_variable(target, wanted, words),
            else => false,
        },
        Seek::Mentioned(name) => match stmt {
            Stmt::Assign { target, .. } => is_variable(target, name, words),
            else => false,
        },
    }
}

/// What one expression, by itself, answers.
fn expression_says(expr: ref Expr, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    return match seek {
        Seek::LengthChanged(list) => match expr {
            Expr::MethodCall { receiver, method, args, .. } => (is_variable(receiver, list, words) && !keeps_length(words.resolve(method))) || any_is_variable(args, list, words),
            Expr::SafeMethod { receiver, method, args, .. } => (is_variable(receiver, list, words) && !keeps_length(words.resolve(method))) || any_is_variable(args, list, words),
            Expr::Call { args, .. } => any_is_variable(args, list, words),
            Expr::Closure { body, .. } => seek_block(body, Seek::Mentioned(list.clone()), words),
            Expr::Spawn { body, .. } => seek_expr(body, Seek::Mentioned(list.clone()), words),
            else => false,
        },
        Seek::Rebound(name) => match expr {
            Expr::Closure { params, .. } => any_symbol(params, name, words),
            else => false,
        },
        Seek::Mentioned(name) => is_variable(expr, name, words),
    }
}

fn seek_block(block: ref Block, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for stmt in block.stmts {
        if seek_statement(stmt.node, seek, words) {
            return true
        }
    }
    return false
}

fn seek_statement(stmt: ref Stmt, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    if statement_says(stmt, seek, words) {
        return true
    }
    return match stmt {
        Stmt::For { iter, body, .. } => seek_expr(iter, seek, words) || seek_block(body, seek, words),
        Stmt::While { cond, body } => seek_expr(cond, seek, words) || seek_block(body, seek, words),
        Stmt::Let { value, .. } => seek_expr(value, seek, words),
        Stmt::Comptime { value, .. } => seek_expr(value, seek, words),
        Stmt::Expr(value) => seek_expr(value, seek, words),
        Stmt::Assign { target, value, .. } => seek_expr(target, seek, words) || seek_expr(value, seek, words),
        Stmt::Return(value) => seek_maybe(value, seek, words),
        else => false,
    }
}

fn seek_all(exprs: ref Vec[Expr], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for e in exprs {
        if seek_expr(e, seek, words) {
            return true
        }
    }
    return false
}

fn seek_config(config: ref Vec[ConfigArg], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for c in config {
        if seek_expr(c.value, seek, words) {
            return true
        }
    }
    return false
}

fn seek_fields(fields: ref Vec[FieldInit], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for field in fields {
        if seek_maybe(field.value, seek, words) {
            return true
        }
    }
    return false
}

fn seek_maybe_block(block: ref Block?, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    return seek_block(block ?? return false, seek, words)
}

fn seek_maybe(expr: ref Expr?, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    return seek_expr(expr ?? return false, seek, words)
}

/// The expression, then each expression and each block directly inside it.
fn seek_expr(expr: ref Expr, seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    if expression_says(expr, seek, words) {
        return true
    }
    return match expr {
        Expr::Match { value, arms, .. } => seek_expr(value, seek, words) || seek_arms(arms, seek, words),
        Expr::Range { start, end, .. } => seek_expr(start, seek, words) || seek_expr(end, seek, words),
        Expr::Tuple(items, _) => seek_all(items, seek, words),
        Expr::ListLit { items, .. } => seek_all(items, seek, words),
        Expr::LitInterpolated { parts, .. } => seek_holes(parts, seek, words),
        Expr::If { cond, then_branch, else_branch, .. } => seek_expr(cond, seek, words) || seek_block(then_branch, seek, words) || seek_maybe_block(else_branch, seek, words),
        Expr::Call { func, args, config, .. } => seek_expr(func, seek, words) || seek_all(args, seek, words) || seek_config(config, seek, words),
        Expr::Spawn { body, .. } => seek_expr(body, seek, words),
        Expr::MethodCall { receiver, args, config, .. } => seek_expr(receiver, seek, words) || seek_all(args, seek, words) || seek_config(config, seek, words),
        Expr::SafeMethod { receiver, args, config, .. } => seek_expr(receiver, seek, words) || seek_all(args, seek, words) || seek_config(config, seek, words),
        Expr::Field { base, .. } => seek_expr(base, seek, words),
        Expr::SafeField { base, .. } => seek_expr(base, seek, words),
        Expr::StructLit { fields, .. } => seek_fields(fields, seek, words),
        Expr::With { base, fields, .. } => seek_expr(base, seek, words) || seek_fields(fields, seek, words),
        Expr::Unary { expr, .. } => seek_expr(expr, seek, words),
        Expr::Try(inner, _) => seek_expr(inner, seek, words),
        Expr::Throw(inner, _) => seek_expr(inner, seek, words),
        Expr::Cast { expr, .. } => seek_expr(expr, seek, words),
        Expr::TryCatch { expr, handler, .. } => seek_expr(expr, seek, words) || seek_block(handler, seek, words),
        Expr::Binary { lhs, rhs, .. } => seek_expr(lhs, seek, words) || seek_expr(rhs, seek, words),
        Expr::Return(value, _) => seek_maybe(value, seek, words),
        Expr::Index { base, index, .. } => seek_expr(base, seek, words) || seek_expr(index, seek, words),
        Expr::Coalesce { value, fallback, .. } => seek_expr(value, seek, words) || seek_expr(fallback, seek, words),
        Expr::Select(arms, _) => seek_select(arms, seek, words),
        Expr::Block(b, _) => seek_block(b, seek, words),
        Expr::Overlap(b, _) => seek_block(b, seek, words),
        Expr::Unsafe(b, _) => seek_block(b, seek, words),
        Expr::Closure { body, .. } => seek_block(body, seek, words),
        else => false,
    }
}

fn seek_arms(arms: ref Vec[MatchArm], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for arm in arms {
        if seek_maybe(arm.guard, seek, words) {
            return true
        }
        if seek_expr(arm.body, seek, words) {
            return true
        }
    }
    return false
}

fn seek_holes(parts: ref Vec[FPart], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for part in parts {
        match part {
            FPart::Hole { expr, .. } if seek_expr(expr, seek, words) => return true,
            else => {},
        }
    }
    return false
}

fn seek_select(arms: ref Vec[SelectArm], seek: ref Seek, words: ref winnow_grammar::InternerContext) -> bool {
    for arm in arms {
        if seek_expr(arm.value, seek, words) || seek_block(arm.body, seek, words) {
            return true
        }
    }
    return false
}
