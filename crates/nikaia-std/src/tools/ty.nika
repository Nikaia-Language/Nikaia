// crates/nikaia-std/src/tools/ty.nika
//
// **The type language the checker reasons in, and the one the ledger records**
// (ADR-294 D12): declared in Nikaia, lowered by `nikaia lower-std` to `ty.rs`
// beside it, `include!`d as `nikaia_std::tools::ty`, and re-exported by the
// compiler's `contracts::ty`, which keeps the algorithms over it until
// ADR-294's step (d) moves them.
//
// **A plain tree, compared by what it says** (ADR-294): a name here is
// text, and two types are the same when they are written the same. A ledger is
// a file, so nothing is interned. The measurement that decided it is in the
// record.
//
// **What moved with the declaration is its text** (ADR-294 step (c)): `text`
// below is what a diagnostic prints and what a ledger stores, and `parse`
// reads it back. Text is read here as a list of characters, which is how
// `ledger.nika` reads a line: this language has no slice of a `String`.
//
use std::text
use std::collections

// The boxes are the compiler's (ADR-246): `Pointed`, `Nullable` and `Seq` hold
// a `Ty` inline, and the lowering boxes them.

/// A type, or the absence of a claim about one.
///
/// It is `ast::Type` with one addition and one subtraction. The addition is
/// `Unknown`, which is not a type but the absence of a claim: anything
/// involving it is compatible with anything, and an error is reported only
/// where **both** sides are known and disagree. The subtraction is the spans:
/// this is also what a ledger records.
pub enum Ty {
    /// No claim. Compatible with everything, in both directions.
    Unknown,
    /// A name, its arguments, and whether it is a view: `ref String`,
    /// `Vec[Row]`, `HashMap[ref String, Stats]`.
    Named {
        name: String,
        args: Vec[Ty],
        view: bool,
    },
    /// `(A, B)`: a fixed number of parts and no name.
    Tuple(Vec[Ty]),
    /// **What the C boundary lends**
    /// ([ADR-302](../../../docs/specification/adr/adr-302.md) D5): `ref mut T`,
    /// `ref Array[u8]` and `ref mut Array[u8]`, each a view that lives for the
    /// call. A plain `ref T` is **not** this: it is `Named` with `view`.
    Pointed {
        /// What is pointed at.
        item: Ty,
        /// A run of them, and the length is the caller's to pass.
        slice: bool,
        /// The callee may write through it.
        mutable: bool,
    },
    /// **A number where a type argument stands**
    /// ([ADR-152](../../../docs/specification/adr/adr-152.md) D1): the `3` of
    /// `Array[f64, 3]`. Compatible with nothing but itself.
    Count(i64),
    /// `$V`: a name in a library's signature that stands for a type the
    /// receiver supplies ([ADR-286](../../../docs/specification/adr/adr-286.md)).
    /// It is bound and substituted away at a call, or it becomes `Unknown`.
    Var {
        name: String,
        /// `ref $V`: the view belongs to the use, not to what was bound.
        view: bool,
    },
    /// `fn(ref Stats) -> R sync throws`
    /// ([ADR-277](../../../docs/specification/adr/adr-277.md) D6). The
    /// defaults are the language's: without `sync` the code may pause, without
    /// `throws` it cannot fail.
    Fn {
        params: Vec[Ty],
        /// `-> R`, absent where the code hands nothing back.
        result: Ty?,
        is_sync: bool,
        /// `throws`, which is a word this language reserves and so cannot name
        /// a field. `ast::Code` spells it the same way.
        can_throw: bool,
    },
    /// `T?`, Part I 2.3's nullable type. A wrapper rather than a flag, because
    /// every reader of a type already recurses.
    Nullable(Ty),
    /// **Elements produced step by step**
    /// ([ADR-105](../../../docs/specification/adr/adr-105.md) D1): `Seq[T]`,
    /// and `Par[T]` with `parallel`. The words after it say what one step may
    /// do ([ADR-172](../../../docs/specification/adr/adr-172.md) D1: `sync`
    /// and `pauses` are not both) and what the whole is (`shape`).
    Seq {
        item: Ty,
        is_sync: bool,
        /// A positive claim, and not the absence of `sync`.
        pauses: bool,
        can_throw: bool,
        parallel: bool,
        shape: Shape,
    },
}

/// **What a sequence is as a whole**
/// ([ADR-293](../../../docs/specification/adr/adr-293.md) D16): the language
/// below's `DoubleEndedIterator`, `ExactSizeIterator` and `Copy`, in this
/// language's words.
pub struct Shape {
    /// It can be walked from the back as well as the front.
    pub ends: bool,
    /// Its length is known before it is walked.
    pub sized: bool,
    /// Walking it does not consume it.
    pub replays: bool,
}

impl Shape {
    /// None of the three: what a sequence is when nobody said. Named rather
    /// than a `Default`, for ADR-294 D9.4's reason.
    pub fn none() -> Shape {
        return Shape { ends: false, sized: false, replays: false }
    }

    /// Whether a sequence of this shape can go where `wanted` is demanded.
    pub fn meets(ref self, wanted: ref Shape) -> bool {
        return self.missing(wanted).len() == 0
    }

    /// The words `wanted` demands and this shape does not have, in the order
    /// they are written.
    pub fn missing(ref self, wanted: ref Shape) -> Vec[String] {
        let mut words: Vec[String] = []
        if wanted.ends && !self.ends {
            words.push(ENDS.clone())
        }
        if wanted.sized && !self.sized {
            words.push(SIZED.clone())
        }
        if wanted.replays && !self.replays {
            words.push(REPLAYS.clone())
        }
        return words
    }
}

/// [`Shape::ends`]'s word.
pub comptime ENDS: ref String = "ends"
/// [`Shape::sized`]'s word.
pub comptime SIZED: ref String = "sized"
/// [`Shape::replays`]'s word.
pub comptime REPLAYS: ref String = "replays"
/// A sequence's name.
pub comptime SEQ: ref String = "Seq"
/// A sequence whose steps run on several cores at once.
pub comptime PAR: ref String = "Par"
/// The word after a sequence whose step suspends.
pub comptime PAUSES: ref String = "pauses"
/// **The array and the run** (ADR-184 D3): `Array[T, N]` is laid out inline,
/// `ref Array[T]` is a view of a run.
pub comptime ARRAY: ref String = "Array"
/// `Array[`, and how many characters it is: where a run's element starts.
comptime ARRAY_OPEN: ref String = "Array["
comptime ARRAY_OPEN_LENGTH: i64 = 6
/// **Text, in the language's word** (ADR-184 D2).
pub comptime TEXT: ref String = "String"
/// **The compiler's noun for a view of text**, which a message never prints.
pub comptime TEXT_VIEW: ref String = "str"

impl Ty {
    /// **The text of a type**: what a diagnostic prints and what a ledger
    /// stores, in the spelling a program writes (Part III, C.1). `Ty::parse`
    /// reads it back, byte for byte.
    pub fn text(ref self) -> String {
        return text(self)
    }
}

/// [`Ty::text`], as a function the arms below recurse through.
pub fn text(ty: ref Ty) -> String {
    return match ty {
        Ty::Unknown => "?",
        // The digits and nothing around them, so `Array[f64, 3]` reads as the
        // source wrote it.
        Ty::Count(n) => f"{n}",
        Ty::Pointed { item, slice, mutable } => pointed(item, slice, mutable),
        Ty::Tuple(parts) => f"({listed(parts)})",
        Ty::Fn { params, result, is_sync, can_throw } => code(params, result, is_sync, can_throw),
        Ty::Var { name, view } => if view { f"ref ${name}" } else { f"${name}" },
        // `T?` and never `Option[T]`: the program cannot write the second.
        Ty::Nullable(inner) => f"{text(inner)}?",
        Ty::Named { name, args, view } => named_text(name, args, view),
        Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => sequence(item, is_sync, pauses, can_throw, parallel, shape),
    }
}

/// `a, b, c`, each part's text.
fn listed(parts: ref Array[Ty]) -> String {
    let mut out: String = ""
    for part in parts {
        if !out.is_empty() {
            out.push_str(", ")
        }
        out.push_str(ref text(part))
    }
    return out
}

/// `ref mut Array[T]`, and not the pointer it lowers to. The `?` a nullable
/// pointee carries comes out after the brackets, which is the spelling
/// `Ty::parse` reads back (ADR-302 D14).
fn pointed(item: ref Ty, slice: bool, mutable: bool) -> String {
    let mut out: String = "ref "
    if mutable {
        out.push_str("mut ")
    }
    if !slice {
        out.push_str(ref text(item))
        return out
    }
    let written = match item {
        Ty::Nullable(inner) => f"{ARRAY}[{text(inner)}]?",
        else => f"{ARRAY}[{text(item)}]",
    }
    out.push_str(ref written)
    return out
}

/// `fn(A, B) -> R sync throws`.
fn code(params: ref Array[Ty], result: ref Ty?, is_sync: bool, can_throw: bool) -> String {
    let mut out = f"fn({listed(params)})"
    if result != null {
        let returned = result?.text() ?? ""
        out.push_str(ref f" -> {returned}")
    }
    if is_sync {
        out.push_str(" sync")
    }
    if can_throw {
        out.push_str(" throws")
    }
    return out
}

/// `ref Vec[Row]`. **`str` is the compiler's noun and `String` is the
/// language's** (ADR-184 D2): a view of text prints as `ref String`.
fn named_text(name: ref String, args: ref Array[Ty], view: bool) -> String {
    let mut out: String = if view { "ref " } else { "" }
    if view && name == TEXT_VIEW {
        out.push_str(TEXT)
    } else {
        out.push_str(name)
    }
    if args.len() > 0 {
        out.push_str(ref f"[{listed(args)}]")
    }
    return out
}

/// `Seq[T] sync pauses throws ends sized replays`, the words in the order they
/// are read, so a ledger that goes through this comes out byte for byte (Part
/// III, 13.5).
fn sequence(item: ref Ty, is_sync: bool, pauses: bool, can_throw: bool, parallel: bool, shape: ref Shape) -> String {
    let word = if parallel { PAR } else { SEQ }
    let mut out = f"{word}[{text(item)}]"
    if is_sync {
        out.push_str(" sync")
    }
    if pauses {
        out.push_str(ref f" {PAUSES}")
    }
    if can_throw {
        out.push_str(" throws")
    }
    for word in Shape::none().missing(shape) {
        out.push_str(ref f" {word}")
    }
    return out
}

/// **A type read back from its text**: what `text` writes, and the older
/// spellings a ledger may still hold (`&T` for `ref T`, `[T]` for
/// `Array[T]`, ADR-184 D4). Nothing here refuses: text that is not a type is
/// read as a name, which is what a type this compiler does not know is.
pub fn parse(written: ref String) -> Ty {
    let trimmed = written.trim()
    if trimmed.len() == 0 || trimmed == "?" {
        return Ty::Unknown
    }
    // **A run of digits is a count** (ADR-152 D1), read first because no type
    // name begins with a digit.
    let count = text::parse_i64(trimmed)
    if count != null {
        return Ty::Count(count ?? 0)
    }
    // The view marker, read once: the two boundary shapes and a plain view
    // both start with it.
    let viewed = a_view_of(trimmed)
    let is_a_view = viewed != null
    let marked: String = viewed ?? ""
    // **The two boundary shapes are read before the `?`** (ADR-302 D14): on a
    // `ref mut T` or a `ref Array[T]` the trailing `?` is the pointee's.
    if is_a_view {
        let pointer = pointed_at(marked)
        if pointer != null {
            return pointer ?? Ty::Unknown
        }
    }
    // A trailing `?` is Part I 2.3's nullable marker, read before anything
    // else so that `ref String?` reaches the rest as what it is nullable of.
    if trimmed.ends_with("?") {
        return Ty::Nullable(parse(cut(trimmed, 0, 1)))
    }
    if trimmed.starts_with("(") && trimmed.ends_with(")") {
        return Ty::Tuple(each(split_args(cut(trimmed, 1, 1))))
    }
    // `fn(Stats) -> R sync throws`: read before a view, because a
    // function type is never one.
    if trimmed.starts_with("fn(") {
        let code = a_function(trimmed)
        if code != null {
            return code ?? Ty::Unknown
        }
    }
    // `Seq[T]` and `Par[T]` with their words: never a view either, because a
    // produced sequence is walked by value (ADR-105 D2).
    let sequence = a_sequence(trimmed, SEQ, false)
    if sequence != null {
        return sequence ?? Ty::Unknown
    }
    let parallel = a_sequence(trimmed, PAR, true)
    if parallel != null {
        return parallel ?? Ty::Unknown
    }
    if is_a_view {
        return a_name(marked.trim(), true)
    }
    return a_name(trimmed, false)
}

/// **Split `a, b[c, d], (e, f)` on the commas that are not inside a bracket**,
/// each part trimmed. An empty last part is not one.
pub fn split_args(written: ref String) -> Vec[String] {
    let mut parts: Vec[String] = []
    let mut depth = 0
    let mut current: String = ""
    for c in written.chars() {
        if c == '[' || c == '(' {
            depth += 1
            current.push(c)
        } else if c == ']' || c == ')' {
            if depth > 0 {
                depth -= 1
            }
            current.push(c)
        } else if c == ',' && depth == 0 {
            parts.push(current.trim().clone())
            current = ""
        } else {
            current.push(c)
        }
    }
    if current.trim().len() > 0 {
        parts.push(current.trim().clone())
    }
    return parts
}

/// **The view marker off the front of a written type** (ADR-184 D1): `ref T`,
/// and `&T`, the spelling it replaced. The word needs the space after it, so
/// `reference` is not read as a view of `erence`.
pub fn a_view_of(written: ref String) -> String? {
    // **`ref(a | b) T`, where a signature's result says what it points
    // into** (ADR-251 D4): a view of `T` like any other, and the names are the
    // ledger's to read, beside the type.
    if written.starts_with("ref(") {
        let c: Vec[char] = written.chars().collect()
        let close = closing(c, 4, ')')
        if close >= 0 {
            let rest = between(c, close + 1, c.len())
            return rest.trim_start().clone()
        }
    }
    if written.starts_with("ref ") {
        let rest = cut(written, 4, 0)
        return rest.trim_start().clone()
    }
    if written.starts_with("&") {
        let rest = cut(written, 1, 0)
        return rest.trim_start().clone()
    }
    return null
}

/// Each part read as a type.
fn each(parts: ref Array[String]) -> Vec[Ty] {
    let mut read: Vec[Ty] = []
    for part in parts {
        read.push(parse(part))
    }
    return read
}

/// The characters from `from` up to `to`, as text.
fn between(c: ref Array[char], from: i64, to: i64) -> String {
    let mut out: String = ""
    for k in from..<to {
        out.push(c[k])
    }
    return out
}

/// `written` with `front` characters taken off the front and `back` off the
/// back.
fn cut(written: ref String, front: i64, back: i64) -> String {
    let c: Vec[char] = written.chars().collect()
    return between(c, front, c.len() - back)
}

/// Where the bracket stands that closes one opened just before `from`: `)`
/// after `fn(`, `]` after `Seq[`. Either bracket opens; the other closer where
/// nothing is open is a mismatch. -1 where nothing closes it.
fn closing(c: ref Array[char], from: i64, closer: char) -> i64 {
    let mut depth = 0
    for at in from..<c.len() {
        let ch = c[at]
        if ch == '(' || ch == '[' {
            depth += 1
        } else if ch == closer {
            if depth == 0 {
                return at
            }
            depth -= 1
        } else if ch == ')' || ch == ']' {
            if depth == 0 {
                return -1
            }
            depth -= 1
        }
    }
    return -1
}

/// `tail` with `word` taken off its end, where the word stands on its own: at
/// the start, or after a space. `Seq[T] ends` loses `ends`; `Seq[T]friends`
/// does not.
fn word_off(tail: ref String, word: ref String) -> String? {
    if !tail.ends_with(word) {
        return null
    }
    let c: Vec[char] = tail.chars().collect()
    let w: Vec[char] = word.chars().collect()
    let shorter = between(c, 0, c.len() - w.len())
    if shorter.len() == 0 {
        return shorter
    }
    if c[c.len() - w.len() - 1].is_whitespace() {
        return shorter.trim_end().clone()
    }
    return null
}

/// **What the C boundary lends, read out of its text** (ADR-302 D5):
/// `ref mut T`, `ref Array[T]` and the two together. A plain `ref T` is not
/// one: it is the view every other declaration writes. The `?` at the end is
/// the pointee's (ADR-302 D14).
fn pointed_at(viewed: ref String) -> Ty? {
    let mut rest: String = viewed.clone()
    let mut mutable = false
    if rest.starts_with("mut ") {
        mutable = true
        let shorter = cut(rest, 4, 0)
        rest = shorter.trim_start().clone()
    }
    let mut absent = false
    if rest.ends_with("?") {
        absent = true
        let shorter = cut(rest, 0, 1)
        rest = shorter.trim_end().clone()
    }
    // **`Array[T]` is the run and `[T]` the spelling it replaced** (ADR-184
    // D3, D4). `Array[T, N]` is not one: the count lays it out inline.
    let mut slice = false
    let mut inner: String = ""
    if rest.starts_with(ARRAY_OPEN) && rest.ends_with("]") {
        let args = cut(rest, ARRAY_OPEN_LENGTH, 1)
        if split_args(args).len() == 1 {
            slice = true
            inner = args
        }
    }
    if !slice && rest.starts_with("[") && rest.ends_with("]") {
        slice = true
        inner = cut(rest, 1, 1)
    }
    if !mutable && !slice {
        return null
    }
    if !slice {
        inner = rest.clone()
    }
    let item = parse(inner)
    if absent {
        return Ty::Pointed { item: Ty::Nullable(item), slice: slice, mutable: mutable }
    }
    return Ty::Pointed { item: item, slice: slice, mutable: mutable }
}

/// `fn(A, B) -> R sync throws`: the parenthesis matched rather than found at
/// the end, and the words read off the back, because the result is whatever
/// stands in front of them (ADR-277 D6).
fn a_function(written: ref String) -> Ty? {
    let c: Vec[char] = written.chars().collect()
    let close = closing(c, 3, ')')
    if close < 0 {
        return null
    }
    let after = between(c, close + 1, c.len())
    let mut tail: String = after.trim().clone()
    let mut is_sync = false
    let mut can_throw = false
    while tail.len() > 0 {
        let without_throws = word_off(tail, "throws")
        if without_throws != null {
            can_throw = true
            tail = without_throws ?? ""
            continue
        }
        let without_sync = word_off(tail, "sync")
        if without_sync != null {
            is_sync = true
            tail = without_sync ?? ""
            continue
        }
        break
    }
    let params = each(split_args(between(c, 3, close)))
    if tail.starts_with("->") {
        let result = parse(cut(tail, 2, 0))
        return Ty::Fn { params: params, result: result, is_sync: is_sync, can_throw: can_throw }
    }
    return Ty::Fn { params: params, result: null, is_sync: is_sync, can_throw: can_throw }
}

/// `Seq[T] sync throws ends`, read the way a function type's tail is: the
/// bracket matched, the words read off the back in any order. `sync` and
/// `pauses` together, or a tail nobody wrote, is not this (ADR-172 D1).
fn a_sequence(written: ref String, word: ref String, parallel: bool) -> Ty? {
    if !written.starts_with(word) {
        return null
    }
    let w: Vec[char] = word.chars().collect()
    let after_word = cut(written, w.len(), 0)
    let rest: String = after_word.trim_start().clone()
    if !rest.starts_with("[") {
        return null
    }
    let c: Vec[char] = rest.chars().collect()
    let close = closing(c, 1, ']')
    if close < 0 {
        return null
    }
    let after = between(c, close + 1, c.len())
    let mut tail: String = after.trim().clone()
    let mut is_sync = false
    let mut pauses = false
    let mut can_throw = false
    let mut ends = false
    let mut sized = false
    let mut replays = false
    while tail.len() > 0 {
        let without_ends = word_off(tail, ENDS)
        if without_ends != null {
            ends = true
            tail = without_ends ?? ""
            continue
        }
        let without_sized = word_off(tail, SIZED)
        if without_sized != null {
            sized = true
            tail = without_sized ?? ""
            continue
        }
        let without_replays = word_off(tail, REPLAYS)
        if without_replays != null {
            replays = true
            tail = without_replays ?? ""
            continue
        }
        let without_throws = word_off(tail, "throws")
        if without_throws != null {
            can_throw = true
            tail = without_throws ?? ""
            continue
        }
        let without_sync = word_off(tail, "sync")
        if without_sync != null {
            is_sync = true
            tail = without_sync ?? ""
            continue
        }
        let without_pauses = word_off(tail, PAUSES)
        if without_pauses != null {
            pauses = true
            tail = without_pauses ?? ""
            continue
        }
        break
    }
    if is_sync && pauses {
        return null
    }
    if tail.len() > 0 {
        return null
    }
    let item = parse(between(c, 1, close))
    let shape = Shape { ends: ends, sized: sized, replays: replays }
    return Ty::Seq { item: item, is_sync: is_sync, pauses: pauses, can_throw: can_throw, parallel: parallel, shape: shape }
}

/// A name, its arguments and whether it is a view, or a variable: `ref $V`
/// is a view of what `$V` binds to. **A view of `String` is a view of text**
/// (ADR-184 D2), read back as the compiler's own noun for one.
fn a_name(rest: ref String, view: bool) -> Ty {
    if rest.starts_with("$") && rest.len() > 1 {
        return Ty::Var { name: cut(rest, 1, 0), view: view }
    }
    if view && rest == TEXT {
        return Ty::Named { name: TEXT_VIEW.clone(), args: [], view: true }
    }
    // Arguments only where the text ends in the bracket that closes them.
    if !rest.ends_with("]") {
        return Ty::Named { name: rest.clone(), args: [], view: view }
    }
    let c: Vec[char] = rest.chars().collect()
    let mut open = -1
    for at in 0..<c.len() {
        if open < 0 && c[at] == '[' {
            open = at
        }
    }
    if open >= 0 {
        let named_text = between(c, 0, open)
        return Ty::Named {
            name: named_text.trim().clone(),
            args: each(split_args(between(c, open + 1, c.len() - 1))),
            view: view,
        }
    }
    return Ty::Named { name: rest.clone(), args: [], view: view }
}

// ---------------------------------------------------------------------------
// The ledger's small records (ADR-294 step (b)): what a function's entry says
// besides its signature. Their text is read by the compiler's `contracts`,
// which writes them back through the methods here.
// ---------------------------------------------------------------------------

/// **Who chose a value's bytes** (ADR-010 D1): the program, or somebody else.
pub enum Provenance {
    Trusted,
    Untrusted,
}

impl Provenance {
    /// Both at once: untrusted where either is.
    pub fn join(self, other: Provenance) -> Provenance {
        if self == Provenance::Untrusted || other == Provenance::Untrusted {
            return Provenance::Untrusted
        }
        return Provenance::Trusted
    }

    /// The ledger's word for it.
    pub fn as_str(self) -> String {
        return match self {
            Provenance::Trusted => "trusted",
            Provenance::Untrusted => "untrusted",
        }
    }
}

/// **Whether a function is `sync`** (Part II 12.1), and how that is known:
/// not at all, inferred from its body, asserted by a hand-written entry, or
/// taken from another function's entry.
///
/// **`Unpromised` is never written.** It is what another package's
/// `"inferred"` reads as where it is checked from outside
/// ([ADR-288](../../../../docs/specification/adr/adr-288.md) D28): the body
/// cannot pause, and nobody promised it, so a caller has to count it as one
/// that may. It is kept apart from `No` so that a refusal can say which of the
/// two it is, and how the other package's author makes the promise.
pub enum Sync {
    No,
    Inferred,
    Asserted,
    From(String),
    Unpromised,
}

impl Sync {
    pub fn is_sync(ref self) -> bool {
        return match self {
            Sync::No => false,
            Sync::Unpromised => false,
            else => true,
        }
    }
}

/// **Whether a function takes a lock** (ADR-281 D28): not, yes, or nobody can
/// say yet.
pub enum Lock {
    No,
    Holds,
    Undecided,
}

impl Lock {
    pub fn holds(self) -> bool {
        return self == Lock::Holds
    }

    /// Either of two: a lock where one holds, undecided where one is.
    pub fn or(self, other: Lock) -> Lock {
        if self == Lock::Holds || other == Lock::Holds {
            return Lock::Holds
        }
        if self == Lock::Undecided || other == Lock::Undecided {
            return Lock::Undecided
        }
        return Lock::No
    }
}

/// **Whether a type may cross a thread** (ADR-005 §1), as a ledger says it.
pub enum Crosses {
    May,
    MayNot,
    Undecided,
}

impl Crosses {
    pub fn may(self) -> bool {
        return self == Crosses::May
    }

    pub fn may_not(self) -> bool {
        return self == Crosses::MayNot
    }
}

/// **Whether a function may run on another thread** than its caller's.
pub enum Threads {
    May,
    MayNot,
    Undecided,
}

impl Threads {
    pub fn may(self) -> bool {
        return self == Threads::May
    }

    pub fn may_not(self) -> bool {
        return self == Threads::MayNot
    }
}

/// **What a function reaches** (ADR-292): a kind of resource, the parameter
/// that names which one where one does, and whether it writes.
pub struct Touch {
    pub kind: String,
    pub parameter: String?,
    pub write: bool,
}

impl Touch {
    pub fn names_a_lock(ref self) -> bool {
        return self.kind == "lock"
    }

    /// `file(path) write`, as a ledger writes it.
    pub fn text(ref self) -> String {
        return touched(self.kind, self.parameter, self.write)
    }
}

/// [`Touch::text`], over a view of the parameter.
fn touched(kind: ref String, parameter: ref String?, write: bool) -> String {
    let access = if write { "write" } else { "read" }
    if parameter == null {
        return f"{kind} {access}"
    }
    let named_text = parameter ?? ""
    return f"{kind}({named_text}) {access}"
}

/// **How a view is held** (ADR-283 D2): borrowed for the call, or tethered to
/// a buffer that has to outlive it.
pub enum State {
    Borrowed,
    Tethered,
}

impl State {
    pub fn as_str(self) -> String {
        return match self {
            State::Borrowed => "borrowed",
            State::Tethered => "tethered",
        }
    }

    pub fn parse(written: ref String) -> State? {
        let word = written.trim()
        if word == "borrowed" {
            return State::Borrowed
        }
        if word == "tethered" {
            return State::Tethered
        }
        return null
    }

    /// The stronger of two: tethered where either is.
    pub fn or(self, other: State) -> State {
        if self == State::Tethered || other == State::Tethered {
            return State::Tethered
        }
        return State::Borrowed
    }
}

/// A position a view is held at, and how.
pub struct Held {
    pub position: String,
    pub state: State,
}

impl Held {
    /// `path: borrowed`.
    pub fn text(ref self) -> String {
        return f"{self.position}: {self.state.as_str()}"
    }
}

/// **What a shared allocation is counted with** (ADR-300): nothing, a plain
/// word, or an atomic one, in that order of cost.
pub enum Count {
    Plain,
    Word,
    Atomic,
}

impl Count {
    /// The costlier of two, which is what both need.
    pub fn join(self, other: Count) -> Count {
        if self == Count::Atomic || other == Count::Atomic {
            return Count::Atomic
        }
        if self == Count::Word || other == Count::Word {
            return Count::Word
        }
        return Count::Plain
    }

    /// Where the order matters to a caller that sorts: plain, word, atomic.
    pub fn rank(self) -> i64 {
        return match self {
            Count::Plain => 0,
            Count::Word => 1,
            Count::Atomic => 2,
        }
    }

    pub fn as_str(self) -> String {
        return match self {
            Count::Plain => "plain",
            Count::Word => "word",
            Count::Atomic => "atomic",
        }
    }

    pub fn parse(written: ref String) -> Count? {
        let word = written.trim()
        if word == "plain" {
            return Count::Plain
        }
        if word == "word" {
            return Count::Word
        }
        if word == "atomic" {
            return Count::Atomic
        }
        return null
    }
}

/// **Positions that are one allocation** (ADR-300), and what counts it.
pub struct Class {
    pub members: Vec[String],
    pub count: Count,
}

impl Class {
    /// `counts | <result>: atomic`.
    pub fn text(ref self) -> String {
        let mut out: String = ""
        for member in self.members {
            if !out.is_empty() {
                out.push_str(" | ")
            }
            out.push_str(member)
        }
        return f"{out}: {self.count.as_str()}"
    }
}

/// A field of a type a ledger describes.
pub struct FieldContract {
    pub name: String,
    pub ty: Ty,
    pub public: bool,
    /// The default's value as a literal (ADR-331 D5, D8), written after the
    /// type with ` = `; empty where the field has none.
    pub default: String,
    /// Its attributes' values, in written order, each a struct literal of
    /// literals: `Name { value: "createdAt", case: Case::Camel }` (ADR-331
    /// D6, D8).
    pub attributes: Vec[String],
}

/// A variant of an `enum` a ledger describes, and what it holds.
pub struct VariantContract {
    pub name: String,
    pub holds: Vec[FieldContract],
    /// `Write(String)` rather than `Move { x: i32 }`: read by position.
    pub positional: bool,
    /// Its attributes' values, as a field's are (ADR-331 D6, D8).
    pub attributes: Vec[String],
}

impl VariantContract {
    /// `Write(String)`, `Move { x: i32 }`, or the bare name.
    pub fn text(ref self) -> String {
        if self.holds.len() == 0 {
            return self.name.clone()
        }
        let mut parts: String = ""
        for field in self.holds {
            if !parts.is_empty() {
                parts.push_str(", ")
            }
            if self.positional {
                parts.push_str(ref field.ty.text())
            } else {
                parts.push_str(ref f"{field.name}: {field.ty.text()}")
            }
        }
        if self.positional {
            return f"{self.name}({parts})"
        }
        return f"{self.name} {{ {parts} }}"
    }
}

/// An option a function takes by name (Part I 5.1), with its type and the
/// default the ledger writes.
pub struct ConfigContract {
    pub name: String,
    pub ty: Ty,
    pub default: String,
}

/// **What a function's parameters and result are**, as the ledger writes them:
/// `[H: Handler](mut out: Vec[i64], text: ref String; limit: i64 = 10) -> T`.
pub struct Signature {
    /// The type parameters and what each must implement (ADR-295 D18).
    pub bounds: Vec[(String, Vec[String])],
    pub params: Vec[(String, Ty)],
    /// The parameters written `mut` (ADR-094 D3).
    pub mutable: Vec[String],
    /// The options it takes by name (Part I 5.1).
    pub config: Vec[ConfigContract],
    pub result: Ty?,
}

impl Signature {
    /// A signature that says nothing: no parameters and no result.
    pub fn empty() -> Signature {
        return Signature { bounds: [], params: [], mutable: [], config: [], result: null }
    }

    /// Whether the first parameter is the receiver.
    pub fn takes_a_receiver(ref self) -> bool {
        return self.params.len() > 0 && self.params[0].0 == "self"
    }

    /// The result, and the empty tuple where nothing is handed back.
    pub fn result_or_unit(ref self) -> Ty {
        return self.result?.clone() ?? Ty::Tuple([])
    }

    /// The ledger's spelling of it.
    pub fn text(ref self) -> String {
        let mut inside: String = ""
        for (name, ty) in self.params {
            if !inside.is_empty() {
                inside.push_str(", ")
            }
            if name == "self" {
                inside.push_str(ref ty.text())
            } else {
                if self.mutable.contains(name) {
                    inside.push_str("mut ")
                }
                inside.push_str(ref f"{name}: {ty.text()}")
            }
        }
        if self.config.len() > 0 {
            inside.push_str("; ")
            let mut first = true
            for option in self.config {
                if !first {
                    inside.push_str(", ")
                }
                first = false
                inside.push_str(ref f"{option.name}: {option.ty.text()} = {option.default}")
            }
        }
        // **In front, where the declaration writes them** (ADR-295 D18).
        let mut before: String = ""
        if self.bounds.len() > 0 {
            before.push('[')
            let mut first = true
            for (name, traits) in self.bounds {
                if !first {
                    before.push_str(", ")
                }
                first = false
                before.push_str(name)
                if traits.len() > 0 {
                    before.push_str(": ")
                    let mut one = true
                    for bound in traits {
                        if !one {
                            before.push_str(" + ")
                        }
                        one = false
                        before.push_str(bound)
                    }
                }
            }
            before.push(']')
        }
        if self.result == null {
            return f"{before}({inside})"
        }
        return f"{before}({inside}) -> {self.result_or_unit().text()}"
    }
}

/// **What a ledger says about one function**: whether others may call it,
/// whether it is `sync`, what it may fail with, what it touches, where its
/// bytes come from, its signature, and what the analyses found about its
/// parameters.
pub struct FnContract {
    pub public: bool,
    /// What the entry claims about `sync` (Part II 12.1). `sync` is a word
    /// this language reserves, so it cannot name the field.
    pub sync_claim: Sync,
    /// What it may fail with: the error types that can leave it (Kap 7.1).
    pub fails_with: Vec[String],
    pub touches: Vec[Touch],
    /// Whether `touches` is what somebody wrote rather than what was inferred.
    pub touches_known: bool,
    pub provenance: Provenance?,
    pub signature: Signature?,
    pub borrows: Vec[String],
    pub keeps: Vec[String],
    pub mutates: bool,
    pub touches_a_lock: Lock,
    pub threads: Threads,
    pub views: Vec[Held],
    pub sharing: Vec[Class],
    pub ends_by_length: bool,
    /// **A grammar entry whose body is a `par_fold`** (ADR-296 D19, #521):
    /// a consumer in another package drives it in pieces, as the grammar's own
    /// file does. Written only where it holds.
    pub pieces: bool,
    /// **What a caller has to establish**: the function's preconditions, each
    /// an `assert` of its body carried back to the entry, in the language's
    /// syntax over the parameters
    /// ([ADR-269](../../../../docs/specification/adr/adr-269.md) D18).
    pub requires: Vec[String],
    /// **What a caller may rely on afterwards**: its postconditions, over the
    /// parameters and `result` (ADR-269 D17, D18).
    pub ensures: Vec[String],
    /// For each entry of `requires` and then of `ensures`, the `assert` it was
    /// computed from, as written (ADR-269 D18).
    pub from: Vec[String],
}

impl FnContract {
    /// An entry that says nothing: not public, not `sync`, touching nothing
    /// known, and undecided where a question has a third answer.
    pub fn empty() -> FnContract {
        return FnContract {
            public: false,
            sync_claim: Sync::No,
            fails_with: [],
            touches: [],
            touches_known: false,
            provenance: null,
            signature: null,
            borrows: [],
            keeps: [],
            mutates: false,
            touches_a_lock: Lock::No,
            threads: Threads::Undecided,
            views: [],
            sharing: [],
            ends_by_length: false,
            pieces: false,
            requires: [],
            ensures: [],
            from: [],
        }
    }
}

/// **What a ledger says about one type**: its fields or variants, and the
/// questions the analyses ask of it.
pub struct TypeContract {
    pub public: bool,
    pub fields: Vec[FieldContract],
    pub variants: Vec[VariantContract],
    pub crosses: Crosses,
    pub iterates_fallibly: bool,
    pub compares: bool,
    pub copies: bool,
    pub touches: Vec[String],
    pub tethered: Vec[String],
    /// **How a build-time value of a `std` type whose parts this compiler
    /// cannot walk is written**: its constructor and the parts it takes,
    /// `time::Duration::new(secs: u64, nanos: u32)`
    /// ([ADR-318](../../../../docs/specification/adr/adr-318.md) D5). Empty
    /// where the type has none, and then it does not cross.
    pub constant: String,
    /// **What its `@meta::Attribute(…)` says**, where it is an attribute
    /// (ADR-331 D2, D8): the places, and `; repeatable` where it may stand
    /// twice - `field, struct; repeatable`. Empty where it is none.
    pub mark: String,
    /// The type's own attributes' values, as a field's are (ADR-331 D6, D8).
    pub attributes: Vec[String],
}

impl TypeContract {
    /// An entry that says nothing, and undecided about crossing a thread.
    pub fn empty() -> TypeContract {
        return TypeContract {
            public: false,
            fields: [],
            variants: [],
            crosses: Crosses::Undecided,
            iterates_fallibly: false,
            compares: false,
            copies: false,
            touches: [],
            tethered: [],
            constant: "",
            mark: "",
            attributes: [],
        }
    }
}

/// **One compilation unit's contracts** (ADR-294 D12).
///
/// Ordered maps throughout, because the file is a **pure function of (source,
/// toolchain)** (13.5) and a hash map's iteration order is not. The
/// determinism is the feature: `--locked` compares bytes, so it needs no
/// tolerance and no semantic comparison.
pub struct Ledger {
    pub version: u32,
    pub toolchain: String,
    pub inference: String,
    /// The sources these entries were derived from: one unit of the package by
    /// file name, and the SHA-256 of its bytes
    /// (ADR-100 D3).
    ///
    /// **What it is for is telling a stale ledger from a believed one.** A
    /// consumer reads a dependency's ledger rather than deriving it (D1), and
    /// the only thing that makes believing safe is that a ledger is never
    /// believed against its own sources: where a hash does not match, that
    /// package is derived again. So this is not a checksum of the file — it is
    /// the record of what the file is an answer *about*.
    ///
    /// **The file name and not a path**, because a package is one directory of
    /// `.nika` files (`modules::collect`) and a path would put the machine that
    /// built it into a file Part III 13.5 makes a pure function of the source
    /// tree.
    ///
    /// Empty where nothing knows the sources — a ledger inferred from one
    /// `Parsed` that never came from a file, and `std`'s own, whose Rust half
    /// has no `.nika` to hash (ADR-020
    /// D5). An empty table renders nothing, so no existing ledger changes.
    pub sources: collections::BTreeMap[String, String],
    pub functions: collections::BTreeMap[String, FnContract],
    pub types: collections::BTreeMap[String, TypeContract],
    /// **Whether the code stored in a function field touches a lock**, by
    /// `Type.field` (ADR-230 D1):
    /// over everything this package stores there. The package's own answer and
    /// not written to the ledger file - a published field is stored into by
    /// packages that do not exist yet, so the file has nothing to say about it.
    pub code_locks: collections::BTreeMap[String, Lock],
    /// Kap 4.7: every `trait` declared here, with the names of its methods.
    ///
    /// The **signatures** are in `functions`, keyed `Summarize::summary`, which
    /// is where a bound looks one up. This map answers the other question a
    /// bound asks first: *is `Summarize` a trait at all*
    /// (ADR-295 D8). A name that
    /// is not in here names no trait, and a bound on it is refused rather than
    /// quietly believed.
    ///
    /// **Written to the ledger file** as `[trait."Handler"]`, with no methods in
    /// it (ADR-295 D12): they are
    /// the `fn` entries beside it, under `Handler::handle`, and the set is
    /// filled from those once the whole file is parsed.
    /// ADR-295 left *a trait a
    /// package publishes* as a question about modules; D1 and D3 of that later
    /// record answered it, and a bound has taken a path since 0.0.171.
    pub traits: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// **Who answers for what**: a trait's name to the types that `impl` it
    /// (ADR-295 D15).
    ///
    /// The other half of a bound, and the reason it is here rather than in the
    /// checker: `impl Speaks for Dog` may stand in a **different file** from
    /// the `fn tell[T: Speaks]` that needs the answer, and one file's walk sees
    /// one file. A program's ledger is absorbed from its units', so the union
    /// over the files is a thing this map already knows how to be.
    ///
    /// **Written to the ledger file** as `[impl."Handler for Static"]`
    /// (ADR-295 D13), one line per
    /// pair. Each ledger says only what it **wrote** — an `impl` may stand in
    /// the trait's package, in the type's, or in a consumer for its own type —
    /// so the answer at a call is the union over every ledger the program reads
    /// plus its own, and no ledger claims completeness.
    pub implementations: collections::BTreeMap[String, collections::BTreeSet[String]],
}

impl Ledger {
    /// A ledger with no header and nothing in it: what the compiler's `empty`
    /// stamps a header onto, and what a reader fills.
    pub fn blank() -> Ledger {
        return Ledger {
            version: 0,
            toolchain: "",
            inference: "",
            sources: collections::BTreeMap(),
            functions: collections::BTreeMap(),
            types: collections::BTreeMap(),
            code_locks: collections::BTreeMap(),
            traits: collections::BTreeMap(),
            implementations: collections::BTreeMap(),
        }
    }
}

/// **What a describer saw and did not claim** (ADR-290 D8, D10).
///
/// Rendered as comments into `contracts/<crate>.contracts` and never parsed
/// back. The distinction the record rests on: ADR-123 D2 lets the describer
/// *fill* `crosses` because a field holding an `Rc` **entails** not sendable;
/// nothing a signature can show entails *threads*, so what it saw is a
/// sentence and the column stays a person's.
pub struct Notes {
    /// About the crate: the `unsafe impl Send`/`Sync` items it contains (D5).
    pub about_the_crate: Vec[String],
    /// About one entry, by the key it is written under (D3).
    pub about_a_function: collections::BTreeMap[String, Vec[String]],
}

impl Notes {
    /// Nothing seen.
    pub fn empty() -> Notes {
        return Notes { about_the_crate: [], about_a_function: collections::BTreeMap() }
    }
}

// ---------------------------------------------------------------------------
// What the checker asks of a type (ADR-294 step (d))
// ---------------------------------------------------------------------------

/// The stamp a lock puts on what it hands out (ADR-281 D22).
pub comptime SEEN: ref String = "Seen"

impl Ty {
    /// Whether this is `?`, the absence of a claim.
    pub fn is_unknown(ref self) -> bool {
        return match self {
            Ty::Unknown => true,
            else => false,
        }
    }

    /// The same type, read as a **view** of it (ADR-278 D19): a view of
    /// `String` is `str` (ADR-184 D2), a view of anything else is that name
    /// with the word on it. A type this compiler cannot name has no view, and
    /// neither does one that is already one.
    pub fn as_a_view(ref self) -> Ty {
        return match self {
            Ty::Named { name, args, view } => viewed_name(name, args, view),
            else => self.clone(),
        }
    }

    /// Whether a lock handed this out (ADR-281 D22), at any depth a stamp can
    /// be at: a nullable of a stamped value is stamped. A bare `Seen` is a
    /// type the program declared.
    pub fn is_seen(ref self) -> bool {
        return match self {
            Ty::Named { name, args, .. } => name == SEEN && args.len() == 1,
            Ty::Nullable(inner) => inner.is_seen(),
            else => false,
        }
    }

    /// The type under the stamp, or this type where there is none. There is
    /// no word for this in the language (ADR-281 D25): it is the emitter's,
    /// which erases the stamp, and a fit's, which compares what is under it.
    pub fn unseen(ref self) -> Ty {
        match self {
            Ty::Named { name, args, .. } => {
                if name == SEEN && args.len() == 1 {
                    return args[0].clone()
                }
            }
            Ty::Nullable(inner) => {
                return Ty::Nullable(inner.unseen())
            }
            else => {}
        }
        return self.clone()
    }

    /// **The value a view is of**: `ref Vec[i64]` is a view of `Vec[i64]`,
    /// and any other type is itself. What a view of a value is lent (#455).
    pub fn owned(ref self) -> Ty {
        return match self {
            Ty::Named { name, args, view } => if view { Ty::Named { name: name.clone(), args: args.clone(), view: false } } else { self.clone() },
            else => self.clone(),
        }
    }

    /// Whether this type **is** a view: whether a second `&` would be written
    /// in front of one (ADR-094 D1). A nullable of a view counts; `ref
    /// Array[T]` is a view of a run (ADR-179 D1) and `ref mut Array[T]` is not,
    /// because a position written through gains its `&mut` from its word.
    pub fn is_a_view(ref self) -> bool {
        return match self {
            Ty::Named { view, .. } => view,
            Ty::Var { view, .. } => view,
            Ty::Nullable(inner) => inner.is_a_view(),
            Ty::Pointed { slice, mutable, .. } => slice && !mutable,
            else => false,
        }
    }

    /// **Whether a value of this type may stand where `expected` is wanted.**
    ///
    /// Equality, plus the rule that makes the checker usable: anything
    /// involving `?` fits. There is no subtyping and no implicit widening
    /// (ADR-013 D7) beyond the one Part I 2.3 writes, a plain value into a
    /// nullable slot. The cases, in the order they are asked:
    ///
    /// * a stamp passes through (ADR-281 D23);
    /// * tuples part by part, a count only the same count (ADR-152 D4);
    /// * what the C boundary lends fits the same shape (ADR-302 D5);
    /// * an `Array[T, N]` fits an `Array[T]` and not back (ADR-184 D3);
    /// * what a caller may hand to a boundary type (ADR-302 D5);
    /// * a lambda that does less fits a type that allows more (ADR-277 D7);
    /// * two sequences when their items do, read as a lambda's words are
    ///   (ADR-105 D1, ADR-172 D1, ADR-293 D16);
    /// * a variable that reaches a comparison was never bound, and fits;
    /// * nullables, and a plain value into a nullable slot;
    /// * two names written the same, with arguments that fit.
    pub fn fits(ref self, expected: ref Ty) -> bool {
        if self.is_unknown() || expected.is_unknown() {
            return true
        }
        if self.is_seen() || expected.is_seen() {
            return self.unseen().fits(ref expected.unseen())
        }
        match self {
            Ty::Tuple(parts) => {
                if a_tuple(expected) {
                    return tuple_fits(parts, expected)
                }
            }
            Ty::Count(n) => {
                if a_count(expected) {
                    return count_fits(n, expected)
                }
            }
            Ty::Pointed { item, slice, mutable } => {
                if a_pointed(expected) {
                    return pointed_fits(item, slice, mutable, expected)
                }
            }
            Ty::Named { name, args, view } => {
                if !view && name == ARRAY && args.len() == 2 && an_array_of_any_length(expected) {
                    return array_fits(args, expected)
                }
            }
            else => {}
        }
        match expected {
            Ty::Pointed { item, slice, .. } => {
                if slice {
                    return lends_a_run_of(self, item)
                }
                return self.fits(item)
            }
            else => {}
        }
        match self {
            Ty::Fn { params, result, is_sync, can_throw } => {
                if a_function_type(expected) {
                    return function_fits(params, result, is_sync, can_throw, expected)
                }
            }
            Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => {
                if a_sequence_type(expected) {
                    return sequence_fits(item, is_sync, pauses, can_throw, parallel, shape, expected)
                }
            }
            Ty::Var { .. } => {
                return true
            }
            else => {}
        }
        match expected {
            Ty::Var { .. } => {
                return true
            }
            Ty::Nullable(wanted) => {
                return nullable_fits(self, wanted)
            }
            Ty::Named { name, args, view } => {
                return named_fits(self, name, args, view)
            }
            else => {}
        }
        return false
    }

    /// The same type with every name in `parameters` replaced by `?`
    /// (ADR-024 D4): a generic parameter stands for a type rather than being
    /// one, so a generic function's parameters are checked for number and not
    /// for type. A count is a number and no parameter stands for it (ADR-152
    /// §4); a library's variable is not a Nikaia function's generic.
    pub fn erase(ref self, parameters: ref collections::BTreeSet[String]) -> Ty {
        return match self {
            Ty::Pointed { item, slice, mutable } => Ty::Pointed { item: item.erase(parameters), slice: slice, mutable: mutable },
            Ty::Tuple(parts) => Ty::Tuple(erased_each(parts, parameters)),
            Ty::Fn { params, result, is_sync, can_throw } => Ty::Fn { params: erased_each(params, parameters), result: result?.erase(parameters), is_sync: is_sync, can_throw: can_throw },
            Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => Ty::Seq { item: item.erase(parameters), is_sync: is_sync, pauses: pauses, can_throw: can_throw, parallel: parallel, shape: shape.clone() },
            Ty::Nullable(inner) => Ty::Nullable(inner.erase(parameters)),
            Ty::Named { name, args, view } => erased_name(name, args, view, parameters),
            else => self.clone(),
        }
    }

    /// The same type with every name in `parameters` turned into a variable a
    /// call site binds (ADR-295): `erase`'s sibling, for a name that stands
    /// for a type a caller passes. A variable is bound and replaced, or
    /// becomes `?`, so it never reaches a comparison.
    pub fn parameterise(ref self, parameters: ref collections::BTreeSet[String]) -> Ty {
        return match self {
            Ty::Pointed { item, slice, mutable } => Ty::Pointed { item: item.parameterise(parameters), slice: slice, mutable: mutable },
            Ty::Tuple(parts) => Ty::Tuple(parameterised_each(parts, parameters)),
            Ty::Fn { params, result, is_sync, can_throw } => Ty::Fn { params: parameterised_each(params, parameters), result: result?.parameterise(parameters), is_sync: is_sync, can_throw: can_throw },
            Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => Ty::Seq { item: item.parameterise(parameters), is_sync: is_sync, pauses: pauses, can_throw: can_throw, parallel: parallel, shape: shape.clone() },
            Ty::Nullable(inner) => Ty::Nullable(inner.parameterise(parameters)),
            Ty::Named { name, args, view } => parameterised_name(name, args, view, parameters),
            else => self.clone(),
        }
    }
}

// The same four walks as methods, so that a `?.` reaches them on a result
// that may be absent.
impl Ty {
    fn fits_any(ref self, wanted: ref Ty?) -> bool {
        return wanted?.fitted_by(self) ?? true
    }

    fn fitted_by(ref self, found: ref Ty) -> bool {
        return found.fits(self)
    }

    fn substituted_in(ref self, bound: ref collections::BTreeMap[String, Ty]) -> Ty {
        return substitute(self, bound)
    }

    fn qualified_in(ref self, module: ref String, declared: ref collections::BTreeSet[String]) -> Ty {
        return qualify(self, module, declared)
    }

    fn renamed_by(ref self, renames: ref collections::BTreeMap[String, String]) -> Ty {
        return renamed(self, renames)
    }
}

// A view of a named type.
fn viewed_name(name: ref String, args: ref Array[Ty], view: bool) -> Ty {
    if view {
        return Ty::Named { name: name.clone(), args: args.clone(), view: true }
    }
    if args.len() == 0 && (name == TEXT || name.ends_with("::String")) {
        return Ty::Named { name: TEXT_VIEW.clone(), args: [], view: true }
    }
    return Ty::Named { name: name.clone(), args: args.clone(), view: true }
}

fn a_tuple(ty: ref Ty) -> bool {
    return match ty {
        Ty::Tuple(_) => true,
        else => false,
    }
}

fn a_count(ty: ref Ty) -> bool {
    return match ty {
        Ty::Count(_) => true,
        else => false,
    }
}

fn a_pointed(ty: ref Ty) -> bool {
    return match ty {
        Ty::Pointed { .. } => true,
        else => false,
    }
}

fn a_function_type(ty: ref Ty) -> bool {
    return match ty {
        Ty::Fn { .. } => true,
        else => false,
    }
}

fn a_sequence_type(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { .. } => true,
        else => false,
    }
}

// Two lists of types that fit part by part.
fn all_fit(found: ref Array[Ty], wanted: ref Array[Ty]) -> bool {
    if found.len() != wanted.len() {
        return false
    }
    for at in 0..<found.len() {
        if !found[at].fits(ref wanted[at]) {
            return false
        }
    }
    return true
}

fn tuple_fits(parts: ref Array[Ty], expected: ref Ty) -> bool {
    return match expected {
        Ty::Tuple(wanted) => all_fit(parts, wanted),
        else => false,
    }
}

fn count_fits(n: i64, expected: ref Ty) -> bool {
    return match expected {
        Ty::Count(wanted) => n == wanted,
        else => false,
    }
}

// A `ref mut Array[u8]` is not a `ref Array[u8]`, which promises not to
// write, and a run is not one element (ADR-302 D5).
fn pointed_fits(found: ref Ty, run: bool, writes: bool, expected: ref Ty) -> bool {
    return match expected {
        Ty::Pointed { item, slice, mutable } => found.fits(item) && run == slice && writes == mutable,
        else => false,
    }
}

// `Array[T]` with no length, which an `Array[T, N]` fits.
fn an_array_of_any_length(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, view } => !view && name == ARRAY && args.len() == 1,
        else => false,
    }
}

fn array_fits(given: ref Array[Ty], expected: ref Ty) -> bool {
    return match expected {
        Ty::Named { args, .. } => given[0].fits(ref args[0]),
        else => false,
    }
}

// Whether a value of this type lends a **run** of `item` laid out in memory
// (ADR-302 D5): a list, an array and - where the item is `u8` - text, which
// is a run of bytes. A slice is a run already (ADR-293 D23).
fn lends_a_run_of(found: ref Ty, item: ref Ty) -> bool {
    return match found {
        Ty::Unknown => true,
        Ty::Named { name, args, .. } => a_run_named(name, args, item),
        else => false,
    }
}

fn a_run_named(name: ref String, args: ref Array[Ty], item: ref Ty) -> bool {
    if (name == "Vec" || name == "List") && args.len() == 1 {
        return args[0].fits(item)
    }
    if name == ARRAY && (args.len() == 1 || args.len() == 2) {
        return args[0].fits(item)
    }
    if (name == "String" || name == "str") && args.len() == 0 {
        return match item {
            Ty::Named { name, .. } => name == "u8",
            else => false,
        }
    }
    return false
}

// A lambda that does less fits a type that allows more (ADR-277 D7): one that
// never pauses goes where pausing is allowed, one that cannot fail where
// failing is. A result nobody wrote is the absence of a claim.
fn function_fits(found: ref Array[Ty], found_result: ref Ty?, never_pauses: bool, fails: bool, expected: ref Ty) -> bool {
    return match expected {
        Ty::Fn { params, result, is_sync, can_throw } => all_fit(found, params) && results_fit(found_result, result) && (never_pauses || !is_sync) && (!fails || can_throw),
        else => false,
    }
}

fn results_fit(found: ref Ty?, wanted: ref Ty?) -> bool {
    if found == null || wanted == null {
        return true
    }
    return found?.fits_any(wanted) ?? true
}

// Two sequences fit when their items do (ADR-105 D1). `pauses` fits as
// `throws` does and the other way round from `sync` (ADR-172 D1); `Par` fits
// `Seq` and not back (D3); a demanded shape is met by the word (ADR-293 D16).
fn sequence_fits(found: ref Ty, never_pauses: bool, may_pause: bool, fails: bool, at_once: bool, has: ref Shape, expected: ref Ty) -> bool {
    return match expected {
        Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => found.fits(item) && (never_pauses || !is_sync) && (!may_pause || pauses) && (!fails || can_throw) && (at_once || !parallel) && has.meets(shape),
        else => false,
    }
}

// Two nullables fit when what they may hold fits, and a plain value fits a
// nullable slot - the one widening this checker has (Part I 2.3).
fn nullable_fits(found: ref Ty, wanted: ref Ty) -> bool {
    return match found {
        Ty::Nullable(inner) => inner.fits(wanted),
        else => found.fits(wanted),
    }
}

// Two names fit when they are written the same, view and all, with arguments
// that fit.
fn named_fits(found: ref Ty, wanted: ref String, wanted_args: ref Array[Ty], wanted_view: bool) -> bool {
    return match found {
        Ty::Named { name, args, view } => name == wanted && view == wanted_view && all_fit(args, wanted_args),
        else => false,
    }
}

fn erased_each(parts: ref Array[Ty], parameters: ref collections::BTreeSet[String]) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    for part in parts {
        out.push(part.erase(parameters))
    }
    return out
}

fn erased_name(name: ref String, args: ref Array[Ty], view: bool, parameters: ref collections::BTreeSet[String]) -> Ty {
    if args.len() == 0 && parameters.contains(name) {
        return Ty::Unknown
    }
    return Ty::Named { name: name.clone(), args: erased_each(args, parameters), view: view }
}

fn parameterised_each(parts: ref Array[Ty], parameters: ref collections::BTreeSet[String]) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    for part in parts {
        out.push(part.parameterise(parameters))
    }
    return out
}

fn parameterised_name(name: ref String, args: ref Array[Ty], view: bool, parameters: ref collections::BTreeSet[String]) -> Ty {
    if args.len() == 0 && parameters.contains(name) {
        return Ty::Var { name: name.clone(), view: view }
    }
    return Ty::Named { name: name.clone(), args: parameterised_each(args, parameters), view: view }
}

/// **Bind a library signature's variables from the receiver's type**
/// (ADR-288): one level and by position, and a mismatch binds nothing. The
/// view flag is not compared, because a signature writes the receiver the way
/// the method takes it and a caller holds it however it holds it. A sequence
/// binds through its item (ADR-105 D1) and a lambda through its parameters and
/// result (ADR-293 D20).
pub fn bind(pattern: ref Ty, actual: ref Ty, mut out: collections::BTreeMap[String, Ty]) {
    match pattern {
        Ty::Var { name, .. } => {
            if !out.contains_key(name) {
                out.insert(name.clone(), actual.clone())
            }
        }
        Ty::Named { name, args, .. } => {
            bind_named(name, args, actual, out)
        }
        Ty::Seq { item, .. } => {
            bind_item(item, actual, out)
        }
        Ty::Fn { params, result, .. } => {
            bind_code(params, result, actual, out)
        }
        else => {}
    }
}

fn bind_named(pattern_name: ref String, pattern_args: ref Array[Ty], actual: ref Ty, mut out: collections::BTreeMap[String, Ty]) {
    match actual {
        Ty::Named { name, args, .. } => {
            bind_arguments(pattern_name, pattern_args, name, args, out)
        }
        else => {}
    }
}

// Argument by argument, where the two are one name with as many arguments.
fn bind_arguments(pattern_name: ref String, pattern_args: ref Array[Ty], name: ref String, args: ref Array[Ty], mut out: collections::BTreeMap[String, Ty]) {
    if name != pattern_name || args.len() != pattern_args.len() {
        return
    }
    for at in 0..<args.len() {
        bind(pattern_args[at], args[at], out)
    }
}

fn bind_item(pattern: ref Ty, actual: ref Ty, mut out: collections::BTreeMap[String, Ty]) {
    match actual {
        Ty::Seq { item, .. } => {
            bind(pattern, item, out)
        }
        else => {}
    }
}

fn bind_code(pattern_params: ref Array[Ty], pattern_result: ref Ty?, actual: ref Ty, mut out: collections::BTreeMap[String, Ty]) {
    match actual {
        Ty::Fn { params, result, .. } => {
            let shorter = if params.len() < pattern_params.len() { params.len() } else { pattern_params.len() }
            for at in 0..<shorter {
                bind(pattern_params[at], params[at], out)
            }
            if pattern_result != null && result != null {
                let pattern = pattern_result?.clone() ?? Ty::Unknown
                let bound_from = result?.clone() ?? Ty::Unknown
                bind(pattern, bound_from, out)
            }
        }
        else => {}
    }
}

/// **A signature's variables replaced by what they were bound to.** An
/// unbound variable becomes `?`, never a name: that is the whole safety
/// argument for `Var` (ADR-024 D4). `ref $V` bound to a named type is a view
/// of it.
pub fn substitute(ty: ref Ty, bound: ref collections::BTreeMap[String, Ty]) -> Ty {
    return match ty {
        Ty::Var { name, view } => substituted(name, view, bound),
        Ty::Named { name, args, view } => Ty::Named { name: name.clone(), args: substituted_each(args, bound), view: view },
        Ty::Tuple(parts) => Ty::Tuple(substituted_each(parts, bound)),
        Ty::Pointed { item, slice, mutable } => Ty::Pointed { item: substitute(item, bound), slice: slice, mutable: mutable },
        Ty::Fn { params, result, is_sync, can_throw } => Ty::Fn { params: substituted_each(params, bound), result: substituted_result(result, bound), is_sync: is_sync, can_throw: can_throw },
        Ty::Seq { item, is_sync, pauses, can_throw, parallel, shape } => Ty::Seq { item: substitute(item, bound), is_sync: is_sync, pauses: pauses, can_throw: can_throw, parallel: parallel, shape: shape.clone() },
        Ty::Nullable(inner) => Ty::Nullable(substitute(inner, bound)),
        else => ty.clone(),
    }
}

fn substituted(name: ref String, view: bool, bound: ref collections::BTreeMap[String, Ty]) -> Ty {
    if !bound.contains_key(name) {
        return Ty::Unknown
    }
    let found = bound[name]?.clone() ?? Ty::Unknown
    if view {
        match found {
            Ty::Named { name, args, .. } => {
                return Ty::Named { name: name.clone(), args: args.clone(), view: true }
            }
            else => {}
        }
    }
    return found.clone()
}

fn substituted_each(parts: ref Array[Ty], bound: ref collections::BTreeMap[String, Ty]) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    for part in parts {
        out.push(substitute(part, bound))
    }
    return out
}

fn substituted_result(result: ref Ty?, bound: ref collections::BTreeMap[String, Ty]) -> Ty? {
    return result?.substituted_in(bound)
}

/// **Every named type `declared` lists, written with `module::` in front**
/// (ADR-296 D17): a module's own signature says `-> Conn`, and a caller writes
/// `pool::Conn`. Made one where a unit is absorbed, the only place that knows
/// both the module and what it declares.
pub fn qualify(ty: ref Ty, module: ref String, declared: ref collections::BTreeSet[String]) -> Ty {
    return match ty {
        Ty::Named { name, args, view } => Ty::Named { name: qualified_name(name, module, declared), args: qualified_each(args, module, declared), view: view },
        Ty::Tuple(parts) => Ty::Tuple(qualified_each(parts, module, declared)),
        Ty::Fn { params, result, is_sync, can_throw } => Ty::Fn { params: qualified_each(params, module, declared), result: qualified_result(result, module, declared), is_sync: is_sync, can_throw: can_throw },
        else => ty.clone(),
    }
}

fn qualified_name(name: ref String, module: ref String, declared: ref collections::BTreeSet[String]) -> String {
    if declared.contains(name) {
        return f"{module}::{name}"
    }
    return name.clone()
}

fn qualified_each(parts: ref Array[Ty], module: ref String, declared: ref collections::BTreeSet[String]) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    for part in parts {
        out.push(qualify(part, module, declared))
    }
    return out
}

fn qualified_result(result: ref Ty?, module: ref String, declared: ref collections::BTreeSet[String]) -> Ty? {
    return result?.qualified_in(module, declared)
}

/// **A type named through one package's word for another, renamed to the
/// word this build uses** (ADR-286 D20): only the prefix, and only where the
/// map has it. A `&` in front is a view's spelling and stays where it was.
pub fn renamed(ty: ref Ty, renames: ref collections::BTreeMap[String, String]) -> Ty {
    return match ty {
        Ty::Named { name, args, view } => Ty::Named { name: renamed_name(name, renames), args: renamed_each(args, renames), view: view },
        Ty::Tuple(parts) => Ty::Tuple(renamed_each(parts, renames)),
        Ty::Fn { params, result, is_sync, can_throw } => Ty::Fn { params: renamed_each(params, renames), result: renamed_result(result, renames), is_sync: is_sync, can_throw: can_throw },
        Ty::Nullable(inner) => Ty::Nullable(renamed(inner, renames)),
        else => ty.clone(),
    }
}

fn renamed_name(name: ref String, renames: ref collections::BTreeMap[String, String]) -> String {
    if name.starts_with("&") {
        let rest = cut(name, 1, 0)
        let path = renamed_path(rest, renames)
        return f"&{path}"
    }
    return renamed_path(name, renames)
}

// The package before the first `::`, renamed where the map has it.
fn renamed_path(name: ref String, renames: ref collections::BTreeMap[String, String]) -> String {
    let c: Vec[char] = name.chars().collect()
    for at in 0..<c.len() {
        if at + 1 < c.len() && c[at] == ':' && c[at + 1] == ':' {
            let package = between(c, 0, at)
            if renames.contains_key(package) {
                let ours = renames[package] ?? ""
                let rest = between(c, at, c.len())
                return f"{ours}{rest}"
            }
            return name.clone()
        }
    }
    return name.clone()
}

fn renamed_each(parts: ref Array[Ty], renames: ref collections::BTreeMap[String, String]) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    for part in parts {
        out.push(renamed(part, renames))
    }
    return out
}

fn renamed_result(result: ref Ty?, renames: ref collections::BTreeMap[String, String]) -> Ty? {
    return result?.renamed_by(renames)
}
