// crates/nikaia-std/src/tools/throws.nika
//
// Kap 7.1: **which errors can leave a function** - the lattice of the
// compiler's `contracts::throws`, moved from Rust (ADR-294, #125).
//
// **What moved is the fixpoint and what a `throw` names.** What stays Rust is
// the walk that finds, per function, what it throws itself and whom it calls:
// it is `sync`'s walk (ADR-288's single resolution), and it moves with it. The
// compiler hands this module the two maps the walk builds and the ledger, and
// writes back what it answers.
//
// An error set is a **least** fixpoint, `sync`'s walk with the lattice turned
// around: everyone starts with what they throw themselves and grows by what
// their callees throw, until nothing changes. Mutual recursion ends because
// the sets only grow, and there are finitely many names to grow by.

use std::collections

/// What every `throws` function of the ledger fails with, by name: `direct`
/// is what each throws itself (`"?"` where it cannot be named) and `calls`
/// whom in this package it calls. A function the ledger does not carry, or
/// carries as one that cannot fail, has no entry - a function that cannot
/// fail cannot propagate. A declared `throws` whose body names nothing keeps
/// `["?"]`: the declaration is a promise a caller already relies on, and this
/// is here to say more than it, never less.
pub fn error_sets(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger) -> collections::BTreeMap[String, Vec[String]] {
    let mut sets = direct.clone()
    let mut changed = true
    while changed {
        changed = false
        for (name, callees) in calls {
            let before = sets[name]?.clone() ?? collections::BTreeSet()
            let mut grown = before.clone()
            for callee in callees {
                for error in theirs(sets, own, callee) {
                    grown.insert(error)
                }
            }
            if grown.len() != before.len() {
                sets.insert(name.clone(), grown)
                changed = true
            }
        }
    }
    let mut settled: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (name, set) in sets {
        let contract = own.functions[name] ?? continue
        if contract.fails_with.len() == 0 {
            continue
        }
        let mut errors: Vec[String] = []
        for error in set {
            errors.push(error.clone())
        }
        if errors.len() == 0 {
            errors.push("?")
        }
        settled.insert(name.clone(), errors)
    }
    return settled
}

/// What a callee fails with. **One the walk did not see still has a set**
/// (ADR-296 D40): a grammar's entry rule is not an `Item::Fn`, and its contract
/// is written straight into the ledger (ADR-296 D24). Read as nothing, what a
/// parse throws reached no caller, and the caller's channel was inferred
/// without it - a file `rustc` refused.
fn theirs(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, callee: ref String) -> Vec[String] {
    let mut errors: Vec[String] = []
    if sets.contains_key(callee) {
        let set = sets[callee] ?? return errors
        for error in set {
            errors.push(error.clone())
        }
        return errors
    }
    let contract = own.functions[callee] ?? return errors
    for error in contract.fails_with {
        errors.push(error.clone())
    }
    return errors
}

/// The type a `throw` raises. `ConfigError::NotFound(p)` and
/// `ConfigError::NotFound` are both `ConfigError`: a variant is written under
/// the type that declares it (Part I, 3.4), so **everything but the last
/// segment** is the type - `io::IoError::NotFound` is `io::IoError`, a type
/// keyed with its module (ADR-154 D3). A variant with named fields is a
/// struct literal, `ConfigError::BadSyntax { line }`, and records the type and
/// not the variant too (ADR-023 D1, ADR-280 D9).
pub fn error_type(names: ref winnow_grammar::InternerContext, thrown: ref Expr) -> String? {
    return match thrown {
        Expr::Path(segments) => if segments.len() > 1 { all_but_the_last(names, segments) } else { null },
        Expr::Call { func, .. } => error_type(names, func),
        Expr::StructLit { name, .. } => struct_type(names.resolve(name)),
        else => null,
    }
}

/// `io::IoError::NotFound` read as the path of its type.
fn all_but_the_last(names: ref winnow_grammar::InternerContext, segments: ref Vec[winnow_grammar::Symbol]) -> String {
    let mut written: String = ""
    for k in 0..<segments.len() - 1 {
        if k > 0 {
            written = f"{written}::"
        }
        let segment = names.resolve(segments[k])
        written = f"{written}{segment}"
    }
    return written
}

/// `ConfigError::BadSyntax` is `ConfigError`; a struct with no `::` is itself.
fn struct_type(written: ref String) -> String {
    let mut parts: Vec[String] = []
    for part in written.split("::") {
        parts.push(part.clone())
    }
    if parts.len() < 2 {
        return written.clone()
    }
    let mut ty: String = ""
    for k in 0..<parts.len() - 1 {
        if k > 0 {
            ty = f"{ty}::"
        }
        ty = f"{ty}{parts[k]}"
    }
    return ty
}

// ---------------------------------------------------------------------------
// **What a function throws itself, and whom it calls** - the walk, moved from
// the compiler's `contracts::throws` (#125). What a call resolves to is the
// compiler's to say (`contribution_of`): `sync`'s single resolution (ADR-288),
// handed in as an answer per expression, as the holes of a literal are.

/// What one function contributes to its own error set before its callees are
/// taken into account: what it names in a `throw` (`?` where it cannot be
/// named), and the functions of this package it calls.
pub struct Thrown {
    pub direct: collections::BTreeSet[String],
    pub calls: collections::BTreeSet[String],
    /// Whether a `throw error` stood anywhere in what was walked: a handler
    /// that has one passes what it caught on (ADR-280 D10).
    passes_on: bool,
}

/// What an expression contributes, as the compiler resolved it: a function of
/// this package it calls, or the errors a ledger names for a callee outside
/// it (`?` for a call nobody can name), or neither.
pub struct Contribution {
    pub call: String?,
    pub errors: Vec[String],
}

/// What a function's body throws itself, and whom in this package it calls.
pub fn thrown_by(body: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> Thrown {
    let mut out = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false }
    thrown_in_block(body, names, holes_of, contribution_of, false, out)
    return out
}

// Each statement's expressions, then the blocks it holds - each with whether
// it is the handler of a `catch`, which is where `throw error` passes on what
// the guarded half threw rather than naming something new.
fn thrown_in_block(block: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Comptime { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Expr(value) => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Return(value) => thrown_in(value ?? continue, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in(target, names, holes_of, contribution_of, in_a_handler, false, out)
                thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out)
            }
            Stmt::For { iter, .. } => thrown_in(iter, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::While { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, false, out),
            else => {}
        }
        match stmt.node {
            Stmt::For { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::While { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Let { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Comptime { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Expr(value) => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Return(value) => thrown_in_blocks(value ?? continue, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in_blocks(target, names, holes_of, contribution_of, in_a_handler, out)
                thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out)
            }
            else => {}
        }
    }
}

// Every expression inside one, the holes of a literal included, and not the
// bodies of nested blocks. **What a handler catches and does not pass on is
// not the function's** (Part I 7.1): everything in the guarded half of a
// `catch` whose handler never writes `throw error` is `caught`, and fails into
// the handler and nowhere else.
fn thrown_in(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    a_contribution(expr, names, contribution_of, in_a_handler, caught, out)
    for hole in holes_of(expr) {
        thrown_in(hole, names, holes_of, contribution_of, in_a_handler, caught, out)
    }
    match expr {
        Expr::Call { func, args, config } => {
            thrown_in(func, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Binary { lhs, rhs, .. } => {
            thrown_in(lhs, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(rhs, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Unary { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Try(inner) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Throw(inner) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Cast { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Field { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::SafeField { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Index { base, index } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(index, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Range { start, end, .. } => {
            thrown_in(start, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(end, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Tuple(parts) => {
            for part in parts {
                thrown_in(part, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Coalesce { value, fallback } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(fallback, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::TryCatch { expr, handler } => {
            let into_the_handler = caught || !passes_on(handler, names, holes_of, contribution_of)
            thrown_in(expr, names, holes_of, contribution_of, in_a_handler, into_the_handler, out)
        }
        Expr::If { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Match { value, arms } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arm in arms {
                maybe_thrown_in(arm.guard, names, holes_of, contribution_of, in_a_handler, caught, out)
                thrown_in(arm.body, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::StructLit { fields, .. } => {
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::ListLit { items, .. } => {
            for item in items {
                thrown_in(item, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::With { base, fields, .. } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Return(value) => thrown_in(value ?? return, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Select(arms) => {
            for arm in arms {
                thrown_in(arm.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        else => {}
    }
}

fn maybe_thrown_in(expr: ref Expr?, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    thrown_in(expr ?? return, names, holes_of, contribution_of, in_a_handler, caught, out)
}

// Every block an expression holds, the body of a lambda passed as an argument
// included - and a `catch`'s handler, walked as one.
fn thrown_in_blocks(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    match expr {
        Expr::Block(block) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Unsafe(block) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Overlap(block) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Closure { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Call { func, args, config } => {
            thrown_in_blocks(func, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            thrown_in_block(then_branch, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(else_branch ?? return, names, holes_of, contribution_of, in_a_handler, out)
        }
        Expr::TryCatch { expr, handler } => {
            thrown_in_blocks(expr, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(handler, names, holes_of, contribution_of, true, out)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                thrown_in_blocks(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::Select(arms) => {
            for arm in arms {
                thrown_in_block(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        else => {}
    }
}

// What one expression contributes. **`throw error` in a handler passes the
// caught error on** (ADR-280 D10): its types are the guarded expression's,
// which the call there already contributed - read as a value nobody can name
// it added `?`, and the function's sum fell back to the unnamed error. Noted
// wherever it stands, caught or not, for `passes_on`.
fn a_contribution(expr: ref Expr, names: ref winnow_grammar::InternerContext, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    let passing = the_caught_error(expr, names)
    if passing {
        out.passes_on = true
    }
    if caught || (in_a_handler && passing) {
        return
    }
    match expr {
        // A `throw` that reached something this compiler cannot name - a
        // value from a call, say - fails; with what is the absence of a claim
        // rather than an answer.
        Expr::Throw(thrown) => {
            out.direct.insert(error_type(names, thrown) ?? "?")
        }
        else => {
            let given = contribution_of(expr)
            let call = given.call ?? ""
            if call.len() > 0 {
                out.calls.insert(call)
            }
            for error in given.errors {
                out.direct.insert(error.clone())
            }
        }
    }
}

// `throw error`, the caught error handed on.
fn the_caught_error(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Throw(thrown) => match thrown {
            Expr::Variable(name) => names.resolve(name) == "error",
            else => false,
        },
        else => false,
    }
}

// Whether a handler passes what it caught on: `throw error` anywhere in it
// (ADR-280 D10).
fn passes_on(handler: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> bool {
    let mut seen = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false }
    thrown_in_block(handler, names, holes_of, contribution_of, false, seen)
    return seen.passes_on
}
