// crates/nikaia-std/src/text.nika
//
// `std::text`, written in Nikaia.
//
// This file is compiled to Rust by the Stage 0 compiler when `nikaia-std` is
// built (`build.rs`), and the result is what `nikaia_std::text` is. It is the
// first piece of Nikaia's own standard library that is Nikaia rather than Rust,
// and it is small on purpose: what a Nikaia file can be here is exactly what
// Stage 0 can lower, and the moment that grows, so can this (ADR-014).

/// The value of a decimal digit: `'7'` is `7`.
///
/// A character that is not a digit is not a question this answers: it hands
/// back whatever the subtraction comes to.
//
// The prose above is the **documentation** (ADR-307 D4) and travels in the
// ledger; what follows is about the source and stays here.
//
// A free function rather than a method on the character: Rust's own
// `char::to_digit` has this name with a different shape, an inherent method
// wins over anything a library adds, and a call that resolves to the wrong
// thing is worse than a name that reads differently (ADR-013 D1).
// `sync` (Part II, 12.1): pure computation, it cannot pause and does no I/O.
// Saying so is what puts it in the ledger, and the ledger is what lets a
// `sync` caller in another program use it (Part III, 13.5).
pub fn digit_value(c: scalar) -> i32 sync {
    return c as i32 - 48
}

/// The whole number this text writes, or nothing where it writes none.
///
/// An optional `-` or `+`, then decimal digits, and nothing else: no space, no
/// `_`, no point. A number too large for an `i64` is nothing too, because the
/// text does not write an `i64`. `text::parse_i64(s) ?? 0` is the usual way to
/// read one; a program that has to say *why* a text is not a number looks at
/// it with a grammar, where `dec[i64](digit+)` reports where it went wrong.
//
// Written in Nikaia for the reason this file exists (ADR-014 D1), and the
// first function here that a compiler written in Nikaia needs: reading a
// number literal is `atoi`, and `std` had no way to do it.
//
// **The value is counted downward**, from `0` towards `least`: an `i64` has
// one more negative value than positive ones, so counting up would overflow on
// `-9223372036854775808`, the one text that writes the smallest `i64`. Before
// each digit the check asks whether `value * 10 - d` would pass `least` -
// `(least + d) / 10` rounds towards zero, which for a negative number is up,
// so a `value` below it is one step too far.
//
// **`null` where Rust's `parse` has an error**: the reasons it gives - empty,
// not a digit, too large - are one answer to a program that only asks *is this
// a number*, and the absence is data, as a key that is not in a map is
// (ADR-293 D1).
pub fn parse_i64(text: ref String) -> i64? sync {
    let least: i64 = -9223372036854775807 - 1
    let mut value: i64 = 0
    let mut negative = false
    let mut digits = 0
    let mut first = true
    for c in text.chars() {
        let signed = first && (c == '-' || c == '+')
        first = false
        if signed {
            negative = c == '-'
            continue
        }
        let d = match c {
            '0'..'9' => digit_value(c) as i64,
            else => return null,
        }
        if value < (least + d) / 10 {
            return null
        }
        value = value * 10 - d
        digits += 1
    }
    if digits == 0 {
        return null
    }
    if negative {
        return value
    }
    if value == least {
        return null
    }
    return 0 - value
}

/// The whole number this text writes as an `i32`, or nothing where it writes
/// none or one an `i32` does not hold. The text is read as `parse_i64` reads
/// it.
pub fn parse_i32(text: ref String) -> i32? sync {
    let n = parse_i64(text) ?? return null
    return n.checked_i32()
}

/// The whole number this text writes as a `u32`, or nothing where it writes
/// none or one a `u32` does not hold. Decimal digits with an optional `+`; an
/// unsigned number takes no `-`, not even `-0`.
pub fn parse_u32(text: ref String) -> u32? sync {
    let n = parse_u64(text) ?? return null
    return n.checked_u32()
}

/// The whole number this text writes as a `u8`, or nothing where it writes
/// none or one a `u8` does not hold, as `parse_u32` reads it.
pub fn parse_u8(text: ref String) -> u8? sync {
    let n = parse_u64(text) ?? return null
    if n > 255 {
        return null
    }
    return n as u8
}

/// The whole number this text writes as a `u64`, or nothing where it writes
/// none or one a `u64` does not hold, as `parse_u32` reads it.
//
// Its own loop, because a `u64` holds numbers no `i64` does: counted upward,
// and before each digit the check asks whether `value * 10 + d` would pass the
// largest `u64`.
pub fn parse_u64(text: ref String) -> u64? sync {
    let most: u64 = 18446744073709551615
    let mut value: u64 = 0
    let mut digits = 0
    let mut first = true
    for c in text.chars() {
        let signed = first && c == '+'
        first = false
        if signed {
            continue
        }
        let d = match c {
            '0'..'9' => (c as u64) - 48,
            else => return null,
        }
        if value > (most - d) / 10 {
            return null
        }
        value = value * 10 + d
        digits += 1
    }
    if digits == 0 {
        return null
    }
    return value
}
