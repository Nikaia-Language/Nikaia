// crates/nikaia/tests/fixtures/sql_statement.nika
//
// A DSL with deferred parameters, end to end (ADR-296 D5).
//
// The statement is written once and carries two holes it does not fill:
// `:id` and `:active` are *deferred* parameters, resolved where the statement
// is used rather than where it is written (ADR-296 D4). That is what makes a
// prepared statement worth preparing - baking the values in destroys the reuse.
//
// The compiler reads the holes out of the body and generates a type carrying
// their names. The call site supplies them as named arguments after the `;`,
// because a DSL parameter is configuration and the Subject `;` Config protocol
// of Part I 5.1 applies to metaprogramming without exception. Leaving one out,
// or naming one the statement does not have, is a compile error against this
// file.

pub struct Db {
    name: String,
}

impl Db {
    // The driver. `...args: Self::dsl` is the typed spread of ADR-296 D5: the
    // parameters of whatever statement this call was given, as one value on
    // the stack.
    pub fn prepare(ref self, statement: ref String; ...args: Self::dsl) -> Self::dsl {
        println(f"{self.name}: {statement}")
        return args
    }
}

fn main() {
    let db = Db { name: "people.db" }

    let query = dsl mysql {
        SELECT name FROM people WHERE id = :id AND active = :active
    } eod

    // Subject: the statement ; Config: what it left open.
    let bound = db.prepare(query; id: 501, active: true)

    println(f"id={bound.id} active={bound.active}")
}
