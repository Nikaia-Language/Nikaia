// crates/nikaia/tests/fixtures/broken_frame.nika
//
// A frame whose rules can run through its own boundary. `until(";")` stops at
// the semicolon and nowhere else, so a line without one runs past the newline
// and swallows the next measurement - which is exactly what makes cutting the
// input at newlines wrong here. The parser backend rejects the grammar rather
// than repairing it (ADR-296 D9).
//
// The point of this fixture is not that it is rejected. It is *where* the
// rejection is reported: line 15, not a line of generated Rust.

grammar Measurements {

    rule NAME -> ref String =
        s:until(";")
        { s }

    @frame(boundary: "\n")
    pub rule MEASUREMENT -> ref String =
        name:NAME ";" frame_end
        { name }
}
